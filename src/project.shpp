#ifndef EDITOR_PROJECT
#define EDITOR_PROJECT

/* A project is a named list of files. It is optional, and
 * more than one project may describe the same directory.
 * Each project is a text file under
 * $HOME/.config/smallcpp/projects/<name>.project.
 * That file also stores the editor's place in the project:
 * the active file, the line, and the other open files.
 * The global editor.ini session is a separate choice.
 */
#include "util.shpp"

enum {
    PROJECT_FILES = 128,
    PROJECT_OPENS = 32,
    PROJECT_ROWS = 160,
    PROJECT_PART = 192,
    PROJECT_LABEL = 224,
    PROJECT_REL = 256,
    PROJECT_NAME = 64,
    PROJECT_KNOWN = 32,
    PROJECT_EXPAND = 48,
    PROJECT_OMIT = 16
};

class EditProject {
public:
    EditProject();
    void clear(void);
    int make(
            const char *name,
            const char *kind,
            const char *path);
    int add_file(const char *path);
    int drop_path(const char *path);
    int load(const char *name);
    int save(void);
    int save_as(const char *name);
    int remove_store(void);
    void clear_opens(void);
    int note_open(const char *path);
    void note_active(const char *path, int line);
    const char *name(void);
    const char *kind_name(void);
    const char *theme_name(void);
    void set_theme(const char *name);
    const char *root(void);
    const char *active_path(void);
    int active_line(void);
    int open_count(void);
    const char *open_at(int index);
    int file_count(void);
    int store_path(char *dest, long cap);
    int row_count(void);
    const char *row_name(int index);
    const char *row_label(int index);
    int row_is_dir(int index);
    const char *row_path(int index);
    int toggle_row(int index);
private:
    char nameText[PROJECT_NAME];
    char kindText[16];
    char themeText[32];
    char rootPath[EDITOR_PATH];
    char activePath[EDITOR_PATH];
    int placeLine;
    int files;
    int opens;
    int rows;
    int expanded;
    char filePath[PROJECT_FILES][EDITOR_PATH];
    char openPath[PROJECT_OPENS][EDITOR_PATH];
    int rowDepth[PROJECT_ROWS];
    int rowDir[PROJECT_ROWS];
    char rowName[PROJECT_ROWS][PROJECT_PART];
    char rowLabel[PROJECT_ROWS][PROJECT_LABEL];
    char rowKey[PROJECT_ROWS][PROJECT_REL];
    char rowPath[PROJECT_ROWS][EDITOR_PATH];
    char expandKey[PROJECT_EXPAND][PROJECT_REL];
    int omits;
    char omitPath[PROJECT_OMIT][EDITOR_PATH];
    int add_abs(const char *path);
    int forget_one(const char *norm);
    void forget_open(const char *norm);
    void drop_omitted(void);
    int note_omit(const char *path);
    void share_root(void);
    int collect(void);
    void walk(const char *dir, int depth);
    int collect_git(void);
    void collect_cmake(const char *dir, int depth);
    void scan_cmake(
            const char *dir,
            const char *text,
            long n,
            int depth);
    void build_tree(void);
    void emit(const char *dirRel, int depth);
    int next_child(
            const char *dirRel,
            const char *after,
            char *name,
            int *isDir);
    void abs_for(
            const char *rel,
            char *dest,
            long cap);
    int expanded_has(const char *key);
    int expanded_add(const char *key);
    void expanded_drop(const char *key);
};

int project_catalog(char *dest, long cap);
int project_known(
        char dest[][PROJECT_NAME],
        int cap);
int template_archive(char *dest, long cap);
int unpack_template(const char *dir);

#endif
