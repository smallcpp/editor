#include "keys.shpp"
#include "util.shpp"

static void key_row(
        int index,
        int want,
        const char *label,
        const char *command,
        const char *config,
        const char *accel,
        const char **outLabel,
        const char **outCommand,
        const char **outConfig,
        const char **outAccel) {
    if (index != want)
        return;
    *outLabel = label;
    *outCommand = command;
    *outConfig = config;
    *outAccel = accel;
}

void key_info(
        int index,
        const char **label,
        const char **command,
        const char **config,
        const char **accel) {
    if (label == nullptr || command == nullptr
            || config == nullptr || accel == nullptr)
        return;
    *label = "";
    *command = "";
    *config = "";
    *accel = "";
    key_row(index, 0, "New", "new", "key-new",
            "<Control>n", label, command, config, accel);
    key_row(index, 1, "Open", "open", "key-open",
            "<Control>o", label, command, config, accel);
    key_row(index, 2, "Save", "save", "key-save",
            "<Control>s", label, command, config, accel);
    key_row(index, 3, "Save As", "save-as", "key-save-as",
            "<Control><Shift>s",
            label, command, config, accel);
    key_row(index, 4, "Save All", "save-all",
            "key-save-all", "<Control><Shift>l",
            label, command, config, accel);
    key_row(index, 5, "Close", "close", "key-close",
            "<Control>w", label, command, config, accel);
    key_row(index, 6, "Close All", "close-all",
            "key-close-all", "<Control><Shift>w",
            label, command, config, accel);
    key_row(index, 7, "Quit", "quit", "key-quit",
            "<Control>q", label, command, config, accel);
    key_row(index, 8, "Undo", "undo", "key-undo",
            "<Control>z", label, command, config, accel);
    key_row(index, 9, "Redo", "redo", "key-redo",
            "<Control>y", label, command, config, accel);
    key_row(index, 10, "Cut", "cut", "key-cut",
            "<Control>x", label, command, config, accel);
    key_row(index, 11, "Copy", "copy", "key-copy",
            "<Control>c", label, command, config, accel);
    key_row(index, 12, "Paste", "paste", "key-paste",
            "<Control>v", label, command, config, accel);
    key_row(index, 13, "Select All", "select-all",
            "key-select-all", "<Control>a",
            label, command, config, accel);
    key_row(index, 14, "Indent", "indent", "key-indent",
            "<Control>bracketright",
            label, command, config, accel);
    key_row(index, 15, "Unindent", "unindent",
            "key-unindent", "<Control>bracketleft",
            label, command, config, accel);
    key_row(index, 16, "Comment", "comment",
            "key-comment", "<Control>slash",
            label, command, config, accel);
    key_row(index, 17, "Block comment", "block-comment",
            "key-block-comment", "<Alt>slash",
            label, command, config, accel);
    key_row(index, 18, "Search", "search", "key-search",
            "<Control>f", label, command, config, accel);
    key_row(index, 19, "Replace", "replace",
            "key-replace", "<Control>h",
            label, command, config, accel);
}

static int key_glyph(const char *name) {
    if (name == nullptr)
        return 0;
    if (name[0] == 'K' && name[1] == 'P' && name[2] == '_'
            && name[3] >= '0' && name[3] <= '9'
            && name[4] == 0)
        return (int)name[3];
    if (text_same(name, "space") == 1
            || text_same(name, "KP_Space") == 1)
        return ' ';
    if (text_same(name, "exclam") == 1)
        return '!';
    if (text_same(name, "quotedbl") == 1)
        return '"';
    if (text_same(name, "numbersign") == 1)
        return '#';
    if (text_same(name, "dollar") == 1)
        return '$';
    if (text_same(name, "percent") == 1)
        return '%';
    if (text_same(name, "ampersand") == 1)
        return '&';
    if (text_same(name, "apostrophe") == 1
            || text_same(name, "quoteright") == 1)
        return '\'';
    if (text_same(name, "parenleft") == 1)
        return '(';
    if (text_same(name, "parenright") == 1)
        return ')';
    if (text_same(name, "asterisk") == 1
            || text_same(name, "KP_Multiply") == 1)
        return '*';
    if (text_same(name, "plus") == 1
            || text_same(name, "KP_Add") == 1)
        return '+';
    if (text_same(name, "comma") == 1
            || text_same(name, "KP_Separator") == 1)
        return ',';
    if (text_same(name, "minus") == 1
            || text_same(name, "KP_Subtract") == 1)
        return '-';
    if (text_same(name, "period") == 1
            || text_same(name, "KP_Decimal") == 1)
        return '.';
    if (text_same(name, "slash") == 1
            || text_same(name, "KP_Divide") == 1)
        return '/';
    if (text_same(name, "colon") == 1)
        return ':';
    if (text_same(name, "semicolon") == 1)
        return ';';
    if (text_same(name, "less") == 1)
        return '<';
    if (text_same(name, "equal") == 1
            || text_same(name, "KP_Equal") == 1)
        return '=';
    if (text_same(name, "greater") == 1)
        return '>';
    if (text_same(name, "question") == 1)
        return '?';
    if (text_same(name, "at") == 1)
        return '@';
    if (text_same(name, "bracketleft") == 1)
        return '[';
    if (text_same(name, "backslash") == 1)
        return '\\';
    if (text_same(name, "bracketright") == 1)
        return ']';
    if (text_same(name, "asciicircum") == 1)
        return '^';
    if (text_same(name, "underscore") == 1)
        return '_';
    if (text_same(name, "grave") == 1
            || text_same(name, "quoteleft") == 1)
        return '`';
    if (text_same(name, "braceleft") == 1)
        return '{';
    if (text_same(name, "bar") == 1)
        return '|';
    if (text_same(name, "braceright") == 1)
        return '}';
    if (text_same(name, "asciitilde") == 1)
        return '~';
    return 0;
}

void accel_shown(
        char *dest,
        long cap,
        const char *accel) {
    long i;
    long n;

    if (dest == nullptr || cap < 1)
        return;
    dest[0] = 0;
    if (accel == nullptr || accel[0] == 0) {
        text_copy(dest, cap, "none");
        return;
    }
    i = 0;
    n = 0;
    while (accel[i] != 0 && n + 1 < cap) {
        if (accel[i] == '<') {
            while (accel[i] != 0 && n + 1 < cap) {
                dest[n] = accel[i];
                n = n + 1;
                if (accel[i] == '>') {
                    i = i + 1;
                    break;
                }
                i = i + 1;
            }
        }
        else {
            char token[64];
            long t;
            long k;
            int glyph;

            t = 0;
            while (accel[i] != 0 && accel[i] != '<'
                    && t + 1 < 64) {
                token[t] = accel[i];
                t = t + 1;
                i = i + 1;
            }
            token[t] = 0;
            glyph = 0;
            if (t > 1)
                glyph = key_glyph(token);
            if (glyph != 0) {
                dest[n] = (char)glyph;
                n = n + 1;
            }
            else {
                k = 0;
                while (k < t && n + 1 < cap) {
                    dest[n] = token[k];
                    n = n + 1;
                    k = k + 1;
                }
            }
        }
    }
    dest[n] = 0;
}

int key_index(const char *line) {
    int i;

    if (line == nullptr)
        return -1;
    i = 0;
    while (i < EDITOR_KEY_COUNT) {
        const char *label;
        const char *command;
        const char *config;
        const char *accel;
        long n;

        key_info(i, &label, &command, &config, &accel);
        n = 0;
        while (config[n] != 0 && line[n] == config[n])
            n = n + 1;
        if (config[n] == 0 && line[n] == '=')
            return i;
        i = i + 1;
    }
    return -1;
}

int key_place(int index, long *menu, long *item) {
    if (menu == nullptr || item == nullptr)
        return 0;
    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return 0;
    if (index < 2) {
        *menu = 0;
        *item = index;
        return 1;
    }
    if (index < 8) {
        *menu = 0;
        *item = index + 1;
        return 1;
    }
    if (index < 18) {
        *menu = 1;
        *item = index - 8;
        return 1;
    }
    *menu = 2;
    *item = index - 18;
    return 1;
}
