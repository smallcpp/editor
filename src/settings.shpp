#ifndef EDITOR_SETTINGS
#define EDITOR_SETTINGS

/* The editor's settings file. The directory is the
 * same one the compiler uses for config.ini. This
 * file is editor.ini and does not replace that one.
 */
#include "util.shpp"
#include "keys.shpp"

enum {
    EDITOR_OPEN_MAX = 32,
    EDITOR_RECENT_MAX = 32,
    THEME_TAGS = 8,
    THEME_ALL = 37,
    THEME_MAX = 64,
    THEME_NAME = 32,
    THEME_LIST = 32
};

class EditorConfig {
public:
    int brackets;
    char bracketPairs[64];
    int indent;
    int spaces;
    int tabWidth;
    int showLine;
    int showMargin;
    int showClose;
    int marginCols;
    int searchWrap;
    int searchBack;
    int searchWhole;
    int searchCase;
    int showSpace;
    int showEnds;
    int showStops;
    int showLeft;
    int showMap;
    char lineColor[32];
    char marginColor[32];
    char themeName[THEME_NAME];
    char themeColor[THEME_ALL][32];
    int themeUsed;
    char themeLang[THEME_MAX][16];
    int themeSlot[THEME_MAX];
    char themeOver[THEME_MAX][32];
    char font[128];
    char accel[EDITOR_KEY_COUNT][64];
    int windowWidth;
    int windowHeight;
    int rememberFiles;
    int saveOnTab;
    int saveOnWindow;
    int trimTrailing;
    int ensureNewline;
    int showPath;
    int pathDepth;
    int recoveryOn;
    int recoveryMinutes;
    int recoveryKeep;
    int recentCount;
    int openCount;
    int recentUsed;
    char openPath[EDITOR_OPEN_MAX][EDITOR_PATH];
    char recentPath[EDITOR_RECENT_MAX][EDITOR_PATH];
    char activePath[EDITOR_PATH];
};

void config_defaults(EditorConfig *item);
const char *theme_name(int slot);
int theme_set(
        EditorConfig *item,
        const char *language,
        const char *tag,
        const char *color);
const char *theme_color(
        const EditorConfig *item,
        const char *language,
        const char *tag);
int theme_bold_slot(int slot);
int theme_bold(
        const EditorConfig *item,
        const char *language,
        const char *tag);
void theme_copy(
        EditorConfig *dest,
        const EditorConfig *src);
int config_path(char *dest, long cap);
int recovery_dir(char *dest, long cap);
int project_home(char *dest, long cap, const char *project);
int project_config_path(
        char *dest,
        long cap,
        const char *project);
int project_lines(
        const char *path,
        char dest[][EDITOR_PATH],
        int cap);
int settings_note(
        const char *path,
        const char *recoveryDir,
        const char projects[][EDITOR_PATH],
        int count);
int project_store(
        const char *project,
        const EditorConfig *item,
        const char projects[][EDITOR_PATH],
        int count);
int theme_load(EditorConfig *item, const char *name);
int theme_save(const char *name, const EditorConfig *item);
int theme_list(char names[][THEME_NAME], int cap);
int theme_is_default(const char *name);
int config_read(const char *path, EditorConfig *item);
int config_write(
        const char *path,
        const EditorConfig *item);

#endif
