#ifndef EDITOR_PANEL
#define EDITOR_PANEL

/* The left panel's folder, file list, CMake names, and
 * symbols. It stores names and paths. It does not keep
 * a copy of a buffer.
 */
#include "util.shpp"

enum {
    PANEL_FILES = 128,
    PANEL_NAME = 256,
    PANEL_TARGETS = 32,
    PANEL_CMDS = 48,
    PANEL_CMD = 192,
    PANEL_SYMBOLS = 64
};

class SidePanel {
public:
    SidePanel();
    int set_root(const char *path);
    const char *root(void);
    const char *listed(void);
    int file_count(void);
    const char *file_name(int index);
    int row_dir(int index);
    int file_path(int index, char *dest, long cap);
    int enter(int index);
    int cmake_project(void);
    void read_lists(const char *text);
    int target_count(void);
    const char *target_name(int index);
    void read_commands(const char *text);
    int command_count(void);
    const char *command_file(int index);
    const char *command_line(int index);
    void scan_symbols(
            const char *text,
            const char *language);
    int symbol_count(void);
    const char *symbol_name(int index);
    long symbol_line(int index);
private:
    char rootPath[EDITOR_PATH];
    char listPath[EDITOR_PATH];
    int files;
    int fileDir[PANEL_FILES];
    char fileName[PANEL_FILES][PANEL_NAME];
    int cmakeOn;
    int targets;
    char targetName[PANEL_TARGETS][PANEL_NAME];
    int commands;
    char commandFile[PANEL_CMDS][EDITOR_PATH];
    char commandLine[PANEL_CMDS][PANEL_CMD];
    int symbols;
    long symbolLine[PANEL_SYMBOLS];
    char symbolName[PANEL_SYMBOLS][PANEL_NAME];
    void list_dir(void);
    void read_project(void);
    void add_target(const char *name);
    void add_command(const char *file, const char *line);
    void add_symbol(const char *name, long line);
    void sort_files(void);
};

#endif
