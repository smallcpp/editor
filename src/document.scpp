#include "document.shpp"



Document::Document() {
    filePath = new String();
    titleText = new String();
    titleText->append("untitled.scpp");
    loaded = new String();
    ignored = new String();
    missingNoted = 0;
    lang = new String();
    lang->append("scpp");
    errorText = new String();
    body = new EditBuffer();
    isUntitled = 1;
}

void Document::set_error(const char *msg) {
    errorText->truncate(0, errorText->size());
    if (msg != nullptr)
        errorText->append(msg);
}

const char *Document::error(void) {
    return errorText->c_str();
}

const char *Document::path(void) {
    return filePath->c_str();
}

int Document::untitled(void) {
    return isUntitled;
}

const char *Document::title(void) {
    return titleText->c_str();
}

const char *Document::language(void) {
    return lang->c_str();
}

void Document::apply_language(void) {
    const char *next;

    if (isUntitled == 1)
        return;
    next = language_of(filePath->c_str());
    if (next == nullptr)
        next = "plain";
    lang->truncate(0, lang->size());
    lang->append(next);
}

EditBuffer *Document::buffer(void) {
    return body;
}

void Document::apply_name(const char *path) {
    char copy[EDITOR_PATH];

    if (path == nullptr)
        copy[0] = 0;
    else
        text_copy(copy, EDITOR_PATH, path);
    filePath->truncate(0, filePath->size());
    titleText->truncate(0, titleText->size());
    lang->truncate(0, lang->size());
    if (copy[0] == 0) {
        isUntitled = 1;
        titleText->append("untitled.scpp");
        lang->append("scpp");
        return;
    }
    isUntitled = 0;
    filePath->append(copy);
    titleText->append(path_base(copy));
    lang->append(language_of(copy));
}

void Document::remember(void) {
    loaded = new String();
    loaded->append(body->text());
    ignored = new String();
    missingNoted = 0;
}

int Document::take_bytes(const char *path, char *raw, long n) {
    if (bytes_have_nul(raw, n) == 1) {
        set_error("not a text file");
        return 0;
    }
    if (utf8_ok(raw, n) == 0) {
        set_error("not a text file");
        return 0;
    }
    body->set_text(raw);
    apply_name(path);
    remember();
    set_error("");
    return 1;
}

int Document::load_path(const char *path) {
    char *raw;
    long n;
    const char *io;

    io = "";
    raw = read_file(path, &n, &io);
    if (raw == nullptr) {
        set_error(io);
        return 0;
    }
    return take_bytes(path, raw, n);
}

int Document::save_file(bool strip) {
    const char *io;

    if (isUntitled == 1) {
        set_error("untitled");
        return 0;
    }
    if (strip == true)
        body->strip_trailing();
    io = "";
    if (write_file(filePath->c_str(), body->text(), &io) == 0) {
        set_error(io);
        return 0;
    }
    remember();
    body->mark_clean();
    set_error("");
    return 1;
}

int Document::save_as(const char *path, bool strip) {
    String *oldPath;
    String *oldTitle;
    String *oldLang;
    int wasUntitled;
    int wrote;

    if (path == nullptr || path[0] == 0) {
        set_error("missing path");
        return 0;
    }
    if (path_has_scheme(path) == 1) {
        set_error("not a local path");
        return 0;
    }
    oldPath = new String();
    oldPath->append(filePath->c_str());
    oldTitle = new String();
    oldTitle->append(titleText->c_str());
    oldLang = new String();
    oldLang->append(lang->c_str());
    wasUntitled = isUntitled;
    apply_name(path);
    wrote = save_file(strip);
    if (wrote == 1)
        return 1;
    filePath->truncate(0, filePath->size());
    filePath->append(oldPath->c_str());
    titleText->truncate(0, titleText->size());
    titleText->append(oldTitle->c_str());
    lang->truncate(0, lang->size());
    lang->append(oldLang->c_str());
    isUntitled = wasUntitled;
    return 0;
}

int Document::reload_file(void) {
    char *raw;
    long n;
    const char *io;
    long line;
    long column;

    if (isUntitled == 1) {
        set_error("untitled");
        return 0;
    }
    io = "";
    raw = read_file(filePath->c_str(), &n, &io);
    if (raw == nullptr) {
        set_error(io);
        return 0;
    }
    line = body->cursor_line();
    column = body->cursor_column();
    if (take_bytes(filePath->c_str(), raw, n) == 0)
        return 0;
    body->move_to(line, column);
    return 1;
}

int Document::disk_differs(void) {
    char *raw;
    long n;
    const char *io;

    if (isUntitled == 1)
        return 0;
    io = "";
    raw = read_file(filePath->c_str(), &n, &io);
    if (raw == nullptr)
        return 1;
    if (bytes_have_nul(raw, n) == 1 || utf8_ok(raw, n) == 0)
        return 1;
    if (text_same(raw, loaded->c_str()) == 1)
        return 0;
    return 1;
}

int Document::disk_status(void) {
    char *raw;
    long n;
    const char *io;

    if (isUntitled == 1)
        return 0;
    if (file_exists(filePath->c_str()) == 0) {
        if (missingNoted == 1)
            return 0;
        return 2;
    }
    missingNoted = 0;
    io = "";
    raw = read_file(filePath->c_str(), &n, &io);
    if (raw == nullptr) {
        if (missingNoted == 1)
            return 0;
        return 2;
    }
    if (ignored->size() > 0
            && text_same(raw, ignored->c_str()) == 1)
        return 0;
    if (bytes_have_nul(raw, n) == 1 || utf8_ok(raw, n) == 0)
        return 1;
    if (text_same(raw, loaded->c_str()) == 1) {
        ignored = new String();
        return 0;
    }
    return 1;
}

void Document::ignore_disk(void) {
    char *raw;
    long n;
    const char *io;

    if (isUntitled == 1)
        return;
    io = "";
    raw = read_file(filePath->c_str(), &n, &io);
    if (raw == nullptr) {
        missingNoted = 1;
        return;
    }
    ignored = new String();
    ignored->append(raw);
}

void Document::mark_missing(void) {
    missingNoted = 1;
}

static void put_hash(char *dest, long *used, long cap, long hash) {
    char digits[16];
    long n;
    long i;

    if (hash < 0)
        hash = -hash;
    n = 0;
    if (hash == 0) {
        digits[0] = '0';
        n = 1;
    }
    while (hash > 0 && n < 16) {
        digits[n] = (char)('0' + (hash % 10));
        hash = hash / 10;
        n = n + 1;
    }
    i = n;
    while (i > 0) {
        if (*used + 1 >= cap)
            return;
        i = i - 1;
        dest[*used] = digits[i];
        *used = *used + 1;
    }
}

int Document::load_recovery(
        const char *path,
        const char *text) {
    long n;

    if (path == nullptr || path[0] == 0 || text == nullptr)
        return 0;
    n = text_length(text);
    if (bytes_have_nul(text, n) == 1 || utf8_ok(text, n) == 0) {
        set_error("not a text file");
        return 0;
    }
    body->set_text(text);
    apply_name(path);
    remember();
    mark_missing();
    body->mark_dirty();
    set_error("");
    return 1;
}

int recovery_leaf_for(const char *path, char *dest, long cap) {
    const char *base;
    long hash;
    long i;
    long n;
    int c;

    if (dest == nullptr || cap < 16)
        return 0;
    dest[0] = 0;
    if (path == nullptr || path[0] == 0)
        return 0;
    base = path_base(path);
    hash = 0;
    i = 0;
    n = 0;
    while (path[i] != 0) {
        c = path[i];
        if (c < 0)
            c = c + 256;
        hash = hash * 33 + c;
        if (hash < 0)
            hash = -hash;
        i = i + 1;
    }
    i = 0;
    while (base[i] != 0 && n + 1 < cap && n < 40) {
        c = base[i];
        if ((c >= 'a' && c <= 'z')
                || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')
                || c == '.' || c == '-' || c == '_')
            dest[n] = (char)c;
        else
            dest[n] = '_';
        n = n + 1;
        i = i + 1;
    }
    if (n + 1 >= cap)
        return 0;
    dest[n] = '-';
    n = n + 1;
    put_hash(dest, &n, cap, hash);
    {
        char suffix[12];

        text_copy(suffix, 12, ".recover");
        i = 0;
        while (suffix[i] != 0) {
            if (n + 1 >= cap)
                return 0;
            dest[n] = suffix[i];
            n = n + 1;
            i = i + 1;
        }
    }
    dest[n] = 0;
    return 1;
}

int Document::recovery_leaf(char *dest, long cap) {
    if (isUntitled == 1)
        return 0;
    return recovery_leaf_for(filePath->c_str(), dest, cap);
}

int Document::write_recovery(const char *dir) {
    char leaf[128];
    char path[EDITOR_PATH];
    const char *io;

    if (dir == nullptr || dir[0] == 0)
        return 0;
    if (recovery_leaf(leaf, 128) == 0)
        return 0;
    path_join(path, EDITOR_PATH, dir, leaf);
    if (path[0] == 0)
        return 0;
    io = "";
    return write_file(path, body->text(), &io);
}

void Document::rename_untitled(void) {
    apply_name(nullptr);
}
