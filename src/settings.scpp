#include "settings.shpp"
#include "syntax.shpp"
#include "buffer.shpp"
#include <dirent>

extern char *getenv(const char *name);

static int color_ok(const char *text) {
    long n;
    char c;
    int letter;

    if (text == nullptr)
        return 0;
    n = 0;
    while (text[n] != 0) {
        c = text[n];
        letter = 0;
        if (c >= 'a' && c <= 'z')
            letter = 1;
        if (c >= 'A' && c <= 'Z')
            letter = 1;
        if (c >= '0' && c <= '9')
            letter = 1;
        if (c == '#')
            letter = 1;
        if (letter == 0)
            return 0;
        n = n + 1;
        if (n > 30)
            return 0;
    }
    if (n == 0)
        return 0;
    return 1;
}

static int lang_ok(const char *text) {
    long n;
    char c;

    if (text == nullptr)
        return 0;
    n = 0;
    while (text[n] != 0) {
        c = text[n];
        if (c < 'a' || c > 'z')
            return 0;
        n = n + 1;
        if (n >= 16)
            return 0;
    }
    if (n == 0)
        return 0;
    return 1;
}

const char *theme_name(int slot) {
    if (slot == 0)
        return "keyword";
    if (slot == 1)
        return "type";
    if (slot == 2)
        return "string";
    if (slot == 3)
        return "comment";
    if (slot == 4)
        return "number";
    if (slot == 5)
        return "preprocessor";
    if (slot == 6)
        return "call";
    if (slot == 7)
        return "operator";
    if (slot == 8)
        return "brackets";
    if (slot == 9)
        return "brackets-back";
    if (slot == 10)
        return "brackets-unmatched";
    if (slot == 11)
        return "brackets-unmatched-back";
    if (slot == 12)
        return "background";
    if (slot == 13)
        return "keyword-bold";
    if (slot == 14)
        return "type-bold";
    if (slot == 15)
        return "string-bold";
    if (slot == 16)
        return "comment-bold";
    if (slot == 17)
        return "number-bold";
    if (slot == 18)
        return "preprocessor-bold";
    if (slot == 19)
        return "call-bold";
    if (slot == 20)
        return "operator-bold";
    if (slot == 21)
        return "brackets-bold";
    if (slot == 22)
        return "brackets-unmatched-bold";
    if (slot == 23)
        return "text";
    if (slot == 24)
        return "menu";
    if (slot == 25)
        return "menu-text";
    if (slot == 26)
        return "tab";
    if (slot == 27)
        return "tab-text";
    if (slot == 28)
        return "tab-current";
    if (slot == 29)
        return "keyword-back";
    if (slot == 30)
        return "type-back";
    if (slot == 31)
        return "string-back";
    if (slot == 32)
        return "comment-back";
    if (slot == 33)
        return "number-back";
    if (slot == 34)
        return "preprocessor-back";
    if (slot == 35)
        return "call-back";
    if (slot == 36)
        return "operator-back";
    return "";
}

static int tag_slot(const char *name) {
    int slot;

    if (name == nullptr)
        return -1;
    slot = 0;
    while (slot < THEME_ALL) {
        if (text_same(name, theme_name(slot)) == 1)
            return slot;
        slot = slot + 1;
    }
    return -1;
}

static int theme_cut(const char *name, long *cut) {
    int slot;
    const char *tag;
    long n;
    long t;
    long i;

    n = 0;
    while (name[n] != 0)
        n = n + 1;
    slot = THEME_ALL - 1;
    while (slot >= 0) {
        tag = theme_name(slot);
        t = 0;
        while (tag[t] != 0)
            t = t + 1;
        if (t > 0 && t <= n) {
            i = 0;
            while (i < t
                    && name[n - t + i] == tag[i])
                i = i + 1;
            if (i == t && t == n) {
                *cut = 0;
                return slot;
            }
            if (i == t && name[n - t - 1] == '-') {
                *cut = n - t;
                return slot;
            }
        }
        slot = slot - 1;
    }
    return -1;
}

int theme_set(
        EditorConfig *item,
        const char *language,
        const char *tag,
        const char *color) {
    int slot;
    int i;

    if (item == nullptr)
        return 0;
    if (color_ok(color) == 0)
        return 0;
    slot = tag_slot(tag);
    if (slot < 0)
        return 0;
    if (language == nullptr || language[0] == 0) {
        text_copy(item->themeColor[slot], 32, color);
        return 1;
    }
    if (lang_ok(language) == 0)
        return 0;
    i = 0;
    while (i < item->themeUsed) {
        if (item->themeSlot[i] == slot
                && text_same(
                        item->themeLang[i],
                        language) == 1) {
            text_copy(item->themeOver[i], 32, color);
            return 1;
        }
        i = i + 1;
    }
    if (item->themeUsed >= THEME_MAX)
        return 0;
    text_copy(
            item->themeLang[item->themeUsed],
            16,
            language);
    item->themeSlot[item->themeUsed] = slot;
    text_copy(
            item->themeOver[item->themeUsed],
            32,
            color);
    item->themeUsed = item->themeUsed + 1;
    return 1;
}

const char *theme_color(
        const EditorConfig *item,
        const char *language,
        const char *tag) {
    int slot;
    int i;

    if (item == nullptr || tag == nullptr)
        return "";
    slot = tag_slot(tag);
    if (slot < 0)
        return "";
    if (language != nullptr && language[0] != 0) {
        i = 0;
        while (i < item->themeUsed) {
            if (item->themeSlot[i] == slot
                    && text_same(
                            item->themeLang[i],
                            language) == 1)
                return item->themeOver[i];
            i = i + 1;
        }
    }
    return item->themeColor[slot];
}

int theme_bold_slot(int slot) {
    if (slot >= 0 && slot < THEME_TAGS)
        return 13 + slot;
    if (slot == 8)
        return 21;
    if (slot == 10)
        return 22;
    return -1;
}

int theme_bold(
        const EditorConfig *item,
        const char *language,
        const char *tag) {
    char name[40];
    const char *value;
    long i;
    long n;
    const char *suffix;

    if (tag == nullptr)
        return 0;
    i = 0;
    while (tag[i] != 0 && i < 30) {
        name[i] = tag[i];
        i = i + 1;
    }
    suffix = "-bold";
    n = 0;
    while (suffix[n] != 0 && i < 39) {
        name[i] = suffix[n];
        i = i + 1;
        n = n + 1;
    }
    name[i] = 0;
    value = theme_color(item, language, name);
    if (value[0] == '1' && value[1] == 0)
        return 1;
    return 0;
}

void theme_copy(
        EditorConfig *dest,
        const EditorConfig *src) {
    int i;
    int slot;

    if (dest == nullptr || src == nullptr)
        return;
    slot = 0;
    while (slot < THEME_ALL) {
        text_copy(
                dest->themeColor[slot],
                32,
                src->themeColor[slot]);
        slot = slot + 1;
    }
    dest->themeUsed = src->themeUsed;
    if (dest->themeUsed > THEME_MAX)
        dest->themeUsed = THEME_MAX;
    if (dest->themeUsed < 0)
        dest->themeUsed = 0;
    i = 0;
    while (i < dest->themeUsed) {
        text_copy(
                dest->themeLang[i],
                16,
                src->themeLang[i]);
        dest->themeSlot[i] = src->themeSlot[i];
        text_copy(
                dest->themeOver[i],
                32,
                src->themeOver[i]);
        i = i + 1;
    }
}

static void theme_defaults(EditorConfig *item) {
    int slot;

    item->themeUsed = 0;
    theme_set(item, "", "keyword", "#2040c0");
    theme_set(item, "", "type", "#6030a0");
    theme_set(item, "", "string", "#208020");
    theme_set(item, "", "comment", "#808080");
    theme_set(item, "", "number", "#804000");
    theme_set(item, "", "preprocessor", "#a04020");
    theme_set(item, "", "call", "#106060");
    theme_set(item, "", "operator", "#404040");
    theme_set(item, "", "brackets", "#1a1a1a");
    theme_set(item, "", "brackets-back", "#ffd56a");
    theme_set(
            item,
            "",
            "brackets-unmatched",
            "#ffffff");
    theme_set(
            item,
            "",
            "brackets-unmatched-back",
            "#c03030");
    theme_set(item, "", "background", "#ffffff");
    theme_set(item, "", "text", "#1a1a1a");
    theme_set(item, "", "menu", "#f4f4f4");
    theme_set(item, "", "menu-text", "#1a1a1a");
    theme_set(item, "", "tab", "#f4f4f4");
    theme_set(item, "", "tab-text", "#1a1a1a");
    theme_set(item, "", "tab-current", "#ffffff");
    theme_set(item, "", "keyword-back", "none");
    theme_set(item, "", "type-back", "none");
    theme_set(item, "", "string-back", "none");
    theme_set(item, "", "comment-back", "none");
    theme_set(item, "", "number-back", "none");
    theme_set(item, "", "preprocessor-back", "none");
    theme_set(item, "", "call-back", "none");
    theme_set(item, "", "operator-back", "none");
    slot = 13;
    while (slot < 23) {
        theme_set(item, "", theme_name(slot), "0");
        slot = slot + 1;
    }
}

void config_defaults(EditorConfig *item) {
    if (item == nullptr)
        return;
    item->brackets = 1;
    copy_bracket_pairs(
            item->bracketPairs,
            64,
            bracket_list());
    item->indent = 1;
    item->spaces = 1;
    item->tabWidth = 4;
    item->showLine = 1;
    item->showMargin = 0;
    item->showClose = 1;
    item->marginCols = 80;
    item->searchWrap = 1;
    item->searchBack = 0;
    item->searchWhole = 0;
    item->searchCase = 0;
    item->showSpace = 0;
    item->showEnds = 0;
    item->showStops = 0;
    item->windowWidth = 0;
    item->windowHeight = 0;
    item->rememberFiles = 0;
    item->saveOnTab = 0;
    item->saveOnWindow = 0;
    item->trimTrailing = 0;
    item->ensureNewline = 0;
    item->showPath = 0;
    item->pathDepth = 0;
    item->recoveryOn = 0;
    item->recoveryMinutes = 5;
    item->recoveryKeep = 20;
    item->recentCount = 10;
    item->openCount = 0;
    item->recentUsed = 0;
    item->activePath[0] = 0;
    text_copy(item->lineColor, 32, "#d6e4f5");
    text_copy(item->marginColor, 32, "#c8c8c8");
    text_copy(item->themeName, THEME_NAME, "default");
    item->font[0] = 0;
    {
        int i;

        i = 0;
        while (i < EDITOR_KEY_COUNT) {
            const char *label;
            const char *command;
            const char *config;
            const char *accel;

            key_info(
                    i,
                    &label,
                    &command,
                    &config,
                    &accel);
            text_copy(item->accel[i], 64, accel);
            i = i + 1;
        }
    }
    theme_defaults(item);
}

int config_path(char *dest, long cap) {
    char *home;
    char config[EDITOR_PATH];
    char dir[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    home = getenv("HOME");
    if (home == nullptr || home[0] == 0)
        return 0;
    path_join(config, EDITOR_PATH, home, ".config");
    if (ensure_dir(config) == 0)
        return 0;
    path_join(dir, EDITOR_PATH, config, "smallcpp");
    if (ensure_dir(dir) == 0)
        return 0;
    path_join(dest, cap, dir, "editor.ini");
    if (dest[0] == 0)
        return 0;
    return 1;
}

int recovery_dir(char *dest, long cap) {
    char *home;
    char config[EDITOR_PATH];
    char dir[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    home = getenv("HOME");
    if (home == nullptr || home[0] == 0)
        return 0;
    path_join(config, EDITOR_PATH, home, ".config");
    if (ensure_dir(config) == 0)
        return 0;
    path_join(dir, EDITOR_PATH, config, "smallcpp");
    if (ensure_dir(dir) == 0)
        return 0;
    path_join(dest, cap, dir, "recovery");
    if (dest[0] == 0)
        return 0;
    if (ensure_dir(dest) == 0)
        return 0;
    return 1;
}

int project_home(char *dest, long cap, const char *project) {
    char dir[EDITOR_PATH];
    char clean[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    if (project == nullptr || project[0] == 0)
        return 0;
    text_copy(dir, EDITOR_PATH, project);
    if (file_is_reg(project) == 1)
        path_dir(dir, EDITOR_PATH, project);
    if (path_normalize(clean, EDITOR_PATH, dir) == 0)
        return 0;
    if (file_is_dir(clean) == 0)
        return 0;
    path_join(dest, cap, clean, ".sedit");
    if (dest[0] == 0)
        return 0;
    if (ensure_dir(dest) == 0)
        return 0;
    return 1;
}

int project_config_path(
        char *dest,
        long cap,
        const char *project) {
    char home[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    if (project_home(home, EDITOR_PATH, project) == 0)
        return 0;
    path_join(dest, cap, home, "editor.ini");
    if (dest[0] == 0)
        return 0;
    return 1;
}

int project_lines(
        const char *path,
        char dest[][EDITOR_PATH],
        int cap) {
    char *raw;
    long n;
    long i;
    long start;
    const char *err;
    int count;

    if (dest == nullptr || cap < 1)
        return 0;
    if (path == nullptr || file_exists(path) == 0)
        return 0;
    err = "";
    n = 0;
    raw = read_file(path, &n, &err);
    if (raw == nullptr)
        return 0;
    count = 0;
    i = 0;
    start = 0;
    while (i <= n && count < cap) {
        if (i == n || raw[i] == '\n' || raw[i] == '\r') {
            if (i - start > 8
                    && raw[start] == 'p'
                    && raw[start + 1] == 'r'
                    && raw[start + 2] == 'o'
                    && raw[start + 3] == 'j'
                    && raw[start + 4] == 'e'
                    && raw[start + 5] == 'c'
                    && raw[start + 6] == 't'
                    && raw[start + 7] == '=') {
                long k;
                long len;

                len = i - (start + 8);
                if (len > EDITOR_PATH - 1)
                    len = EDITOR_PATH - 1;
                if (len > 0) {
                    k = 0;
                    while (k < len) {
                        dest[count][k] = raw[start + 8 + k];
                        k = k + 1;
                    }
                    dest[count][k] = 0;
                    count = count + 1;
                }
            }
            if (i < n && raw[i] == '\r' && raw[i + 1] == '\n')
                i = i + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

int settings_note(
        const char *path,
        const char *recoveryDir,
        const char projects[][EDITOR_PATH],
        int count) {
    char *raw;
    long n;
    const char *err;
    String *text;
    int i;

    if (path == nullptr || path[0] == 0)
        return 0;
    err = "";
    n = 0;
    raw = read_file(path, &n, &err);
    if (raw == nullptr)
        return 0;
    text = new String();
    text->append(raw);
    if (n == 0 || raw[n - 1] != '\n')
        text->append("\n");
    if (recoveryDir != nullptr && recoveryDir[0] != 0) {
        text->append("recovery-dir=");
        text->append(recoveryDir);
        text->append("\n");
    }
    if (count < 0)
        count = 0;
    if (count > EDITOR_RECENT_MAX)
        count = EDITOR_RECENT_MAX;
    i = 0;
    while (i < count && projects != nullptr) {
        if (projects[i][0] != 0) {
            text->append("project=");
            text->append(projects[i]);
            text->append("\n");
        }
        i = i + 1;
    }
    err = "";
    return write_file(path, text->c_str(), &err);
}

int project_store(
        const char *project,
        const EditorConfig *item,
        const char projects[][EDITOR_PATH],
        int count) {
    char path[EDITOR_PATH];
    char home[EDITOR_PATH];

    if (item == nullptr)
        return 0;
    if (project_home(home, EDITOR_PATH, project) == 0)
        return 0;
    if (project_config_path(path, EDITOR_PATH, project) == 0)
        return 0;
    if (config_write(path, item) == 0)
        return 0;
    return settings_note(path, home, projects, count);
}

static int key_is(const char *line, const char *key) {
    long i;

    i = 0;
    while (key[i] != 0) {
        if (line[i] != key[i])
            return 0;
        i = i + 1;
    }
    if (line[i] != '=')
        return 0;
    return 1;
}

static const char *after_eq(const char *line) {
    long i;

    i = 0;
    while (line[i] != 0 && line[i] != '=')
        i = i + 1;
    if (line[i] != '=')
        return "";
    return line + i + 1;
}

static int read_int(const char *text, int fallback) {
    long i;
    int value;

    if (text == nullptr || text[0] == 0)
        return fallback;
    i = 0;
    if (text[i] < '0' || text[i] > '9')
        return fallback;
    value = 0;
    while (text[i] >= '0' && text[i] <= '9') {
        value = value * 10 + (text[i] - '0');
        i = i + 1;
        if (value > 100000)
            return fallback;
    }
    return value;
}

static int has_prefix(
        const char *line,
        const char *prefix) {
    long i;

    i = 0;
    while (prefix[i] != 0) {
        if (line[i] != prefix[i])
            return 0;
        i = i + 1;
    }
    return 1;
}

static void take_theme(
        EditorConfig *item,
        const char *line) {
    char name[48];
    char lang[16];
    const char *value;
    long i;
    long n;
    long cut;

    if (has_prefix(line, "theme-") == 0)
        return;
    value = after_eq(line);
    i = 6;
    n = 0;
    while (line[i] != 0 && line[i] != '=' && n < 47) {
        name[n] = line[i];
        n = n + 1;
        i = i + 1;
    }
    name[n] = 0;
    if (line[i] != '=')
        return;
    cut = 0;
    if (theme_cut(name, &cut) < 0)
        return;
    if (cut == 0) {
        theme_set(item, "", name, value);
        return;
    }
    if (cut <= 1 || cut >= 16)
        return;
    i = 0;
    while (i < cut - 1) {
        lang[i] = name[i];
        i = i + 1;
    }
    lang[i] = 0;
    theme_set(item, lang, name + cut, value);
}

int theme_is_default(const char *name) {
    if (name == nullptr || name[0] == 0)
        return 1;
    if (text_same(name, "default") == 1)
        return 1;
    return 0;
}

static int theme_file_ok(const char *name) {
    long i;
    char c;

    if (name == nullptr || name[0] == 0)
        return 0;
    if (theme_is_default(name) == 1)
        return 0;
    i = 0;
    while (name[i] != 0) {
        c = name[i];
        if (c >= 'a' && c <= 'z')
            c = 'a';
        else if (c >= 'A' && c <= 'Z')
            c = 'A';
        else if (c >= '0' && c <= '9')
            c = '0';
        else if (c == '-' || c == '_')
            c = '-';
        else
            return 0;
        i = i + 1;
        if (i >= THEME_NAME)
            return 0;
    }
    return 1;
}

static int themes_dir(char *dest, long cap) {
    char *home;
    char config[EDITOR_PATH];
    char dir[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    home = getenv("HOME");
    if (home == nullptr || home[0] == 0)
        return 0;
    path_join(config, EDITOR_PATH, home, ".config");
    if (ensure_dir(config) == 0)
        return 0;
    path_join(dir, EDITOR_PATH, config, "smallcpp");
    if (ensure_dir(dir) == 0)
        return 0;
    path_join(dest, cap, dir, "themes");
    if (dest[0] == 0)
        return 0;
    if (ensure_dir(dest) == 0)
        return 0;
    return 1;
}

static int theme_path(
        char *dest,
        long cap,
        const char *name) {
    char dir[EDITOR_PATH];
    char file[40];
    long i;

    if (theme_file_ok(name) == 0)
        return 0;
    if (themes_dir(dir, EDITOR_PATH) == 0)
        return 0;
    i = 0;
    while (name[i] != 0 && i < THEME_NAME - 1) {
        file[i] = name[i];
        i = i + 1;
    }
    file[i] = '.';
    file[i + 1] = 'i';
    file[i + 2] = 'n';
    file[i + 3] = 'i';
    file[i + 4] = 0;
    path_join(dest, cap, dir, file);
    if (dest[0] == 0)
        return 0;
    return 1;
}

static void theme_apply_text(
        EditorConfig *item,
        const char *raw,
        long n) {
    char line[EDITOR_PATH];
    const char *value;
    long i;
    long start;
    long k;

    if (item == nullptr || raw == nullptr)
        return;
    i = 0;
    start = 0;
    while (i <= n) {
        if (i < n && raw[i] != '\n') {
            i = i + 1;
            continue;
        }
        k = 0;
        while (start + k < i && k < EDITOR_PATH - 1) {
            line[k] = raw[start + k];
            k = k + 1;
        }
        line[k] = 0;
        if (line[0] != 0 && line[0] != '#') {
            take_theme(item, line);
            value = after_eq(line);
            if (key_is(line, "line-color") == 1)
                text_copy(item->lineColor, 32, value);
            if (key_is(line, "margin-color") == 1)
                text_copy(item->marginColor, 32, value);
            if (key_is(line, "font") == 1)
                text_copy(item->font, 128, value);
        }
        if (i < n && raw[i] == '\n')
            start = i + 1;
        i = i + 1;
    }
}

int theme_load(EditorConfig *item, const char *name) {
    char path[EDITOR_PATH];
    char *raw;
    const char *err;
    long n;

    if (item == nullptr)
        return 0;
    if (theme_is_default(name) == 1)
        return 1;
    if (theme_path(path, EDITOR_PATH, name) == 0)
        return 0;
    err = "";
    n = 0;
    raw = read_file(path, &n, &err);
    if (raw == nullptr)
        return 0;
    theme_apply_text(item, raw, n);
    return 1;
}

static void add_theme(
        String *text,
        const EditorConfig *item);

int theme_save(const char *name, const EditorConfig *item) {
    char path[EDITOR_PATH];
    String *text;
    const char *err;

    if (item == nullptr || theme_file_ok(name) == 0)
        return 0;
    if (theme_path(path, EDITOR_PATH, name) == 0)
        return 0;
    text = new String();
    add_theme(text, item);
    text->append("line-color=");
    text->append(item->lineColor);
    text->append("\n");
    text->append("margin-color=");
    text->append(item->marginColor);
    text->append("\n");
    text->append("font=");
    text->append(item->font);
    text->append("\n");
    err = "";
    return write_file(path, text->c_str(), &err);
}

static int ends_ini(const char *name) {
    long n;

    n = text_length(name);
    if (n < 5)
        return 0;
    if (name[n - 4] != '.')
        return 0;
    if (name[n - 3] != 'i')
        return 0;
    if (name[n - 2] != 'n')
        return 0;
    if (name[n - 1] != 'i')
        return 0;
    return 1;
}

int theme_list(char names[][THEME_NAME], int cap) {
    char dir[EDITOR_PATH];
    DIR *listing;
    struct dirent *entry;
    int count;
    long n;
    long i;
    char stem[THEME_NAME];

    if (names == nullptr || cap < 1)
        return 0;
    text_copy(names[0], THEME_NAME, "default");
    count = 1;
    if (themes_dir(dir, EDITOR_PATH) == 0)
        return count;
    listing = opendir(dir);
    if (listing == nullptr)
        return count;
    entry = readdir(listing);
    while (entry != nullptr) {
        if (entry->d_name[0] != '.'
                && ends_ini(entry->d_name) == 1
                && count < cap) {
            n = text_length(entry->d_name) - 4;
            if (n > 0 && n < THEME_NAME) {
                i = 0;
                while (i < n) {
                    stem[i] = entry->d_name[i];
                    i = i + 1;
                }
                stem[i] = 0;
                if (theme_file_ok(stem) == 1) {
                    text_copy(
                            names[count],
                            THEME_NAME,
                            stem);
                    count = count + 1;
                }
            }
        }
        entry = readdir(listing);
    }
    closedir(listing);
    return count;
}

static void take_line(EditorConfig *item, const char *line) {
    const char *value;

    take_theme(item, line);
    value = after_eq(line);
    if (key_is(line, "brackets") == 1)
        item->brackets = read_int(value, item->brackets);
    if (key_is(line, "bracket-pairs") == 1)
        copy_bracket_pairs(
                item->bracketPairs,
                64,
                value);
    if (key_is(line, "indent") == 1)
        item->indent = read_int(value, item->indent);
    if (key_is(line, "spaces") == 1)
        item->spaces = read_int(value, item->spaces);
    if (key_is(line, "tab-width") == 1)
        item->tabWidth = read_int(value, item->tabWidth);
    if (key_is(line, "line-highlight") == 1)
        item->showLine = read_int(value, item->showLine);
    if (key_is(line, "margin") == 1)
        item->showMargin = read_int(value, item->showMargin);
    if (key_is(line, "close-marks") == 1)
        item->showClose = read_int(value, item->showClose);
    if (key_is(line, "margin-columns") == 1)
        item->marginCols = read_int(value, item->marginCols);
    if (key_is(line, "line-color") == 1)
        text_copy(item->lineColor, 32, value);
    if (key_is(line, "margin-color") == 1)
        text_copy(item->marginColor, 32, value);
    if (key_is(line, "font") == 1)
        text_copy(item->font, 128, value);
    if (key_is(line, "theme") == 1) {
        if (theme_is_default(value) == 1
                || theme_file_ok(value) == 1)
            text_copy(item->themeName, THEME_NAME, value);
    }
    if (key_is(line, "search-wrap") == 1)
        item->searchWrap = read_int(value, item->searchWrap);
    if (key_is(line, "search-reverse") == 1)
        item->searchBack = read_int(value, item->searchBack);
    if (key_is(line, "search-whole") == 1)
        item->searchWhole = read_int(value, item->searchWhole);
    if (key_is(line, "search-case") == 1)
        item->searchCase = read_int(value, item->searchCase);
    if (key_is(line, "show-whitespace") == 1)
        item->showSpace = read_int(value, item->showSpace);
    if (key_is(line, "show-line-ends") == 1)
        item->showEnds = read_int(value, item->showEnds);
    if (key_is(line, "show-indent-stops") == 1)
        item->showStops = read_int(value, item->showStops);
    if (key_is(line, "window-width") == 1)
        item->windowWidth = read_int(value, item->windowWidth);
    if (key_is(line, "window-height") == 1)
        item->windowHeight = read_int(value, item->windowHeight);
    if (key_is(line, "remember-files") == 1)
        item->rememberFiles = read_int(
                value,
                item->rememberFiles);
    if (key_is(line, "save-on-tab") == 1)
        item->saveOnTab = read_int(
                value,
                item->saveOnTab);
    if (key_is(line, "save-on-window") == 1)
        item->saveOnWindow = read_int(
                value,
                item->saveOnWindow);
    if (key_is(line, "trim-trailing") == 1)
        item->trimTrailing = read_int(
                value,
                item->trimTrailing);
    if (key_is(line, "ensure-newline") == 1)
        item->ensureNewline = read_int(
                value,
                item->ensureNewline);
    if (key_is(line, "show-path") == 1)
        item->showPath = read_int(
                value,
                item->showPath);
    if (key_is(line, "path-depth") == 1)
        item->pathDepth = read_int(
                value,
                item->pathDepth);
    if (key_is(line, "recovery") == 1)
        item->recoveryOn = read_int(
                value,
                item->recoveryOn);
    if (key_is(line, "recovery-minutes") == 1)
        item->recoveryMinutes = read_int(
                value,
                item->recoveryMinutes);
    if (key_is(line, "recovery-keep") == 1)
        item->recoveryKeep = read_int(
                value,
                item->recoveryKeep);
    if (key_is(line, "indent-with") == 1) {
        if (text_same(value, "tabs") == 1)
            item->spaces = 0;
        else if (text_same(value, "both") == 1)
            item->spaces = 2;
        else if (text_same(value, "spaces") == 1)
            item->spaces = 1;
    }
    if (key_is(line, "recent-count") == 1)
        item->recentCount = read_int(value, item->recentCount);
    if (key_is(line, "active-path") == 1)
        text_copy(item->activePath, EDITOR_PATH, value);
    if (key_is(line, "open") == 1
            && item->openCount < EDITOR_OPEN_MAX) {
        text_copy(
                item->openPath[item->openCount],
                EDITOR_PATH,
                value);
        item->openCount = item->openCount + 1;
    }
    if (key_is(line, "recent") == 1
            && item->recentUsed < EDITOR_RECENT_MAX) {
        text_copy(
                item->recentPath[item->recentUsed],
                EDITOR_PATH,
                value);
        item->recentUsed = item->recentUsed + 1;
    }
    {
        int which;

        which = key_index(line);
        if (which >= 0)
            text_copy(item->accel[which], 64, value);
    }
}

int config_read(const char *path, EditorConfig *item) {
    char *raw;
    long n;
    long i;
    long start;
    const char *err;
    char line[EDITOR_PATH];

    if (item == nullptr || path == nullptr || path[0] == 0)
        return 0;
    if (file_exists(path) == 0)
        return 0;
    err = "";
    n = 0;
    raw = read_file(path, &n, &err);
    if (raw == nullptr)
        return 0;
    i = 0;
    start = 0;
    while (i <= n) {
        if (i == n || raw[i] == '\n' || raw[i] == '\r') {
            long len;
            long k;

            len = i - start;
            if (len > EDITOR_PATH - 1)
                len = EDITOR_PATH - 1;
            k = 0;
            while (k < len) {
                line[k] = raw[start + k];
                k = k + 1;
            }
            line[k] = 0;
            if (line[0] != 0 && line[0] != '#')
                take_line(item, line);
            if (i < n && raw[i] == '\r' && raw[i + 1] == '\n')
                i = i + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (item->recentCount < 1 || item->recentCount > 32)
        item->recentCount = 10;
    if (item->recoveryOn != 0)
        item->recoveryOn = 1;
    if (item->ensureNewline != 0)
        item->ensureNewline = 1;
    if (item->showPath != 0)
        item->showPath = 1;
    if (item->pathDepth < 0 || item->pathDepth > 32)
        item->pathDepth = 0;
    if (item->recoveryMinutes < 1
            || item->recoveryMinutes > 1440)
        item->recoveryMinutes = 5;
    if (item->recoveryKeep < 0 || item->recoveryKeep > 500)
        item->recoveryKeep = 20;
    if (item->recentUsed > item->recentCount)
        item->recentUsed = item->recentCount;
    return 1;
}

static void add_flag(
        String *text,
        const char *key,
        int value) {
    text->append(key);
    text->append("=");
    if (value == 0)
        text->append("0\n");
    else
        text->append("1\n");
}

static void add_num(
        String *text,
        const char *key,
        int value) {
    char digits[16];
    long n;
    long i;

    text->append(key);
    text->append("=");
    if (value < 0)
        value = 0;
    n = 0;
    if (value == 0) {
        digits[0] = '0';
        n = 1;
    }
    while (value > 0 && n < 15) {
        digits[n] = (char)('0' + (value % 10));
        value = value / 10;
        n = n + 1;
    }
    i = n;
    while (i > 0) {
        i = i - 1;
        text->append(digits[i]);
    }
    text->append("\n");
}

static void add_theme(
        String *text,
        const EditorConfig *item) {
    int i;

    i = 0;
    while (i < THEME_ALL) {
        text->append("theme-");
        text->append(theme_name(i));
        text->append("=");
        text->append(item->themeColor[i]);
        text->append("\n");
        i = i + 1;
    }
    i = 0;
    while (i < item->themeUsed) {
        text->append("theme-");
        text->append(item->themeLang[i]);
        text->append("-");
        text->append(theme_name(
                item->themeSlot[i]));
        text->append("=");
        text->append(item->themeOver[i]);
        text->append("\n");
        i = i + 1;
    }
}

int config_write(
        const char *path,
        const EditorConfig *item) {
    String *text;
    const char *err;
    int i;

    if (path == nullptr || item == nullptr)
        return 0;
    text = new String();
    add_flag(text, "brackets", item->brackets);
    text->append("bracket-pairs=");
    text->append(item->bracketPairs);
    text->append("\n");
    add_flag(text, "indent", item->indent);
    if (item->spaces == 1)
        add_flag(text, "spaces", 1);
    else
        add_flag(text, "spaces", 0);
    text->append("indent-with=");
    if (item->spaces == 0)
        text->append("tabs");
    else if (item->spaces == 2)
        text->append("both");
    else
        text->append("spaces");
    text->append("\n");
    add_num(text, "tab-width", item->tabWidth);
    add_flag(text, "line-highlight", item->showLine);
    text->append("line-color=");
    text->append(item->lineColor);
    text->append("\n");
    add_flag(text, "margin", item->showMargin);
    add_num(text, "margin-columns", item->marginCols);
    text->append("margin-color=");
    text->append(item->marginColor);
    text->append("\n");
    add_theme(text, item);
    add_flag(text, "close-marks", item->showClose);
    add_flag(text, "search-wrap", item->searchWrap);
    add_flag(text, "search-reverse", item->searchBack);
    add_flag(text, "search-whole", item->searchWhole);
    add_flag(text, "search-case", item->searchCase);
    add_flag(text, "show-whitespace", item->showSpace);
    add_flag(text, "show-line-ends", item->showEnds);
    add_flag(text, "show-indent-stops", item->showStops);
    add_flag(text, "remember-files", item->rememberFiles);
    add_flag(text, "save-on-tab", item->saveOnTab);
    add_flag(text, "save-on-window", item->saveOnWindow);
    add_flag(text, "trim-trailing", item->trimTrailing);
    add_flag(text, "ensure-newline", item->ensureNewline);
    add_flag(text, "show-path", item->showPath);
    add_num(text, "path-depth", item->pathDepth);
    add_flag(text, "recovery", item->recoveryOn);
    add_num(text, "recovery-minutes", item->recoveryMinutes);
    add_num(text, "recovery-keep", item->recoveryKeep);
    add_num(text, "recent-count", item->recentCount);
    if (item->windowWidth >= 100
            && item->windowHeight >= 100) {
        add_num(text, "window-width", item->windowWidth);
        add_num(text, "window-height", item->windowHeight);
    }
    text->append("font=");
    text->append(item->font);
    text->append("\n");
    text->append("theme=");
    text->append(item->themeName);
    text->append("\n");
    i = 0;
    while (i < EDITOR_KEY_COUNT) {
        const char *label;
        const char *command;
        const char *config;
        const char *accel;

        key_info(
                i,
                &label,
                &command,
                &config,
                &accel);
        text->append(config);
        text->append("=");
        text->append(item->accel[i]);
        text->append("\n");
        i = i + 1;
    }
    i = 0;
    while (i < item->openCount && i < EDITOR_OPEN_MAX) {
        text->append("open=");
        text->append(item->openPath[i]);
        text->append("\n");
        i = i + 1;
    }
    if (item->activePath[0] != 0) {
        text->append("active-path=");
        text->append(item->activePath);
        text->append("\n");
    }
    i = 0;
    while (i < item->recentUsed
            && i < item->recentCount
            && i < EDITOR_RECENT_MAX) {
        text->append("recent=");
        text->append(item->recentPath[i]);
        text->append("\n");
        i = i + 1;
    }
    err = "";
    return write_file(path, text->c_str(), &err);
}
