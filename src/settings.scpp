#include "settings.shpp"

extern char *getenv(const char *name);

void config_defaults(EditorConfig *item) {
    if (item == nullptr)
        return;
    item->brackets = 1;
    item->indent = 1;
    item->spaces = 1;
    item->tabWidth = 4;
    item->showLine = 1;
    item->showMargin = 0;
    item->showClose = 1;
    item->marginCols = 80;
    item->searchWrap = 1;
    item->searchBack = 0;
    item->searchWhole = 0;
    item->searchCase = 0;
    item->showSpace = 0;
    item->showEnds = 0;
    item->showStops = 0;
    item->windowWidth = 0;
    item->windowHeight = 0;
    item->rememberFiles = 0;
    item->saveOnTab = 0;
    item->saveOnWindow = 0;
    item->recentCount = 10;
    item->openCount = 0;
    item->recentUsed = 0;
    item->activePath[0] = 0;
    text_copy(item->lineColor, 32, "#d6e4f5");
    text_copy(item->marginColor, 32, "#c8c8c8");
    item->font[0] = 0;
    {
        int i;

        i = 0;
        while (i < EDITOR_KEY_COUNT) {
            const char *label;
            const char *command;
            const char *config;
            const char *accel;

            key_info(
                    i,
                    &label,
                    &command,
                    &config,
                    &accel);
            text_copy(item->accel[i], 64, accel);
            i = i + 1;
        }
    }
}

int config_path(char *dest, long cap) {
    char *home;
    char config[EDITOR_PATH];
    char dir[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    home = getenv("HOME");
    if (home == nullptr || home[0] == 0)
        return 0;
    path_join(config, EDITOR_PATH, home, ".config");
    if (ensure_dir(config) == 0)
        return 0;
    path_join(dir, EDITOR_PATH, config, "smallcpp");
    if (ensure_dir(dir) == 0)
        return 0;
    path_join(dest, cap, dir, "editor.ini");
    if (dest[0] == 0)
        return 0;
    return 1;
}

static int key_is(const char *line, const char *key) {
    long i;

    i = 0;
    while (key[i] != 0) {
        if (line[i] != key[i])
            return 0;
        i = i + 1;
    }
    if (line[i] != '=')
        return 0;
    return 1;
}

static const char *after_eq(const char *line) {
    long i;

    i = 0;
    while (line[i] != 0 && line[i] != '=')
        i = i + 1;
    if (line[i] != '=')
        return "";
    return line + i + 1;
}

static int read_int(const char *text, int fallback) {
    long i;
    int value;

    if (text == nullptr || text[0] == 0)
        return fallback;
    i = 0;
    if (text[i] < '0' || text[i] > '9')
        return fallback;
    value = 0;
    while (text[i] >= '0' && text[i] <= '9') {
        value = value * 10 + (text[i] - '0');
        i = i + 1;
        if (value > 100000)
            return fallback;
    }
    return value;
}

static void take_line(EditorConfig *item, const char *line) {
    const char *value;

    value = after_eq(line);
    if (key_is(line, "brackets") == 1)
        item->brackets = read_int(value, item->brackets);
    if (key_is(line, "indent") == 1)
        item->indent = read_int(value, item->indent);
    if (key_is(line, "spaces") == 1)
        item->spaces = read_int(value, item->spaces);
    if (key_is(line, "tab-width") == 1)
        item->tabWidth = read_int(value, item->tabWidth);
    if (key_is(line, "line-highlight") == 1)
        item->showLine = read_int(value, item->showLine);
    if (key_is(line, "margin") == 1)
        item->showMargin = read_int(value, item->showMargin);
    if (key_is(line, "close-marks") == 1)
        item->showClose = read_int(value, item->showClose);
    if (key_is(line, "margin-columns") == 1)
        item->marginCols = read_int(value, item->marginCols);
    if (key_is(line, "line-color") == 1)
        text_copy(item->lineColor, 32, value);
    if (key_is(line, "margin-color") == 1)
        text_copy(item->marginColor, 32, value);
    if (key_is(line, "font") == 1)
        text_copy(item->font, 128, value);
    if (key_is(line, "search-wrap") == 1)
        item->searchWrap = read_int(value, item->searchWrap);
    if (key_is(line, "search-reverse") == 1)
        item->searchBack = read_int(value, item->searchBack);
    if (key_is(line, "search-whole") == 1)
        item->searchWhole = read_int(value, item->searchWhole);
    if (key_is(line, "search-case") == 1)
        item->searchCase = read_int(value, item->searchCase);
    if (key_is(line, "show-whitespace") == 1)
        item->showSpace = read_int(value, item->showSpace);
    if (key_is(line, "show-line-ends") == 1)
        item->showEnds = read_int(value, item->showEnds);
    if (key_is(line, "show-indent-stops") == 1)
        item->showStops = read_int(value, item->showStops);
    if (key_is(line, "window-width") == 1)
        item->windowWidth = read_int(value, item->windowWidth);
    if (key_is(line, "window-height") == 1)
        item->windowHeight = read_int(value, item->windowHeight);
    if (key_is(line, "remember-files") == 1)
        item->rememberFiles = read_int(
                value,
                item->rememberFiles);
    if (key_is(line, "save-on-tab") == 1)
        item->saveOnTab = read_int(
                value,
                item->saveOnTab);
    if (key_is(line, "save-on-window") == 1)
        item->saveOnWindow = read_int(
                value,
                item->saveOnWindow);
    if (key_is(line, "recent-count") == 1)
        item->recentCount = read_int(value, item->recentCount);
    if (key_is(line, "active-path") == 1)
        text_copy(item->activePath, EDITOR_PATH, value);
    if (key_is(line, "open") == 1
            && item->openCount < EDITOR_OPEN_MAX) {
        text_copy(
                item->openPath[item->openCount],
                EDITOR_PATH,
                value);
        item->openCount = item->openCount + 1;
    }
    if (key_is(line, "recent") == 1
            && item->recentUsed < EDITOR_RECENT_MAX) {
        text_copy(
                item->recentPath[item->recentUsed],
                EDITOR_PATH,
                value);
        item->recentUsed = item->recentUsed + 1;
    }
    {
        int which;

        which = key_index(line);
        if (which >= 0)
            text_copy(item->accel[which], 64, value);
    }
}

int config_read(const char *path, EditorConfig *item) {
    char *raw;
    long n;
    long i;
    long start;
    const char *err;
    char line[EDITOR_PATH];

    if (item == nullptr || path == nullptr || path[0] == 0)
        return 0;
    if (file_exists(path) == 0)
        return 0;
    err = "";
    n = 0;
    raw = read_file(path, &n, &err);
    if (raw == nullptr)
        return 0;
    i = 0;
    start = 0;
    while (i <= n) {
        if (i == n || raw[i] == '\n' || raw[i] == '\r') {
            long len;
            long k;

            len = i - start;
            if (len > EDITOR_PATH - 1)
                len = EDITOR_PATH - 1;
            k = 0;
            while (k < len) {
                line[k] = raw[start + k];
                k = k + 1;
            }
            line[k] = 0;
            if (line[0] != 0 && line[0] != '#')
                take_line(item, line);
            if (i < n && raw[i] == '\r' && raw[i + 1] == '\n')
                i = i + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (item->recentCount < 1 || item->recentCount > 32)
        item->recentCount = 10;
    if (item->recentUsed > item->recentCount)
        item->recentUsed = item->recentCount;
    return 1;
}

static void add_flag(
        String *text,
        const char *key,
        int value) {
    text->append(key);
    text->append("=");
    if (value == 0)
        text->append("0\n");
    else
        text->append("1\n");
}

static void add_num(
        String *text,
        const char *key,
        int value) {
    char digits[16];
    long n;
    long i;

    text->append(key);
    text->append("=");
    if (value < 0)
        value = 0;
    n = 0;
    if (value == 0) {
        digits[0] = '0';
        n = 1;
    }
    while (value > 0 && n < 15) {
        digits[n] = (char)('0' + (value % 10));
        value = value / 10;
        n = n + 1;
    }
    i = n;
    while (i > 0) {
        i = i - 1;
        text->append(digits[i]);
    }
    text->append("\n");
}

int config_write(
        const char *path,
        const EditorConfig *item) {
    String *text;
    const char *err;
    int i;

    if (path == nullptr || item == nullptr)
        return 0;
    text = new String();
    add_flag(text, "brackets", item->brackets);
    add_flag(text, "indent", item->indent);
    add_flag(text, "spaces", item->spaces);
    add_num(text, "tab-width", item->tabWidth);
    add_flag(text, "line-highlight", item->showLine);
    text->append("line-color=");
    text->append(item->lineColor);
    text->append("\n");
    add_flag(text, "margin", item->showMargin);
    add_num(text, "margin-columns", item->marginCols);
    text->append("margin-color=");
    text->append(item->marginColor);
    text->append("\n");
    add_flag(text, "close-marks", item->showClose);
    add_flag(text, "search-wrap", item->searchWrap);
    add_flag(text, "search-reverse", item->searchBack);
    add_flag(text, "search-whole", item->searchWhole);
    add_flag(text, "search-case", item->searchCase);
    add_flag(text, "show-whitespace", item->showSpace);
    add_flag(text, "show-line-ends", item->showEnds);
    add_flag(text, "show-indent-stops", item->showStops);
    add_flag(text, "remember-files", item->rememberFiles);
    add_flag(text, "save-on-tab", item->saveOnTab);
    add_flag(text, "save-on-window", item->saveOnWindow);
    add_num(text, "recent-count", item->recentCount);
    if (item->windowWidth >= 100
            && item->windowHeight >= 100) {
        add_num(text, "window-width", item->windowWidth);
        add_num(text, "window-height", item->windowHeight);
    }
    text->append("font=");
    text->append(item->font);
    text->append("\n");
    i = 0;
    while (i < EDITOR_KEY_COUNT) {
        const char *label;
        const char *command;
        const char *config;
        const char *accel;

        key_info(
                i,
                &label,
                &command,
                &config,
                &accel);
        text->append(config);
        text->append("=");
        text->append(item->accel[i]);
        text->append("\n");
        i = i + 1;
    }
    i = 0;
    while (i < item->openCount && i < EDITOR_OPEN_MAX) {
        text->append("open=");
        text->append(item->openPath[i]);
        text->append("\n");
        i = i + 1;
    }
    if (item->activePath[0] != 0) {
        text->append("active-path=");
        text->append(item->activePath);
        text->append("\n");
    }
    i = 0;
    while (i < item->recentUsed
            && i < item->recentCount
            && i < EDITOR_RECENT_MAX) {
        text->append("recent=");
        text->append(item->recentPath[i]);
        text->append("\n");
        i = i + 1;
    }
    err = "";
    return write_file(path, text->c_str(), &err);
}
