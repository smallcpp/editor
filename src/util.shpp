#ifndef EDITOR_UTIL
#define EDITOR_UTIL

/* Shared text, path, and file helpers for the editor.
 * A returned const char * from a String is valid until
 * that String changes. Callers copy anything they keep.
 */
#include <errno>
#include <fcntl>
#include <stat>
#include <stdio>
#include <stdlib>
#include "string.shpp"
#include <time>
#include <unistd>

enum {
    EDITOR_PATH = 4096,
    EDITOR_FILE_MAX = 33554432
};

enum {
    EDITOR_ISLNK_MODE = 40960,
    EDITOR_MODE_MASK = 61440
};

long text_length(const char *text);
int text_same(const char *left, const char *right);
int text_starts(const char *text, const char *prefix);
void text_copy(char *dest, long cap, const char *src);
int text_has(const char *text, const char *needle);
int byte_at(const char *text, long index);
int utf8_len(int value);
void text_position(
        const char *text,
        long offset,
        long *line,
        long *column);
int bytes_have_nul(const char *text, long n);
int utf8_ok(const char *text, long n);
int is_ident(int value);
int ascii_lower(int value);
void append_range(
        String *dest,
        const char *src,
        long from,
        long to);
String *slice_text(const char *src, long from, long to);
int current_directory(char *dest, long cap);
int startup_directory(char *dest, long cap);
int path_in_start(char *dest, long cap, const char *path);
int dialog_folder(
        char *dest,
        long cap,
        const char *remembered);
int path_is_abs(const char *path);
int path_has_scheme(const char *path);
void path_join(
        char *dest,
        long cap,
        const char *dir,
        const char *name);
const char *path_base(const char *path);
void path_tail(
        char *dest,
        long cap,
        const char *path,
        int depth);
void path_dir(char *dest, long cap, const char *path);
int path_normalize(char *dest, long cap, const char *path);
int file_is_dir(const char *path);
int file_is_reg(const char *path);
int file_is_link(const char *path);
long file_mtime(const char *path);
int file_exists(const char *path);
int ensure_dir(const char *path);
int trim_recovery_dir(const char *dir, int limit);
char *read_file(
        const char *path,
        long *size,
        const char **error);
int write_file(
        const char *path,
        const char *text,
        const char **error);
void format_clock(char *dest, long cap, long seconds);
const char *comment_leader(const char *language);
const char *shebang_language(const char *text);
void comment_style(
        const char *language,
        const char *path,
        const char *text,
        const char **leader,
        int *block);
const char *language_of(const char *path);
int glob_match(const char *pat, const char *text);
int pattern_ok(const char *pat);

#endif
