#ifndef EDITOR_UI
#define EDITOR_UI

/* GTK window for the text editor. Headless tests do
 * not include this file. The window title is the
 * current session name, or <No Session>.
 */
#include "editor.shpp"
#include "minimap.shpp"
#include "panel.shpp"
