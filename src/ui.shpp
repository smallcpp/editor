using namespace Gtk;

enum {
    EDITOR_PAGES = 32
};

class PageRef {
public:
    long index;
};

class MapColumn : public Widget {
public:
    MapColumn(void *owner, long index);
    void redraw(void);
    void watch(void *view);
    void note_size(long width, long height);
    long drawn_height(void);
    long drawn_width(void);
    void *owner;
    long page;
    long pixels;
    long wide;
    long markAt;
    long markSize;
    long grab;
    long dragAt;
    long splitWide;
    long splitPos;
    int hooked;
    int markDrag;
    void *adjust;
};

class EditPage {
public:
    TextBuffer *buffer;
    TextView *view;
    ScrolledWindow *scroll;
    MapColumn *map;
    Paned *mapSplit;
    int tags;
    int userDepth;
    int pendingSync;
    int pendingIdle;
};

