#ifndef EDITOR_UI
#define EDITOR_UI

/* GTK window for the text editor. Headless tests do
 * not include this file. The menu bar is the first
 * child of the window because the wrapper has no
 * title-bar setter.
 */
#include "editor.shpp"
#include "settings.shpp"
#include "syntax.shpp"
#include <exceptions>
#include <gtk>

using namespace Gtk;

enum {
    EDITOR_PAGES = 32
};

class PageRef {
public:
    long index;
};

class EditPage {
public:
    TextBuffer *buffer;
    TextView *view;
    ScrolledWindow *scroll;
    int tags;
    int userDepth;
    int pendingSync;
    int pendingIdle;
};

class Ui {
public:
    Ui(Editor *editor);
    Editor *editor(void);
    int start(void);
    void prepare(void);
    void show_main(void);
    void refresh(void);
    void handle(int code);
    void on_menu(const char *label);
    void open_path(const char *path);
    void save_path(const char *path);
    void choice(int response);
    void changed(long index);
    void moved(long index, long line, long offset);
    void switched(long index);
    void show_settings(void);
    void hide_settings(void);
    void apply_settings(void);
    void load_settings(void);
    void use_config(EditorConfig *item);
    void user_begin(long index);
    void user_end(long index);
    void flush_sync(long index);
    TextBuffer *view_buffer(void);
    const char *page_text(long index);
    const char *line_number_text(void);
    long gutter_line_y(long line);
    void scroll_view(long line);
    const char *tab_text(long index);
    void select_named(const char *title);
    int tab_marks(void);
    int shows_line(void);
    int shows_margin(void);
    int margin_columns(void);
    int is_leaving(void);
    void choose_font(const char *description);
    void leave(void);
    void close_at(long index);
    void set_line_shown(int value);
    void set_margin_shown(int value);
    void set_close_shown(int value);
    void set_line_color(const char *color);
    void set_margin_color(const char *color);
    void set_margin_count(int value);
    void set_width(int value);
    void open_font(void);
    void set_option(const char *label, int on);
    int assign_key(int index, const char *accel);
    void arm_key(int index);
    int take_key(const char *accel, int escape);
    const char *key_text(int index);
    const char *key_warning(void);
    const char *key_help(void);
    int shows_space(void);
    int shows_ends(void);
    int shows_stops(void);
    int search_wrap(void);
    void find_query(const char *query);
    void find_again(void);
    void replace_query(
            const char *query,
            const char *repl);
    void replace_every(
            const char *query,
            const char *repl);
    void replace_again(void);
    void replace_all_again(void);
    void hide_search(void);
    void hide_replace(void);
private:
    Editor *state;
    Application *app;
    Window *mainWindow;
    MenuBar *menuBar;
    long documentsMenu;
    Notebook *book;
    Label *status;
    EditPage pages[EDITOR_PAGES];
    PageRef refs[EDITOR_PAGES];
    Label *tabTitle[EDITOR_PAGES];
    long pageCount;
    int choiceMode;
    int applying;
    int building;
    int showLine;
    int showMargin;
    int showClose;
    int marginCols;
    int hasLastDir;
    int leaving;
    char lineColor[32];
    char marginColor[32];
    char fontDesc[128];
    char lastDir[EDITOR_PATH];
    char docName[EDITOR_PAGES][80];
    String *pendingPath;
    Dialog *choiceDialog;
    Dialog *settingsDialog;
    CheckButton *bracketCheck;
    CheckButton *indentCheck;
    CheckButton *spacesCheck;
    CheckButton *lineCheck;
    CheckButton *marginCheck;
    CheckButton *closeCheck;
    SpinButton *tabSpin;
    SpinButton *marginSpin;
    Entry *lineEntry;
    Entry *marginEntry;
    FileDialog *files;
    FontDialog *fonts;
    int searchBack;
    int searchWhole;
    int searchCase;
    int searchWrap;
    int showSpace;
    int showEnds;
    int showStops;
    long searchMenu;
    long viewMenu;
    CheckButton *wrapCheck;
    CheckButton *backCheck;
    CheckButton *wholeCheck;
    CheckButton *caseCheck;
    CheckButton *spaceCheck;
    CheckButton *endCheck;
    CheckButton *stopCheck;
    Dialog *searchDialog;
    Dialog *replaceDialog;
    Entry *searchEntry;
    Entry *replaceFind;
    Entry *replaceWith;
    Button *keyButton[EDITOR_KEY_COUNT];
    Label *keyHelp;
    Label *keyState;
    int keyCapture;
    char keyWarn[160];
    char keyPrompt[160];
    char keyAccel[EDITOR_KEY_COUNT][64];
    char searchText[256];
    char replaceText[256];
    char withText[256];
    void build(void);
    void bind_keys(void);
    void push_options(void);
    void sync_boxes(void);
    void read_keys(void);
    void show_key_note(void);
    void show_search(void);
    void show_replace(void);
    void add_page(long index);
    void rebuild(void);
    void push_active(void);
    void place_cursor(long index);
    void sync_view(long index);
    void take_selection(void);
    void highlight(long index);
    void paint_status(void);
    void paint_line(long index);
    void apply_view(long index);
    void retitle(long index);
    void mount_tab(long index, const char *title);
    void fill_documents(void);
    void arm_dialog(void);
    void note_folder(const char *path);
    void show_choice(const char *title, int mode);
};

#endif
