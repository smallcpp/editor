#ifndef EDITOR_UI
#define EDITOR_UI

/* GTK window for the text editor. Headless tests do
 * not include this file. The menu bar is the first
 * child of the window because the wrapper has no
 * title-bar setter.
 */
#include "editor.shpp"
#include "panel.shpp"
#include "settings.shpp"
#include "syntax.shpp"
#include "language.shpp"
#include <exceptions>
#include <gtk>

using namespace Gtk;

enum {
    EDITOR_PAGES = 32
};

class PageRef {
public:
    long index;
};

class EditPage {
public:
    TextBuffer *buffer;
    TextView *view;
    ScrolledWindow *scroll;
    int tags;
    int userDepth;
    int pendingSync;
    int pendingIdle;
};

