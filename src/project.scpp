#include "project.shpp"
#include <dirent>

extern File *popen(const char *command, const char *mode);
extern int pclose(File *stream);
extern int system(const char *command);

static int name_ok(const char *name) {
    long n;
    long i;

    if (name == nullptr || name[0] == 0)
        return 0;
    if (text_same(name, ".") == 1)
        return 0;
    if (text_same(name, "..") == 1)
        return 0;
    n = text_length(name);
    if (n <= 0 || n >= PROJECT_NAME)
        return 0;
    i = 0;
    while (i < n) {
        int ch;
        int ok;

        ch = byte_at(name, i);
        ok = 0;
        if (ch >= 'a' && ch <= 'z')
            ok = 1;
        if (ch >= 'A' && ch <= 'Z')
            ok = 1;
        if (ch >= '0' && ch <= '9')
            ok = 1;
        if (ch == ' ' || ch == '_' || ch == '-' || ch == '.')
            ok = 1;
        if (ok == 0)
            return 0;
        i = i + 1;
    }
    return 1;
}

static int kind_code(const char *kind) {
    if (text_same(kind, "files") == 1)
        return 1;
    if (text_same(kind, "directory") == 1)
        return 2;
    if (text_same(kind, "git") == 1)
        return 3;
    if (text_same(kind, "cmake") == 1)
        return 4;
    return 0;
}

static int path_safe(const char *path) {
    long i;

    if (path == nullptr || path[0] == 0)
        return 0;
    i = 0;
    while (path[i] != 0) {
        int ch;

        ch = byte_at(path, i);
        if (ch == '\'' || ch == '"' || ch == '\n')
            return 0;
        if (ch == '\r' || ch == '`' || ch == '$')
            return 0;
        if (ch == ';' || ch == '|' || ch == '\\')
            return 0;
        i = i + 1;
    }
    return 1;
}

static int under_dir(const char *dir, const char *path) {
    long n;

    if (dir == nullptr || dir[0] == 0 || path == nullptr)
        return 0;
    n = text_length(dir);
    if (text_starts(path, dir) == 0)
        return 0;
    if (path[n] == 0)
        return 1;
    if (path[n] == '/')
        return 1;
    return 0;
}

static void relative_of(
        char *dest,
        long cap,
        const char *dir,
        const char *full) {
    long n;

    if (dest == nullptr || cap < 2)
        return;
    dest[0] = 0;
    if (full == nullptr)
        return;
    if (dir != nullptr && dir[0] != 0) {
        n = text_length(dir);
        if (text_starts(full, dir) == 1 && full[n] == '/') {
            text_copy(dest, cap, full + n + 1);
            return;
        }
        if (text_same(dir, "/") == 1 && full[0] == '/') {
            text_copy(dest, cap, full + 1);
            return;
        }
    }
    if (full[0] == '/')
        text_copy(dest, cap, full + 1);
    else
        text_copy(dest, cap, full);
}

static int name_less(const char *left, const char *right) {
    long i;

    if (left == nullptr)
        return 1;
    if (right == nullptr)
        return 0;
    i = 0;
    while (left[i] != 0 && right[i] != 0) {
        if (left[i] != right[i])
            return (int)(left[i] < right[i]);
        i = i + 1;
    }
    return (int)(left[i] == 0 && right[i] != 0);
}

static void join_key(
        char *dest,
        long cap,
        const char *dir,
        const char *name) {
    long n;
    long i;
    long m;

    if (dest == nullptr || cap < 2)
        return;
    dest[0] = 0;
    if (name == nullptr)
        return;
    if (dir == nullptr || dir[0] == 0) {
        text_copy(dest, cap, name);
        return;
    }
    n = text_length(dir);
    m = text_length(name);
    if (n + m + 2 > cap)
        return;
    text_copy(dest, cap, dir);
    dest[n] = '/';
    i = 0;
    while (i < m) {
        dest[n + 1 + i] = name[i];
        i = i + 1;
    }
    dest[n + 1 + i] = 0;
}

static void write_label(
        char *dest,
        long cap,
        int depth,
        int isDir,
        int open,
        const char *name) {
    long i;
    long k;

    if (dest == nullptr || cap < 2)
        return;
    dest[0] = 0;
    if (name == nullptr)
        return;
    i = 0;
    k = 0;
    while (k < depth && k < 12 && i + 2 < cap) {
        dest[i] = ' ';
        i = i + 1;
        dest[i] = ' ';
        i = i + 1;
        k = k + 1;
    }
    if (isDir == 1 && i + 3 < cap) {
        if (open == 1)
            dest[i] = '-';
        else
            dest[i] = '+';
        i = i + 1;
        dest[i] = ' ';
        i = i + 1;
    }
    k = 0;
    while (name[k] != 0 && i + 1 < cap) {
        dest[i] = name[k];
        i = i + 1;
        k = k + 1;
    }
    dest[i] = 0;
}

static void write_digits(char *dest, long cap, int value) {
    char rev[16];
    int n;
    int i;

    if (dest == nullptr || cap < 2)
        return;
    if (value < 0)
        value = 0;
    n = 0;
    if (value == 0) {
        dest[0] = '0';
        dest[1] = 0;
        return;
    }
    while (value > 0 && n < 15) {
        rev[n] = (char)('0' + (value % 10));
        n = n + 1;
        value = value / 10;
    }
    i = 0;
    while (n > 0 && i + 1 < cap) {
        n = n - 1;
        dest[i] = rev[n];
        i = i + 1;
    }
    dest[i] = 0;
}

static int number_of(const char *text) {
    int n;
    int i;

    if (text == nullptr || text[0] == 0)
        return 0;
    n = 0;
    i = 0;
    while (text[i] >= '0' && text[i] <= '9') {
        n = n * 10 + (int)(text[i] - '0');
        if (n > 1000000)
            return 1000000;
        i = i + 1;
    }
    return n;
}

static void take_line(
        const char *raw,
        long n,
        long *at,
        char *dest,
        long cap) {
    long i;
    long k;

    if (dest == nullptr || cap < 2 || at == nullptr)
        return;
    dest[0] = 0;
    i = *at;
    k = 0;
    if (raw == nullptr || i >= n)
        return;
    while (i < n && raw[i] != '\n') {
        if (k + 1 < cap) {
            dest[k] = raw[i];
            k = k + 1;
        }
        i = i + 1;
    }
    if (k > 0 && dest[k - 1] == '\r')
        k = k - 1;
    dest[k] = 0;
    if (i < n && raw[i] == '\n')
        i = i + 1;
    *at = i;
}

static int split_key(
        const char *line,
        const char *key,
        char *value,
        long cap) {
    long k;

    if (line == nullptr || key == nullptr || value == nullptr)
        return 0;
    value[0] = 0;
    k = text_length(key);
    if (text_starts(line, key) == 0)
        return 0;
    if (line[k] != '=')
        return 0;
    text_copy(value, cap, line + k + 1);
    return 1;
}

static int ends_with(const char *text, const char *suffix) {
    long n;
    long m;
    long i;

    if (text == nullptr || suffix == nullptr)
        return 0;
    n = text_length(text);
    m = text_length(suffix);
    if (m <= 0 || m > n)
        return 0;
    i = 0;
    while (i < m) {
        if (text[n - m + i] != suffix[i])
            return 0;
        i = i + 1;
    }
    return 1;
}

static int token_file(const char *token) {
    int i;
    int dot;

    if (token == nullptr || token[0] == 0)
        return 0;
    if (token[0] == '-')
        return 0;
    dot = 0;
    i = 0;
    while (token[i] != 0) {
        if (token[i] == '$' || token[i] == '{')
            return 0;
        if (token[i] == '}' || token[i] == '*')
            return 0;
        if (token[i] == '.')
            dot = 1;
        i = i + 1;
    }
    return dot;
}

static long next_token(
        const char *raw,
        long n,
        long i,
        char *dest,
        long cap) {
    long k;

    if (dest == nullptr || cap < 2)
        return n;
    dest[0] = 0;
    if (raw == nullptr)
        return n;
    while (i < n) {
        int ch;

        ch = byte_at(raw, i);
        if (ch == '#') {
            while (i < n && raw[i] != '\n')
                i = i + 1;
        } else if (ch == ' ' || ch == '\t' || ch == '\n')
            i = i + 1;
        else if (ch == '\r' || ch == '(' || ch == ')')
            i = i + 1;
        else if (ch == ',')
            i = i + 1;
        else
            break;
    }
    if (i >= n)
        return i;
    k = 0;
    if (raw[i] == '"' || raw[i] == '\'') {
        int quote;

        quote = byte_at(raw, i);
        i = i + 1;
        while (i < n && raw[i] != quote && raw[i] != '\n') {
            if (k + 1 < cap) {
                dest[k] = raw[i];
                k = k + 1;
            }
            i = i + 1;
        }
        if (i < n && raw[i] == quote)
            i = i + 1;
        dest[k] = 0;
        return i;
    }
    while (i < n) {
        int ch;

        ch = byte_at(raw, i);
        if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r')
            break;
        if (ch == '(' || ch == ')' || ch == ',' || ch == '#')
            break;
        if (k + 1 < cap) {
            dest[k] = (char)ch;
            k = k + 1;
        }
        i = i + 1;
    }
    dest[k] = 0;
    return i;
}

int project_catalog(char *dest, long cap) {
    char *home;
    char config[EDITOR_PATH];
    char small[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    home = getenv("HOME");
    if (home == nullptr || home[0] == 0)
        return 0;
    path_join(config, EDITOR_PATH, home, ".config");
    if (ensure_dir(config) == 0)
        return 0;
    path_join(small, EDITOR_PATH, config, "smallcpp");
    if (ensure_dir(small) == 0)
        return 0;
    path_join(dest, cap, small, "projects");
    if (dest[0] == 0)
        return 0;
    if (ensure_dir(dest) == 0)
        return 0;
    return 1;
}

int project_known(char dest[][PROJECT_NAME], int cap) {
    char dir[EDITOR_PATH];
    DIR *listing;
    struct dirent *entry;
    int count;
    int i;

    if (dest == nullptr || cap <= 0)
        return 0;
    if (project_catalog(dir, EDITOR_PATH) == 0)
        return 0;
    listing = opendir(dir);
    if (listing == nullptr)
        return 0;
    count = 0;
    entry = readdir(listing);
    while (entry != nullptr && count < cap) {
        long n;
        long m;

        m = text_length(".project");
        n = text_length(entry->d_name);
        if (ends_with(entry->d_name, ".project") == 1
                && n > m
                && n - m < PROJECT_NAME) {
            long k;

            k = 0;
            while (k < n - m) {
                dest[count][k] = entry->d_name[k];
                k = k + 1;
            }
            dest[count][k] = 0;
            if (name_ok(dest[count]) == 1)
                count = count + 1;
        }
        entry = readdir(listing);
    }
    closedir(listing);
    i = 1;
    while (i < count) {
        char saved[PROJECT_NAME];
        int j;

        text_copy(saved, PROJECT_NAME, dest[i]);
        j = i;
        while (j > 0 && name_less(saved, dest[j - 1]) == 1) {
            text_copy(dest[j], PROJECT_NAME, dest[j - 1]);
            j = j - 1;
        }
        text_copy(dest[j], PROJECT_NAME, saved);
        i = i + 1;
    }
    return count;
}

EditProject::EditProject() {
    clear();
}

void EditProject::clear(void) {
    nameText[0] = 0;
    kindText[0] = 0;
    themeText[0] = 0;
    rootPath[0] = 0;
    activePath[0] = 0;
    placeLine = 1;
    files = 0;
    opens = 0;
    rows = 0;
    expanded = 0;
    omits = 0;
}

const char *EditProject::name(void) {
    return nameText;
}

const char *EditProject::kind_name(void) {
    return kindText;
}

const char *EditProject::theme_name(void) {
    return themeText;
}

void EditProject::set_theme(const char *name) {
    if (name == nullptr || name[0] == 0
            || text_same(name, "default") == 1) {
        themeText[0] = 0;
        return;
    }
    text_copy(themeText, 32, name);
}

const char *EditProject::root(void) {
    return rootPath;
}

const char *EditProject::active_path(void) {
    return activePath;
}

int EditProject::active_line(void) {
    return placeLine;
}

int EditProject::open_count(void) {
    return opens;
}

const char *EditProject::open_at(int index) {
    if (index < 0 || index >= opens)
        return "";
    return openPath[index];
}

int EditProject::file_count(void) {
    return files;
}

int EditProject::store_path(char *dest, long cap) {
    char dir[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    if (name_ok(nameText) == 0)
        return 0;
    if (project_catalog(dir, EDITOR_PATH) == 0)
        return 0;
    path_join(dest, cap, dir, nameText);
    if (dest[0] == 0)
        return 0;
    if (text_length(dest) + 9 >= cap)
        return 0;
    {
        long n;

        n = text_length(dest);
        dest[n] = '.';
        dest[n + 1] = 'p';
        dest[n + 2] = 'r';
        dest[n + 3] = 'o';
        dest[n + 4] = 'j';
        dest[n + 5] = 'e';
        dest[n + 6] = 'c';
        dest[n + 7] = 't';
        dest[n + 8] = 0;
    }
    return 1;
}

int EditProject::row_count(void) {
    return rows;
}

const char *EditProject::row_name(int index) {
    if (index < 0 || index >= rows)
        return "";
    return rowName[index];
}

const char *EditProject::row_label(int index) {
    if (index < 0 || index >= rows)
        return "";
    return rowLabel[index];
}

int EditProject::row_is_dir(int index) {
    if (index < 0 || index >= rows)
        return 0;
    return rowDir[index];
}

const char *EditProject::row_path(int index) {
    if (index < 0 || index >= rows)
        return "";
    return rowPath[index];
}

void EditProject::clear_opens(void) {
    opens = 0;
}

int EditProject::note_open(const char *path) {
    char norm[EDITOR_PATH];
    int i;

    if (opens >= PROJECT_OPENS)
        return 0;
    if (path == nullptr || path[0] == 0)
        return 0;
    if (path_normalize(norm, EDITOR_PATH, path) == 0)
        text_copy(norm, EDITOR_PATH, path);
    i = 0;
    while (i < opens) {
        if (text_same(openPath[i], norm) == 1)
            return 1;
        i = i + 1;
    }
    text_copy(openPath[opens], EDITOR_PATH, norm);
    opens = opens + 1;
    return 1;
}

void EditProject::note_active(const char *path, int line) {
    if (line < 1)
        line = 1;
    placeLine = line;
    if (path == nullptr || path[0] == 0) {
        activePath[0] = 0;
        return;
    }
    if (path_normalize(activePath, EDITOR_PATH, path) == 0)
        text_copy(activePath, EDITOR_PATH, path);
}

int EditProject::add_abs(const char *path) {
    char norm[EDITOR_PATH];
    int i;

    if (files >= PROJECT_FILES)
        return 0;
    if (path == nullptr || path[0] == 0)
        return 0;
    if (path_normalize(norm, EDITOR_PATH, path) == 0)
        return 0;
    if (file_is_reg(norm) == 0)
        return 0;
    i = 0;
    while (i < files) {
        if (text_same(filePath[i], norm) == 1)
            return 1;
        i = i + 1;
    }
    text_copy(filePath[files], EDITOR_PATH, norm);
    files = files + 1;
    return 1;
}

void EditProject::share_root(void) {
    char parent[EDITOR_PATH];
    int i;

    if (files <= 0) {
        rootPath[0] = 0;
        return;
    }
    path_dir(rootPath, EDITOR_PATH, filePath[0]);
    i = 1;
    while (i < files) {
        while (rootPath[0] != 0
                && under_dir(rootPath, filePath[i]) == 0) {
            path_dir(parent, EDITOR_PATH, rootPath);
            if (text_same(parent, rootPath) == 1) {
                rootPath[0] = 0;
                break;
            }
            text_copy(rootPath, EDITOR_PATH, parent);
        }
        i = i + 1;
    }
}

void EditProject::walk(const char *dir, int depth) {
    DIR *listing;
    struct dirent *entry;

    if (dir == nullptr || dir[0] == 0)
        return;
    if (depth > 8 || files >= PROJECT_FILES)
        return;
    listing = opendir(dir);
    if (listing == nullptr)
        return;
    entry = readdir(listing);
    while (entry != nullptr && files < PROJECT_FILES) {
        char path[EDITOR_PATH];

        if (entry->d_name[0] != '.') {
            path_join(path, EDITOR_PATH, dir, entry->d_name);
            if (file_is_dir(path) == 1) {
                if (file_is_link(path) == 0)
                    walk(path, depth + 1);
            } else if (file_is_reg(path) == 1)
                add_abs(path);
        }
        entry = readdir(listing);
    }
    closedir(listing);
}

int EditProject::collect_git(void) {
    String *cmd;
    File *pipe;
    char line[EDITOR_PATH];

    if (path_safe(rootPath) == 0)
        return 0;
    cmd = new String();
    cmd->append("git -C '");
    cmd->append(rootPath);
    cmd->append("' ls-files");
    pipe = popen(cmd->c_str(), "r");
    if (pipe == nullptr)
        return 0;
    while (fgets(line, EDITOR_PATH, pipe) != nullptr) {
        char full[EDITOR_PATH];
        int i;

        i = 0;
        while (line[i] != 0 && line[i] != '\n' && line[i] != '\r')
            i = i + 1;
        line[i] = 0;
        if (line[0] != 0) {
            path_join(full, EDITOR_PATH, rootPath, line);
            add_abs(full);
        }
    }
    pclose(pipe);
    return 1;
}

void EditProject::scan_cmake(
        const char *dir,
        const char *text,
        long n,
        int depth) {
    long i;
    int wantSub;

    if (dir == nullptr || text == nullptr)
        return;
    i = 0;
    wantSub = 0;
    while (i < n) {
        char token[EDITOR_PATH];

        i = next_token(text, n, i, token, EDITOR_PATH);
        if (token[0] == 0)
            break;
        if (wantSub == 1) {
            char sub[EDITOR_PATH];

            wantSub = 0;
            if (token[0] != '$') {
                path_join(sub, EDITOR_PATH, dir, token);
                collect_cmake(sub, depth + 1);
            }
        } else if (text_same(token, "add_subdirectory") == 1)
            wantSub = 1;
        else if (token_file(token) == 1) {
            char full[EDITOR_PATH];

            if (token[0] == '/')
                add_abs(token);
            else {
                path_join(full, EDITOR_PATH, dir, token);
                add_abs(full);
            }
        }
    }
}

void EditProject::collect_cmake(const char *dir, int depth) {
    char lists[EDITOR_PATH];
    char *raw;
    long n;
    const char *err;

    if (dir == nullptr || depth > 1)
        return;
    path_join(lists, EDITOR_PATH, dir, "CMakeLists.txt");
    if (file_is_reg(lists) == 0)
        return;
    add_abs(lists);
    err = "";
    n = 0;
    raw = read_file(lists, &n, &err);
    if (raw == nullptr)
        return;
    scan_cmake(dir, raw, n, depth);
}

int EditProject::collect(void) {
    files = 0;
    if (text_same(kindText, "directory") == 1) {
        if (file_is_dir(rootPath) == 0)
            return 0;
        walk(rootPath, 0);
        return 1;
    }
    if (text_same(kindText, "git") == 1) {
        if (file_is_dir(rootPath) == 0)
            return 0;
        return collect_git();
    }
    if (text_same(kindText, "cmake") == 1) {
        if (file_is_dir(rootPath) == 0)
            return 0;
        collect_cmake(rootPath, 0);
        return 1;
    }
    return 0;
}

int EditProject::expanded_has(const char *key) {
    int i;

    if (key == nullptr || key[0] == 0)
        return 1;
    i = 0;
    while (i < expanded) {
        if (text_same(expandKey[i], key) == 1)
            return 1;
        i = i + 1;
    }
    return 0;
}

int EditProject::expanded_add(const char *key) {
    if (key == nullptr || key[0] == 0)
        return 0;
    if (expanded_has(key) == 1)
        return 1;
    if (expanded >= PROJECT_EXPAND)
        return 0;
    text_copy(expandKey[expanded], PROJECT_REL, key);
    expanded = expanded + 1;
    return 1;
}

void EditProject::expanded_drop(const char *key) {
    int i;

    if (key == nullptr || key[0] == 0)
        return;
    i = 0;
    while (i < expanded) {
        if (text_same(expandKey[i], key) == 1) {
            while (i + 1 < expanded) {
                text_copy(
                        expandKey[i],
                        PROJECT_REL,
                        expandKey[i + 1]);
                i = i + 1;
            }
            expanded = expanded - 1;
            return;
        }
        i = i + 1;
    }
}

void EditProject::abs_for(
        const char *rel,
        char *dest,
        long cap) {
    int i;

    if (dest == nullptr || cap < 2)
        return;
    dest[0] = 0;
    if (rel == nullptr)
        return;
    i = 0;
    while (i < files) {
        char got[EDITOR_PATH];

        relative_of(got, EDITOR_PATH, rootPath, filePath[i]);
        if (text_same(got, rel) == 1) {
            text_copy(dest, cap, filePath[i]);
            return;
        }
        i = i + 1;
    }
}

int EditProject::next_child(
        const char *dirRel,
        const char *after,
        char *name,
        int *isDir) {
    char best[PROJECT_PART];
    int bestDir;
    int found;
    int i;
    long skip;

    if (name == nullptr || isDir == nullptr)
        return 0;
    name[0] = 0;
    *isDir = 0;
    best[0] = 0;
    bestDir = 0;
    found = 0;
    skip = 0;
    if (dirRel != nullptr && dirRel[0] != 0)
        skip = text_length(dirRel) + 1;
    i = 0;
    while (i < files) {
        char rel[EDITOR_PATH];
        char part[PROJECT_PART];
        long k;
        long n;
        int dir;

        relative_of(rel, EDITOR_PATH, rootPath, filePath[i]);
        if (skip == 0
                || (text_starts(rel, dirRel) == 1
                    && rel[skip - 1] == '/')) {
            k = 0;
            n = skip;
            while (rel[n] != 0 && rel[n] != '/'
                    && k + 1 < PROJECT_PART) {
                part[k] = rel[n];
                k = k + 1;
                n = n + 1;
            }
            part[k] = 0;
            dir = 0;
            if (rel[n] == '/')
                dir = 1;
            if (part[0] != 0) {
                int take;

                take = 1;
                if (after != nullptr && after[0] != 0) {
                    if (text_same(part, after) == 1)
                        take = 0;
                    if (name_less(part, after) == 1)
                        take = 0;
                }
                if (take == 1) {
                    if (found == 1
                            && text_same(part, best) == 1) {
                        if (dir == 1)
                            bestDir = 1;
                    } else if (found == 0
                            || name_less(part, best) == 1) {
                        text_copy(best, PROJECT_PART, part);
                        bestDir = dir;
                        found = 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    if (found == 0)
        return 0;
    text_copy(name, PROJECT_PART, best);
    *isDir = bestDir;
    return 1;
}

void EditProject::emit(const char *dirRel, int depth) {
    char after[PROJECT_PART];

    if (dirRel == nullptr || depth > 12)
        return;
    after[0] = 0;
    while (rows < PROJECT_ROWS) {
        char part[PROJECT_PART];
        char child[PROJECT_REL];
        int isDir;

        if (next_child(dirRel, after, part, &isDir) == 0)
            return;
        text_copy(after, PROJECT_PART, part);
        join_key(child, PROJECT_REL, dirRel, part);
        if (child[0] == 0)
            return;
        rowDepth[rows] = depth;
        rowDir[rows] = isDir;
        text_copy(rowName[rows], PROJECT_PART, part);
        text_copy(rowKey[rows], PROJECT_REL, child);
        rowPath[rows][0] = 0;
        if (isDir == 0)
            abs_for(child, rowPath[rows], EDITOR_PATH);
        write_label(
                rowLabel[rows],
                PROJECT_LABEL,
                depth,
                isDir,
                expanded_has(child),
                part);
        rows = rows + 1;
        if (isDir == 1 && expanded_has(child) == 1)
            emit(child, depth + 1);
    }
}

void EditProject::build_tree(void) {
    rows = 0;
    emit("", 0);
}

int EditProject::toggle_row(int index) {
    if (index < 0 || index >= rows)
        return 0;
    if (rowDir[index] == 0)
        return 0;
    if (expanded_has(rowKey[index]) == 1)
        expanded_drop(rowKey[index]);
    else if (expanded_add(rowKey[index]) == 0)
        return 0;
    build_tree();
    return 1;
}

int EditProject::save(void) {
    char path[EDITOR_PATH];
    char digits[16];
    String *text;
    const char *err;
    int i;

    if (name_ok(nameText) == 0)
        return 0;
    if (store_path(path, EDITOR_PATH) == 0)
        return 0;
    text = new String();
    text->append("name=");
    text->append(nameText);
    text->append("\nkind=");
    text->append(kindText);
    if (themeText[0] != 0) {
        text->append("\ntheme=");
        text->append(themeText);
    }
    text->append("\nroot=");
    text->append(rootPath);
    text->append("\nactive=");
    text->append(activePath);
    text->append("\nline=");
    write_digits(digits, 16, placeLine);
    text->append(digits);
    text->append("\n");
    i = 0;
    while (i < opens) {
        text->append("open=");
        text->append(openPath[i]);
        text->append("\n");
        i = i + 1;
    }
    if (text_same(kindText, "files") == 1) {
        i = 0;
        while (i < files) {
            text->append("file=");
            text->append(filePath[i]);
            text->append("\n");
            i = i + 1;
        }
    } else {
        i = 0;
        while (i < omits) {
            text->append("omit=");
            text->append(omitPath[i]);
            text->append("\n");
            i = i + 1;
        }
    }
    err = "";
    if (write_file(path, text->c_str(), &err) == 0)
        return 0;
    return 1;
}

int EditProject::save_as(const char *next) {
    if (name_ok(next) == 0)
        return 0;
    if (nameText[0] == 0)
        return 0;
    text_copy(nameText, PROJECT_NAME, next);
    return save();
}

int EditProject::remove_store(void) {
    char path[EDITOR_PATH];

    if (store_path(path, EDITOR_PATH) == 0)
        return 0;
    if (file_exists(path) == 0)
        return 0;
    if (remove(path) != 0)
        return 0;
    return 1;
}

int EditProject::load(const char *wanted) {
    char path[EDITOR_PATH];
    char *raw;
    long n;
    long at;
    const char *err;

    if (name_ok(wanted) == 0)
        return 0;
    clear();
    text_copy(nameText, PROJECT_NAME, wanted);
    if (store_path(path, EDITOR_PATH) == 0) {
        clear();
        return 0;
    }
    err = "";
    n = 0;
    raw = read_file(path, &n, &err);
    if (raw == nullptr) {
        clear();
        return 0;
    }
    at = 0;
    while (at < n) {
        char line[EDITOR_PATH];
        char value[EDITOR_PATH];

        take_line(raw, n, &at, line, EDITOR_PATH);
        if (split_key(line, "kind", value, 16) == 1)
            text_copy(kindText, 16, value);
        else if (split_key(line, "theme", value, 32) == 1)
            text_copy(themeText, 32, value);
        else if (split_key(line, "root", value, EDITOR_PATH) == 1)
            text_copy(rootPath, EDITOR_PATH, value);
        else if (split_key(line, "active", value, EDITOR_PATH) == 1)
            text_copy(activePath, EDITOR_PATH, value);
        else if (split_key(line, "line", value, 16) == 1)
            placeLine = number_of(value);
        else if (split_key(line, "open", value, EDITOR_PATH) == 1)
            note_open(value);
        else if (split_key(line, "file", value, EDITOR_PATH) == 1)
            add_abs(value);
        else if (split_key(line, "omit", value, EDITOR_PATH) == 1)
            note_omit(value);
    }
    if (kind_code(kindText) == 0) {
        clear();
        return 0;
    }
    if (placeLine < 1)
        placeLine = 1;
    if (text_same(kindText, "files") == 0) {
        files = 0;
        collect();
        drop_omitted();
    } else
        share_root();
    build_tree();
    return 1;
}

int EditProject::add_file(const char *path) {
    if (text_same(kindText, "files") == 0)
        return 0;
    if (add_abs(path) == 0)
        return 0;
    share_root();
    build_tree();
    return save();
}

int EditProject::forget_one(const char *norm) {
    int i;
    int j;

    if (norm == nullptr || norm[0] == 0)
        return 0;
    i = 0;
    while (i < files) {
        if (text_same(filePath[i], norm) == 1) {
            j = i;
            while (j + 1 < files) {
                text_copy(
                        filePath[j],
                        EDITOR_PATH,
                        filePath[j + 1]);
                j = j + 1;
            }
            files = files - 1;
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

void EditProject::forget_open(const char *norm) {
    int i;
    int j;

    if (norm == nullptr)
        return;
    if (text_same(activePath, norm) == 1)
        activePath[0] = 0;
    i = 0;
    while (i < opens) {
        if (text_same(openPath[i], norm) == 1) {
            j = i;
            while (j + 1 < opens) {
                text_copy(
                        openPath[j],
                        EDITOR_PATH,
                        openPath[j + 1]);
                j = j + 1;
            }
            opens = opens - 1;
        } else
            i = i + 1;
    }
}

void EditProject::drop_omitted(void) {
    int i;

    i = 0;
    while (i < omits) {
        forget_one(omitPath[i]);
        i = i + 1;
    }
}

int EditProject::note_omit(const char *path) {
    char norm[EDITOR_PATH];
    int i;

    if (path == nullptr || path[0] == 0)
        return 0;
    if (omits >= PROJECT_OMIT)
        return 0;
    if (path_normalize(norm, EDITOR_PATH, path) == 0)
        text_copy(norm, EDITOR_PATH, path);
    i = 0;
    while (i < omits) {
        if (text_same(omitPath[i], norm) == 1)
            return 1;
        i = i + 1;
    }
    text_copy(omitPath[omits], EDITOR_PATH, norm);
    omits = omits + 1;
    return 1;
}

int EditProject::drop_path(const char *path) {
    char norm[EDITOR_PATH];

    if (path_normalize(norm, EDITOR_PATH, path) == 0)
        return 0;
    if (forget_one(norm) == 0)
        return 0;
    if (text_same(kindText, "files") == 1)
        share_root();
    else if (note_omit(norm) == 0) {
        add_abs(norm);
        return 0;
    }
    forget_open(norm);
    build_tree();
    return save();
}

int EditProject::make(
        const char *wanted,
        const char *kindName,
        const char *path) {
    char used[EDITOR_PATH];

    if (name_ok(wanted) == 0)
        return 0;
    if (kind_code(kindName) == 0)
        return 0;
    if (path == nullptr || path[0] == 0)
        return 0;
    if (path_in_start(used, EDITOR_PATH, path) == 0)
        return 0;
    clear();
    text_copy(nameText, PROJECT_NAME, wanted);
    text_copy(kindText, 16, kindName);
    placeLine = 1;
    if (text_same(kindText, "files") == 1) {
        if (add_abs(used) == 0) {
            clear();
            return 0;
        }
        share_root();
    } else {
        if (file_is_dir(used) == 0 && file_is_reg(used) == 1)
            path_dir(used, EDITOR_PATH, used);
        if (file_is_dir(used) == 0) {
            clear();
            return 0;
        }
        text_copy(rootPath, EDITOR_PATH, used);
        collect();
    }
    build_tree();
    if (save() == 0) {
        clear();
        return 0;
    }
    return 1;
}

int template_archive(char *dest, long cap) {
    char *home;
    char config[EDITOR_PATH];
    char small[EDITOR_PATH];

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    home = getenv("HOME");
    if (home == nullptr || home[0] == 0)
        return 0;
    path_join(config, EDITOR_PATH, home, ".config");
    path_join(small, EDITOR_PATH, config, "smallcpp");
    path_join(dest, cap, small, "template.tar.gz");
    if (dest[0] == 0)
        return 0;
    return 1;
}

int unpack_template(const char *dir) {
    char archive[EDITOR_PATH];
    char dest[EDITOR_PATH];
    String *cmd;

    if (dir == nullptr || dir[0] == 0)
        return 0;
    if (template_archive(archive, EDITOR_PATH) == 0)
        return 0;
    if (file_exists(archive) == 0)
        return 0;
    if (path_normalize(dest, EDITOR_PATH, dir) == 0)
        return 0;
    if (file_is_reg(dest) == 1)
        path_dir(dest, EDITOR_PATH, dest);
    if (dest[0] == 0)
        return 0;
    if (path_safe(archive) == 0 || path_safe(dest) == 0)
        return 0;
    if (ensure_dir(dest) == 0)
        return 0;
    cmd = new String();
    cmd->append("tar -xzf '");
    cmd->append(archive);
    cmd->append("' -C '");
    cmd->append(dest);
    cmd->append("'");
    if (system(cmd->c_str()) != 0)
        return 0;
    return 1;
}
