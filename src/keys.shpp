#ifndef EDITOR_KEYS_H
#define EDITOR_KEYS_H

/* One accelerator for each menu command. The menu
 * index matches the order File, Edit, Search.
 */
enum {
    EDITOR_KEY_COUNT = 20
};

void key_info(
        int index,
        const char **label,
        const char **command,
        const char **config,
        const char **accel);
int key_index(const char *line);
int key_place(int index, long *menu, long *item);
void accel_shown(
        char *dest,
        long cap,
        const char *accel);

#endif
