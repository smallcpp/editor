void Ui::use_config(EditorConfig *item) {
    if (item == nullptr)
        return;
    theme_copy(themeConfig, item);
    if (item->brackets == 0)
        state->use_brackets(0);
    else
        state->use_brackets(1);
    state->set_bracket_pairs(item->bracketPairs);
    if (item->indent == 0)
        state->use_indent(0);
    else
        state->use_indent(1);
    state->set_indent_style(item->spaces);
    state->set_trim(item->trimTrailing);
    trimOn = item->trimTrailing;
    state->set_newline(item->ensureNewline);
    newlineOn = item->ensureNewline;
    state->set_tab_width(item->tabWidth);
    set_line_shown(item->showLine);
    set_margin_shown(item->showMargin);
    set_close_shown(item->showClose);
    set_margin_count(item->marginCols);
    set_caret_margin(item->caretMargin);
    set_line_color(item->lineColor);
    set_margin_color(item->marginColor);
    if (item->mapFont[0] != 0)
        set_map_font(item->mapFont);
    set_map_width(item->mapWidth);
    if (item->font[0] != 0)
        choose_font(item->font);
    searchWrap = item->searchWrap;
    searchBack = item->searchBack;
    searchWhole = item->searchWhole;
    searchCase = item->searchCase;
    showSpace = item->showSpace;
    showEnds = item->showEnds;
    showStops = item->showStops;
    showLeft = item->showLeft;
    if (showLeft != 0)
        showLeft = 1;
    showMap = item->showMap;
    if (showMap != 0)
        showMap = 1;
    windowWidth = item->windowWidth;
    windowHeight = item->windowHeight;
    rememberFiles = item->rememberFiles;
    saveOnTab = item->saveOnTab;
    saveOnWindow = item->saveOnWindow;
    trimOn = item->trimTrailing;
    newlineOn = item->ensureNewline;
    if (newlineOn != 0)
        newlineOn = 1;
    pathOn = item->showPath;
    if (pathOn != 0)
        pathOn = 1;
    pathDepth = item->pathDepth;
    if (pathDepth < 0 || pathDepth > 32)
        pathDepth = 0;
    recoveryOn = item->recoveryOn;
    if (recoveryOn != 0)
        recoveryOn = 1;
    recoveryMinutes = item->recoveryMinutes;
    if (recoveryMinutes < 1 || recoveryMinutes > 1440)
        recoveryMinutes = 5;
    recoveryKeep = item->recoveryKeep;
    if (recoveryKeep < 0 || recoveryKeep > 500)
        recoveryKeep = 20;
    if (recoveryOn != 0)
        recoveryMark = (long)time(nullptr);
    recentCount = item->recentCount;
    recentUsed = item->recentUsed;
    openCount = item->openCount;
    text_copy(activePath, EDITOR_PATH, item->activePath);
    {
        int i;

        i = 0;
        while (i < recentUsed && i < EDITOR_RECENT_MAX) {
            text_copy(
                    recentPath[i],
                    EDITOR_PATH,
                    item->recentPath[i]);
            i = i + 1;
        }
        i = 0;
        while (i < openCount && i < EDITOR_OPEN_MAX) {
            text_copy(
                    openPath[i],
                    EDITOR_PATH,
                    item->openPath[i]);
            i = i + 1;
        }
    }
    {
        int n;

        n = 0;
        while (n < EDITOR_KEY_COUNT) {
            text_copy(keyAccel[n], 64, item->accel[n]);
            if (keyButton[n] != nullptr) {
                char shown[64];

                button_text(keyAccel[n], shown, 64);
                keyButton[n]->set_label(shown);
            }
            n = n + 1;
        }
    }
    if (mainWindow != nullptr)
        bind_keys();
    {
        long i;

        i = 0;
        while (i < pageCount) {
            retitle(i);
            i = i + 1;
        }
    }
    push_options();
}

void Ui::load_settings(void) {
    EditorConfig item;
    char path[EDITOR_PATH];

    config_defaults(&item);
    if (config_path(path, EDITOR_PATH) == 0)
        return;
    if (config_read(path, &item) == 0)
        return;
    keep_theme_base(&item);
    text_copy(themeName, THEME_NAME, item.themeName);
    if (theme_is_default(themeName) == 0) {
        if (theme_load(&item, themeName) == 0)
            text_copy(themeName, THEME_NAME, "default");
    }
    text_copy(editorTheme, THEME_NAME, themeName);
    use_config(&item);
}

void Ui::apply_settings(void) {
    EditorConfig item;
    char path[EDITOR_PATH];

    if (settingsHold != 0)
        return;
    settingsHold = 1;
    config_defaults(&item);
    item.brackets = state->uses_brackets();
    item.indent = state->uses_indent();
    item.spaces = state->indent_style();
    item.trimTrailing = state->trims();
    item.ensureNewline = state->ensures_newline();
    item.showPath = pathOn;
    item.pathDepth = pathDepth;
    item.tabWidth = state->tab_width();
    item.showLine = showLine;
    item.showMargin = showMargin;
    item.showClose = showClose;
    item.marginCols = marginCols;
    item.caretMargin = wheelMargin;
    item.searchWrap = searchWrap;
    item.searchBack = searchBack;
    item.searchWhole = searchWhole;
    item.searchCase = searchCase;
    item.showSpace = showSpace;
    item.showEnds = showEnds;
    item.showStops = showStops;
    item.showLeft = showLeft;
    item.showMap = showMap;
    item.rememberFiles = rememberFiles;
    item.saveOnTab = saveOnTab;
    item.saveOnWindow = saveOnWindow;
    item.recentCount = recentCount;
    item.windowWidth = windowWidth;
    item.windowHeight = windowHeight;
    text_copy(item.lineColor, 32, lineColor);
    text_copy(item.marginColor, 32, marginColor);
    text_copy(item.font, 128, fontDesc);
    text_copy(item.mapFont, 128, mapFont);
    item.mapWidth = (int)mapWide;
    read_keys();
    {
        int n;

        n = 0;
        while (n < EDITOR_KEY_COUNT) {
            text_copy(item.accel[n], 64, keyAccel[n]);
            n = n + 1;
        }
    }
    copy_bracket_pairs(
            item.bracketPairs,
            64,
            state->bracket_pairs());
    recentCount = item.recentCount;
    rememberFiles = item.rememberFiles;
    saveOnTab = item.saveOnTab;
    saveOnWindow = item.saveOnWindow;
    trimOn = item.trimTrailing;
    state->set_trim(trimOn);
    newlineOn = item.ensureNewline;
    if (newlineOn != 0)
        newlineOn = 1;
    state->set_newline(newlineOn);
    pathOn = item.showPath;
    if (pathOn != 0)
        pathOn = 1;
    pathDepth = item.pathDepth;
    if (pathDepth < 0 || pathDepth > 32)
        pathDepth = 0;
    state->set_indent_style(item.spaces);
    if (recentCount < 1)
        recentCount = 1;
    if (recentCount > EDITOR_RECENT_MAX)
        recentCount = EDITOR_RECENT_MAX;
    item.recentCount = recentCount;
    item.rememberFiles = rememberFiles;
    item.saveOnTab = saveOnTab;
    item.saveOnWindow = saveOnWindow;
    item.trimTrailing = trimOn;
    item.ensureNewline = newlineOn;
    item.showPath = pathOn;
    item.pathDepth = pathDepth;
    item.spaces = state->indent_style();
    item.recentUsed = recentUsed;
    if (item.recentUsed > item.recentCount)
        item.recentUsed = item.recentCount;
    {
        int i;

        i = 0;
        while (i < item.recentUsed) {
            text_copy(
                    item.recentPath[i],
                    EDITOR_PATH,
                    recentPath[i]);
            i = i + 1;
        }
    }
    item.openCount = 0;
    item.activePath[0] = 0;
    if (rememberFiles == 1)
        collect_open(&item);
    item.recoveryOn = recoveryOn;
    item.recoveryMinutes = recoveryMinutes;
    item.recoveryKeep = recoveryKeep;
    theme_copy(&item, themeConfig);
    text_copy(item.themeName, THEME_NAME, editorTheme);
    if (theme_is_default(themeName) == 1)
        keep_theme_base(&item);
    else
        theme_save(themeName, &item);
    use_config(&item);
    if (theme_is_default(themeName) == 0)
        give_theme_base(&item);
    text_copy(item.themeName, THEME_NAME, editorTheme);
    item.caretMargin = wheelMargin;
    if (config_path(path, EDITOR_PATH) == 1)
        write_config(path, &item);
    settingsHold = 0;
}

static ScrolledWindow *page_scroll(Widget *child) {
    ScrolledWindow *scroll;

    scroll = new ScrolledWindow();
    scroll->set_h_expand(true);
    scroll->set_v_expand(true);
    scroll->set_min_content(320, 160);
    scroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    scroll->set_child(child);
    return scroll;
}

static Box *color_field(Entry *entry, Button *button) {
    Box *row;

    row = new Box(GTK_HORIZONTAL, 8);
    row->append((Widget *)entry);
    row->append((Widget *)button);
    return row;
}

static Box *centered_close(void (*action)(void *)) {
    Box *row;
    Box *left;
    Box *right;
    Button *button;

    row = new Box(GTK_HORIZONTAL, 8);
    row->set_h_expand(true);
    left = new Box(GTK_HORIZONTAL, 0);
    right = new Box(GTK_HORIZONTAL, 0);
    left->set_h_expand(true);
    right->set_h_expand(true);
    button = new Button("Close");
    button->on_clicked(action, nullptr);
    row->append((Widget *)left);
    row->append((Widget *)button);
    row->append((Widget *)right);
    return row;
}

static Box *ruled_close(void (*action)(void *)) {
    Box *box;

    box = new Box(GTK_VERTICAL, 0);
    box->set_h_expand(true);
    box->add_css(
            "box { border-top: 1px solid #222222; }");
    box->add_css("box { padding-top: 8px; }");
    box->add_css("box { margin-top: 8px; }");
    box->append((Widget *)centered_close(action));
    return box;
}

static int themeSlots[THEME_ALL];

static Box *theme_field(
        int slot,
        Entry **entryOut,
        Button **buttonOut) {
    Entry *entry;
    Button *button;

    entry = new Entry("#000000");
    entry->set_width_chars(12);
    entry->on_changed(
            ui_theme_entry,
            (void *)&themeSlots[slot]);
    button = new Button("Color");
    button->on_clicked(
            ui_theme_color,
            (void *)&themeSlots[slot]);
    *entryOut = entry;
    *buttonOut = button;
    return color_field(entry, button);
}

static Box *group_box(const char *title) {
    Box *box;

    box = new Box(GTK_VERTICAL, 6);
    box->add_css("box { border: 1px solid #222222; }");
    box->add_css("box { padding: 8px; }");
    box->append((Widget *)new Label(title));
    return box;
}

static Box *labeled_field(
        const char *label,
        Widget *field) {
    Box *row;

    row = new Box(GTK_HORIZONTAL, 8);
    row->append((Widget *)new Label(label));
    row->append(field);
    return row;
}

static int themeSlotsReady = 0;

static int theme_type_count(void) {
    return 7;
}

static const char *theme_type_name(int index) {
    if (index == 1)
        return "c";
    if (index == 2)
        return "cpp";
    if (index == 3)
        return "cw";
    if (index == 4)
        return "python";
    if (index == 5)
        return "shell";
    if (index == 6)
        return "toml";
    return "scpp";
}

static const char *theme_type_label(int index) {
    if (index == 1)
        return "C";
    if (index == 2)
        return "C++";
    if (index == 4)
        return "Python";
    return theme_type_name(index);
}

