void Ui::build(void) {
    const char *fileLabels[9];
    const char *editLabels[8];
    const char *searchLabels[6];
    const char *viewLabels[4];
    long fileMenu;
    long editMenu;
    Box *outer;

    app = new Application("org.smallcpp.Editor");
    mainWindow = new Window("editor");
    if (windowWidth >= 100 && windowHeight >= 100)
        mainWindow->set_default_size(
                windowWidth,
                windowHeight);
    else
        mainWindow->set_default_size(880, 640);
    mainWindow->on_resize(ui_resized, nullptr);
    mainWindow->on_active(ui_window_active, nullptr);
    mainWindow->on_close_request(ui_close, nullptr);
    menuBar = new MenuBar();
    fileLabels[0] = "New";
    fileLabels[1] = "Open";
    fileLabels[2] = "Open Recent";
    fileLabels[3] = "Save";
    fileLabels[4] = "Save As";
    fileLabels[5] = "Save All";
    fileLabels[6] = "Close";
    fileLabels[7] = "Close All";
    fileLabels[8] = "Quit";
    searchLabels[0] = "Search";
    searchLabels[1] = "Replace";
    searchLabels[2] = "Reverse";
    searchLabels[3] = "Whole word";
    searchLabels[4] = "Match case";
    searchLabels[5] = "Wrap";
    viewLabels[0] = "Whitespace";
    viewLabels[1] = "Line ends";
    viewLabels[2] = "Indent stops";
    viewLabels[3] = "Remember files";
    editLabels[0] = "Undo";
    editLabels[1] = "Redo";
    editLabels[2] = "Cut";
    editLabels[3] = "Copy";
    editLabels[4] = "Paste";
    editLabels[5] = "Indent";
    editLabels[6] = "Unindent";
    editLabels[7] = "Settings";
    fileMenu = menuBar->add_menu(
            "File",
            fileLabels,
            9,
            ui_menu,
            nullptr);
    editMenu = menuBar->add_menu(
            "Edit",
            editLabels,
            8,
            ui_menu,
            nullptr);
    searchMenu = menuBar->add_menu(
            "Search",
            searchLabels,
            6,
            ui_menu,
            nullptr);
    viewMenu = menuBar->add_menu(
            "View",
            viewLabels,
            4,
            ui_menu,
            nullptr);
    menuBar->set_separator(fileMenu, 3);
    menuBar->set_separator(fileMenu, 6);
    menuBar->set_separator(fileMenu, 8);
    menuBar->set_separator(editMenu, 2);
    menuBar->set_separator(editMenu, 5);
    menuBar->set_separator(editMenu, 7);
    menuBar->set_separator(searchMenu, 2);
    documentsMenu = menuBar->add_menu(
            "Documents",
            nullptr,
            0,
            ui_doc,
            nullptr);
    outer = new Box(GTK_VERTICAL, 0);
    outer->append((Widget *)menuBar);
    book = new Notebook();
    book->set_scrollable(true);
    book->add_css("tab { border: 1px solid #222222; }");
    book->add_css("tab { margin: 2px; padding: 2px 6px; }");
    book->add_css("tab { background-color: #f4f4f4; }");
    book->add_css("tab:checked { background-color: #ffffff; }");
    book->on_switch_page(ui_switched, nullptr);
    book->set_v_expand(true);
    status = new Label("editor");
    outer->append((Widget *)book);
    outer->append((Widget *)status);
    mainWindow->set_child((Widget *)outer);
    bind_keys();
    push_options();
    files = new FileDialog();
    files->set_parent(mainWindow);
    fonts = new FontDialog();
    colors = new ColorDialog();
    choiceDialog = new Dialog("Confirm");
    choiceDialog->set_transient(mainWindow);
    choiceDialog->add_button("Save", EDITOR_SAVE);
    choiceDialog->add_button("Discard", EDITOR_DISCARD);
    choiceDialog->add_button("Cancel", EDITOR_CANCEL);
    choiceDialog->on_response(ui_choice_response, nullptr);
    dirtyDialog = new Dialog("Save changes?");
    dirtyDialog->set_transient(mainWindow);
    dirtyDialog->add_button("Save all", EDITOR_SAVE);
    dirtyDialog->add_button("Discard all", EDITOR_DISCARD);
    dirtyDialog->add_button("Cancel", EDITOR_CANCEL);
    dirtyDialog->on_response(ui_choice_response, nullptr);
    show_recent();
}

void Ui::prepare(void) {
    int named;

    if (app != nullptr)
        return;
    named = 0;
    if (state->count() > 1)
        named = 1;
    if (state->count() == 1
            && state->at(0)->untitled() == 0)
        named = 1;
    build();
    if (named == 0 && rememberFiles == 1 && openCount > 0)
        restore_files();
    else
        note_loaded();
    refresh();
}

void Ui::add_page(long index) {
    Document *doc;
    char title[256];
    ScrolledWindow *scroll;

    doc = state->at(index);
    if (doc == nullptr)
        return;
    pages[index].buffer = new TextBuffer();
    pages[index].view = new TextView(pages[index].buffer);
    pages[index].view->set_monospace(true);
    pages[index].view->set_editable(true);
    pages[index].view->set_line_numbers(true);
    pages[index].userDepth = 0;
    pages[index].pendingSync = 0;
    pages[index].pendingIdle = 0;
    scroll = new ScrolledWindow();
    scroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    scroll->set_child((Widget *)pages[index].view);
    pages[index].scroll = scroll;
    pages[index].tags = 0;
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    applying = 0;
    pages[index].buffer->on_changed(
            ui_changed,
            (void *)&refs[index]);
    g_signal_connect_data(
            pages[index].buffer->native,
            "begin-user-action",
            (void *)ui_user_begin,
            (void *)&refs[index],
            nullptr,
            0);
    g_signal_connect_data(
            pages[index].buffer->native,
            "end-user-action",
            (void *)ui_user_end,
            (void *)&refs[index],
            nullptr,
            0);
    pages[index].view->on_move_cursor(
            ui_moved,
            (void *)&refs[index]);
    text_copy(title, 256, doc->title());
    book->append_page((Widget *)scroll, title);
    pageCount = pageCount + 1;
    mount_tab(index, title);
    apply_view(index);
    highlight(index);
    place_cursor(index);
    paint_line(index);
}

void Ui::rebuild(void) {
    long i;
    long n;
    long want;

    want = state->index();
    building = 1;
    while (pageCount > 0) {
        book->remove_page(0);
        pageCount = pageCount - 1;
    }
    i = 0;
    while (i < EDITOR_PAGES) {
        pages[i].buffer = nullptr;
        pages[i].view = nullptr;
        pages[i].scroll = nullptr;
        pages[i].tags = 0;
        pages[i].userDepth = 0;
        pages[i].pendingSync = 0;
        pages[i].pendingIdle = 0;
        tabTitle[i] = nullptr;
        i = i + 1;
    }
    n = state->count();
    if (n > EDITOR_PAGES)
        n = EDITOR_PAGES;
    i = 0;
    while (i < n) {
        add_page(i);
        i = i + 1;
    }
    building = 0;
    if (pageCount == 0)
        return;
    if (want < 0 || want >= pageCount)
        want = 0;
    state->set_index(want);
    book->set_current_page(want);
}

void Ui::place_cursor(long index) {
    Document *doc;
    TextIter *at;
    TextIter *bound;
    long line;
    long column;
    long line2;
    long column2;
    long lo;
    long hi;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    if (doc->buffer()->has_selection() == false) {
        doc->buffer()->line_column_at(
                doc->buffer()->cursor_offset(),
                &line,
                &column);
        at = new TextIter(line, column);
        pages[index].buffer->place_cursor(at);
        if (pages[index].view != nullptr)
            pages[index].view->scroll_to(line, column);
        return;
    }
    lo = doc->buffer()->sel_lo();
    hi = doc->buffer()->sel_hi();
    doc->buffer()->line_column_at(lo, &line, &column);
    doc->buffer()->line_column_at(hi, &line2, &column2);
    at = new TextIter(line, column);
    bound = new TextIter(line2, column2);
    pages[index].buffer->select_range(at, bound);
    doc->buffer()->line_column_at(
            doc->buffer()->cursor_offset(),
            &line,
            &column);
    if (pages[index].view != nullptr)
        pages[index].view->scroll_to(line, column);
}

void Ui::push_active(void) {
    long index;
    Document *doc;

    index = state->index();
    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->active();
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    retitle(index);
    if (text_same(
                pages[index].buffer->get_text(),
                doc->buffer()->text()) == 1) {
        place_cursor(index);
        paint_line(index);
        return;
    }
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    place_cursor(index);
    applying = 0;
    highlight(index);
    paint_line(index);
}

void Ui::take_selection(void) {
    TextBuffer *gtkBuf;
    TextIter *start;
    TextIter *end;
    Document *doc;
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    gtkBuf = pages[index].buffer;
    if (gtkBuf == nullptr)
        return;
    doc = state->active();
    if (doc == nullptr)
        return;
    start = new TextIter(0, 0);
    end = new TextIter(0, 0);
    if (gtkBuf->selection_bounds(start, end) == false)
        return;
    doc->buffer()->select_span(
            start->line() + 1,
            start->offset() + 1,
            end->line() + 1,
            end->offset() + 1);
}

static void seek_offset(
        const char *text,
        long n,
        long target,
        long *at,
        long *line,
        long *column) {
    int value;
    int step;

    if (target < *at) {
        *at = 0;
        *line = 0;
        *column = 0;
    }
    if (target > n)
        target = n;
    while (*at < target) {
        value = byte_at(text, *at);
        if (value == '\n') {
            *line = *line + 1;
            *column = 0;
            *at = *at + 1;
            continue;
        }
        step = utf8_len(value);
        if (*at + step > target) {
            *at = target;
            return;
        }
        *column = *column + 1;
        *at = *at + step;
    }
}

void Ui::highlight(long index) {
    Highlighter *scan;
    Document *doc;
    const char *text;
    long i;
    long byte;
    long line;
    long col;
    long line2;
    long col2;
    long n;
    TextIter *start;
    TextIter *end;
    const char *name;
    const char *color;
    Span *span;
    int kind;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    text = pages[index].buffer->get_text();
    n = text_length(text);
    if (n > 200000)
        return;
    text_position(text, n, &line2, &col2);
    start = new TextIter(0, 0);
    end = new TextIter(line2, col2);
    kind = SPAN_KEYWORD;
    while (kind <= SPAN_OPERATOR) {
        name = span_tag(kind);
        color = theme_color(
                themeConfig,
                doc->language(),
                name);
        pages[index].buffer->set_tag_foreground(
                name,
                color);
        if (n > 0)
            pages[index].buffer->remove_tag(
                    name,
                    start,
                    end);
        kind = kind + 1;
    }
    pages[index].tags = 1;
    scan = new Highlighter();
    scan->scan(text, doc->language());
    byte = 0;
    line = 0;
    col = 0;
    i = 0;
    while (i < scan->count()) {
        span = scan->at(i);
        seek_offset(text, n, span->start, &byte, &line, &col);
        line2 = line;
        col2 = col;
        seek_offset(text, n, span->end, &byte, &line, &col);
        start = new TextIter(line2, col2);
        end = new TextIter(line, col);
        name = span->tag;
        if (name != nullptr && name[0] != 0)
            pages[index].buffer->apply_tag(
                    name,
                    start,
                    end);
        i = i + 1;
    }
}

void Ui::paint_status(void) {
    status->set_text(state->status());
}

void Ui::refresh(void) {
    long i;
    long want;

    want = state->index();
    if (pageCount != state->count())
        rebuild();
    else {
        push_active();
        if (book != nullptr
                && want >= 0
                && want < pageCount)
            book->set_current_page(want);
    }
    i = 0;
    while (i < pageCount) {
        retitle(i);
        paint_line(i);
        i = i + 1;
    }
    fill_documents();
    paint_status();
}

void Ui::show_main(void) {
    refresh();
    mainWindow->present();
}

void Ui::show_choice(const char *title, int mode) {
    choiceMode = mode;
    choiceDialog->set_title(title);
    choiceDialog->present();
}

void Ui::handle(int code) {
    if (code == EDITOR_NEEDS_CHOICE) {
        show_dirty();
        return;
    }
    if (code == EDITOR_NEEDS_PATH
            || code == EDITOR_CHOOSE_SAVE) {
        if (files->pending != 0)
            return;
        files->set_title("Save");
        arm_dialog();
        files->save(ui_saved, nullptr);
        return;
    }
    if (code == EDITOR_CHOOSE_OPEN) {
        if (files->pending != 0)
            return;
        files->set_title("Open");
        arm_dialog();
        files->open(ui_opened, nullptr);
        return;
    }
    if (code == EDITOR_FAILED
            && text_same(state->error(), "overwrite") == 1) {
        show_choice("Overwrite the file?", 1);
        return;
    }
    refresh();
}

void Ui::open_path(const char *path) {
    int code;

    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0)
        return;
    note_folder(path);
    code = state->open_file(path);
    if (code == EDITOR_OK)
        note_recent(path);
    handle(code);
}

void Ui::save_path(const char *path) {
    int code;

    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0) {
        finish_choice(state->answer(EDITOR_CANCEL));
        return;
    }
    note_folder(path);
    pendingPath = new String();
    pendingPath->append(path);
    code = state->provide_path(path);
    if (code == EDITOR_OK)
        note_recent(path);
    finish_choice(code);
}

void Ui::finish_choice(int code) {
    if (code != EDITOR_NEEDS_CHOICE
            && dirtyDialog != nullptr) {
        dirtyOpen = 0;
        dirtyDialog->set_visible(false);
    }
    handle(code);
    if (state->quit_ready() == 1)
        leave();
}

void Ui::choice(int response) {
    if (choiceMode == 1) {
        choiceMode = 0;
        if (response == EDITOR_SAVE) {
            state->allow_overwrite(1);
            handle(state->provide_path(
                    pendingPath->c_str()));
            return;
        }
        handle(state->answer(EDITOR_CANCEL));
        return;
    }
    if (response == EDITOR_CANCEL) {
        if (dirtyDialog != nullptr)
            dirtyDialog->set_visible(false);
        finish_choice(state->answer(EDITOR_CANCEL));
        return;
    }
    if (response == EDITOR_SAVE) {
        finish_choice(state->save_every());
        return;
    }
    if (response == EDITOR_DISCARD) {
        finish_choice(state->discard_every());
        return;
    }
    finish_choice(state->answer(response));
}

void Ui::user_begin(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].userDepth = pages[index].userDepth + 1;
}

void Ui::user_end(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].userDepth > 0)
        pages[index].userDepth =
                pages[index].userDepth - 1;
    if (pages[index].userDepth == 0)
        flush_sync(index);
}

void Ui::flush_sync(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].pendingIdle = 0;
    if (pages[index].pendingSync == 0)
        return;
    pages[index].pendingSync = 0;
    sync_view(index);
}

void Ui::sync_view(long index) {
    Document *doc;
    String *want;
    String *have;
    const char *wantRaw;
    const char *haveRaw;
    long wantN;
    long haveN;
    long prefix;
    long wantEnd;
    long haveEnd;
    long line;
    long column;
    long line2;
    long column2;
    TextIter *at;
    TextIter *bound;
    String *bit;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    want = new String();
    want->append(doc->buffer()->text());
    have = new String();
    have->append(pages[index].buffer->get_text());
    wantRaw = want->c_str();
    haveRaw = have->c_str();
    if (text_same(wantRaw, haveRaw) == 1) {
        place_cursor(index);
        return;
    }
    wantN = want->size();
    haveN = have->size();
    prefix = 0;
    while (prefix < wantN
            && prefix < haveN
            && wantRaw[prefix] == haveRaw[prefix])
        prefix = prefix + 1;
    wantEnd = wantN;
    haveEnd = haveN;
    while (wantEnd > prefix
            && haveEnd > prefix
            && wantRaw[wantEnd - 1] == haveRaw[haveEnd - 1]) {
        wantEnd = wantEnd - 1;
        haveEnd = haveEnd - 1;
    }
    applying = 1;
    if (haveEnd > prefix) {
        text_position(haveRaw, prefix, &line, &column);
        text_position(haveRaw, haveEnd, &line2, &column2);
        at = new TextIter(line, column);
        bound = new TextIter(line2, column2);
        pages[index].buffer->delete_range(at, bound);
    }
    if (wantEnd > prefix) {
        bit = slice_text(wantRaw, prefix, wantEnd);
        text_position(wantRaw, prefix, &line, &column);
        at = new TextIter(line, column);
        pages[index].buffer->insert(at, bit->c_str());
    }
    applying = 0;
    place_cursor(index);
    highlight(index);
    paint_line(index);
}

void Ui::changed(long index) {
    Document *doc;
    const char *text;
    int extra;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    text = pages[index].buffer->get_text();
    extra = doc->buffer()->note_external(text);
    if (extra == 1) {
        pages[index].pendingSync = 1;
        if (pages[index].userDepth == 0
                && pages[index].pendingIdle == 0) {
            pages[index].pendingIdle = 1;
            g_idle_add(
                    (void *)ui_sync_idle,
                    (void *)&refs[index]);
        }
    } else
        highlight(index);
    retitle(index);
    paint_status();
}

void Ui::moved(long index, long line, long offset) {
    Document *doc;

    if (applying == 1)
        return;
    if (index < 0 || index >= state->count())
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    doc->buffer()->move_to(line + 1, offset + 1);
    paint_line(index);
    paint_status();
}

void Ui::switched(long index) {
    long previous;

    if (building == 1)
        return;
    previous = state->index();
    if (saveOnTab == 1 && previous != index)
        save_quiet(previous);
    state->set_index(index);
    paint_status();
}

TextBuffer *Ui::view_buffer(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return nullptr;
    return pages[index].buffer;
}

const char *Ui::page_text(long index) {
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].buffer == nullptr)
        return "";
    return pages[index].buffer->get_text();
}

const char *Ui::line_number_text(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].view == nullptr)
        return "";
    return pages[index].view->line_number_text();
}

long Ui::gutter_line_y(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return -1;
    if (pages[index].view == nullptr)
        return -1;
    return pages[index].view->line_number_origin(line);
}

void Ui::scroll_view(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    pages[index].view->scroll_to(line, 0);
}

void Ui::hide_settings(void) {
    if (settingsDialog == nullptr)
        return;
    settingsDialog->set_visible(false);
}

static void set_box(CheckButton *box, int on) {
    if (box == nullptr)
        return;
    if (on == 0)
        box->set_active(false);
    else
        box->set_active(true);
}

void Ui::sync_boxes(void) {
    long i;

    applying = 1;
    set_box(wrapCheck, searchWrap);
    set_box(backCheck, searchBack);
    set_box(wholeCheck, searchWhole);
    set_box(caseCheck, searchCase);
    set_box(spaceCheck, showSpace);
    set_box(endCheck, showEnds);
    set_box(stopCheck, showStops);
    set_box(rememberCheck, rememberFiles);
    set_box(saveTabCheck, saveOnTab);
    set_box(saveWinCheck, saveOnWindow);
    set_box(trimCheck, trimOn);
    if (recentSpin != nullptr)
        recentSpin->set_value((double)recentCount);
    applying = 0;
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::push_options(void) {
    applying = 1;
    if (menuBar != nullptr) {
        menuBar->set_check(searchMenu, 2, searchBack);
        menuBar->set_check(searchMenu, 3, searchWhole);
        menuBar->set_check(searchMenu, 4, searchCase);
        menuBar->set_check(searchMenu, 5, searchWrap);
        menuBar->set_check(viewMenu, 0, showSpace);
        menuBar->set_check(viewMenu, 1, showEnds);
        menuBar->set_check(viewMenu, 2, showStops);
        menuBar->set_check(viewMenu, 3, rememberFiles);
    }
    applying = 0;
    sync_boxes();
}

void Ui::set_option(const char *label, int on) {
    int value;

    if (applying == 1)
        return;
    if (label == nullptr)
        return;
    value = 0;
    if (on != 0)
        value = 1;
    if (text_same(label, "Wrap") == 1)
        searchWrap = value;
    if (text_same(label, "Reverse") == 1)
        searchBack = value;
    if (text_same(label, "Whole word") == 1)
        searchWhole = value;
    if (text_same(label, "Match case") == 1)
        searchCase = value;
    if (text_same(label, "Whitespace") == 1)
        showSpace = value;
    if (text_same(label, "Line ends") == 1)
        showEnds = value;
    if (text_same(label, "Indent stops") == 1)
        showStops = value;
    if (text_same(label, "Remember files") == 1)
        rememberFiles = value;
    if (text_same(label, "Save when a tab loses focus") == 1)
        saveOnTab = value;
    if (text_same(
                label,
                "Save when the window loses focus") == 1)
        saveOnWindow = value;
    if (text_same(
                label,
                "Trim trailing spaces on save") == 1) {
        trimOn = value;
        state->set_trim(value);
    }
    push_options();
    apply_settings();
}

int Ui::shows_space(void) {
    return showSpace;
}

int Ui::shows_ends(void) {
    return showEnds;
}

int Ui::shows_stops(void) {
    return showStops;
}

int Ui::search_wrap(void) {
    return searchWrap;
}

void Ui::bind_keys(void) {
    int n;

    if (mainWindow == nullptr)
        return;
    mainWindow->clear_shortcuts();
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        const char *label;
        const char *command;
        const char *config;
        const char *accel;
        long menu;
        long item;

        key_info(n, &label, &command, &config, &accel);
        (void)command;
        (void)config;
        (void)accel;
        if (keyAccel[n][0] != 0
                && mainWindow->shortcut_ok(keyAccel[n]) == 1)
            mainWindow->add_shortcut(
                    keyAccel[n],
                    ui_key,
                    (void *)label);
        if (menuBar != nullptr
                && key_place(n, &menu, &item) == 1)
            menuBar->set_shortcut(menu, item, keyAccel[n]);
        n = n + 1;
    }
    mainWindow->add_shortcut(
            "<Control><Shift>z",
            ui_key,
            (void *)"Redo");
    mainWindow->add_shortcut("Tab", ui_key, (void *)"Indent");
    mainWindow->add_shortcut(
            "<Shift>Tab",
            ui_key,
            (void *)"Unindent");
    mainWindow->add_shortcut(
            "ISO_Left_Tab",
            ui_key,
            (void *)"Unindent");
}

static void fill_span(
        char *buf,
        long cap,
        const char *left,
        const char *mid,
        const char *right) {
    long n;
    long i;
    const char *part;
    int which;

    n = 0;
    which = 0;
    while (which < 3) {
        part = left;
        if (which == 1)
            part = mid;
        if (which == 2)
            part = right;
        if (part != nullptr) {
            i = 0;
            while (part[i] != 0 && n + 1 < cap) {
                buf[n] = part[i];
                n = n + 1;
                i = i + 1;
            }
        }
        which = which + 1;
    }
    buf[n] = 0;
}

static void add_dot(char *buf, long cap) {
    long n;

    n = 0;
    while (buf[n] != 0)
        n = n + 1;
    if (n + 1 < cap) {
        buf[n] = '.';
        n = n + 1;
        buf[n] = 0;
    }
}

static void button_text(const char *accel, char *buf, long cap) {
    if (accel == nullptr || accel[0] == 0)
        text_copy(buf, cap, "none");
    else
        text_copy(buf, cap, accel);
}

void Ui::show_key_note(void) {
    if (keyState == nullptr)
        return;
    if (keyCapture >= 0)
        keyState->set_text(keyPrompt);
    else
        keyState->set_text(keyWarn);
}

const char *Ui::key_help(void) {
    return "Click a shortcut, press the new keys. Escape cancels.";
}

const char *Ui::key_warning(void) {
    return keyWarn;
}

const char *Ui::key_text(int index) {
    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return "";
    return keyAccel[index];
}

void Ui::arm_key(int index) {
    const char *label;
    const char *command;
    const char *config;
    const char *accel;

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return;
    key_info(index, &label, &command, &config, &accel);
    keyCapture = index;
    fill_span(
            keyPrompt,
            160,
            "Press the new keys for ",
            label,
            ". Escape cancels.");
    show_key_note();
}

int Ui::take_key(const char *accel, int escape) {
    int index;

    if (keyCapture < 0)
        return 0;
    index = keyCapture;
    keyCapture = -1;
    keyPrompt[0] = 0;
    if (escape != 0) {
        show_key_note();
        return 1;
    }
    if (accel == nullptr)
        accel = "";
    assign_key(index, accel);
    return 1;
}

int Ui::assign_key(int index, const char *accel) {
    char next[64];
    char other[64];
    int i;

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return 0;
    if (mainWindow == nullptr)
        return 0;
    if (accel == nullptr)
        accel = "";
    if (mainWindow->normalize_accel(accel, next, 64) == 0) {
        text_copy(keyWarn, 160, "That shortcut is not valid.");
        show_key_note();
        return 0;
    }
    i = 0;
    while (i < EDITOR_KEY_COUNT) {
        if (i != index && next[0] != 0) {
            int same;

            same = mainWindow->normalize_accel(
                    keyAccel[i],
                    other,
                    64);
            if (same == 1 && text_same(next, other) == 1) {
                const char *label;
                const char *command;
                const char *config;
                const char *saved;

                key_info(
                        i,
                        &label,
                        &command,
                        &config,
                        &saved);
                fill_span(
                        keyWarn,
                        160,
                        label,
                        " already uses ",
                        other);
                add_dot(keyWarn, 160);
                show_key_note();
                return 0;
            }
        }
        i = i + 1;
    }
    text_copy(keyAccel[index], 64, next);
    if (keyButton[index] != nullptr) {
        button_text(next, other, 64);
        keyButton[index]->set_label(other);
    }
    keyWarn[0] = 0;
    show_key_note();
    apply_settings();
    return 1;
}

void Ui::read_keys(void) {
    char next[EDITOR_KEY_COUNT][64];
    char shown[64];
    int n;
    int i;

    keyCapture = -1;
    keyPrompt[0] = 0;
    keyWarn[0] = 0;
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        const char *text;

        text = keyAccel[n];
        if (keyButton[n] != nullptr)
            text = keyButton[n]->label();
        if (text_same(text, "none") == 1)
            text = "";
        if (mainWindow == nullptr
                || mainWindow->normalize_accel(
                        text,
                        next[n],
                        64) == 0)
            text_copy(next[n], 64, keyAccel[n]);
        n = n + 1;
    }
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        int clash;

        clash = -1;
        i = 0;
        while (i < n) {
            if (next[n][0] != 0
                    && text_same(next[n], next[i]) == 1)
                clash = i;
            i = i + 1;
        }
        if (clash >= 0) {
            const char *label;
            const char *command;
            const char *config;
            const char *accel;
            int kept;

            key_info(
                    clash,
                    &label,
                    &command,
                    &config,
                    &accel);
            fill_span(
                    keyWarn,
                    160,
                    label,
                    " already uses ",
                    next[clash]);
            add_dot(keyWarn, 160);
            kept = 0;
            if (mainWindow != nullptr)
                kept = mainWindow->normalize_accel(
                        keyAccel[n],
                        next[n],
                        64);
            if (kept == 0)
                next[n][0] = 0;
            i = 0;
            while (i < n) {
                if (next[n][0] != 0
                        && text_same(next[n], next[i]) == 1)
                    next[n][0] = 0;
                i = i + 1;
            }
        }
        n = n + 1;
    }
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        text_copy(keyAccel[n], 64, next[n]);
        if (keyButton[n] != nullptr) {
            button_text(keyAccel[n], shown, 64);
            keyButton[n]->set_label(shown);
        }
        n = n + 1;
    }
    show_key_note();
}

static void search_flags(
        int match,
        int word,
        int scope,
        int back,
        bool *matchCase,
        bool *whole,
        bool *inSel,
        bool *backward) {
    *matchCase = false;
    *whole = false;
    *inSel = false;
    *backward = false;
    if (match != 0)
        *matchCase = true;
    if (word != 0)
        *whole = true;
    if (scope != 0)
        *inSel = true;
    if (back != 0)
        *backward = true;
}

void Ui::find_query(const char *query) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;
    bool wrap;

    if (query == nullptr)
        query = "";
    text_copy(searchText, 256, query);
    if (searchEntry != nullptr)
        searchEntry->set_text(searchText);
    if (searchText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    wrap = false;
    if (searchWrap != 0)
        wrap = true;
    buffer->find_next(
            searchText,
            matchCase,
            whole,
            inSel,
            backward,
            wrap);
    refresh();
}

void Ui::find_again(void) {
    if (searchEntry != nullptr)
        text_copy(searchText, 256, searchEntry->text());
    find_query(searchText);
}

void Ui::replace_query(const char *query, const char *repl) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;
    bool wrap;

    if (query == nullptr)
        query = "";
    if (repl == nullptr)
        repl = "";
    text_copy(replaceText, 256, query);
    text_copy(withText, 256, repl);
    if (replaceFind != nullptr)
        replaceFind->set_text(replaceText);
    if (replaceWith != nullptr)
        replaceWith->set_text(withText);
    if (replaceText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    wrap = false;
    if (searchWrap != 0)
        wrap = true;
    buffer->replace_next(
            replaceText,
            withText,
            matchCase,
            whole,
            inSel,
            backward,
            wrap);
    refresh();
}

void Ui::replace_every(const char *query, const char *repl) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;

    if (query == nullptr)
        query = "";
    if (repl == nullptr)
        repl = "";
    text_copy(replaceText, 256, query);
    text_copy(withText, 256, repl);
    if (replaceText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    (void)backward;
    buffer->replace_all(
            replaceText,
            withText,
            matchCase,
            whole,
            inSel);
    refresh();
}

void Ui::replace_again(void) {
    if (replaceFind != nullptr)
        text_copy(replaceText, 256, replaceFind->text());
    if (replaceWith != nullptr)
        text_copy(withText, 256, replaceWith->text());
    replace_query(replaceText, withText);
}

void Ui::replace_all_again(void) {
    if (replaceFind != nullptr)
        text_copy(replaceText, 256, replaceFind->text());
    if (replaceWith != nullptr)
        text_copy(withText, 256, replaceWith->text());
    replace_every(replaceText, withText);
}

void Ui::hide_search(void) {
    if (searchDialog == nullptr)
        return;
    searchDialog->set_visible(false);
}

void Ui::hide_replace(void) {
    if (replaceDialog == nullptr)
        return;
    replaceDialog->set_visible(false);
}

void Ui::show_search(void) {
    Box *box;
    Label *label;

    if (searchDialog == nullptr) {
        searchDialog = new Dialog("Search");
        searchDialog->set_transient(mainWindow);
        box = new Box(GTK_VERTICAL, 8);
        label = new Label("Find");
        searchEntry = new Entry(searchText);
        box->append((Widget *)label);
        box->append((Widget *)searchEntry);
        searchDialog->set_content((Widget *)box);
        searchDialog->add_button("Find", 2);
        searchDialog->add_button("Close", 1);
        searchDialog->on_response(ui_search_response, nullptr);
    }
    if (searchEntry != nullptr)
        searchEntry->set_text(searchText);
    searchDialog->present();
}

void Ui::show_replace(void) {
    Box *box;
    Label *findLabel;
    Label *withLabel;

    if (replaceDialog == nullptr) {
        replaceDialog = new Dialog("Replace");
        replaceDialog->set_transient(mainWindow);
        box = new Box(GTK_VERTICAL, 8);
        findLabel = new Label("Find");
        withLabel = new Label("Replace with");
        replaceFind = new Entry(replaceText);
        replaceWith = new Entry(withText);
        box->append((Widget *)findLabel);
        box->append((Widget *)replaceFind);
        box->append((Widget *)withLabel);
        box->append((Widget *)replaceWith);
        replaceDialog->set_content((Widget *)box);
        replaceDialog->add_button("Replace", 2);
        replaceDialog->add_button("Replace All", 3);
        replaceDialog->add_button("Close", 1);
        replaceDialog->on_response(
                ui_replace_response,
                nullptr);
    }
    if (replaceFind != nullptr)
        replaceFind->set_text(replaceText);
    if (replaceWith != nullptr)
        replaceWith->set_text(withText);
    replaceDialog->present();
}

static int safe_color(const char *text) {
    long i;
    char ch;

    if (text == nullptr || text[0] == 0)
        return 0;
    i = 0;
    while (text[i] != 0) {
        if (i > 30)
            return 0;
        ch = text[i];
        if (ch >= 'a' && ch <= 'z') {
            i = i + 1;
            continue;
        }
        if (ch >= 'A' && ch <= 'Z') {
            i = i + 1;
            continue;
        }
        if (ch >= '0' && ch <= '9') {
            i = i + 1;
            continue;
        }
        if (ch == '#') {
            i = i + 1;
            continue;
        }
        return 0;
    }
    return 1;
}

