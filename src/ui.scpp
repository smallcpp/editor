Editor *Ui::editor(void) {
    return state;
}

void Ui::build(void) {
    const char *fileLabels[9];
    const char *editLabels[10];
    const char *searchLabels[6];
    const char *viewLabels[4];
    long fileMenu;
    long editMenu;
    Box *outer;

    app = new Application("org.smallcpp.Editor");
    mainWindow = new Window("editor");
    if (windowWidth >= 100 && windowHeight >= 100)
        mainWindow->set_default_size(
                windowWidth,
                windowHeight);
    else
        mainWindow->set_default_size(880, 640);
    mainWindow->on_resize(ui_resized, nullptr);
    mainWindow->on_active(ui_window_active, nullptr);
    mainWindow->on_close_request(ui_close, nullptr);
    menuBar = new MenuBar();
    fileLabels[0] = "New";
    fileLabels[1] = "Open";
    fileLabels[2] = "Open Recent";
    fileLabels[3] = "Save";
    fileLabels[4] = "Save As";
    fileLabels[5] = "Save All";
    fileLabels[6] = "Close";
    fileLabels[7] = "Close All";
    fileLabels[8] = "Quit";
    searchLabels[0] = "Search";
    searchLabels[1] = "Replace";
    searchLabels[2] = "Reverse";
    searchLabels[3] = "Whole word";
    searchLabels[4] = "Match case";
    searchLabels[5] = "Wrap";
    viewLabels[0] = "Whitespace";
    viewLabels[1] = "Line ends";
    viewLabels[2] = "Indent stops";
    viewLabels[3] = "Remember files";
    editLabels[0] = "Undo";
    editLabels[1] = "Redo";
    editLabels[2] = "Cut";
    editLabels[3] = "Copy";
    editLabels[4] = "Paste";
    editLabels[5] = "Indent";
    editLabels[6] = "Unindent";
    editLabels[7] = "Comment";
    editLabels[8] = "Block comment";
    editLabels[9] = "Settings";
    fileMenu = menuBar->add_menu(
            "File",
            fileLabels,
            9,
            ui_menu,
            nullptr);
    editMenu = menuBar->add_menu(
            "Edit",
            editLabels,
            10,
            ui_menu,
            nullptr);
    searchMenu = menuBar->add_menu(
            "Search",
            searchLabels,
            6,
            ui_menu,
            nullptr);
    viewMenu = menuBar->add_menu(
            "View",
            viewLabels,
            4,
            ui_menu,
            nullptr);
    menuBar->set_separator(fileMenu, 3);
    menuBar->set_separator(fileMenu, 6);
    menuBar->set_separator(fileMenu, 8);
    menuBar->set_separator(editMenu, 2);
    menuBar->set_separator(editMenu, 5);
    menuBar->set_separator(editMenu, 9);
    menuBar->set_separator(searchMenu, 2);
    documentsMenu = menuBar->add_menu(
            "Documents",
            nullptr,
            0,
            ui_doc,
            nullptr);
    outer = new Box(GTK_VERTICAL, 0);
    outer->append((Widget *)menuBar);
    book = new Notebook();
    book->set_scrollable(true);
    book->add_css("tab { border: 1px solid #222222; }");
    book->add_css("tab { margin: 2px; padding: 2px 6px; }");
    book->add_css("tab { background-color: #f4f4f4; }");
    book->add_css("tab:checked { background-color: #ffffff; }");
    book->on_switch_page(ui_switched, nullptr);
    book->set_v_expand(true);
    status = new Label("editor");
    outer->append((Widget *)book);
    outer->append((Widget *)status);
    mainWindow->set_child((Widget *)outer);
    bind_keys();
    push_options();
    files = new FileDialog();
    files->set_parent(mainWindow);
    fonts = new FontDialog();
    colors = new ColorDialog();
    choiceDialog = new Dialog("Confirm");
    choiceDialog->set_transient(mainWindow);
    choiceDialog->add_button("Save", EDITOR_SAVE);
    choiceDialog->add_button("Discard", EDITOR_DISCARD);
    choiceDialog->add_button("Cancel", EDITOR_CANCEL);
    choiceDialog->on_response(ui_choice_response, nullptr);
    dirtyDialog = new Dialog("Save changes?");
    dirtyDialog->set_transient(mainWindow);
    dirtyDialog->add_button("Save all", EDITOR_SAVE);
    dirtyDialog->add_button("Discard all", EDITOR_DISCARD);
    dirtyDialog->add_button("Cancel", EDITOR_CANCEL);
    dirtyDialog->on_response(ui_choice_response, nullptr);
    show_recent();
}

void Ui::prepare(void) {
    int named;

    if (app != nullptr)
        return;
    named = 0;
    if (state->count() > 1)
        named = 1;
    if (state->count() == 1
            && state->at(0)->untitled() == 0)
        named = 1;
    build();
    if (named == 0 && rememberFiles == 1 && openCount > 0)
        restore_files();
    else
        note_loaded();
    refresh();
}

MapColumn::MapColumn(void *owner, long index) : Widget() {
    void (*draw)(void *, void *, int, int, void *);
    void (*pressed)(void *, int, double, double, void *);
    void *click;

    this->owner = owner;
    page = index;
    pixels = 0;
    wide = 0;
    hooked = 0;
    adjust = nullptr;
    native = gtk_drawing_area_new();
    set_width_request(MAP_WIDTH);
    set_v_expand(true);
    set_h_expand(false);
    draw = map_draw;
    gtk_drawing_area_set_draw_func(
            native,
            (void *)draw,
            (void *)this,
            nullptr);
    click = gtk_gesture_click_new();
    pressed = map_pressed;
    g_signal_connect_data(
            click,
            "pressed",
            (void *)pressed,
            (void *)this,
            nullptr,
            0);
    gtk_widget_add_controller(native, click);
}

void MapColumn::redraw(void) {
    if (native == nullptr)
        return;
    gtk_widget_queue_draw(native);
}

void MapColumn::watch(void *view) {
    void (*typed)(void *, void *);
    void *next;

    if (view == nullptr || hooked != 0)
        return;
    next = gtk_scrollable_get_vadjustment(view);
    if (next == nullptr)
        return;
    adjust = next;
    typed = map_scrolled;
    g_signal_connect_data(
            adjust,
            "value-changed",
            (void *)typed,
            (void *)this,
            nullptr,
            0);
    hooked = 1;
}

void MapColumn::note_size(long width, long height) {
    if (width < 0)
        width = 0;
    if (height < 0)
        height = 0;
    wide = width;
    pixels = height;
}

long MapColumn::drawn_height(void) {
    return pixels;
}

long MapColumn::drawn_width(void) {
    return wide;
}

void Ui::redraw_map(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].map == nullptr)
        return;
    if (pages[index].view != nullptr)
        pages[index].map->watch(
                pages[index].view->native);
    pages[index].map->redraw();
}

void Ui::view_span(
        long index,
        long *first,
        long *count) {
    int rect[4];
    long words[12];
    long lines;
    long topLine;
    long endLine;
    int at;

    if (first != nullptr)
        *first = 0;
    if (count != nullptr)
        *count = 1;
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    if (state == nullptr || state->at(index) == nullptr)
        return;
    if (state->at(index)->buffer() == nullptr)
        return;
    lines = state->at(index)->buffer()->line_count();
    if (lines < 1)
        lines = 1;
    if (count != nullptr)
        *count = lines;
    if (gtk_widget_get_mapped(
                pages[index].view->native) == 0)
        return;
    rect[0] = 0;
    rect[1] = 0;
    rect[2] = 0;
    rect[3] = 0;
    gtk_text_view_get_visible_rect(
            pages[index].view->native,
            (void *)rect);
    if (rect[3] <= 0)
        return;
    at = 0;
    gtk_text_view_get_line_at_y(
            pages[index].view->native,
            (void *)words,
            rect[1],
            &at);
    topLine = gtk_text_iter_get_line((void *)words);
    at = 0;
    gtk_text_view_get_line_at_y(
            pages[index].view->native,
            (void *)words,
            rect[1] + rect[3] - 1,
            &at);
    endLine = gtk_text_iter_get_line((void *)words);
    if (topLine < 0)
        topLine = 0;
    if (endLine < topLine)
        endLine = topLine;
    if (endLine >= lines)
        endLine = lines - 1;
    if (first != nullptr)
        *first = topLine;
    if (count != nullptr)
        *count = endLine - topLine + 1;
}

void Ui::paint_map(
        MapColumn *column,
        void *cr,
        int width,
        int height) {
    Document *doc;
    const char *text;
    int *rowInk;
    long lines;
    long first;
    long count;
    long top;
    long band;
    long line;
    long y;
    long bar;
    int ink;

    if (column == nullptr || cr == nullptr)
        return;
    if (width < 1 || height < 1)
        return;
    cairo_set_source_rgba(cr, 0.93, 0.93, 0.94, 1.0);
    cairo_rectangle(cr, 0, 0, (double)width, (double)height);
    cairo_fill(cr);
    if (state == nullptr)
        return;
    doc = state->at(column->page);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    text = doc->buffer()->text();
    lines = doc->buffer()->line_count();
    if (lines < 1)
        lines = 1;
    rowInk = new int[height];
    y = 0;
    while (y < height) {
        long from;
        long to;

        from = y * lines / (long)height;
        if (y == (long)height - 1)
            to = lines;
        else
            to = (y + 1) * lines / (long)height;
        if (to <= from)
            to = from + 1;
        if (from < 0)
            from = 0;
        if (to > lines)
            to = lines;
        ink = 0;
        line = from;
        while (line < to) {
            int got;

            got = map_ink_at(text, line);
            if (got > ink)
                ink = got;
            line = line + 1;
        }
        rowInk[y] = ink;
        y = y + 1;
    }
    y = 0;
    while (y < height) {
        ink = rowInk[y];
        if (ink > 0) {
            bar = 4 + (long)ink * (width - 8) / MAP_INK;
            if (bar < 2)
                bar = 2;
            if (bar > width - 4)
                bar = width - 4;
            cairo_set_source_rgba(
                    cr,
                    0.35,
                    0.35,
                    0.38,
                    1.0);
            cairo_rectangle(
                    cr,
                    2,
                    (double)y,
                    (double)bar,
                    1);
            cairo_fill(cr);
        }
        y = y + 1;
    }
    view_span(column->page, &first, &count);
    map_place(lines, (long)height, first, count, &top, &band);
    cairo_set_source_rgba(cr, 0.25, 0.45, 0.75, 0.28);
    cairo_rectangle(
            cr,
            0,
            (double)top,
            (double)width,
            (double)band);
    cairo_fill(cr);
}

long Ui::map_height(void) {
    long index;

    if (state == nullptr)
        return 0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return 0;
    if (pages[index].map == nullptr)
        return 0;
    return pages[index].map->drawn_height();
}

long Ui::map_top(void) {
    long index;
    long lines;
    long height;
    long first;
    long count;
    long top;
    long band;

    if (state == nullptr)
        return 0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return 0;
    if (state->at(index) == nullptr)
        return 0;
    if (state->at(index)->buffer() == nullptr)
        return 0;
    height = map_height();
    if (height < 1)
        return 0;
    lines = state->at(index)->buffer()->line_count();
    view_span(index, &first, &count);
    map_place(lines, height, first, count, &top, &band);
    return top;
}

long Ui::map_band(void) {
    long index;
    long lines;
    long height;
    long first;
    long count;
    long top;
    long band;

    if (state == nullptr)
        return 0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return 0;
    if (state->at(index) == nullptr)
        return 0;
    if (state->at(index)->buffer() == nullptr)
        return 0;
    height = map_height();
    if (height < 1)
        return 0;
    lines = state->at(index)->buffer()->line_count();
    view_span(index, &first, &count);
    map_place(lines, height, first, count, &top, &band);
    return band;
}

int Ui::map_ink(long line) {
    Document *doc;

    if (state == nullptr)
        return 0;
    doc = state->active();
    if (doc == nullptr || doc->buffer() == nullptr)
        return 0;
    return map_ink_at(doc->buffer()->text(), line);
}

void Ui::map_click(long y) {
    long index;
    long lines;
    long height;
    long line;

    if (state == nullptr)
        return;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (state->at(index) == nullptr)
        return;
    if (state->at(index)->buffer() == nullptr)
        return;
    lines = state->at(index)->buffer()->line_count();
    height = map_height();
    if (height < 1)
        height = 1;
    line = map_line(lines, height, y);
    scroll_view(line);
    redraw_map(index);
}

void Ui::add_page(long index) {
    Document *doc;
    char title[256];
    ScrolledWindow *scroll;

    doc = state->at(index);
    if (doc == nullptr)
        return;
    pages[index].buffer = new TextBuffer();
    pages[index].view = new TextView(pages[index].buffer);
    pages[index].view->set_monospace(true);
    pages[index].view->set_editable(true);
    pages[index].view->set_line_numbers(true);
    pages[index].userDepth = 0;
    pages[index].pendingSync = 0;
    pages[index].pendingIdle = 0;
    scroll = new ScrolledWindow();
    scroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    scroll->set_child((Widget *)pages[index].view);
    scroll->set_h_expand(true);
    scroll->set_v_expand(true);
    pages[index].scroll = scroll;
    pages[index].map = new MapColumn((void *)this, index);
    pages[index].map->watch(pages[index].view->native);
    g_signal_connect_data(
            pages[index].view->native,
            "map",
            (void *)map_mapped,
            (void *)pages[index].map,
            nullptr,
            0);
    pages[index].tags = 0;
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    applying = 0;
    pages[index].buffer->on_changed(
            ui_changed,
            (void *)&refs[index]);
    g_signal_connect_data(
            pages[index].buffer->native,
            "begin-user-action",
            (void *)ui_user_begin,
            (void *)&refs[index],
            nullptr,
            0);
    g_signal_connect_data(
            pages[index].buffer->native,
            "end-user-action",
            (void *)ui_user_end,
            (void *)&refs[index],
            nullptr,
            0);
    pages[index].view->on_move_cursor(
            ui_moved,
            (void *)&refs[index]);
    g_signal_connect_data(
            pages[index].buffer->native,
            "mark-set",
            (void *)ui_mark,
            (void *)&refs[index],
            nullptr,
            0);
    text_copy(title, 256, doc->title());
    {
        Box *row;

        row = new Box(GTK_HORIZONTAL, 0);
        row->set_h_expand(true);
        row->set_v_expand(true);
        row->append((Widget *)scroll);
        row->append((Widget *)pages[index].map);
        book->append_page((Widget *)row, title);
    }
    pageCount = pageCount + 1;
    mount_tab(index, title);
    apply_view(index);
    highlight(index);
    place_cursor(index);
    paint_line(index);
}

void Ui::rebuild(void) {
    long i;
    long n;
    long want;

    want = state->index();
    building = 1;
    while (pageCount > 0) {
        book->remove_page(0);
        pageCount = pageCount - 1;
    }
    i = 0;
    while (i < EDITOR_PAGES) {
        pages[i].buffer = nullptr;
        pages[i].view = nullptr;
        pages[i].scroll = nullptr;
        pages[i].map = nullptr;
        pages[i].tags = 0;
        pages[i].userDepth = 0;
        pages[i].pendingSync = 0;
        pages[i].pendingIdle = 0;
        tabTitle[i] = nullptr;
        i = i + 1;
    }
    n = state->count();
    if (n > EDITOR_PAGES)
        n = EDITOR_PAGES;
    i = 0;
    while (i < n) {
        add_page(i);
        i = i + 1;
    }
    building = 0;
    if (pageCount == 0)
        return;
    if (want < 0 || want >= pageCount)
        want = 0;
    state->set_index(want);
    book->set_current_page(want);
}

void Ui::place_cursor(long index) {
    Document *doc;
    TextIter *at;
    TextIter *bound;
    long line;
    long column;
    long line2;
    long column2;
    long lo;
    long hi;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    if (doc->buffer()->has_selection() == false) {
        doc->buffer()->line_column_at(
                doc->buffer()->cursor_offset(),
                &line,
                &column);
        at = new TextIter(line, column);
        pages[index].buffer->place_cursor(at);
        if (pages[index].view != nullptr)
            pages[index].view->scroll_to(line, column);
        return;
    }
    lo = doc->buffer()->sel_lo();
    hi = doc->buffer()->sel_hi();
    doc->buffer()->line_column_at(lo, &line, &column);
    doc->buffer()->line_column_at(hi, &line2, &column2);
    at = new TextIter(line, column);
    bound = new TextIter(line2, column2);
    pages[index].buffer->select_range(at, bound);
    doc->buffer()->line_column_at(
            doc->buffer()->cursor_offset(),
            &line,
            &column);
    if (pages[index].view != nullptr)
        pages[index].view->scroll_to(line, column);
}

void Ui::push_active(void) {
    long index;
    Document *doc;

    index = state->index();
    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->active();
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    retitle(index);
    if (text_same(
                pages[index].buffer->get_text(),
                doc->buffer()->text()) == 1) {
        place_cursor(index);
        paint_line(index);
        return;
    }
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    place_cursor(index);
    applying = 0;
    highlight(index);
    paint_line(index);
}

void Ui::take_selection(void) {
    TextBuffer *gtkBuf;
    TextIter *start;
    TextIter *end;
    Document *doc;
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    gtkBuf = pages[index].buffer;
    if (gtkBuf == nullptr)
        return;
    doc = state->active();
    if (doc == nullptr)
        return;
    start = new TextIter(0, 0);
    end = new TextIter(0, 0);
    if (gtkBuf->selection_bounds(start, end) == false)
        return;
    doc->buffer()->select_span(
            start->line() + 1,
            start->offset() + 1,
            end->line() + 1,
            end->offset() + 1);
}

static void seek_offset(
        const char *text,
        long n,
        long target,
        long *at,
        long *line,
        long *column) {
    int value;
    int step;

    if (target < *at) {
        *at = 0;
        *line = 0;
        *column = 0;
    }
    if (target > n)
        target = n;
    while (*at < target) {
        value = byte_at(text, *at);
        if (value == '\n') {
            *line = *line + 1;
            *column = 0;
            *at = *at + 1;
            continue;
        }
        step = utf8_len(value);
        if (*at + step > target) {
            *at = target;
            return;
        }
        *column = *column + 1;
        *at = *at + step;
    }
}

void Ui::highlight(long index) {
    Highlighter *scan;
    Document *doc;
    const char *text;
    long i;
    long byte;
    long line;
    long col;
    long line2;
    long col2;
    long n;
    TextIter *start;
    TextIter *end;
    const char *name;
    const char *color;
    Span *span;
    int kind;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    text = pages[index].buffer->get_text();
    n = text_length(text);
    if (n > 200000)
        return;
    text_position(text, n, &line2, &col2);
    start = new TextIter(0, 0);
    end = new TextIter(line2, col2);
    kind = SPAN_KEYWORD;
    while (kind <= SPAN_OPERATOR) {
        name = span_tag(kind);
        color = theme_color(
                themeConfig,
                doc->language(),
                name);
        pages[index].buffer->set_tag_foreground(
                name,
                color);
        {
            bool heavy;

            heavy = false;
            if (theme_bold(
                    themeConfig,
                    doc->language(),
                    name) == 1)
                heavy = true;
            pages[index].buffer->set_tag_bold(
                    name,
                    heavy);
        }
        if (n > 0)
            pages[index].buffer->remove_tag(
                    name,
                    start,
                    end);
        kind = kind + 1;
    }
    pages[index].tags = 1;
    scan = new Highlighter();
    scan->scan(text, doc->language());
    byte = 0;
    line = 0;
    col = 0;
    i = 0;
    while (i < scan->count()) {
        span = scan->at(i);
        seek_offset(text, n, span->start, &byte, &line, &col);
        line2 = line;
        col2 = col;
        seek_offset(text, n, span->end, &byte, &line, &col);
        start = new TextIter(line2, col2);
        end = new TextIter(line, col);
        name = span->tag;
        if (name != nullptr && name[0] != 0)
            pages[index].buffer->apply_tag(
                    name,
                    start,
                    end);
        i = i + 1;
    }
    paint_brackets(index);
}

static void paint_one(
        TextBuffer *buffer,
        const char *text,
        long n,
        long offset,
        const char *name) {
    long at;
    long line;
    long column;
    long line2;
    long column2;
    TextIter *start;
    TextIter *end;

    at = 0;
    line = 0;
    column = 0;
    seek_offset(
            text,
            n,
            offset,
            &at,
            &line,
            &column);
    line2 = line;
    column2 = column;
    seek_offset(
            text,
            n,
            offset + 1,
            &at,
            &line,
            &column);
    start = new TextIter(line2, column2);
    end = new TextIter(line, column);
    buffer->apply_tag(name, start, end);
}

static void prepare_bracket_tag(
        TextBuffer *buffer,
        const EditorConfig *theme,
        const char *language,
        const char *name,
        const char *back,
        TextIter *start,
        TextIter *end,
        int clear) {
    buffer->set_tag_foreground(
            name,
            theme_color(theme, language, name));
    {
        bool heavy;

        heavy = false;
        if (theme_bold(theme, language, name) == 1)
            heavy = true;
        buffer->set_tag_bold(name, heavy);
    }
    buffer->set_tag_text_background(
            name,
            theme_color(theme, language, back));
    if (clear == 1)
        buffer->remove_tag(name, start, end);
}

void Ui::paint_brackets(long index) {
    Document *doc;
    const char *text;
    const char *language;
    const char *name;
    long n;
    long here;
    long other;
    long line;
    long column;
    TextIter *start;
    TextIter *end;
    int clear;
    int matched;

    if (bracketPainting == 1)
        return;
    bracketPainting = 1;
    if (index < 0 || index >= pageCount) {
        bracketPainting = 0;
        return;
    }
    if (pages[index].buffer == nullptr) {
        bracketPainting = 0;
        return;
    }
    doc = state->at(index);
    if (doc == nullptr) {
        bracketPainting = 0;
        return;
    }
    text = pages[index].buffer->get_text();
    if (text == nullptr)
        text = "";
    n = text_length(text);
    language = doc->language();
    line = 0;
    column = 0;
    text_position(text, n, &line, &column);
    start = new TextIter(0, 0);
    end = new TextIter(line, column);
    clear = 0;
    if (n > 0)
        clear = 1;
    prepare_bracket_tag(
            pages[index].buffer,
            themeConfig,
            language,
            "brackets",
            "brackets-back",
            start,
            end,
            clear);
    prepare_bracket_tag(
            pages[index].buffer,
            themeConfig,
            language,
            "brackets-unmatched",
            "brackets-unmatched-back",
            start,
            end,
            clear);
    if (n > 200000) {
        bracketPainting = 0;
        return;
    }
    matched = match_bracket(
            text,
            language,
            doc->buffer()->cursor_offset(),
            &here,
            &other);
    if (matched == 0) {
        bracketPainting = 0;
        return;
    }
    if (other < 0)
        name = "brackets-unmatched";
    else
        name = "brackets";
    paint_one(
            pages[index].buffer,
            text,
            n,
            here,
            name);
    if (other >= 0)
        paint_one(
                pages[index].buffer,
                text,
                n,
                other,
                name);
    bracketPainting = 0;
}

void Ui::paint_status(void) {
    status->set_text(state->status());
}

void Ui::refresh(void) {
    long i;
    long want;

    want = state->index();
    if (pageCount != state->count())
        rebuild();
    else {
        push_active();
        if (book != nullptr
                && want >= 0
                && want < pageCount)
            book->set_current_page(want);
    }
    i = 0;
    while (i < pageCount) {
        retitle(i);
        paint_line(i);
        i = i + 1;
    }
    fill_documents();
    paint_status();
}

void Ui::show_main(void) {
    refresh();
    mainWindow->present();
    arm_tick();
    offer_recovery();
}

void Ui::show_choice(const char *title, int mode) {
    choiceMode = mode;
    choiceDialog->set_title(title);
    choiceDialog->present();
}

void Ui::handle(int code) {
    if (code == EDITOR_NEEDS_CHOICE) {
        show_dirty();
        return;
    }
    if (code == EDITOR_NEEDS_PATH
            || code == EDITOR_CHOOSE_SAVE) {
        if (files->pending != 0)
            return;
        files->set_title("Save");
        arm_dialog();
        files->save(ui_saved, nullptr);
        return;
    }
    if (code == EDITOR_CHOOSE_OPEN) {
        if (files->pending != 0)
            return;
        files->set_title("Open");
        arm_dialog();
        files->open(ui_opened, nullptr);
        return;
    }
    if (code == EDITOR_FAILED
            && text_same(state->error(), "overwrite") == 1) {
        show_choice("Overwrite the file?", 1);
        return;
    }
    mirror_pages();
    refresh();
}

static void missing_line(
        char *dest,
        long cap,
        const char *name,
        const char *suffix) {
    const char *prefix;
    long n;
    long i;

    prefix = "File \"";
    if (suffix == nullptr)
        suffix = "";
    n = 0;
    i = 0;
    if (name == nullptr)
        name = "";
    while (prefix[i] != 0 && n + 1 < cap) {
        dest[n] = prefix[i];
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (name[i] != 0 && n + 1 < cap) {
        dest[n] = name[i];
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (suffix[i] != 0 && n + 1 < cap) {
        dest[n] = suffix[i];
        n = n + 1;
        i = i + 1;
    }
    dest[n] = 0;
}

void Ui::open_recent(const char *path) {
    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0)
        return;
    if (file_exists(path) == 0) {
        show_missing(path);
        return;
    }
    open_path(path);
}

void Ui::show_missing(const char *path) {
    void *parent;
    void (*typed)(void *, int, void *);
    const char *base;

    if (path == nullptr || path[0] == 0)
        return;
    base = path_base(path);
    if (base == nullptr || base[0] == 0)
        base = path;
    missing_line(
            missingNote,
            EDITOR_PATH,
            base,
            "\" not found.");
    parent = nullptr;
    if (mainWindow != nullptr)
        parent = mainWindow->native;
    missingNative = gtk_message_dialog_new(
            parent,
            3,
            3,
            2,
            "%s",
            missingNote);
    if (missingNative == nullptr)
        return;
    typed = ui_message_response;
    g_signal_connect_data(
            missingNative,
            "response",
            (void *)typed,
            nullptr,
            nullptr,
            0);
    missingOpen = 1;
    gtk_window_present(missingNative);
}

void Ui::answer_missing(int response) {
    void *dialog;

    (void)response;
    missingOpen = 0;
    dialog = missingNative;
    missingNative = nullptr;
    if (dialog != nullptr)
        gtk_widget_set_visible(dialog, 0);
}

int Ui::missing_prompt(void) {
    return missingOpen;
}

const char *Ui::missing_text(void) {
    return missingNote;
}

void Ui::queue_recover(const char *path) {
    char dir[EDITOR_PATH];
    char leaf[128];
    char full[EDITOR_PATH];
    long i;
    Document *doc;

    if (path == nullptr || path[0] == 0)
        return;
    if (recoverCount >= EDITOR_RECENT_MAX)
        return;
    if (file_exists(path) == 1)
        return;
    i = 0;
    while (i < state->count()) {
        doc = state->at(i);
        if (doc != nullptr
                && doc->untitled() == 0
                && text_same(doc->path(), path) == 1)
            return;
        i = i + 1;
    }
    i = 0;
    while (i < recoverCount) {
        if (text_same(recoverPath[i], path) == 1)
            return;
        i = i + 1;
    }
    if (recovery_leaf_for(path, leaf, 128) == 0)
        return;
    if (recovery_dir(dir, EDITOR_PATH) == 0)
        return;
    path_join(full, EDITOR_PATH, dir, leaf);
    if (full[0] == 0 || file_exists(full) == 0)
        return;
    text_copy(
            recoverPath[recoverCount],
            EDITOR_PATH,
            path);
    recoverCount = recoverCount + 1;
}

void Ui::show_next_recover(void) {
    const char *base;
    const char *path;

    if (recoverAt < 0 || recoverAt >= recoverCount) {
        recoverOpen = 0;
        return;
    }
    path = recoverPath[recoverAt];
    base = path_base(path);
    if (base == nullptr || base[0] == 0)
        base = path;
    missing_line(
            recoverNote,
            EDITOR_PATH,
            base,
            "\" is gone.");
    if (recoverDialog == nullptr) {
        recoverDialog = new Dialog("Recover file");
        recoverDialog->set_transient(mainWindow);
        recoverLabel = new Label("");
        recoverDialog->set_content((Widget *)recoverLabel);
        recoverDialog->add_button("Open", 1);
        recoverDialog->add_button("Ignore", 2);
        recoverDialog->on_response(
                ui_recover_response,
                nullptr);
    }
    recoverLabel->set_text(recoverNote);
    recoverOpen = 1;
    recoverDialog->present();
}

void Ui::show_restored(const char *path) {
    void *parent;
    void (*typed)(void *, int, void *);
    const char *base;

    base = path_base(path);
    if (base == nullptr || base[0] == 0)
        base = path;
    missing_line(
            restoredNote,
            EDITOR_PATH,
            base,
            "\" was restored.");
    parent = nullptr;
    if (mainWindow != nullptr)
        parent = mainWindow->native;
    restoredNative = gtk_message_dialog_new(
            parent,
            3,
            3,
            2,
            "%s",
            restoredNote);
    restoredOpen = 1;
    if (restoredNative == nullptr)
        return;
    typed = ui_restored_response;
    g_signal_connect_data(
            restoredNative,
            "response",
            (void *)typed,
            nullptr,
            nullptr,
            0);
    gtk_window_present(restoredNative);
}

void Ui::offer_recovery(void) {
    int i;

    if (leaving == 1 || state == nullptr)
        return;
    if (recoveryOn == 0)
        return;
    if (recoverOpen != 0 || restoredOpen != 0)
        return;
    recoverCount = 0;
    recoverAt = 0;
    i = 0;
    while (i < recentUsed && i < recentCount) {
        queue_recover(recentPath[i]);
        i = i + 1;
    }
    i = 0;
    while (i < openCount && i < EDITOR_OPEN_MAX) {
        queue_recover(openPath[i]);
        i = i + 1;
    }
    show_next_recover();
}

static void drop_recovery_copy(const char *path) {
    char dir[EDITOR_PATH];
    char leaf[128];
    char full[EDITOR_PATH];

    if (path == nullptr || path[0] == 0)
        return;
    if (recovery_dir(dir, EDITOR_PATH) == 0)
        return;
    if (recovery_leaf_for(path, leaf, 128) == 0)
        return;
    path_join(full, EDITOR_PATH, dir, leaf);
    if (full[0] != 0)
        unlink(full);
}

void Ui::answer_recovery(int response) {
    char path[EDITOR_PATH];
    char dir[EDITOR_PATH];
    char leaf[128];
    char full[EDITOR_PATH];
    char *raw;
    long n;
    const char *io;
    int open;

    if (recoverOpen == 0)
        return;
    if (recoverAt < 0 || recoverAt >= recoverCount) {
        recoverOpen = 0;
        return;
    }
    open = 0;
    if (response == 1)
        open = 1;
    text_copy(path, EDITOR_PATH, recoverPath[recoverAt]);
    recoverAt = recoverAt + 1;
    recoverOpen = 0;
    if (recoverDialog != nullptr)
        recoverDialog->set_visible(false);
    if (open == 0) {
        drop_recovery_copy(path);
        show_next_recover();
        return;
    }
    io = "";
    n = 0;
    raw = nullptr;
    if (recovery_dir(dir, EDITOR_PATH) == 1
            && recovery_leaf_for(path, leaf, 128) == 1) {
        path_join(full, EDITOR_PATH, dir, leaf);
        if (full[0] != 0)
            raw = read_file(full, &n, &io);
    }
    if (raw != nullptr && state != nullptr) {
        state->open_recovery(path, raw);
        refresh();
    }
    show_restored(path);
}

int Ui::recovery_prompt(void) {
    return recoverOpen;
}

const char *Ui::recovery_text(void) {
    return recoverNote;
}

void Ui::answer_restored(int response) {
    void *dialog;

    (void)response;
    if (restoredOpen == 0)
        return;
    restoredOpen = 0;
    dialog = restoredNative;
    restoredNative = nullptr;
    if (dialog != nullptr)
        gtk_widget_set_visible(dialog, 0);
    show_next_recover();
}

int Ui::restored_prompt(void) {
    return restoredOpen;
}

const char *Ui::restored_text(void) {
    return restoredNote;
}

void Ui::open_path(const char *path) {
    int code;

    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0)
        return;
    note_folder(path);
    code = state->open_file(path);
    if (code == EDITOR_OK)
        note_recent(path);
    handle(code);
}

void Ui::save_path(const char *path) {
    int code;

    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0) {
        finish_choice(state->answer(EDITOR_CANCEL));
        return;
    }
    note_folder(path);
    pendingPath = new String();
    pendingPath->append(path);
    code = state->provide_path(path);
    if (code == EDITOR_OK)
        note_recent(path);
    finish_choice(code);
}

void Ui::finish_choice(int code) {
    if (code != EDITOR_NEEDS_CHOICE
            && dirtyDialog != nullptr) {
        dirtyOpen = 0;
        dirtyDialog->set_visible(false);
    }
    handle(code);
    if (state->quit_ready() == 1)
        leave();
}

void Ui::choice(int response) {
    if (choiceMode == 1) {
        choiceMode = 0;
        if (response == EDITOR_SAVE) {
            state->allow_overwrite(1);
            handle(state->provide_path(
                    pendingPath->c_str()));
            return;
        }
        handle(state->answer(EDITOR_CANCEL));
        return;
    }
    if (response == EDITOR_CANCEL) {
        if (dirtyDialog != nullptr)
            dirtyDialog->set_visible(false);
        finish_choice(state->answer(EDITOR_CANCEL));
        return;
    }
    if (response == EDITOR_SAVE) {
        finish_choice(state->save_every());
        return;
    }
    if (response == EDITOR_DISCARD) {
        finish_choice(state->discard_every());
        return;
    }
    finish_choice(state->answer(response));
}

void Ui::user_begin(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].userDepth = pages[index].userDepth + 1;
}

void Ui::user_end(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].userDepth > 0)
        pages[index].userDepth =
                pages[index].userDepth - 1;
    if (pages[index].userDepth == 0)
        flush_sync(index);
}

void Ui::flush_sync(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].pendingIdle = 0;
    if (pages[index].pendingSync == 0)
        return;
    pages[index].pendingSync = 0;
    sync_view(index);
}

void Ui::mirror_pages(void) {
    long i;

    if (state == nullptr)
        return;
    i = 0;
    while (i < pageCount && i < state->count()) {
        Document *doc;
        const char *shown;

        doc = state->at(i);
        if (doc != nullptr
                && pages[i].buffer != nullptr) {
            shown = pages[i].buffer->get_text();
            if (shown == nullptr)
                shown = "";
            if (text_same(
                        shown,
                        doc->buffer()->text()) == 0)
                show_buffer(i);
        }
        i = i + 1;
    }
}

void Ui::sync_view(long index) {
    Document *doc;
    String *want;
    String *have;
    const char *wantRaw;
    const char *haveRaw;
    long wantN;
    long haveN;
    long prefix;
    long wantEnd;
    long haveEnd;
    long line;
    long column;
    long line2;
    long column2;
    TextIter *at;
    TextIter *bound;
    String *bit;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    want = new String();
    want->append(doc->buffer()->text());
    have = new String();
    have->append(pages[index].buffer->get_text());
    wantRaw = want->c_str();
    haveRaw = have->c_str();
    if (text_same(wantRaw, haveRaw) == 1) {
        place_cursor(index);
        return;
    }
    wantN = want->size();
    haveN = have->size();
    prefix = 0;
    while (prefix < wantN
            && prefix < haveN
            && wantRaw[prefix] == haveRaw[prefix])
        prefix = prefix + 1;
    wantEnd = wantN;
    haveEnd = haveN;
    while (wantEnd > prefix
            && haveEnd > prefix
            && wantRaw[wantEnd - 1] == haveRaw[haveEnd - 1]) {
        wantEnd = wantEnd - 1;
        haveEnd = haveEnd - 1;
    }
    applying = 1;
    if (haveEnd > prefix) {
        text_position(haveRaw, prefix, &line, &column);
        text_position(haveRaw, haveEnd, &line2, &column2);
        at = new TextIter(line, column);
        bound = new TextIter(line2, column2);
        pages[index].buffer->delete_range(at, bound);
    }
    if (wantEnd > prefix) {
        bit = slice_text(wantRaw, prefix, wantEnd);
        text_position(wantRaw, prefix, &line, &column);
        at = new TextIter(line, column);
        pages[index].buffer->insert(at, bit->c_str());
    }
    applying = 0;
    place_cursor(index);
    highlight(index);
    paint_line(index);
}

void Ui::changed(long index) {
    Document *doc;
    const char *text;
    int extra;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    text = pages[index].buffer->get_text();
    extra = doc->buffer()->note_external(text);
    if (extra == 1) {
        pages[index].pendingSync = 1;
        if (pages[index].userDepth == 0
                && pages[index].pendingIdle == 0) {
            pages[index].pendingIdle = 1;
            g_idle_add(
                    (void *)ui_sync_idle,
                    (void *)&refs[index]);
        }
    } else
        highlight(index);
    retitle(index);
    paint_status();
    if (index == state->index())
        redraw_map(index);
}

void Ui::moved(long index, long line, long offset) {
    Document *doc;

    if (applying == 1)
        return;
    if (index < 0 || index >= state->count())
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    doc->buffer()->move_to(line + 1, offset + 1);
    paint_brackets(index);
    paint_line(index);
    paint_status();
}

void Ui::switched(long index) {
    long previous;

    if (building == 1)
        return;
    previous = state->index();
    if (saveOnTab == 1 && previous != index)
        save_quiet(previous);
    state->set_index(index);
    paint_status();
    redraw_map(index);
}

TextBuffer *Ui::view_buffer(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return nullptr;
    return pages[index].buffer;
}

const char *Ui::page_text(long index) {
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].buffer == nullptr)
        return "";
    return pages[index].buffer->get_text();
}

const char *Ui::line_number_text(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].view == nullptr)
        return "";
    return pages[index].view->line_number_text();
}

long Ui::gutter_line_y(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return -1;
    if (pages[index].view == nullptr)
        return -1;
    return pages[index].view->line_number_origin(line);
}

void Ui::scroll_view(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    pages[index].view->scroll_to(line, 0);
}

void Ui::hide_settings(void) {
    if (settingsDialog == nullptr)
        return;
    settingsDialog->set_visible(false);
}

static void minutes_text(char *dest, int value) {
    char digits[8];
    long n;
    long i;

    if (value < 1)
        value = 1;
    n = 0;
    while (value > 0 && n < 7) {
        digits[n] = (char)('0' + (value % 10));
        value = value / 10;
        n = n + 1;
    }
    i = 0;
    while (n > 0) {
        n = n - 1;
        dest[i] = digits[n];
        i = i + 1;
    }
    dest[i] = 0;
}

static void set_box(CheckButton *box, int on) {
    if (box == nullptr)
        return;
    if (on == 0)
        box->set_active(false);
    else
        box->set_active(true);
}

void Ui::sync_boxes(void) {
    long i;

    applying = 1;
    set_box(wrapCheck, searchWrap);
    set_box(backCheck, searchBack);
    set_box(wholeCheck, searchWhole);
    set_box(caseCheck, searchCase);
    set_box(spaceCheck, showSpace);
    set_box(endCheck, showEnds);
    set_box(stopCheck, showStops);
    set_box(rememberCheck, rememberFiles);
    set_box(saveTabCheck, saveOnTab);
    set_box(saveWinCheck, saveOnWindow);
    set_box(trimCheck, trimOn);
    set_box(newlineCheck, newlineOn);
    set_box(pathCheck, pathOn);
    set_box(recoverCheck, recoveryOn);
    if (recoverEntry != nullptr) {
        char shown[8];

        minutes_text(shown, recoveryMinutes);
        recoverEntry->set_text(shown);
    }
    if (keepEntry != nullptr) {
        char shown[8];

        minutes_text(shown, recoveryKeep);
        keepEntry->set_text(shown);
    }
    if (recentSpin != nullptr)
        recentSpin->set_value((double)recentCount);
    if (pathSpin != nullptr)
        pathSpin->set_value((double)pathDepth);
    applying = 0;
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::push_options(void) {
    applying = 1;
    if (menuBar != nullptr) {
        menuBar->set_check(searchMenu, 2, searchBack);
        menuBar->set_check(searchMenu, 3, searchWhole);
        menuBar->set_check(searchMenu, 4, searchCase);
        menuBar->set_check(searchMenu, 5, searchWrap);
        menuBar->set_check(viewMenu, 0, showSpace);
        menuBar->set_check(viewMenu, 1, showEnds);
        menuBar->set_check(viewMenu, 2, showStops);
        menuBar->set_check(viewMenu, 3, rememberFiles);
    }
    applying = 0;
    sync_boxes();
}

void Ui::set_option(const char *label, int on) {
    int value;

    if (applying == 1)
        return;
    if (label == nullptr)
        return;
    value = 0;
    if (on != 0)
        value = 1;
    if (text_same(label, "Wrap") == 1)
        searchWrap = value;
    if (text_same(label, "Reverse") == 1)
        searchBack = value;
    if (text_same(label, "Whole word") == 1)
        searchWhole = value;
    if (text_same(label, "Match case") == 1)
        searchCase = value;
    if (text_same(label, "Whitespace") == 1)
        showSpace = value;
    if (text_same(label, "Line ends") == 1)
        showEnds = value;
    if (text_same(label, "Indent stops") == 1)
        showStops = value;
    if (text_same(label, "Remember files") == 1)
        rememberFiles = value;
    if (text_same(label, "Save when a tab loses focus") == 1)
        saveOnTab = value;
    if (text_same(
                label,
                "Save when the window loses focus") == 1)
        saveOnWindow = value;
    if (text_same(
                label,
                "Trim trailing spaces on save") == 1) {
        trimOn = value;
        state->set_trim(value);
    }
    if (text_same(
                label,
                "Ensure newline at end of file") == 1) {
        newlineOn = value;
        state->set_newline(value);
    }
    if (text_same(
                label,
                "Show path in file tab") == 1) {
        if (value == 0)
            pathOn = 0;
        else
            pathOn = 1;
    }
    if (text_same(label, "Write recovery files") == 1) {
        recoveryOn = value;
        if (value != 0)
            recoveryMark = (long)time(nullptr);
    }
    push_options();
    apply_settings();
}

int Ui::shows_space(void) {
    return showSpace;
}

int Ui::shows_ends(void) {
    return showEnds;
}

int Ui::shows_stops(void) {
    return showStops;
}

int Ui::search_wrap(void) {
    return searchWrap;
}

void Ui::bind_keys(void) {
    int n;

    if (mainWindow == nullptr)
        return;
    mainWindow->clear_shortcuts();
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        const char *label;
        const char *command;
        const char *config;
        const char *accel;
        long menu;
        long item;

        key_info(n, &label, &command, &config, &accel);
        (void)command;
        (void)config;
        (void)accel;
        if (keyAccel[n][0] != 0
                && mainWindow->shortcut_ok(keyAccel[n]) == 1)
            mainWindow->add_shortcut(
                    keyAccel[n],
                    ui_key,
                    (void *)label);
        if (menuBar != nullptr
                && key_place(n, &menu, &item) == 1)
            menuBar->set_shortcut(menu, item, keyAccel[n]);
        n = n + 1;
    }
    mainWindow->add_shortcut(
            "<Control><Shift>z",
            ui_key,
            (void *)"Redo");
    mainWindow->add_shortcut("Tab", ui_key, (void *)"Indent");
    mainWindow->add_shortcut(
            "<Shift>Tab",
            ui_key,
            (void *)"Unindent");
    mainWindow->add_shortcut(
            "ISO_Left_Tab",
            ui_key,
            (void *)"Unindent");
}

static void fill_span(
        char *buf,
        long cap,
        const char *left,
        const char *mid,
        const char *right) {
    long n;
    long i;
    const char *part;
    int which;

    n = 0;
    which = 0;
    while (which < 3) {
        part = left;
        if (which == 1)
            part = mid;
        if (which == 2)
            part = right;
        if (part != nullptr) {
            i = 0;
            while (part[i] != 0 && n + 1 < cap) {
                buf[n] = part[i];
                n = n + 1;
                i = i + 1;
            }
        }
        which = which + 1;
    }
    buf[n] = 0;
}

static void add_dot(char *buf, long cap) {
    long n;

    n = 0;
    while (buf[n] != 0)
        n = n + 1;
    if (n + 1 < cap) {
        buf[n] = '.';
        n = n + 1;
        buf[n] = 0;
    }
}

static void button_text(const char *accel, char *buf, long cap) {
    accel_shown(buf, cap, accel);
}

void Ui::show_key_note(void) {
    if (keyState == nullptr)
        return;
    if (keyCapture >= 0)
        keyState->set_text(keyPrompt);
    else
        keyState->set_text(keyWarn);
}

const char *Ui::key_help(void) {
    return "Click a shortcut, press the new keys. Escape cancels.";
}

const char *Ui::key_warning(void) {
    return keyWarn;
}

const char *Ui::key_text(int index) {
    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return "";
    return keyAccel[index];
}

void Ui::arm_key(int index) {
    const char *label;
    const char *command;
    const char *config;
    const char *accel;

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return;
    key_info(index, &label, &command, &config, &accel);
    keyCapture = index;
    fill_span(
            keyPrompt,
            160,
            "Press the new keys for ",
            label,
            ". Escape cancels.");
    show_key_note();
}

int Ui::take_key(const char *accel, int escape) {
    int index;

    if (keyCapture < 0)
        return 0;
    index = keyCapture;
    keyCapture = -1;
    keyPrompt[0] = 0;
    if (escape != 0) {
        show_key_note();
        return 1;
    }
    if (accel == nullptr)
        accel = "";
    assign_key(index, accel);
    return 1;
}

int Ui::assign_key(int index, const char *accel) {
    char next[64];
    char other[64];
    int i;

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return 0;
    if (mainWindow == nullptr)
        return 0;
    if (accel == nullptr)
        accel = "";
    if (mainWindow->normalize_accel(accel, next, 64) == 0) {
        text_copy(keyWarn, 160, "That shortcut is not valid.");
        show_key_note();
        return 0;
    }
    i = 0;
    while (i < EDITOR_KEY_COUNT) {
        if (i != index && next[0] != 0) {
            int same;

            same = mainWindow->normalize_accel(
                    keyAccel[i],
                    other,
                    64);
            if (same == 1 && text_same(next, other) == 1) {
                const char *label;
                const char *command;
                const char *config;
                const char *saved;

                key_info(
                        i,
                        &label,
                        &command,
                        &config,
                        &saved);
                fill_span(
                        keyWarn,
                        160,
                        label,
                        " already uses ",
                        other);
                add_dot(keyWarn, 160);
                show_key_note();
                return 0;
            }
        }
        i = i + 1;
    }
    text_copy(keyAccel[index], 64, next);
    if (keyButton[index] != nullptr) {
        button_text(next, other, 64);
        keyButton[index]->set_label(other);
    }
    keyWarn[0] = 0;
    show_key_note();
    apply_settings();
    return 1;
}

void Ui::read_keys(void) {
    char next[EDITOR_KEY_COUNT][64];
    char shown[64];
    int n;
    int i;

    keyCapture = -1;
    keyPrompt[0] = 0;
    keyWarn[0] = 0;
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        const char *text;

        text = keyAccel[n];
        if (keyButton[n] != nullptr)
            text = keyButton[n]->label();
        if (text_same(text, "none") == 1)
            text = "";
        if (mainWindow == nullptr
                || mainWindow->normalize_accel(
                        text,
                        next[n],
                        64) == 0)
            text_copy(next[n], 64, keyAccel[n]);
        n = n + 1;
    }
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        int clash;

        clash = -1;
        i = 0;
        while (i < n) {
            if (next[n][0] != 0
                    && text_same(next[n], next[i]) == 1)
                clash = i;
            i = i + 1;
        }
        if (clash >= 0) {
            const char *label;
            const char *command;
            const char *config;
            const char *accel;
            int kept;

            key_info(
                    clash,
                    &label,
                    &command,
                    &config,
                    &accel);
            fill_span(
                    keyWarn,
                    160,
                    label,
                    " already uses ",
                    next[clash]);
            add_dot(keyWarn, 160);
            kept = 0;
            if (mainWindow != nullptr)
                kept = mainWindow->normalize_accel(
                        keyAccel[n],
                        next[n],
                        64);
            if (kept == 0)
                next[n][0] = 0;
            i = 0;
            while (i < n) {
                if (next[n][0] != 0
                        && text_same(next[n], next[i]) == 1)
                    next[n][0] = 0;
                i = i + 1;
            }
        }
        n = n + 1;
    }
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        text_copy(keyAccel[n], 64, next[n]);
        if (keyButton[n] != nullptr) {
            button_text(keyAccel[n], shown, 64);
            keyButton[n]->set_label(shown);
        }
        n = n + 1;
    }
    show_key_note();
}

static void search_flags(
        int match,
        int word,
        int scope,
        int back,
        bool *matchCase,
        bool *whole,
        bool *inSel,
        bool *backward) {
    *matchCase = false;
    *whole = false;
    *inSel = false;
    *backward = false;
    if (match != 0)
        *matchCase = true;
    if (word != 0)
        *whole = true;
    if (scope != 0)
        *inSel = true;
    if (back != 0)
        *backward = true;
}

void Ui::find_query(const char *query) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;
    bool wrap;

    if (query == nullptr)
        query = "";
    text_copy(searchText, 256, query);
    if (searchEntry != nullptr)
        searchEntry->set_text(searchText);
    if (searchText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    wrap = false;
    if (searchWrap != 0)
        wrap = true;
    buffer->find_next(
            searchText,
            matchCase,
            whole,
            inSel,
            backward,
            wrap);
    refresh();
}

void Ui::find_again(void) {
    if (searchEntry != nullptr)
        text_copy(searchText, 256, searchEntry->text());
    find_query(searchText);
}

void Ui::replace_query(const char *query, const char *repl) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;
    bool wrap;

    if (query == nullptr)
        query = "";
    if (repl == nullptr)
        repl = "";
    text_copy(replaceText, 256, query);
    text_copy(withText, 256, repl);
    if (replaceFind != nullptr)
        replaceFind->set_text(replaceText);
    if (replaceWith != nullptr)
        replaceWith->set_text(withText);
    if (replaceText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    wrap = false;
    if (searchWrap != 0)
        wrap = true;
    buffer->replace_next(
            replaceText,
            withText,
            matchCase,
            whole,
            inSel,
            backward,
            wrap);
    refresh();
}

void Ui::replace_every(const char *query, const char *repl) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;

    if (query == nullptr)
        query = "";
    if (repl == nullptr)
        repl = "";
    text_copy(replaceText, 256, query);
    text_copy(withText, 256, repl);
    if (replaceText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    (void)backward;
    buffer->replace_all(
            replaceText,
            withText,
            matchCase,
            whole,
            inSel);
    refresh();
}

void Ui::replace_again(void) {
    if (replaceFind != nullptr)
        text_copy(replaceText, 256, replaceFind->text());
    if (replaceWith != nullptr)
        text_copy(withText, 256, replaceWith->text());
    replace_query(replaceText, withText);
}

void Ui::replace_all_again(void) {
    if (replaceFind != nullptr)
        text_copy(replaceText, 256, replaceFind->text());
    if (replaceWith != nullptr)
        text_copy(withText, 256, replaceWith->text());
    replace_every(replaceText, withText);
}

