    dirtyDialog->add_button("Cancel", EDITOR_CANCEL);
    dirtyDialog->on_response(ui_choice_response, nullptr);
    show_recent();
}

static void panel_digits(
        char *dest,
        long cap,
        long value) {
    char digits[16];
    long n;
    long i;

    if (dest == nullptr || cap < 2)
        return;
    if (value < 0)
        value = 0;
    n = 0;
    if (value == 0) {
        digits[0] = '0';
        n = 1;
    }
    while (value > 0 && n < 15) {
        digits[n] = (char)('0' + (value % 10));
        value = value / 10;
        n = n + 1;
    }
    i = 0;
    while (n > 0 && i < cap - 1) {
        n = n - 1;
        dest[i] = digits[n];
        i = i + 1;
    }
    dest[i] = 0;
}

static Box *group_box(const char *title);
static Box *labeled_field(const char *label, Widget *field);

static void shrink_scroll(ScrolledWindow *scroll) {
    if (scroll == nullptr || scroll->native == nullptr)
        return;
    gtk_scrolled_window_set_propagate_natural_width(
            scroll->native,
            0);
    gtk_scrolled_window_set_min_content_width(
            scroll->native,
            48);
}

static void expand_column(ColumnView *view) {
    void *columns;
    void *column;

    if (view == nullptr || view->native == nullptr)
        return;
    columns = gtk_column_view_get_columns(view->native);
    if (columns == nullptr)
        return;
    column = g_list_model_get_item(columns, 0);
    if (column == nullptr)
        return;
    gtk_column_view_column_set_expand(column, 1);
    g_object_unref(column);
}

static ScrolledWindow *panel_scroll(Widget *child) {
    ScrolledWindow *scroll;

    scroll = new ScrolledWindow();
    scroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    scroll->set_child(child);
    scroll->set_v_expand(true);
    scroll->set_h_expand(true);
    shrink_scroll(scroll);
    return scroll;
}

Widget *Ui::mount_panel(void) {
    Paned *split;
    Box *frame;
    Box *tabBar;
    Box *strip;
    Button *filesTab;
    Button *symbolsTab;
    ScrolledWindow *fileScroll;
    ScrolledWindow *symbolScroll;
    ScrolledWindow *docScroll;
    Button *documentsTab;
    Box *docs;

    panelBook = new Notebook();
    panelBook->set_scrollable(true);
    panelBook->set_v_expand(true);
    panelBook->set_h_expand(true);
    gtk_notebook_set_show_tabs(panelBook->native, 0);
    fileView = new ColumnView();
    fileView->append_column("Name");
    fileView->on_activate(ui_panel_file, nullptr);
    expand_column(fileView);
    fileScroll = panel_scroll((Widget *)fileView);
    panelBook->append_page((Widget *)fileScroll, "Files");
    symbolView = new ColumnView();
    symbolView->append_column("Symbol");
    symbolView->append_column("Line");
    symbolView->on_activate(ui_panel_symbol, nullptr);
    symbolScroll = panel_scroll((Widget *)symbolView);
    panelBook->append_page(
            (Widget *)symbolScroll,
            "Symbols");
    docView = new ColumnView();
    docView->append_column("Name");
    docView->on_activate(ui_panel_doc, nullptr);
    gtk_column_view_set_single_click_activate(
            docView->native,
            1);
    expand_column(docView);
    docScroll = panel_scroll((Widget *)docView);
    docs = new Box(GTK_VERTICAL, 4);
    docs->set_v_expand(true);
    docScroll->set_v_expand(true);
    docs->append((Widget *)new Label("Open"));
    docs->append((Widget *)docScroll);
    panelBook->append_page((Widget *)docs, "Documents");
    frame = new Box(GTK_VERTICAL, 0);
    frame->set_v_expand(true);
    frame->set_h_expand(true);
    frame->set_width_request(64);
    gtk_widget_set_halign(frame->native, 0);
    tabBar = new Box(GTK_HORIZONTAL, 0);
    tabBar->set_h_expand(true);
    panelTabLeft = new Button("<");
    panelTabRight = new Button(">");
    panelTabLeft->on_clicked(ui_panel_scroll_left, nullptr);
    panelTabRight->on_clicked(ui_panel_scroll_right, nullptr);
    strip = new Box(GTK_HORIZONTAL, 0);
    filesTab = new Button("Files");
    symbolsTab = new Button("Symbols");
    documentsTab = new Button("Documents");
    filesTab->on_clicked(ui_panel_tab_files, nullptr);
    symbolsTab->on_clicked(ui_panel_tab_symbols, nullptr);
    documentsTab->on_clicked(ui_panel_tab_documents, nullptr);
    strip->append((Widget *)filesTab);
    strip->append((Widget *)symbolsTab);
    strip->append((Widget *)documentsTab);
    panelTabScroll = new ScrolledWindow();
    panelTabScroll->set_policy(
            GTK_POLICY_EXTERNAL,
            GTK_POLICY_NEVER);
    panelTabScroll->set_h_expand(true);
    panelTabScroll->set_child((Widget *)strip);
    shrink_scroll(panelTabScroll);
    tabBar->append((Widget *)panelTabLeft);
    tabBar->append((Widget *)panelTabScroll);
    tabBar->append((Widget *)panelTabRight);
    frame->append((Widget *)tabBar);
    frame->append((Widget *)panelBook);
    panelFrame = (Widget *)frame;
    split = new Paned(GTK_HORIZONTAL);
    split->set_start_child(panelFrame);
    split->set_end_child((Widget *)book);
    gtk_paned_set_resize_start_child(split->native, 0);
    gtk_paned_set_shrink_start_child(split->native, 1);
    gtk_paned_set_resize_end_child(split->native, 1);
    gtk_paned_set_shrink_end_child(split->native, 1);
    gtk_paned_set_wide_handle(split->native, 1);
    split->set_position(200);
    editorSplit = split;
    split->set_v_expand(true);
    mount_row_menus();
    return (Widget *)split;
}

void Ui::fill_files(void) {
    int i;

    if (fileView == nullptr || panel == nullptr)
        return;
    fileView->clear_rows();
    i = 0;
    while (i < panel->file_count()) {
        const char *cells[1];
        char shown[260];
        long n;

        text_copy(shown, 260, panel->file_name(i));
        if (panel->row_dir(i) == 1
                && text_same(shown, "..") == 0) {
            n = text_length(shown);
            if (n + 1 < 260) {
                shown[n] = '/';
                shown[n + 1] = 0;
            }
        }
        cells[0] = shown;
        fileView->append_row(cells, 1);
        i = i + 1;
    }
    g_idle_add((void *)ui_align_idle, nullptr);
}

void Ui::fill_symbols(void) {
    Document *doc;
    int i;

    if (panel == nullptr || symbolView == nullptr)
        return;
    doc = nullptr;
    if (state != nullptr)
        doc = state->active();
    if (doc == nullptr || doc->buffer() == nullptr)
        panel->scan_symbols("", "");
    else
        panel->scan_symbols(
                doc->buffer()->text(),
                doc->language());
    symbolView->clear_rows();
    i = 0;
    while (i < panel->symbol_count()) {
        const char *cells[2];
        char digits[16];

        panel_digits(digits, 16, panel->symbol_line(i));
        cells[0] = panel->symbol_name(i);
        cells[1] = digits;
        symbolView->append_row(cells, 2);
        i = i + 1;
    }
}

int Ui::show_folder(const char *path) {
    if (panel == nullptr)
        return 0;
    if (panel->set_root(path) == 0)
        return 0;
    fill_files();
    return 1;
}

void Ui::refresh_sessions(void) {
    sessionUsed = session_catalog(
            sessionNames,
            sessionCounts,
            sessionDates,
            SESSION_LIST);
    if (sessionUsed < 0)
        sessionUsed = 0;
    recentSessionCount = sessionUsed;
    if (recentSessionCount > 8)
        recentSessionCount = 8;
    fill_session_rows();
    refresh_recent_menu();
}

void Ui::capture_place(void) {
    long i;
    Document *doc;

    if (session == nullptr)
        return;
    session->clear_opens();
    if (state == nullptr)
        return;
    i = 0;
    while (i < state->count()) {
        doc = state->at(i);
        if (doc != nullptr
                && doc->untitled() == 0
                && doc->path() != nullptr
                && doc->path()[0] != 0)
            session->note_open(doc->path());
        i = i + 1;
    }
    doc = state->active();
    if (doc != nullptr
            && doc->untitled() == 0
            && doc->path() != nullptr
            && doc->path()[0] != 0
            && doc->buffer() != nullptr)
        session->note_active(
                doc->path(),
                (int)doc->buffer()->cursor_line());
    else
        session->note_active("", 1);
}

void Ui::apply_place(void) {
    int i;
    int line;
    const char *active;

    if (session == nullptr || state == nullptr)
        return;
    i = 0;
    while (i < session->open_count()) {
        open_path(session->open_at(i));
        i = i + 1;
    }
    active = session->active_path();
    if (active == nullptr || active[0] == 0)
        return;
    open_path(active);
    if (state->active() == nullptr)
        return;
    if (state->active()->buffer() == nullptr)
        return;
    line = session->active_line();
    if (line < 1)
        line = 1;
    state->active()->buffer()->move_to((long)line, (long)1);
    place_cursor(state->index());
    paint_status();
}

int Ui::take_buffers(void) {
    int code;

    if (state == nullptr)
        return 1;
    code = state->close_all();
    handle(code);
    if (code == EDITOR_OK)
        return 1;
    if (code == EDITOR_NEEDS_CHOICE)
        return -1;
    return 0;
}

void Ui::present_editor(void) {
    refresh();
    if (mainWindow != nullptr)
        mainWindow->present();
    arm_tick();
    offer_recovery();
}

void Ui::fill_session_rows(void) {
    int i;
    int pick;

    if (sessionView == nullptr)
        return;
    pick = sessionPick;
    sessionView->clear_rows();
    i = 0;
    while (i < sessionUsed) {
        const char *cells[3];

        panel_digits(
                sessionCountText[i],
                8,
                (long)sessionCounts[i]);
        cells[0] = sessionNames[i];
        cells[1] = sessionCountText[i];
        cells[2] = sessionDates[i];
        sessionView->append_row(cells, 3);
        i = i + 1;
    }
    if (pick < 0)
        pick = 0;
    if (sessionUsed == 0)
        pick = 0;
    else if (pick >= sessionUsed)
        pick = 0;
    sessionPick = pick;
    if (sessionSelect != nullptr && sessionUsed > 0)
        gtk_single_selection_set_selected(
                sessionSelect,
                (unsigned)pick);
}

void Ui::arm_session_list(void) {
    void *single;
    void (*marked)(void *, void *, void *);

    if (sessionView == nullptr
            || sessionView->native == nullptr
            || sessionView->rows == nullptr)
        return;
    if (sessionSelect != nullptr)
        return;
    g_object_ref(sessionView->rows);
    single = gtk_single_selection_new(sessionView->rows);
    if (single == nullptr)
        return;
    gtk_single_selection_set_autoselect(single, 1);
    gtk_single_selection_set_can_unselect(single, 0);
    gtk_column_view_set_model(sessionView->native, single);
    sessionSelect = single;
    marked = session_marked;
    g_signal_connect_data(
            single,
            "notify::selected",
            (void *)marked,
            nullptr,
            nullptr,
            0);
    g_object_unref(single);
}

void Ui::focus_session_list(void) {
    if (sessionView == nullptr
            || sessionView->native == nullptr)
        return;
    gtk_widget_grab_focus(sessionView->native);
}

void Ui::refresh_recent_menu(void) {
    const char *labels[8];
    int i;

    if (menuBar == nullptr)
        return;
    i = 0;
    while (i < recentSessionCount && i < 8) {
        text_copy(
                recentSession[i],
                SESSION_NAME,
                sessionNames[i]);
        labels[i] = recentSession[i];
        i = i + 1;
    }
    menuBar->set_submenu(
            sessionMenu,
            1,
            labels,
            (long)i,
            ui_session_recent,
            nullptr);
}

void Ui::complete_held_session(void) {
    int mode;
    int ok;
    char name[SESSION_NAME];

    if (sessionHold == 0)
        return;
    mode = sessionHold;
    text_copy(name, SESSION_NAME, holdName);
    sessionHold = 0;
    ok = 0;
    if (mode == 1)
        ok = open_session(name);
    else if (mode == 2)
        ok = new_session();
    if (ok == 1) {
        sessionShown = 0;
        sessionAsk = 0;
        present_editor();
        if (sessionDialog != nullptr)
            sessionDialog->set_visible(false);
    }
}

int Ui::open_session(const char *name) {
    int ready;

    if (session == nullptr || name == nullptr)
        return 0;
    if (name[0] == 0)
        return 0;
    ready = take_buffers();
    if (ready < 0) {
        text_copy(holdName, SESSION_NAME, name);
        sessionHold = 1;
        return 0;
    }
    if (ready == 0)
        return 0;
    if (session->load(name) == 0) {
        if (status != nullptr)
            status->set_text("Could not open the session");
        return 0;
    }
    apply_place();
    if (state != nullptr && state->count() == 0)
        state->new_file();
    sessionAsk = 0;
    refresh_sessions();
    refresh();
    show_session_title();
    if (status != nullptr)
        status->set_text("Opened the session");
    return 1;
}

int Ui::new_session(void) {
    int ready;

    ready = take_buffers();
    if (ready < 0) {
        holdName[0] = 0;
        sessionHold = 2;
        return 0;
    }
    if (ready == 0)
        return 0;
    if (session == nullptr)
        session = new EditSession();
    session->clear();
    if (state != nullptr && state->count() == 0)
        state->new_file();
    sessionAsk = 0;
    refresh();
    show_session_title();
    if (status != nullptr)
        status->set_text("New session");
    return 1;
}

int Ui::save_current_session(void) {
    if (session == nullptr)
        return 0;
    if (session->name()[0] == 0) {
        show_session_save();
        return 0;
    }
    capture_place();
    if (session->save() == 0) {
        if (status != nullptr)
            status->set_text("Could not save the session");
        return 0;
    }
    refresh_sessions();
    show_session_title();
    if (status != nullptr)
        status->set_text("Saved the session");
    return 1;
}

int Ui::save_session_as(const char *name) {
    if (session == nullptr || name == nullptr)
        return 0;
    capture_place();
    if (session->save_as(name) == 0) {
        if (status != nullptr)
            status->set_text("Could not save the session");
        return 0;
    }
    refresh_sessions();
    show_session_title();
    if (status != nullptr)
        status->set_text("Saved the session");
    return 1;
}

int Ui::delete_session(const char *name) {
    if (session_remove(name) == 0) {
        if (status != nullptr)
            status->set_text("Could not delete the session");
        return 0;
    }
    if (session != nullptr
            && text_same(session->name(), name) == 1)
        session->set_name("");
    refresh_sessions();
    show_session_title();
    if (status != nullptr)
        status->set_text("Deleted the session");
    return 1;
}

int Ui::rename_session(
        const char *from,
        const char *to) {
    if (session_rename(from, to) == 0) {
        if (status != nullptr)
            status->set_text("Could not rename the session");
        return 0;
    }
    if (session != nullptr
            && text_same(session->name(), from) == 1)
        session->set_name(to);
    refresh_sessions();
    show_session_title();
    if (status != nullptr)
        status->set_text("Renamed the session");
    return 1;
}

int Ui::duplicate_session(
        const char *from,
        const char *to) {
    if (session_copy(from, to) == 0) {
        if (status != nullptr)
            status->set_text(
                    "Could not duplicate the session");
        return 0;
    }
    refresh_sessions();
    if (status != nullptr)
        status->set_text("Duplicated the session");
    return 1;
}

