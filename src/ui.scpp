    fileLabels[3] = "Save";
    fileLabels[4] = "Save As";
    fileLabels[5] = "Save All";
    fileLabels[6] = "Close";
    fileLabels[7] = "Close All";
    fileLabels[8] = "Quit";
    searchLabels[0] = "Search";
    searchLabels[1] = "Replace";
    searchLabels[2] = "Reverse";
    searchLabels[3] = "Whole word";
    searchLabels[4] = "Match case";
    searchLabels[5] = "Wrap";
    viewLabels[0] = "Whitespace";
    viewLabels[1] = "Line ends";
    viewLabels[2] = "Indent stops";
    viewLabels[3] = "Remember files";
    viewLabels[4] = "Left panel";
    viewLabels[5] = "Right panel";
    sessionLabels[0] = "New Session";
    sessionLabels[1] = "Recent";
    sessionLabels[2] = "All Sessions";
    sessionLabels[3] = "Save Session";
    sessionLabels[4] = "Save As";
    editLabels[0] = "Undo";
    editLabels[1] = "Redo";
    editLabels[2] = "Cut";
    editLabels[3] = "Copy";
    editLabels[4] = "Paste";
    editLabels[5] = "Select All";
    editLabels[6] = "Indent";
    editLabels[7] = "Unindent";
    editLabels[8] = "Comment";
    editLabels[9] = "Block comment";
    editLabels[10] = "Add caret";
    editLabels[11] = "Clear carets";
    editLabels[12] = "Record";
    editLabels[13] = "Stop";
    editLabels[14] = "Play";
    editLabels[15] = "Settings";
    fileMenu = menuBar->add_menu(
            "File",
            fileLabels,
            9,
            ui_menu,
            nullptr);
    editMenu = menuBar->add_menu(
            "Edit",
            editLabels,
            16,
            ui_menu,
            nullptr);
    searchMenu = menuBar->add_menu(
            "Search",
            searchLabels,
            6,
