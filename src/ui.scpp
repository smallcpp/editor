        marginColorButton = new Button("Color");
        fontButton = new Button("Font");
        kinds[0] = "Tabs";
        kinds[1] = "Spaces";
        kinds[2] = "Both";
        indentDrop = new DropDown();
        indentDrop->set_items(kinds, 3);
        indentDrop->set_selected(1);
        bracketCheck->set_active(true);
        indentCheck->set_active(true);
        lineCheck->set_active(true);
        marginCheck->set_active(false);
        closeCheck->set_active(true);
        trimCheck->set_active(false);
        newlineCheck->set_active(false);
        bracketCheck->on_toggled(ui_brackets, nullptr);
        indentCheck->on_toggled(ui_indent, nullptr);
        indentDrop->on_changed(
                ui_indent_kind,
                (void *)indentDrop);
        lineCheck->on_toggled(ui_line_toggle, nullptr);
        marginCheck->on_toggled(ui_margin_toggle, nullptr);
        closeCheck->on_toggled(ui_close_toggle, nullptr);
        trimCheck->on_toggled(
                ui_option,
                (void *)"Trim trailing spaces on save");
        newlineCheck->on_toggled(
                ui_option,
                (void *)"Ensure newline at end of file");
        tabSpin->on_changed(ui_tab_spin, (void *)tabSpin);
        marginSpin->on_changed(
                ui_margin_spin,
                (void *)marginSpin);
        lineEntry->on_changed(
                ui_line_entry,
                (void *)lineEntry);
        marginEntry->on_changed(
                ui_margin_entry,
                (void *)marginEntry);
        bracketEntry->on_changed(
                ui_pairs,
                (void *)bracketEntry);
        lineColorButton->on_clicked(ui_line_color, nullptr);
        marginColorButton->on_clicked(
                ui_margin_color,
                nullptr);
        fontButton->on_clicked(ui_font_button, nullptr);
        tabSpin->set_width_chars(12);
        marginSpin->set_width_chars(12);
        lineEntry->set_width_chars(12);
        marginEntry->set_width_chars(12);
        bracketEntry->set_width_chars(12);
        {
            Box *pairGroup;

            pairGroup = group_box("Brackets");
            pairGroup->append((Widget *)bracketCheck);
            pairGroup->append((Widget *)labeled_field(
                    "Pairs",
                    (Widget *)bracketEntry));
            box->append((Widget *)pairGroup);
        }
        indentGroup = group_box("Indenting");
        indentGroup->append((Widget *)indentCheck);
        indentGroup->append((Widget *)labeled_field(
                "Indent with",
                (Widget *)indentDrop));
        indentGroup->append((Widget *)labeled_field(
                "Indent width",
                (Widget *)tabSpin));
        box->append((Widget *)indentGroup);
        lineGroup = group_box("Current line");
        lineGroup->append((Widget *)lineCheck);
        lineGroup->append((Widget *)labeled_field(
                "Current line color",
                (Widget *)color_field(
                        lineEntry,
                        lineColorButton)));
        box->append((Widget *)lineGroup);
        marginGroup = group_box("Column marker");
        marginGroup->append((Widget *)marginCheck);
        marginGroup->append((Widget *)labeled_field(
                "Columns",
                (Widget *)marginSpin));
        marginGroup->append((Widget *)labeled_field(
                "Column marker color",
                (Widget *)color_field(
                        marginEntry,
                        marginColorButton)));
        box->append((Widget *)marginGroup);
        recentSpin = new SpinButton(1, 32, 10);
        recentSpin->set_width_chars(12);
        recentSpin->on_changed(
                ui_recent_spin,
                (void *)recentSpin);
        rememberCheck = new CheckButton("Remember files");
        rememberCheck->on_toggled(
                ui_option,
                (void *)"Remember files");
        recoverCheck = new CheckButton(
                "Write recovery files");
        recoverCheck->on_toggled(
                ui_option,
                (void *)"Write recovery files");
        recoverEntry = new Entry("5");
        recoverEntry->set_width_chars(6);
        recoverEntry->on_changed(ui_recover_text, nullptr);
        {
            Box *fileGroup;

            fileGroup = group_box("Files");
            fileGroup->append((Widget *)labeled_field(
                    "Recent files",
                    (Widget *)recentSpin));
            fileGroup->append((Widget *)rememberCheck);
            fileGroup->append((Widget *)closeCheck);
            pathCheck = new CheckButton(
                    "Show path in file tab");
            pathCheck->on_toggled(
                    ui_option,
                    (void *)"Show path in file tab");
            pathCheck->set_active(false);
            pathSpin = new SpinButton(0, 32, 0);
            pathSpin->set_width_chars(12);
            pathSpin->on_changed(
                    ui_path_spin,
                    (void *)pathSpin);
            fileGroup->append((Widget *)pathCheck);
            fileGroup->append((Widget *)labeled_field(
                    "Depth",
                    (Widget *)pathSpin));
            fileGroup->append((Widget *)recoverCheck);
            fileGroup->append((Widget *)labeled_field(
                    "Minutes",
                    (Widget *)recoverEntry));
            keepEntry = new Entry("20");
            keepEntry->set_width_chars(6);
            keepEntry->on_changed(ui_keep_text, nullptr);
            fileGroup->append((Widget *)labeled_field(
                    "Keep",
                    (Widget *)keepEntry));
            box->append((Widget *)fileGroup);
        }
        saveTabCheck = new CheckButton(
                "Save when a tab loses focus");
        saveWinCheck = new CheckButton(
                "Save when the window loses focus");
        saveTabCheck->on_toggled(
                ui_option,
                (void *)"Save when a tab loses focus");
        saveWinCheck->on_toggled(
                ui_option,
                (void *)"Save when the window loses focus");
        saveGroup = group_box("Saving");
        saveGroup->append((Widget *)trimCheck);
        saveGroup->append((Widget *)newlineCheck);
        saveGroup->append((Widget *)saveTabCheck);
        saveGroup->append((Widget *)saveWinCheck);
        box->append((Widget *)saveGroup);
        box->set_h_expand(true);
        search = new Box(GTK_VERTICAL, 8);
        search->set_h_expand(true);
        search->append((Widget *)new Label(
                "These are the default settings."));
        wrapCheck = new CheckButton(
                "Wrap search at end of buffer");
        backCheck = new CheckButton(
                "Reverse search direction");
        wholeCheck = new CheckButton(
                "Match whole words only");
        caseCheck = new CheckButton(
                "Match word case exactly");
        wrapCheck->on_toggled(ui_option, (void *)"Wrap");
        backCheck->on_toggled(ui_option, (void *)"Reverse");
        wholeCheck->on_toggled(
                ui_option,
                (void *)"Whole word");
        caseCheck->on_toggled(
                ui_option,
                (void *)"Match case");
        search->append((Widget *)wrapCheck);
        search->append((Widget *)backCheck);
        search->append((Widget *)wholeCheck);
        search->append((Widget *)caseCheck);
        view = new Box(GTK_VERTICAL, 8);
        view->set_h_expand(true);
        view->append((Widget *)new Label(
                "These are the default settings."));
        spaceCheck = new CheckButton("Whitespace");
        endCheck = new CheckButton("Line ends");
        stopCheck = new CheckButton("Indent stops");
        spaceCheck->on_toggled(
                ui_option,
                (void *)"Whitespace");
        endCheck->on_toggled(
                ui_option,
                (void *)"Line ends");
        stopCheck->on_toggled(
                ui_option,
                (void *)"Indent stops");
        markGroup = group_box("Marks");
        markGroup->append((Widget *)spaceCheck);
        markGroup->append((Widget *)endCheck);
        markGroup->append((Widget *)stopCheck);
        view->append((Widget *)markGroup);
        {
            Box *fontGroup;

            fontGroup = group_box("Font");
            fontGroup->append((Widget *)fontButton);
            view->append((Widget *)fontGroup);
        }
        {
            Box *syntaxGroup;
            Button *syntaxButton;

            syntaxGroup = group_box("Syntax");
            syntaxButton = new Button("Syntax colors");
            syntaxButton->on_clicked(
                    ui_theme_button,
                    nullptr);
            syntaxGroup->append((Widget *)syntaxButton);
            view->append((Widget *)syntaxGroup);
        }
        keyHelp = new Label(key_help());
        keyState = new Label("");
        keys->attach((Widget *)keyHelp, 0, 0, 2, 1);
        keys->attach((Widget *)keyState, 0, 1, 2, 1);
        keys->attach(
                (Widget *)new Label("Command"),
                0,
                2,
                1,
                1);
        keys->attach(
                (Widget *)new Label("Shortcut"),
                1,
                2,
                1,
                1);
        if (keySlotsReady == 0) {
            n = 0;
            while (n < EDITOR_KEY_COUNT) {
                keySlots[n] = n;
                n = n + 1;
            }
            keySlotsReady = 1;
        }
        n = 0;
        while (n < EDITOR_KEY_COUNT) {
            const char *label;
            const char *command;
            const char *config;
            const char *accel;
            Label *name;
            Button *entry;
            char shown[64];

            key_info(
                    n,
                    &label,
                    &command,
                    &config,
                    &accel);
            name = new Label(label);
            button_text(keyAccel[n], shown, 64);
            entry = new Button(shown);
            entry->set_h_expand(true);
            entry->on_clicked(
                    ui_key_click,
                    (void *)&keySlots[n]);
            keyButton[n] = entry;
            keys->attach((Widget *)name, 0, n + 3, 1, 1);
            keys->attach((Widget *)entry, 1, n + 3, 1, 1);
            n = n + 1;
        }
        pages->set_h_expand(true);
        pages->set_v_expand(true);
        keys->set_h_expand(true);
        pages->append_page(
                (Widget *)page_scroll((Widget *)box),
                "General");
        pages->append_page(
                (Widget *)page_scroll((Widget *)search),
                "Search");
        pages->append_page(
                (Widget *)page_scroll((Widget *)view),
                "Appearance");
        pages->append_page(
                (Widget *)page_scroll((Widget *)keys),
                "Keyboard");
        settingsDialog->set_default_size(760, 560);
        {
            Box *shell;

            shell = new Box(GTK_VERTICAL, 8);
            shell->append((Widget *)pages);
            shell->append((Widget *)centered_close(
                    ui_settings_close));
            settingsDialog->set_content((Widget *)shell);
        }
        settingsDialog->on_key(ui_key_press, nullptr);
        settingsDialog->on_response(
                ui_settings_response,
                nullptr);
        g_signal_connect_data(
                settingsDialog->native,
                "close-request",
                (void *)ui_settings_stop,
                nullptr,
                nullptr,
                0);
    }
    settingsHold = 1;
    if (state->uses_brackets() == 0)
        bracketCheck->set_active(false);
    else
        bracketCheck->set_active(true);
    if (state->uses_indent() == 0)
        indentCheck->set_active(false);
    else
        indentCheck->set_active(true);
    if (indentDrop != nullptr)
        indentDrop->set_selected(
                state->indent_style());
    if (trimCheck != nullptr)
        set_box(trimCheck, trimOn);
    if (newlineCheck != nullptr)
        set_box(newlineCheck, newlineOn);
    if (pathCheck != nullptr)
        set_box(pathCheck, pathOn);
    if (showLine == 0)
        lineCheck->set_active(false);
    else
        lineCheck->set_active(true);
    if (showMargin == 0)
        marginCheck->set_active(false);
    else
        marginCheck->set_active(true);
    if (showClose == 0)
        closeCheck->set_active(false);
    else
        closeCheck->set_active(true);
    if (bracketEntry != nullptr) {
        char shown[64];

        copy_bracket_pairs(
                shown,
                64,
                state->bracket_pairs());
        pairFill = 1;
        bracketEntry->set_text(shown);
        pairFill = 0;
    }
    if (lineEntry != nullptr)
        lineEntry->set_text(lineColor);
    if (marginEntry != nullptr)
        marginEntry->set_text(marginColor);
    tabSpin->set_value((double)state->tab_width());
    if (recentSpin != nullptr)
        recentSpin->set_value((double)recentCount);
    if (pathSpin != nullptr)
        pathSpin->set_value((double)pathDepth);
    marginSpin->set_value((double)marginCols);
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        char shown[64];

        if (keyButton[n] != nullptr) {
            button_text(keyAccel[n], shown, 64);
            keyButton[n]->set_label(shown);
        }
        n = n + 1;
    }
    settingsHold = 0;
    push_options();
    settingsDialog->present();
}

void Ui::on_menu(const char *label) {
    if (label == nullptr)
        return;
    if (text_same(label, "New") == 1) {
        handle(state->run("new"));
        return;
    }
    if (text_same(label, "Open") == 1) {
        handle(state->run("open"));
        return;
    }
    if (text_same(label, "Save") == 1) {
        handle(state->run("save"));
        return;
    }
    if (text_same(label, "Save As") == 1) {
        handle(state->run("save-as"));
        return;
    }
    if (text_same(label, "Save All") == 1) {
        handle(state->run("save-all"));
        return;
    }
    if (text_same(label, "Close") == 1) {
        handle(state->run("close"));
        return;
    }
    if (text_same(label, "Close All") == 1) {
        handle(state->run("close-all"));
        return;
    }
    if (text_same(label, "Search") == 1) {
        show_search();
        return;
    }
    if (text_same(label, "Replace") == 1) {
        show_replace();
        return;
    }
    if (text_same(label, "Reverse") == 1) {
        searchBack = menuBar->is_checked(searchMenu, 2);
        sync_boxes();
        return;
    }
    if (text_same(label, "Whole word") == 1) {
        searchWhole = menuBar->is_checked(searchMenu, 3);
        sync_boxes();
        return;
    }
    if (text_same(label, "Match case") == 1) {
        searchCase = menuBar->is_checked(searchMenu, 4);
        sync_boxes();
        return;
    }
    if (text_same(label, "Wrap") == 1) {
        searchWrap = menuBar->is_checked(searchMenu, 5);
        sync_boxes();
        return;
    }
    if (text_same(label, "Whitespace") == 1) {
        showSpace = menuBar->is_checked(viewMenu, 0);
        sync_boxes();
        return;
    }
    if (text_same(label, "Line ends") == 1) {
        showEnds = menuBar->is_checked(viewMenu, 1);
        sync_boxes();
        return;
    }
    if (text_same(label, "Indent stops") == 1) {
        showStops = menuBar->is_checked(viewMenu, 2);
        sync_boxes();
        return;
    }
    if (text_same(label, "Remember files") == 1) {
        rememberFiles = menuBar->is_checked(viewMenu, 3);
        sync_boxes();
        return;
    }
    if (text_same(label, "Settings") == 1) {
        show_settings();
        return;
    }
    if (text_same(label, "Quit") == 1) {
        handle(state->run("quit"));
        if (state->quit_ready() == 1)
            leave();
        return;
    }
    if (text_same(label, "Undo") == 1) {
        handle(state->run("undo"));
        return;
    }
    if (text_same(label, "Redo") == 1) {
        handle(state->run("redo"));
        return;
    }
    if (text_same(label, "Cut") == 1
            || text_same(label, "Copy") == 1
            || text_same(label, "Indent") == 1
            || text_same(label, "Unindent") == 1
            || text_same(label, "Comment") == 1
            || text_same(label, "Block comment") == 1)
        take_selection();
    if (text_same(label, "Cut") == 1) {
        handle(state->run("cut"));
        return;
    }
    if (text_same(label, "Copy") == 1) {
        handle(state->run("copy"));
        return;
    }
    if (text_same(label, "Paste") == 1) {
        handle(state->run("paste"));
        return;
    }
    if (text_same(label, "Indent") == 1) {
        handle(state->run("indent"));
        return;
    }
    if (text_same(label, "Unindent") == 1) {
        handle(state->run("unindent"));
        return;
    }
    if (text_same(label, "Comment") == 1) {
        handle(state->run("comment"));
        return;
    }
    if (text_same(label, "Block comment") == 1) {
        handle(state->run("block-comment"));
        return;
    }
}

void Ui::mount_tab(long index, const char *title) {
    Box *row;
    Label *label;
    Button *mark;

    if (index < 0 || index >= pageCount)
        return;
    row = new Box(GTK_HORIZONTAL, 4);
    row->add_css("box { border: 1px solid #222222; }");
    row->add_css("box { padding: 1px 4px; }");
    label = new Label(title);
    tabTitle[index] = label;
    row->append((Widget *)label);
    if (showClose == 1) {
        mark = new Button("x");
        mark->add_css_class("flat");
        mark->add_css("button{padding:0;min-width:0;min-height:0;}");
        mark->add_css("button{border:none;background:none;}");
        mark->add_css("button{box-shadow:none;}");
        mark->on_clicked(ui_tab_close, (void *)&refs[index]);
        row->append((Widget *)mark);
    }
    book->set_tab(index, (Widget *)row);
}

void Ui::retitle(long index) {
    Document *doc;
    char title[EDITOR_PATH];
    char shown[EDITOR_PATH];
    long n;

    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    title[0] = 0;
    if (doc->untitled() == 0 && pathOn != 0)
        path_tail(
                title,
                EDITOR_PATH,
                doc->path(),
                pathDepth);
    if (title[0] == 0)
        text_copy(title, EDITOR_PATH, doc->title());
    shown[0] = 0;
    if (doc->buffer() != nullptr
            && doc->buffer()->dirty() == true) {
        shown[0] = (char)226;
        shown[1] = (char)128;
        shown[2] = (char)162;
        shown[3] = ' ';
        shown[4] = 0;
    }
    n = 0;
    while (shown[n] != 0)
        n = n + 1;
    text_copy(shown + n, EDITOR_PATH - n, title);
    if (tabTitle[index] != nullptr)
        tabTitle[index]->set_text(shown);
    else
        book->set_tab_label(index, shown);
}

const char *Ui::tab_text(long index) {
    if (index < 0 || index >= pageCount)
        return "";
    if (tabTitle[index] == nullptr)
        return "";
    return tabTitle[index]->text();
}

void Ui::fill_documents(void) {
    const char *labels[EDITOR_PAGES];
    long n;
    long i;
    long j;
    int clash;

    if (menuBar == nullptr)
        return;
    n = state->count();
    if (n > EDITOR_PAGES)
        n = EDITOR_PAGES;
    i = 0;
    while (i < n) {
        text_copy(docName[i], 80, state->at(i)->title());
        clash = 0;
        j = 0;
        while (j < i) {
            if (text_same(docName[j], docName[i]) == 1)
                clash = 1;
            j = j + 1;
        }
        if (clash == 1) {
            long used;
            char extra[8];
            long v;

            used = 0;
            while (docName[i][used] != 0
                    && used + 4 < 80)
                used = used + 1;
            docName[i][used] = ' ';
            used = used + 1;
            v = i + 1;
            extra[0] = (char)('0' + (int)(v % 10));
            extra[1] = 0;
            docName[i][used] = extra[0];
            docName[i][used + 1] = 0;
        }
        labels[i] = docName[i];
        i = i + 1;
    }
    menuBar->set_menu(documentsMenu, labels, n);
}

void Ui::select_named(const char *title) {
    long i;

    if (leaving == 1 || title == nullptr)
        return;
    i = 0;
    while (i < state->count() && i < EDITOR_PAGES) {
        if (text_same(docName[i], title) == 1
                || text_same(
                        state->at(i)->title(),
                        title) == 1) {
            state->set_index(i);
            if (book != nullptr && i < pageCount)
                book->set_current_page(i);
            paint_status();
            return;
        }
        i = i + 1;
    }
}

void Ui::paint_line(long index) {
    int on;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    on = 0;
    if (showLine != 0)
        on = 1;
    pages[index].view->set_line_shade(on, lineColor);
}

static void paper_css(
        char *css,
        long cap,
        const char *color) {
    const char *prefix;
    const char *suffix;
    long i;
    long n;

    prefix = "textview text { background-color: ";
    suffix = "; }";
    i = 0;
    n = 0;
    while (prefix[n] != 0 && i + 1 < cap) {
        css[i] = prefix[n];
        i = i + 1;
        n = n + 1;
    }
    n = 0;
    while (color[n] != 0 && i + 1 < cap) {
        css[i] = color[n];
        i = i + 1;
        n = n + 1;
    }
    n = 0;
    while (suffix[n] != 0 && i + 1 < cap) {
        css[i] = suffix[n];
        i = i + 1;
        n = n + 1;
    }
    css[i] = 0;
}

void Ui::paint_paper(long index) {
    Document *doc;
    const char *color;
    char css[96];

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    if (state == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    color = theme_color(
            themeConfig,
            doc->language(),
            "background");
    if (color == nullptr || color[0] == 0)
        return;
    paper_css(css, 96, color);
    pages[index].view->add_css(css);
}

void Ui::apply_view(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    if (fontDesc[0] != 0)
        pages[index].view->set_font(fontDesc);
    if (showMargin == 1)
        pages[index].view->set_column_marker(
                marginCols,
                marginColor);
        else
            pages[index].view->set_column_marker(
                    0,
                    marginColor);
    pages[index].view->set_tab_width(state->tab_width());
    pages[index].view->set_marks(
            showSpace,
            showEnds,
            showStops,
            state->tab_width());
    paint_paper(index);
}

void Ui::arm_dialog(void) {
    char folder[EDITOR_PATH];
    void *file;
    const char *remembered;

    if (files == nullptr || files->native == nullptr)
        return;
    files->set_parent(mainWindow);
    remembered = nullptr;
    if (hasLastDir == 1)
        remembered = lastDir;
    if (dialog_folder(
                folder,
                EDITOR_PATH,
                remembered) == 0)
        return;
    file = g_file_new_for_path(folder);
    if (file == nullptr)
        return;
    gtk_file_dialog_set_initial_folder(
            files->native,
            file);
    g_object_unref(file);
}

void Ui::note_folder(const char *path) {
    char dir[EDITOR_PATH];

    path_dir(dir, EDITOR_PATH, path);
    if (dir[0] == 0 || text_same(dir, ".") == 1)
        return;
    text_copy(lastDir, EDITOR_PATH, dir);
    hasLastDir = 1;
}

void Ui::note_size(long width, long height) {
    if (leaving == 1)
        return;
    if (width < 100 || height < 100)
        return;
    if (sizeSeen == 0) {
        sizeSeen = 1;
        seenWidth = (int)width;
        seenHeight = (int)height;
        return;
    }
    if (width == seenWidth && height == seenHeight)
        return;
    seenWidth = (int)width;
    seenHeight = (int)height;
    windowWidth = (int)width;
    windowHeight = (int)height;
    store_session();
}

void Ui::collect_open(EditorConfig *item) {
    long i;
    int n;

    if (item == nullptr || state == nullptr)
        return;
    item->openCount = 0;
    item->activePath[0] = 0;
    n = 0;
    i = 0;
    while (i < state->count() && n < EDITOR_OPEN_MAX) {
        Document *doc;

        doc = state->at(i);
        if (doc != nullptr
                && doc->untitled() == 0
                && doc->path() != nullptr
                && doc->path()[0] != 0) {
            text_copy(
                    item->openPath[n],
                    EDITOR_PATH,
                    doc->path());
            if (i == state->index())
                text_copy(
                        item->activePath,
                        EDITOR_PATH,
                        doc->path());
            n = n + 1;
        }
        i = i + 1;
    }
    item->openCount = n;
}

void Ui::store_session(void) {
    EditorConfig item;
    char path[EDITOR_PATH];
    int i;

    config_defaults(&item);
    if (config_path(path, EDITOR_PATH) == 0)
        return;
    config_read(path, &item);
    item.windowWidth = windowWidth;
    item.windowHeight = windowHeight;
    item.rememberFiles = rememberFiles;
    item.saveOnTab = saveOnTab;
    item.saveOnWindow = saveOnWindow;
    item.trimTrailing = trimOn;
    item.ensureNewline = newlineOn;
    item.showPath = pathOn;
    item.pathDepth = pathDepth;
    item.recoveryOn = recoveryOn;
    item.recoveryMinutes = recoveryMinutes;
    item.recoveryKeep = recoveryKeep;
    item.spaces = state->indent_style();
    item.recentCount = recentCount;
    if (item.recentCount < 1)
        item.recentCount = 1;
    if (item.recentCount > EDITOR_RECENT_MAX)
        item.recentCount = EDITOR_RECENT_MAX;
    item.recentUsed = recentUsed;
    if (item.recentUsed > item.recentCount)
        item.recentUsed = item.recentCount;
    i = 0;
    while (i < item.recentUsed) {
        text_copy(
                item.recentPath[i],
                EDITOR_PATH,
                recentPath[i]);
        i = i + 1;
    }
    item.openCount = 0;
    item.activePath[0] = 0;
    if (rememberFiles == 1)
        collect_open(&item);
    config_write(path, &item);
}

void Ui::show_recent(void) {
    const char *labels[EDITOR_RECENT_MAX];
    int n;
    int i;

    if (menuBar == nullptr)
        return;
    n = recentUsed;
    if (n > recentCount)
        n = recentCount;
    if (n < 0)
        n = 0;
    i = 0;
    while (i < n) {
        labels[i] = recentPath[i];
        i = i + 1;
    }
    menuBar->set_submenu(
            fileMenu,
            2,
            labels,
            n,
            ui_recent,
            nullptr);
}

void Ui::note_recent(const char *path) {
    char kept[EDITOR_RECENT_MAX][EDITOR_PATH];
    int n;
    int i;

    if (path == nullptr || path[0] == 0)
        return;
    if (recentCount < 1)
        recentCount = 1;
    if (recentCount > EDITOR_RECENT_MAX)
        recentCount = EDITOR_RECENT_MAX;
    text_copy(kept[0], EDITOR_PATH, path);
    n = 1;
    i = 0;
    while (i < recentUsed && n < recentCount) {
        if (text_same(recentPath[i], path) == 0) {
            text_copy(kept[n], EDITOR_PATH, recentPath[i]);
            n = n + 1;
        }
        i = i + 1;
    }
    recentUsed = n;
    i = 0;
    while (i < n) {
        text_copy(recentPath[i], EDITOR_PATH, kept[i]);
        i = i + 1;
    }
    show_recent();
    store_session();
}

void Ui::set_recent_count(int value) {
    if (value < 1)
        value = 1;
    if (value > EDITOR_RECENT_MAX)
        value = EDITOR_RECENT_MAX;
    recentCount = value;
    if (recentUsed > recentCount)
        recentUsed = recentCount;
    show_recent();
}

int Ui::recent_count(void) {
    return recentCount;
}

void Ui::set_path_depth(int value) {
    long i;

    if (value < 0)
        value = 0;
    if (value > 32)
        value = 32;
    pathDepth = value;
    i = 0;
    while (i < pageCount) {
        retitle(i);
        i = i + 1;
    }
}

int Ui::path_depth(void) {
    return pathDepth;
}

const char *Ui::recent_at(int index) {
    if (index < 0 || index >= recentUsed)
        return "";
    return recentPath[index];
}

int Ui::remember_on(void) {
    return rememberFiles;
}

long Ui::window_width(void) {
    if (mainWindow == nullptr)
        return 0;
    return mainWindow->width();
}

long Ui::window_height(void) {
    if (mainWindow == nullptr)
        return 0;
    return mainWindow->height();
}

void Ui::restore_files(void) {
    int i;
    long n;
    char active[EDITOR_PATH];

    text_copy(active, EDITOR_PATH, activePath);
    i = 0;
    while (i < openCount && i < EDITOR_OPEN_MAX) {
        state->open_file(openPath[i]);
        i = i + 1;
    }
    if (active[0] == 0)
        return;
    n = 0;
    while (n < state->count()) {
        Document *doc;

        doc = state->at(n);
        if (doc != nullptr
                && doc->untitled() == 0
                && text_same(doc->path(), active) == 1) {
            state->set_index(n);
            return;
        }
        n = n + 1;
    }
}

void Ui::note_loaded(void) {
    long i;
    long n;

    if (state == nullptr)
        return;
    n = state->count();
    i = 0;
    while (i < n) {
        Document *doc;

        doc = state->at(i);
        if (doc != nullptr && doc->untitled() == 0)
            note_recent(doc->path());
        i = i + 1;
    }
}

void Ui::show_dirty(void) {
    Box *rows;
    long i;
    long n;
    Document *doc;
    Box *row;
    Button *save;
    Button *drop;

    choiceMode = 0;
    dirtyOpen = 1;
    if (dirtyDialog == nullptr)
        return;
    rows = new Box(GTK_VERTICAL, 6);
    n = 0;
    i = 0;
    while (i < state->count() && n < EDITOR_PAGES) {
        doc = state->at(i);
        if (doc != nullptr
                && doc->buffer()->dirty() == true) {
            dirtySlot[n] = i;
            row = new Box(GTK_HORIZONTAL, 8);
            row->append((Widget *)new Label(doc->title()));
            save = new Button("Save");
            drop = new Button("Discard");
            save->on_clicked(
                    ui_dirty_save,
                    (void *)&dirtySlot[n]);
            drop->on_clicked(
                    ui_dirty_drop,
                    (void *)&dirtySlot[n]);
            row->append((Widget *)save);
            row->append((Widget *)drop);
            rows->append((Widget *)row);
            n = n + 1;
        }
        i = i + 1;
    }
    listedCount = (int)n;
    dirtyDialog->set_content((Widget *)rows);
    dirtyDialog->present();
}

void Ui::save_listed(long index) {
    int code;

    code = state->save_at(index);
    retitle(index);
    paint_status();
    finish_choice(code);
}

void Ui::discard_listed(long index) {
    int code;

    code = state->discard_at(index);
    retitle(index);
    paint_status();
    finish_choice(code);
}

int Ui::listed_count(void) {
    return listedCount;
}

long Ui::listed_at(int index) {
    if (index < 0 || index >= listedCount)
        return -1;
    return dirtySlot[index];
}

void Ui::save_quiet(long index) {
    Document *doc;

    if (leaving == 1)
        return;
    if (index < 0 || index >= state->count())
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    if (doc->untitled() == 1)
        return;
    if (doc->buffer()->dirty() == false)
        return;
    if (state->save_at(index) != EDITOR_OK)
        return;
    mirror_pages();
    retitle(index);
    paint_status();
}

static void join_note(
        char *dest,
        long cap,
        const char *title,
        const char *tail) {
    long n;
    long i;

    n = 0;
    i = 0;
    if (title == nullptr)
        title = "";
    while (title[i] != 0 && n + 1 < cap) {
        dest[n] = title[i];
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (tail[i] != 0 && n + 1 < cap) {
        dest[n] = tail[i];
        n = n + 1;
        i = i + 1;
    }
    dest[n] = 0;
}

void Ui::show_buffer(long index) {
    Document *doc;

    if (state == nullptr)
        return;
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    applying = 0;
    place_cursor(index);
    highlight(index);
    retitle(index);
    paint_status();
    paint_line(index);
}

void Ui::show_disk(long index) {
    Document *doc;
    char text[160];

    if (state == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    diskIndex = index;
    diskKind = 1;
    if (diskDialog == nullptr) {
        diskDialog = new Dialog("File changed");
        diskDialog->set_transient(mainWindow);
        diskLabel = new Label("");
        diskDialog->set_content((Widget *)diskLabel);
        diskDialog->add_button("Reload", 1);
        diskDialog->add_button("Save", 2);
        diskDialog->add_button("Ignore", 3);
        diskDialog->on_response(ui_disk_response, nullptr);
    }
    join_note(
            text,
            160,
            doc->title(),
            " changed on disk.");
    diskLabel->set_text(text);
    diskDialog->present();
}

void Ui::show_gone(long index) {
    Document *doc;
    char text[160];

    if (state == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    diskIndex = index;
    diskKind = 2;
    if (goneDialog == nullptr) {
        goneDialog = new Dialog("File removed");
        goneDialog->set_transient(mainWindow);
        goneLabel = new Label("");
        goneDialog->set_content((Widget *)goneLabel);
        goneDialog->add_button("Close", 1);
        goneDialog->on_response(ui_disk_response, nullptr);
    }
    join_note(
            text,
            160,
            doc->title(),
            " is no longer on disk.");
    goneLabel->set_text(text);
    goneDialog->present();
}

void Ui::check_files(void) {
    long i;

    if (leaving == 1 || state == nullptr)
        return;
    if (diskKind != 0)
        return;
    i = 0;
    while (i < state->count()) {
        Document *doc;
        int status;

        doc = state->at(i);
        status = 0;
        if (doc != nullptr)
            status = doc->disk_status();
        if (status == 1) {
            show_disk(i);
            return;
        }
        if (status == 2) {
            show_gone(i);
            return;
        }
        i = i + 1;
    }
}

void Ui::answer_disk(int response) {
    Document *doc;
    long index;

    index = diskIndex;
    doc = nullptr;
    if (state != nullptr
            && index >= 0
            && index < state->count())
        doc = state->at(index);
    if (diskKind == 2) {
        diskKind = 0;
        if (goneDialog != nullptr)
            goneDialog->set_visible(false);
        if (doc != nullptr)
            doc->mark_missing();
        return;
    }
    diskKind = 0;
    if (diskDialog != nullptr)
        diskDialog->set_visible(false);
    if (doc == nullptr)
        return;
    if (response == 1) {
        if (doc->reload_file() == 1)
            show_buffer(index);
        return;
    }
    if (response == 2) {
        state->set_index(index);
        state->save_active();
        mirror_pages();
        retitle(index);
        paint_status();
        return;
    }
    doc->ignore_disk();
}

int Ui::disk_prompt(void) {
    return diskKind;
}

int Ui::recovery_on(void) {
    return recoveryOn;
}

int Ui::recovery_minutes(void) {
    return recoveryMinutes;
}

int Ui::recovery_keep(void) {
    return recoveryKeep;
}

void Ui::set_recovery_minutes(int value) {
    if (value < 1)
        value = 1;
    if (value > 1440)
        value = 1440;
    recoveryMinutes = value;
    if (applying == 1 || settingsHold != 0)
        return;
    apply_settings();
}

void Ui::set_recovery_keep(int value) {
    char dir[EDITOR_PATH];

    if (value < 0)
        value = 0;
    if (value > 500)
        value = 500;
    recoveryKeep = value;
    if (applying == 1 || settingsHold != 0)
        return;
    if (recovery_dir(dir, EDITOR_PATH) == 1)
        trim_recovery_dir(dir, recoveryKeep);
    apply_settings();
}

void Ui::take_recovery_text(void) {
    const char *text;
    int value;
    long i;

    if (applying == 1 || settingsHold != 0)
        return;
    if (recoverEntry == nullptr)
        return;
    text = recoverEntry->text();
    if (text == nullptr || text[0] == 0)
        return;
    i = 0;
    value = 0;
    while (text[i] >= '0' && text[i] <= '9') {
        value = value * 10 + (text[i] - '0');
        i = i + 1;
        if (value > 100000)
            return;
    }
    if (text[i] != 0)
        return;
    set_recovery_minutes(value);
}

void Ui::take_recovery_keep(void) {
    const char *text;
    int value;
    long i;

    if (applying == 1 || settingsHold != 0)
        return;
    if (keepEntry == nullptr)
        return;
    text = keepEntry->text();
    if (text == nullptr || text[0] == 0)
        return;
    i = 0;
    value = 0;
    while (text[i] >= '0' && text[i] <= '9') {
        value = value * 10 + (text[i] - '0');
        i = i + 1;
        if (value > 100000)
            return;
    }
    if (text[i] != 0)
        return;
    set_recovery_keep(value);
}

int Ui::write_recovery_files(void) {
    char dir[EDITOR_PATH];
    long i;
    int n;

    if (state == nullptr)
        return 0;
    if (recovery_dir(dir, EDITOR_PATH) == 0)
        return 0;
    n = 0;
    i = 0;
    while (i < state->count()) {
        Document *doc;

        doc = state->at(i);
        if (doc != nullptr && doc->write_recovery(dir) == 1)
            n = n + 1;
        i = i + 1;
    }
    trim_recovery_dir(dir, recoveryKeep);
    return n;
}

void Ui::arm_tick(void) {
    if (tickArmed == 1)
        return;
    tickArmed = 1;
    g_timeout_add(2000, (void *)ui_tick, nullptr);
}

void Ui::tick(void) {
    long now;

    if (leaving == 1)
        return;
    check_files();
    if (recoveryOn == 0)
        return;
    now = (long)time(nullptr);
    if (recoveryMark == 0)
        recoveryMark = now;
    if (now - recoveryMark < (long)recoveryMinutes * 60)
        return;
    write_recovery_files();
    recoveryMark = now;
}

void Ui::note_active(int active) {
    if (leaving == 1)
        return;
    if (active != 0) {
        check_files();
        return;
    }
    if (dirtyOpen == 1)
        return;
    if (saveOnWindow == 0)
        return;
    save_quiet(state->index());
}

void Ui::leave(void) {
    long w;
    long h;

    if (leaving == 1)
        return;
    if (mainWindow != nullptr) {
        w = mainWindow->width();
        h = mainWindow->height();
        if (w >= 100 && h >= 100) {
            windowWidth = (int)w;
            windowHeight = (int)h;
        }
    }
    store_session();
    leaving = 1;
    if (settingsDialog != nullptr)
        settingsDialog->set_visible(false);
    if (diskDialog != nullptr)
        diskDialog->set_visible(false);
    if (goneDialog != nullptr)
        goneDialog->set_visible(false);
    if (recoverDialog != nullptr)
        recoverDialog->set_visible(false);
    if (restoredNative != nullptr)
        gtk_widget_set_visible(restoredNative, 0);
    if (choiceDialog != nullptr)
        choiceDialog->set_visible(false);
    if (dirtyDialog != nullptr) {
        dirtyOpen = 0;
        dirtyDialog->set_visible(false);
    }
    if (mainWindow != nullptr)
        mainWindow->destroy();
    if (app != nullptr)
        app->quit();
}

void Ui::close_at(long index) {
    if (leaving == 1)
        return;
    if (index < 0 || index >= state->count())
        return;
    state->set_index(index);
    if (book != nullptr && index < pageCount)
        book->set_current_page(index);
    handle(state->run("close"));
}

int Ui::tab_marks(void) {
    return showClose;
}

int Ui::shows_line(void) {
    return showLine;
}

int Ui::shows_margin(void) {
    return showMargin;
}

int Ui::margin_columns(void) {
    return marginCols;
}

int Ui::is_leaving(void) {
    return leaving;
}

void Ui::choose_font(const char *description) {
    long i;

    if (description == nullptr || description[0] == 0)
        return;
    text_copy(fontDesc, 128, description);
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
    apply_settings();
}

void Ui::set_line_shown(int value) {
    long i;

    if (value == 0)
        showLine = 0;
    else
        showLine = 1;
    i = 0;
    while (i < pageCount) {
        paint_line(i);
        i = i + 1;
    }
}

void Ui::set_margin_shown(int value) {
    long i;

    if (value == 0)
        showMargin = 0;
    else
        showMargin = 1;
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::set_close_shown(int value) {
    int next;

    next = 0;
    if (value != 0)
        next = 1;
    if (next == showClose)
        return;
    showClose = next;
    if (book == nullptr)
        return;
    rebuild();
    fill_documents();
}

void Ui::set_line_color(const char *color) {
    long i;

    if (safe_color(color) == 0)
        return;
    text_copy(lineColor, 32, color);
    i = 0;
    while (i < pageCount) {
        paint_line(i);
        i = i + 1;
    }
}

void Ui::set_margin_color(const char *color) {
    long i;

    if (safe_color(color) == 0)
        return;
    text_copy(marginColor, 32, color);
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::set_margin_count(int value) {
    long i;

    if (value < 1)
        value = 1;
    if (value > 400)
        value = 400;
    marginCols = value;
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::set_width(int value) {
    long i;

    state->set_tab_width(value);
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::open_line_color(void) {
    if (leaving == 1)
        return;
    if (colors == nullptr || mainWindow == nullptr)
        return;
    if (colors->pending != 0)
        return;
    colorKind = 0;
    colors->choose(
            mainWindow,
            lineColor,
            ui_color,
            nullptr);
}

void Ui::open_margin_color(void) {
    if (leaving == 1)
        return;
    if (colors == nullptr || mainWindow == nullptr)
        return;
    if (colors->pending != 0)
        return;
    colorKind = 1;
    colors->choose(
            mainWindow,
            marginColor,
            ui_color,
            nullptr);
}

void Ui::take_color(const char *color) {
    if (safe_color(color) == 0)
        return;
    if (colorKind == 2) {
        if (themeTag >= 0
                && themeTag < THEME_ALL
                && themeEntry[themeTag] != nullptr)
            themeEntry[themeTag]->set_text(color);
        return;
    }
    if (colorKind == 0) {
        set_line_color(color);
        if (lineEntry != nullptr)
            lineEntry->set_text(color);
        return;
    }
    set_margin_color(color);
    if (marginEntry != nullptr)
        marginEntry->set_text(color);
}

void Ui::open_font(void) {
    if (leaving == 1)
        return;
    if (fonts == nullptr || mainWindow == nullptr)
        return;
    if (fonts->pending != 0)
        return;
    fonts->choose(mainWindow, ui_font, nullptr);
}

int Ui::start(void) {
    prepare();
    app->on_activate(ui_activate, nullptr);
    return app->run();
}
