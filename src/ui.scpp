    Box *box;

    if (sessionSaveDialog == nullptr) {
        box = new Box(GTK_VERTICAL, 8);
        sessionSaveEntry = new Entry("");
        box->append((Widget *)new Label("Name"));
        box->append((Widget *)sessionSaveEntry);
        sessionSaveDialog = new Dialog("Save session");
        sessionSaveDialog->set_content((Widget *)box);
        sessionSaveDialog->add_button("Cancel", 0);
        sessionSaveDialog->add_button("Save", 1);
        sessionSaveDialog->on_response(
                ui_session_save,
                nullptr);
        sessionSaveDialog->set_transient(mainWindow);
        sessionSaveDialog->set_default_size(360, 140);
    }
    if (sessionSaveEntry != nullptr)
        sessionSaveEntry->set_text("");
    sessionSaveDialog->present();
}

void Ui::hide_session_save(void) {
    if (sessionSaveDialog != nullptr)
        sessionSaveDialog->set_visible(false);
}

void Ui::accept_session_save(void) {
    const char *name;

    name = "";
    if (sessionSaveEntry != nullptr)
        name = sessionSaveEntry->text();
    if (save_session_as(name) == 1)
        hide_session_save();
}

void Ui::show_sessions(void) {
    Box *row;
    Box *listCol;
    Box *side;
    const char *labels[6];
    int gap[6];
    int i;
    void (*press)(void *);

    refresh_sessions();
    if (sessionDialog == nullptr) {
        labels[0] = "Open";
        labels[1] = "New Session";
        labels[2] = "Delete";
        labels[3] = "Close";
        labels[4] = "Rename";
        labels[5] = "Duplicate";
        gap[0] = 0;
        gap[1] = 0;
        gap[2] = 1;
        gap[3] = 0;
        gap[4] = 1;
        gap[5] = 0;
        row = new Box(GTK_HORIZONTAL, 12);
        listCol = new Box(GTK_VERTICAL, 8);
        listCol->set_h_expand(true);
        listCol->set_v_expand(true);
        sessionView = new ColumnView();
        sessionView->append_column("Name");
        sessionView->append_column("Files");
        sessionView->append_column("Opened");
        gtk_column_view_set_single_click_activate(
                sessionView->native,
                0);
        arm_session_list();
        sessionView->set_v_expand(true);
        sessionView->set_h_expand(true);
        listCol->append((Widget *)sessionView);
        side = new Box(GTK_VERTICAL, 6);
        gtk_widget_set_valign(side->native, 1);
        press = session_press;
        i = 0;
        while (i < 6) {
            sessionButton[i] = new Button(labels[i]);
            sessionButton[i]->set_h_expand(true);
            if (gap[i] != 0)
                gtk_widget_set_margin_top(
                        sessionButton[i]->native,
                        12);
            sessionButton[i]->on_clicked(
                    press,
                    (void *)labels[i]);
            side->append((Widget *)sessionButton[i]);
            i = i + 1;
        }
        row->append((Widget *)listCol);
        row->append((Widget *)side);
        sessionDialog = new Dialog("Sessions");
        sessionDialog->set_content((Widget *)row);
        sessionDialog->set_transient(mainWindow);
        sessionDialog->set_default_size(640, 380);
        {
            int (*stop)(void *, void *);

            stop = session_close;
            g_signal_connect_data(
                    sessionDialog->native,
                    "close-request",
                    (void *)stop,
                    nullptr,
                    nullptr,
                    0);
        }
        fill_session_rows();
    }
    sessionShown = 1;
    sessionDialog->present();
    focus_session_list();
}

int Ui::session_dialog_open(void) {
    return sessionShown;
}

void Ui::answer_session(int response) {
    char listed[SESSION_NAME];
    int ok;

    listed[0] = 0;
    if (sessionPick >= 0 && sessionPick < sessionUsed)
        text_copy(
                listed,
                SESSION_NAME,
                sessionNames[sessionPick]);
    ok = 0;
    if (response == 1)
        ok = open_session(listed);
    else if (response == 2)
        ok = new_session();
    else if (response == 3) {
        if (listed[0] != 0)
            delete_session(listed);
        return;
    }
    else if (response == 4) {
        if (sessionUsed == 0)
            ok = new_session();
        else
            ok = open_session(sessionNames[0]);
    }
    else if (response == 5) {
        ask_session_name(5);
        return;
    }
    else if (response == 6) {
        ask_session_name(6);
        return;
    }
    if (ok == 0)
        return;
    sessionShown = 0;
    sessionAsk = 0;
    present_editor();
    if (sessionDialog != nullptr)
        sessionDialog->set_visible(false);
}

void Ui::on_session_menu(const char *label) {
    int ok;

    if (label == nullptr)
        return;
    ok = 0;
    if (text_same(label, "New Session") == 1)
        ok = new_session();
    else if (text_same(label, "All Sessions") == 1) {
        show_sessions();
        return;
    }
    else if (text_same(label, "Save Session") == 1) {
        save_current_session();
        return;
    }
    else if (text_same(label, "Save As") == 1) {
        show_session_save();
        return;
    }
    if (ok == 0)
        return;
    sessionShown = 0;
    sessionAsk = 0;
    present_editor();
    if (sessionDialog != nullptr)
        sessionDialog->set_visible(false);
}

void Ui::open_recent_session(const char *name) {
    if (open_session(name) == 0)
        return;
    sessionShown = 0;
    sessionAsk = 0;
    present_editor();
    if (sessionDialog != nullptr)
        sessionDialog->set_visible(false);
}

