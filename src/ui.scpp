void Ui::hide_theme(void) {
    if (themeDialog == nullptr)
        return;
    themeDialog->set_visible(false);
}

void Ui::show_theme(void) {
    Grid *grid;
    int i;
    int row;
    int pick;
    const char *labels[7];
    Document *doc;
    Entry *entry;
    Button *button;
    CheckButton *bold;
    Box *shell;
    int slot;

    if (themeDialog == nullptr) {
        themeDialog = new Dialog("Syntax colors");
        themeDialog->set_transient(mainWindow);
        grid = new Grid();
        grid->set_spacing(12, 4);
        themeDrop = new DropDown();
        i = 0;
        while (i < theme_type_count()) {
            labels[i] = theme_type_label(i);
            i = i + 1;
        }
        themeDrop->set_items(labels, theme_type_count());
        themeDrop->on_changed(ui_theme_type, nullptr);
        grid->attach(
                (Widget *)new Label("File type"),
                0,
                0,
                1,
                1);
        grid->attach(
                (Widget *)themeDrop,
                1,
                0,
                3,
                1);
        grid->attach(
                (Widget *)new Label("Buffer background"),
                0,
                1,
                1,
                1);
        if (themeSlotsReady == 0) {
            i = 0;
            while (i < THEME_ALL) {
                themeSlots[i] = i;
                i = i + 1;
            }
            themeSlotsReady = 1;
        }
        i = 0;
        while (i < THEME_ALL) {
            themeEntry[i] = nullptr;
            themeColorButton[i] = nullptr;
            i = i + 1;
        }
        i = 0;
        while (i < 10) {
            themeBold[i] = nullptr;
            i = i + 1;
        }
        grid->attach(
                (Widget *)theme_field(
                        12,
                        &entry,
                        &button),
                1,
                1,
                1,
                1);
        themeEntry[12] = entry;
        themeColorButton[12] = button;
        grid->attach(
                (Widget *)new Label("Foreground"),
                1,
                2,
                1,
                1);
        grid->attach(
                (Widget *)new Label("Background"),
                2,
                2,
                1,
                1);
        grid->attach(
                (Widget *)new Label("Bold"),
                3,
                2,
                1,
                1);
        i = 0;
        while (i < THEME_TAGS) {
            row = i + 3;
            grid->attach(
                    (Widget *)new Label(span_tag(i + 1)),
                    0,
                    row,
                    1,
                    1);
            grid->attach(
                    (Widget *)theme_field(
                            i,
                            &entry,
                            &button),
                    1,
                    row,
                    1,
                    1);
            themeEntry[i] = entry;
            themeColorButton[i] = button;
            slot = theme_bold_slot(i);
            bold = new CheckButton("Bold");
            bold->on_toggled(
                    ui_theme_bold,
                    (void *)&themeSlots[slot]);
            grid->attach((Widget *)bold, 3, row, 1, 1);
            themeBold[i] = bold;
            i = i + 1;
        }
        row = THEME_TAGS + 3;
        grid->attach(
                (Widget *)new Label(theme_name(8)),
                0,
                row,
                1,
                1);
        grid->attach(
                (Widget *)theme_field(8, &entry, &button),
                1,
                row,
                1,
                1);
        themeEntry[8] = entry;
        themeColorButton[8] = button;
        grid->attach(
                (Widget *)theme_field(9, &entry, &button),
                2,
                row,
                1,
                1);
        themeEntry[9] = entry;
        themeColorButton[9] = button;
        slot = theme_bold_slot(8);
        bold = new CheckButton("Bold");
        bold->on_toggled(
                ui_theme_bold,
                (void *)&themeSlots[slot]);
        grid->attach((Widget *)bold, 3, row, 1, 1);
        themeBold[8] = bold;
        row = row + 1;
        grid->attach(
                (Widget *)new Label(theme_name(10)),
                0,
                row,
                1,
                1);
        grid->attach(
                (Widget *)theme_field(
                        10,
                        &entry,
                        &button),
                1,
                row,
                1,
                1);
        themeEntry[10] = entry;
        themeColorButton[10] = button;
        grid->attach(
                (Widget *)theme_field(
                        11,
                        &entry,
                        &button),
                2,
                row,
                1,
                1);
        themeEntry[11] = entry;
        themeColorButton[11] = button;
        slot = theme_bold_slot(10);
        bold = new CheckButton("Bold");
        bold->on_toggled(
                ui_theme_bold,
                (void *)&themeSlots[slot]);
        grid->attach((Widget *)bold, 3, row, 1, 1);
        themeBold[9] = bold;
        shell = new Box(GTK_VERTICAL, 8);
        shell->append((Widget *)grid);
        shell->append(
                (Widget *)ruled_close(ui_theme_close));
        themeDialog->set_content((Widget *)shell);
        themeDialog->on_response(
                ui_theme_response,
                nullptr);
        g_signal_connect_data(
                themeDialog->native,
                "close-request",
                (void *)ui_theme_stop,
                nullptr,
                nullptr,
                0);
        themeDialog->set_default_size(960, 760);
    }
    pick = 0;
    doc = nullptr;
    if (state != nullptr)
        doc = state->at(state->index());
    if (doc != nullptr) {
        i = 0;
        while (i < theme_type_count()) {
            if (text_same(
                    doc->language(),
                    theme_type_name(i)) == 1)
                pick = i;
            i = i + 1;
        }
    }
    themeFill = 1;
    themeDrop->set_selected((long)pick);
    themeFill = 0;
    fill_theme();
    themeDialog->present();
}

void Ui::fill_theme(void) {
    int which;
    int i;
    int slot;
    const char *language;
    const char *color;

    if (themeDrop == nullptr)
        return;
    which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    themeFill = 1;
    i = 0;
    while (i < THEME_ALL) {
        if (themeEntry[i] != nullptr) {
            color = theme_color(
                    themeConfig,
                    language,
                    theme_name(i));
            themeEntry[i]->set_text(color);
            paint_color_button(
                    themeColorButton[i],
                    &themeSwatchProvider[i],
                    themeSwatch[i],
                    color);
        }
        i = i + 1;
    }
    i = 0;
    while (i < 10) {
        if (themeBold[i] != nullptr) {
            slot = 0;
            if (i < 8)
                slot = theme_bold_slot(i);
            if (i == 8)
                slot = theme_bold_slot(8);
            if (i == 9)
                slot = theme_bold_slot(10);
            color = theme_color(
                    themeConfig,
                    language,
                    theme_name(slot));
            if (color[0] == '1' && color[1] == 0)
                themeBold[i]->set_active(true);
            else
                themeBold[i]->set_active(false);
        }
        i = i + 1;
    }
    themeFill = 0;
}

void Ui::take_theme_entry(int slot) {
    int which;
    const char *language;
    const char *color;

    if (themeFill != 0)
        return;
    if (slot < 0 || slot >= THEME_ALL)
        return;
    if (themeEntry[slot] == nullptr)
        return;
    which = 0;
    if (themeDrop != nullptr)
        which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    color = themeEntry[slot]->text();
    if (theme_set(
            themeConfig,
            language,
            theme_name(slot),
            color) == 0)
        return;
    paint_color_button(
            themeColorButton[slot],
            &themeSwatchProvider[slot],
            themeSwatch[slot],
            color);
    paint_theme(language);
    if (text_same(
            theme_name(slot),
            "background") == 1) {
        long n;
        Document *doc;

        n = 0;
        while (n < pageCount) {
            doc = state->at(n);
            if (doc != nullptr
                    && text_same(
                            doc->language(),
                            language) == 1)
                paint_paper(n);
            n = n + 1;
        }
    }
    apply_settings();
}

void Ui::take_theme_bold(int slot, int on) {
    int which;
    const char *language;
    const char *flag;

    if (themeFill != 0)
        return;
    if (slot < 0 || slot >= THEME_ALL)
        return;
    which = 0;
    if (themeDrop != nullptr)
        which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    flag = "0";
    if (on != 0)
        flag = "1";
    if (theme_set(
            themeConfig,
            language,
            theme_name(slot),
            flag) == 0)
        return;
    paint_theme(language);
    apply_settings();
}

void Ui::open_theme_color(int slot) {
    const char *color;

    if (leaving == 1)
        return;
    if (colors == nullptr || mainWindow == nullptr)
        return;
    if (colors->pending != 0)
        return;
    if (slot < 0 || slot >= THEME_ALL)
        return;
    if (themeEntry[slot] == nullptr)
        return;
    themeTag = slot;
    colorKind = 2;
    color = themeEntry[slot]->text();
    colors->choose(
            mainWindow,
            color,
            ui_color,
            nullptr);
}

void Ui::paint_theme(const char *language) {
    long i;
    Document *doc;

    if (language == nullptr)
        return;
    i = 0;
    while (i < pageCount) {
        doc = state->at(i);
        if (doc != nullptr
                && text_same(
                        doc->language(),
                        language) == 1)
            highlight(i);
        i = i + 1;
    }
}

static int hex_nibble(char ch) {
    if (ch >= '0' && ch <= '9')
        return (int)(ch - '0');
    if (ch >= 'a' && ch <= 'f')
        return (int)(ch - 'a') + 10;
    if (ch >= 'A' && ch <= 'F')
        return (int)(ch - 'A') + 10;
    return -1;
}

static int hex_color(const char *text) {
    int i;

    if (text == nullptr || text[0] != '#')
        return 0;
    i = 1;
    while (i <= 6) {
        if (hex_nibble(text[i]) < 0)
            return 0;
        i = i + 1;
    }
    if (text[7] != 0)
        return 0;
    return 1;
}

static int swatch_dark(const char *color) {
    int red;
    int green;
    int blue;
    int bright;

    red = hex_nibble(color[1]) * 16 + hex_nibble(color[2]);
    green = hex_nibble(color[3]) * 16 + hex_nibble(color[4]);
    blue = hex_nibble(color[5]) * 16 + hex_nibble(color[6]);
    bright = (red * 3 + green * 6 + blue) / 10;
    if (bright < 140)
        return 1;
    return 0;
}

static void css_rule(
        String *css,
        const char *selector,
        const char *prop,
        const char *color) {
    if (css == nullptr || selector == nullptr || prop == nullptr)
        return;
    if (color == nullptr || color[0] == 0)
        return;
    if (text_same(color, "none") == 1)
        return;
    css->append(selector);
    css->append(" { ");
    css->append(prop);
    css->append(": ");
    css->append(color);
    css->append("; }\n");
}

static void css_pair(
        String *css,
        const char *selector,
        const char *back,
        const char *ink) {
    css_rule(css, selector, "background-color", back);
    css_rule(css, selector, "color", ink);
}

void Ui::keep_theme_base(const EditorConfig *item) {
    if (themeBase == nullptr || item == nullptr)
        return;
    theme_copy(themeBase, item);
    text_copy(themeBase->lineColor, 32, item->lineColor);
    text_copy(themeBase->marginColor, 32, item->marginColor);
    text_copy(themeBase->font, 128, item->font);
}

void Ui::give_theme_base(EditorConfig *item) {
    if (themeBase == nullptr || item == nullptr)
        return;
    theme_copy(item, themeBase);
    text_copy(item->lineColor, 32, themeBase->lineColor);
    text_copy(item->marginColor, 32, themeBase->marginColor);
    text_copy(item->font, 128, themeBase->font);
    text_copy(item->themeName, THEME_NAME, themeName);
}

void Ui::paint_color_button(
        Button *button,
        void **provider,
        char *shown,
        const char *color) {
    String *css;
    void *context;
    const char *ink;

    if (button == nullptr || button->native == nullptr)
        return;
    if (provider == nullptr || shown == nullptr)
        return;
    if (hex_color(color) == 0)
        return;
    text_copy(shown, 32, color);
    ink = "#1a1a1a";
    if (swatch_dark(color) == 1)
        ink = "#f7f7f7";
    css = new String();
    css->append("button { background-image: none; ");
    css->append("background-color: ");
    css->append(color);
    css->append("; color: ");
    css->append(ink);
    css->append("; }\n");
    if (*provider == nullptr) {
        *provider = gtk_css_provider_new();
        if (*provider == nullptr)
            return;
        context = gtk_widget_get_style_context(button->native);
        if (context == nullptr)
            return;
        gtk_style_context_add_provider(
                context,
                *provider,
                800);
    }
    gtk_css_provider_load_from_string(
            *provider,
            css->c_str());
}

const char *Ui::line_swatch(void) {
    return lineSwatch;
}

const char *Ui::margin_swatch(void) {
    return marginSwatch;
}

const char *Ui::theme_swatch(int slot) {
    if (slot < 0 || slot >= THEME_ALL)
        return "";
    return themeSwatch[slot];
}

const char *Ui::frame_css(void) {
    if (frameText == nullptr)
        return "";
    return frameText->c_str();
}

void Ui::paint_frame(void) {
    String *css;
    void *display;
    const char *ink;
    const char *paper;
    const char *menu;
    const char *menuText;
    const char *tab;
    const char *tabText;
    const char *current;

    if (themeConfig == nullptr)
        return;
    ink = theme_color(themeConfig, "", "text");
    paper = theme_color(themeConfig, "", "background");
    menu = theme_color(themeConfig, "", "menu");
    menuText = theme_color(themeConfig, "", "menu-text");
    tab = theme_color(themeConfig, "", "tab");
    tabText = theme_color(themeConfig, "", "tab-text");
    current = theme_color(themeConfig, "", "tab-current");
    css = new String();
    css_rule(css, "window.editor", "background-color", paper);
    css_rule(css, "window.editor", "color", ink);
    css_rule(css, "menubar", "background-color", menu);
    css_rule(css, "menubar", "color", menuText);
    css_rule(css, "menubar item", "color", menuText);
    css_rule(css, "popover.menu", "background-color", menu);
    css_rule(css, "popover.menu", "color", menuText);
    css_rule(
            css,
            "notebook.editor-book tab",
            "background-color",
            tab);
    css_rule(
            css,
            "notebook.editor-book tab",
            "color",
            tabText);
    css_rule(
            css,
            "notebook.editor-book tab:checked",
            "background-color",
            current);
    css_rule(
            css,
            "notebook.editor-book tab:checked",
            "color",
            tabText);
    css_rule(css, "textview", "color", ink);
    css_pair(css, "window.editor box", paper, ink);
    css_pair(css, "window.editor paned", paper, ink);
    css_pair(css, "window.editor notebook", paper, ink);
    css_pair(css, "window.editor columnview", paper, ink);
    css_pair(css, "window.editor listview", paper, ink);
    css_pair(
            css,
            "window.editor scrolledwindow",
            paper,
            ink);
    css_rule(css, "window.editor label", "color", ink);
    css_pair(css, "window.editor button", paper, ink);
    css_pair(css, "menubar item", menu, menuText);
    css_rule(css, "menubar item label", "color", menuText);
    css_pair(css, "popover.menu contents", menu, menuText);
    css_pair(css, "popover.menu box", menu, menuText);
    css_pair(
            css,
            "popover.menu modelbutton",
            menu,
            menuText);
    css_rule(css, "popover.menu label", "color", menuText);
    frameText = css;
    if (themeCss == nullptr) {
        display = gdk_display_get_default();
        if (display == nullptr)
            return;
        themeCss = gtk_css_provider_new();
        if (themeCss == nullptr)
            return;
        gtk_style_context_add_provider_for_display(
                display,
                themeCss,
                600);
    }
    gtk_css_provider_load_from_string(
            themeCss,
            css->c_str());
}

void Ui::fill_themes(void) {
    char listed[THEME_LIST][THEME_NAME];
    const char *items[THEME_LIST];
    int n;
    int i;
    int sel;

    if (themePick == nullptr)
        return;
    n = theme_list(listed, THEME_LIST);
    i = 0;
    while (i < n) {
        items[i] = listed[i];
        i = i + 1;
    }
    themePick->set_items(items, n);
    sel = 0;
    i = 0;
    while (i < n) {
        if (text_same(listed[i], themeName) == 1)
            sel = i;
        i = i + 1;
    }
    if (n > 0)
        themePick->set_selected((long)sel);
}

const char *Ui::editor_theme(void) {
    return editorTheme;
}

const char *Ui::theme_choice(void) {
    return themeName;
}

int Ui::theme_pick(const char *name) {
    EditorConfig item;

    if (themeBase == nullptr || name == nullptr)
        return 0;
    config_defaults(&item);
    give_theme_base(&item);
    if (theme_is_default(name) == 0) {
        if (theme_load(&item, name) == 0)
            return 0;
        text_copy(themeName, THEME_NAME, name);
    }
    else
        text_copy(themeName, THEME_NAME, "default");
    if (themeFromProject == 0)
        text_copy(editorTheme, THEME_NAME, themeName);
    theme_copy(themeConfig, &item);
    set_line_color(item.lineColor);
    set_margin_color(item.marginColor);
    if (item.font[0] != 0)
        choose_font(item.font);
    else
        fontDesc[0] = 0;
    paint_frame();
    refresh();
    apply_settings();
    return 1;
}

int Ui::theme_store(const char *name) {
    EditorConfig item;

    if (theme_is_default(name) == 1)
        return 0;
    config_defaults(&item);
    theme_copy(&item, themeConfig);
    text_copy(item.lineColor, 32, lineColor);
    text_copy(item.marginColor, 32, marginColor);
    text_copy(item.font, 128, fontDesc);
    if (theme_save(name, &item) == 0)
        return 0;
    text_copy(themeName, THEME_NAME, name);
    text_copy(editorTheme, THEME_NAME, name);
    apply_settings();
    settingsHold = 1;
    fill_themes();
    settingsHold = 0;
    return 1;
}

void Ui::choose_theme_list(void) {
    const char *name;

    if (settingsHold != 0 || themePick == nullptr)
        return;
    name = themePick->selected_string();
    if (name == nullptr || text_same(name, themeName) == 1)
        return;
    theme_pick(name);
}

void Ui::save_theme_entry(void) {
    const char *name;

    if (themeSaveEntry == nullptr)
        return;
    name = themeSaveEntry->text();
    if (name == nullptr)
        return;
    theme_store(name);
}

static const char *field_text(Entry *entry) {
    const char *text;

    if (entry == nullptr)
        return "";
    text = entry->text();
    if (text == nullptr)
        return "";
    return text;
}

void Ui::read_language_fields(
        const char **name,
        const char **suffixes,
        const char **names,
        const char **shebang,
        const char **line,
        const char **block,
        const char **keywords) {
    if (name != nullptr)
        *name = field_text(langName);
    if (suffixes != nullptr)
        *suffixes = field_text(langSuffix);
    if (names != nullptr)
        *names = field_text(langNames);
    if (shebang != nullptr)
        *shebang = field_text(langShebang);
    if (line != nullptr)
        *line = field_text(langLine);
    if (block != nullptr)
        *block = field_text(langBlock);
    if (keywords != nullptr)
        *keywords = field_text(langKeys);
}

void Ui::show_language_fields(void) {
    Language *item;
    long picked;

    if (langName == nullptr)
        return;
    if (settingsHold == 0 && langDrop != nullptr) {
        picked = langDrop->selected();
        if (picked >= 0)
            langIndex = (int)picked;
    }
    item = language_at(langIndex);
    if (item == nullptr)
        return;
    langName->set_text(item->name);
    langSuffix->set_text(item->suffixes);
    langNames->set_text(item->names);
    langShebang->set_text(item->shebang);
    langLine->set_text(item->line);
    langBlock->set_text(item->block);
    langKeys->set_text(item->keywords);
}

void Ui::fill_languages(void) {
    const char *items[EDITOR_LANG_MAX];
    int n;
    int i;

    if (langDrop == nullptr)
        return;
    n = language_count();
    if (n > EDITOR_LANG_MAX)
        n = EDITOR_LANG_MAX;
    i = 0;
    while (i < n) {
        items[i] = language_at(i)->name;
        i = i + 1;
    }
    if (n == 0)
        langIndex = 0;
    else if (langIndex < 0 || langIndex >= n)
        langIndex = 0;
    langDrop->set_items(items, n);
    if (n > 0)
        langDrop->set_selected((long)langIndex);
    show_language_fields();
}

void Ui::add_language(void) {
    const char *name;
    const char *suffixes;
    const char *names;
    const char *shebang;
    const char *line;
    const char *block;
    const char *keywords;
    int index;

    read_language_fields(
            &name,
            &suffixes,
            &names,
            &shebang,
            &line,
            &block,
            &keywords);
    if (language_insert(
                name,
                suffixes,
                names,
                shebang,
                line,
                block,
                keywords) == 0)
        return;
    index = language_find(name);
    if (index >= 0)
        langIndex = index;
    fill_languages();
    refresh();
}

void Ui::save_language(void) {
    const char *name;
    const char *suffixes;
    const char *names;
    const char *shebang;
    const char *line;
    const char *block;
    const char *keywords;
    int index;

    read_language_fields(
            &name,
            &suffixes,
            &names,
            &shebang,
            &line,
            &block,
            &keywords);
    if (language_store(
                langIndex,
                name,
                suffixes,
                names,
                shebang,
                line,
                block,
                keywords) == 0)
        return;
    index = language_find(name);
    if (index >= 0)
        langIndex = index;
    fill_languages();
    refresh();
}

void Ui::delete_language(void) {
    if (language_remove(langIndex) == 0)
        return;
    if (langIndex >= language_count())
        langIndex = 0;
    fill_languages();
    refresh();
}

void Ui::reset_language(void) {
    const char *name;
    Language *item;
    int index;

    name = field_text(langName);
    if (language_restore(name) == 0) {
        item = language_at(langIndex);
        if (item == nullptr)
            return;
        if (language_restore(item->origin) == 0)
            return;
        name = item->origin;
    }
    index = language_find(name);
    if (index >= 0)
        langIndex = index;
    fill_languages();
    refresh();
}

int Ui::language_total(void) {
    return language_count();
}

const char *Ui::language_choice(void) {
    if (langDrop == nullptr)
        return "";
    return langDrop->selected_string();
}

int Ui::language_define(
        const char *name,
        const char *suffixes,
        const char *names,
        const char *shebang,
        const char *line,
        const char *block,
        const char *keywords) {
    int index;

    index = language_find(name);
    if (index >= 0) {
        if (language_store(
                    index,
                    name,
                    suffixes,
                    names,
                    shebang,
                    line,
                    block,
                    keywords) == 0)
            return 0;
    }
    else if (language_insert(
                    name,
                    suffixes,
                    names,
                    shebang,
                    line,
                    block,
                    keywords) == 0)
        return 0;
    index = language_find(name);
    if (index >= 0)
        langIndex = index;
    if (langDrop != nullptr)
        fill_languages();
    refresh();
    return 1;
}

int Ui::language_drop(const char *name) {
    int index;

    index = language_find(name);
    if (language_remove(index) == 0)
        return 0;
    if (langIndex >= language_count())
        langIndex = 0;
    if (langDrop != nullptr)
        fill_languages();
    refresh();
    return 1;
}

int Ui::language_builtin_reset(const char *name) {
    int index;

    if (language_restore(name) == 0)
        return 0;
    index = language_find(name);
    if (index >= 0)
        langIndex = index;
    if (langDrop != nullptr)
        fill_languages();
    refresh();
    return 1;
}

static long shortcut_pixels(void *widget) {
    void *sample;
    int wide;
    int tall;
    int other;

    wide = 0;
    tall = 0;
    other = 0;
    if (widget == nullptr)
        return (long)280;
    sample = gtk_widget_create_pango_layout(
            widget,
            "Control Alt Sys Shift X");
    if (sample != nullptr) {
        pango_layout_get_pixel_size(sample, &wide, &tall);
        g_object_unref(sample);
    }
    sample = gtk_widget_create_pango_layout(
            widget,
            "<Control><Alt><Super><Shift>X");
    if (sample != nullptr) {
        pango_layout_get_pixel_size(sample, &other, &tall);
        g_object_unref(sample);
    }
    if (other > wide)
        wide = other;
    if (wide < 160)
        wide = 160;
    return (long)wide + 48;
}

