static void session_name_response(void *data, int response) {
    (void)data;
    if (editorUi == nullptr)
        return;
    if (response == 1)
        editorUi->accept_session_name();
    else
        editorUi->hide_session_name();
}

static void session_press(void *data) {
    const char *label;
    int code;

    if (editorUi == nullptr || data == nullptr)
        return;
    label = (const char *)data;
    code = 0;
    if (text_same(label, "Open") == 1)
        code = 1;
    else if (text_same(label, "New Session") == 1)
        code = 2;
    else if (text_same(label, "Delete") == 1)
        code = 3;
    else if (text_same(label, "Close") == 1)
        code = 4;
    else if (text_same(label, "Rename") == 1)
        code = 5;
    else if (text_same(label, "Duplicate") == 1)
        code = 6;
    if (code != 0)
        editorUi->answer_session(code);
}

static void session_marked(
        void *selection,
        void *pspec,
        void *data) {
    unsigned pos;

    (void)pspec;
    (void)data;
    if (editorUi == nullptr || selection == nullptr)
        return;
    pos = gtk_single_selection_get_selected(selection);
    if (pos + 1 == 0)
        return;
    editorUi->keep_session_pick((int)pos);
}

void ui_session_save(void *data, int response) {
    (void)data;
    if (editorUi == nullptr)
        return;
    if (response == 1)
        editorUi->accept_session_save();
    else
        editorUi->hide_session_save();
}

static int session_close(void *window, void *data) {
    (void)window;
    (void)data;
    if (editorUi != nullptr)
        editorUi->answer_session(4);
    return 1;
}

