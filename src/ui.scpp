#include "ui.shpp"

extern void *g_file_new_for_path(const char *path);
extern void gtk_file_dialog_set_initial_folder(
        void *dialog,
        void *folder);
extern void g_object_unref(void *object);
extern unsigned g_idle_add(void *func, void *data);
extern unsigned long g_signal_connect_data(
        void *instance,
        const char *signal,
        void *handler,
        void *data,
        void *destroy,
        int flags);

Ui *editorUi;

void ui_activate(void *data) {
    (void)data;
    editorUi->show_main();
}

void ui_menu(void *data, const char *label) {
    (void)data;
    editorUi->on_menu(label);
}

void ui_opened(void *data, const char *path) {
    (void)data;
    editorUi->open_path(path);
}

void ui_saved(void *data, const char *path) {
    (void)data;
    editorUi->save_path(path);
}

void ui_choice_response(void *data, int response) {
    (void)data;
    editorUi->choice(response);
}

bool ui_close(void *data) {
    int code;

    (void)data;
    if (editorUi->is_leaving() == 1)
        return false;
    if (editorUi->editor()->quit_ready() == 1) {
        editorUi->leave();
        return false;
    }
    code = editorUi->editor()->quit();
    if (editorUi->editor()->quit_ready() == 1) {
        editorUi->leave();
        return false;
    }
    editorUi->handle(code);
    return true;
}

void ui_changed(void *data) {
    PageRef *ref;

    ref = (PageRef *)data;
    editorUi->changed(ref->index);
}

void ui_moved(void *data, long line, long offset) {
    PageRef *ref;

    ref = (PageRef *)data;
    editorUi->moved(ref->index, line, offset);
}

void ui_switched(void *data, long index) {
    (void)data;
    editorUi->switched(index);
}

void ui_user_begin(void *buffer, void *data) {
    PageRef *ref;

    (void)buffer;
    ref = (PageRef *)data;
    editorUi->user_begin(ref->index);
}

void ui_user_end(void *buffer, void *data) {
    PageRef *ref;

    (void)buffer;
    ref = (PageRef *)data;
    editorUi->user_end(ref->index);
}

int ui_sync_idle(void *data) {
    PageRef *ref;

    ref = (PageRef *)data;
    editorUi->flush_sync(ref->index);
    return 0;
}

int ui_key_idle(void *data) {
    if (editorUi == nullptr)
        return 0;
    if (editorUi->is_leaving() == 1)
        return 0;
    editorUi->on_menu((const char *)data);
    return 0;
}

void ui_key(void *data) {
    g_idle_add((void *)ui_key_idle, data);
}

void ui_doc(void *data, const char *label) {
    (void)data;
    editorUi->select_named(label);
}

void ui_tab_close(void *data) {
    PageRef *ref;

    ref = (PageRef *)data;
    editorUi->close_at(ref->index);
}

void ui_font(void *data, const char *description) {
    (void)data;
    editorUi->choose_font(description);
}

void ui_brackets(void *data, bool value) {
    (void)data;
    if (value)
        editorUi->editor()->use_brackets(1);
    else
        editorUi->editor()->use_brackets(0);
}

void ui_indent(void *data, bool value) {
    (void)data;
    if (value)
        editorUi->editor()->use_indent(1);
    else
        editorUi->editor()->use_indent(0);
}

void ui_settings_response(void *data, int response) {
    (void)data;
    (void)response;
    editorUi->hide_settings();
}

Ui::Ui(Editor *editor) {
    long i;

    state = editor;
    applying = 0;
    pageCount = 0;
    choiceMode = 0;
    pendingPath = new String();
    fileMenu = nullptr;
    docMenu = nullptr;
    app = nullptr;
    mainWindow = nullptr;
    book = nullptr;
    status = nullptr;
    choiceDialog = nullptr;
    settingsDialog = nullptr;
    bracketCheck = nullptr;
    indentCheck = nullptr;
    lineCheck = nullptr;
    marginCheck = nullptr;
    closeCheck = nullptr;
    tabSpin = nullptr;
    marginSpin = nullptr;
    lineEntry = nullptr;
    marginEntry = nullptr;
    files = nullptr;
    fonts = nullptr;
    showLine = 1;
    showMargin = 0;
    showClose = 1;
    marginCols = 80;
    hasLastDir = 0;
    leaving = 0;
    text_copy(lineColor, 32, "#d6e4f5");
    text_copy(marginColor, 32, "#c8c8c8");
    fontDesc[0] = 0;
    lastDir[0] = 0;
    i = 0;
    while (i < EDITOR_PAGES) {
        pages[i].buffer = nullptr;
        pages[i].view = nullptr;
        pages[i].scroll = nullptr;
        pages[i].tags = 0;
        pages[i].userDepth = 0;
        pages[i].pendingSync = 0;
        pages[i].pendingIdle = 0;
        tabTitle[i] = nullptr;
        docName[i][0] = 0;
        refs[i].index = i;
        i = i + 1;
    }
    editorUi = this;
}

Editor *Ui::editor(void) {
    return state;
}

void Ui::build(void) {
    HeaderBar *bar;
    MenuButton *editMenu;
    const char *fileLabels[8];
    const char *editLabels[8];
    Box *outer;

    app = new Application("org.smallcpp.Editor");
    mainWindow = new Window("editor");
    mainWindow->set_default_size(880, 640);
    mainWindow->on_close_request(ui_close, nullptr);
    bar = new HeaderBar();
    bar->set_show_title_buttons(false);
    bar->set_title("editor");
    fileMenu = new MenuButton("File");
    editMenu = new MenuButton("Edit");
    fileLabels[0] = "New";
    fileLabels[1] = "Open";
    fileLabels[2] = "Save";
    fileLabels[3] = "Save As";
    fileLabels[4] = "Save All";
    fileLabels[5] = "Close";
    fileLabels[6] = "Settings";
    fileLabels[7] = "Quit";
    fileMenu->set_menu(fileLabels, 8, ui_menu, nullptr);
    editLabels[0] = "Undo";
    editLabels[1] = "Redo";
    editLabels[2] = "Cut";
    editLabels[3] = "Copy";
    editLabels[4] = "Paste";
    editLabels[5] = "Indent";
    editLabels[6] = "Unindent";
    editMenu->set_menu(editLabels, 7, ui_menu, nullptr);
    docMenu = new MenuButton("Documents");
    bar->pack_start((Widget *)fileMenu);
    bar->pack_start((Widget *)editMenu);
    bar->pack_start((Widget *)docMenu);
    outer = new Box(GTK_VERTICAL, 0);
    outer->append((Widget *)bar);
    book = new Notebook();
    book->add_css(
            "tab { border: 1px solid #666666; margin: 1px; }");
    book->add_css("tab { padding: 1px 6px; }");
    book->on_switch_page(ui_switched, nullptr);
    book->set_v_expand(true);
    status = new Label("editor");
    outer->append((Widget *)book);
    outer->append((Widget *)status);
    mainWindow->set_child((Widget *)outer);
    mainWindow->add_shortcut("<Control>o", ui_key, (void *)"Open");
    mainWindow->add_shortcut("<Control>s", ui_key, (void *)"Save");
    mainWindow->add_shortcut(
            "<Control><Shift>s",
            ui_key,
            (void *)"Save As");
    mainWindow->add_shortcut(
            "<Control><Shift>l",
            ui_key,
            (void *)"Save All");
    mainWindow->add_shortcut("<Control>c", ui_key, (void *)"Copy");
    mainWindow->add_shortcut("<Control>x", ui_key, (void *)"Cut");
    mainWindow->add_shortcut("<Control>v", ui_key, (void *)"Paste");
    mainWindow->add_shortcut("<Control>z", ui_key, (void *)"Undo");
    mainWindow->add_shortcut(
            "<Control><Shift>z",
            ui_key,
            (void *)"Redo");
    mainWindow->add_shortcut("<Control>y", ui_key, (void *)"Redo");
    mainWindow->add_shortcut(
            "<Control>bracketright",
            ui_key,
            (void *)"Indent");
    mainWindow->add_shortcut(
            "<Control>bracketleft",
            ui_key,
            (void *)"Unindent");
    files = new FileDialog();
    files->set_parent(mainWindow);
    fonts = new FontDialog();
    choiceDialog = new Dialog("Confirm");
    choiceDialog->set_transient(mainWindow);
    choiceDialog->add_button("Save", EDITOR_SAVE);
    choiceDialog->add_button("Discard", EDITOR_DISCARD);
    choiceDialog->add_button("Cancel", EDITOR_CANCEL);
    choiceDialog->on_response(ui_choice_response, nullptr);
}

void Ui::prepare(void) {
    if (app != nullptr)
        return;
    build();
    refresh();
}

void Ui::add_page(long index) {
    Document *doc;
    char title[256];
    ScrolledWindow *scroll;

    doc = state->at(index);
    if (doc == nullptr)
        return;
    pages[index].buffer = new TextBuffer();
    pages[index].view = new TextView(pages[index].buffer);
    pages[index].view->set_monospace(true);
    pages[index].view->set_editable(true);
    pages[index].view->set_line_numbers(true);
    pages[index].userDepth = 0;
    pages[index].pendingSync = 0;
    pages[index].pendingIdle = 0;
    scroll = new ScrolledWindow();
    scroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    scroll->set_child((Widget *)pages[index].view);
    pages[index].scroll = scroll;
    pages[index].tags = 0;
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    applying = 0;
    pages[index].buffer->on_changed(
            ui_changed,
            (void *)&refs[index]);
    g_signal_connect_data(
            pages[index].buffer->native,
            "begin-user-action",
            (void *)ui_user_begin,
            (void *)&refs[index],
            nullptr,
            0);
    g_signal_connect_data(
            pages[index].buffer->native,
            "end-user-action",
            (void *)ui_user_end,
            (void *)&refs[index],
            nullptr,
            0);
    pages[index].view->on_move_cursor(
            ui_moved,
            (void *)&refs[index]);
    text_copy(title, 256, doc->title());
    book->append_page((Widget *)scroll, title);
    pageCount = pageCount + 1;
    mount_tab(index, title);
    apply_view(index);
    highlight(index);
    place_cursor(index);
    paint_line(index);
}

void Ui::rebuild(void) {
    long i;
    long n;

    while (pageCount > 0) {
        book->remove_page(0);
        pageCount = pageCount - 1;
    }
    i = 0;
    while (i < EDITOR_PAGES) {
        pages[i].buffer = nullptr;
        pages[i].view = nullptr;
        pages[i].scroll = nullptr;
        pages[i].tags = 0;
        pages[i].userDepth = 0;
        pages[i].pendingSync = 0;
        pages[i].pendingIdle = 0;
        tabTitle[i] = nullptr;
        i = i + 1;
    }
    n = state->count();
    if (n > EDITOR_PAGES)
        n = EDITOR_PAGES;
    i = 0;
    while (i < n) {
        add_page(i);
        i = i + 1;
    }
    if (pageCount > 0 && state->index() < pageCount)
        book->set_current_page(state->index());
}

void Ui::place_cursor(long index) {
    Document *doc;
    TextIter *at;
    TextIter *bound;
    long line;
    long column;
    long line2;
    long column2;
    long lo;
    long hi;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    if (doc->buffer()->has_selection() == false) {
        doc->buffer()->line_column_at(
                doc->buffer()->cursor_offset(),
                &line,
                &column);
        at = new TextIter(line, column);
        pages[index].buffer->place_cursor(at);
        if (pages[index].view != nullptr)
            pages[index].view->scroll_to(line, column);
        return;
    }
    lo = doc->buffer()->sel_lo();
    hi = doc->buffer()->sel_hi();
    doc->buffer()->line_column_at(lo, &line, &column);
    doc->buffer()->line_column_at(hi, &line2, &column2);
    at = new TextIter(line, column);
    bound = new TextIter(line2, column2);
    pages[index].buffer->select_range(at, bound);
    doc->buffer()->line_column_at(
            doc->buffer()->cursor_offset(),
            &line,
            &column);
    if (pages[index].view != nullptr)
        pages[index].view->scroll_to(line, column);
}

void Ui::push_active(void) {
    long index;
    Document *doc;

    index = state->index();
    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->active();
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    retitle(index);
    if (text_same(
                pages[index].buffer->get_text(),
                doc->buffer()->text()) == 1) {
        place_cursor(index);
        paint_line(index);
        return;
    }
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    place_cursor(index);
    applying = 0;
    highlight(index);
    paint_line(index);
}

void Ui::take_selection(void) {
    TextBuffer *gtkBuf;
    TextIter *start;
    TextIter *end;
    Document *doc;
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    gtkBuf = pages[index].buffer;
    if (gtkBuf == nullptr)
        return;
    doc = state->active();
    if (doc == nullptr)
        return;
    start = new TextIter(0, 0);
    end = new TextIter(0, 0);
    if (gtkBuf->selection_bounds(start, end) == false)
        return;
    doc->buffer()->select_span(
            start->line() + 1,
            start->offset() + 1,
            end->line() + 1,
            end->offset() + 1);
}

void Ui::highlight(long index) {
    Highlighter *scan;
    Document *doc;
    const char *text;
    long i;
    long line;
    long col;
    long line2;
    long col2;
    long n;
    TextIter *start;
    TextIter *end;
    const char *name;
    Span *span;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    text = pages[index].buffer->get_text();
    n = text_length(text);
    if (n > 200000)
        return;
    text_position(text, n, &line2, &col2);
    start = new TextIter(0, 0);
    end = new TextIter(line2, col2);
    if (pages[index].tags == 0) {
        pages[index].buffer->create_tag(
                "keyword",
                "#2040c0");
        pages[index].buffer->create_tag(
                "string",
                "#208020");
        pages[index].buffer->create_tag(
                "comment",
                "#808080");
        pages[index].buffer->create_tag(
                "number",
                "#804000");
        pages[index].buffer->create_tag(
                "type",
                "#6030a0");
        pages[index].buffer->create_tag(
                "preproc",
                "#a04020");
        pages[index].buffer->create_tag(
                "call",
                "#106060");
        pages[index].tags = 1;
    }
    if (n > 0) {
        pages[index].buffer->remove_tag(
                "keyword",
                start,
                end);
        pages[index].buffer->remove_tag(
                "string",
                start,
                end);
        pages[index].buffer->remove_tag(
                "comment",
                start,
                end);
        pages[index].buffer->remove_tag(
                "number",
                start,
                end);
        pages[index].buffer->remove_tag(
                "type",
                start,
                end);
        pages[index].buffer->remove_tag(
                "preproc",
                start,
                end);
        pages[index].buffer->remove_tag(
                "call",
                start,
                end);
    }
    scan = new Highlighter();
    scan->scan(text, doc->language());
    i = 0;
    while (i < scan->count()) {
        span = scan->at(i);
        text_position(text, span->start, &line, &col);
        text_position(text, span->end, &line2, &col2);
        start = new TextIter(line, col);
        end = new TextIter(line2, col2);
        name = "keyword";
        if (span->kind == SPAN_STRING)
            name = "string";
        if (span->kind == SPAN_COMMENT)
            name = "comment";
        if (span->kind == SPAN_NUMBER)
            name = "number";
        if (span->kind == SPAN_TYPE)
            name = "type";
        if (span->kind == SPAN_PREPROC)
            name = "preproc";
        if (span->kind == SPAN_CALL)
            name = "call";
        pages[index].buffer->apply_tag(name, start, end);
        i = i + 1;
    }
}

void Ui::paint_status(void) {
    status->set_text(state->status());
}

void Ui::refresh(void) {
    long i;

    if (pageCount != state->count())
        rebuild();
    else
        push_active();
    i = 0;
    while (i < pageCount) {
        retitle(i);
        paint_line(i);
        i = i + 1;
    }
    fill_documents();
    paint_status();
}

void Ui::show_main(void) {
    refresh();
    mainWindow->present();
}

void Ui::show_choice(const char *title, int mode) {
    choiceMode = mode;
    choiceDialog->set_title(title);
    choiceDialog->present();
}

void Ui::handle(int code) {
    if (code == EDITOR_NEEDS_CHOICE) {
        show_choice("Save changes?", 0);
        return;
    }
    if (code == EDITOR_NEEDS_PATH
            || code == EDITOR_CHOOSE_SAVE) {
        if (files->pending != 0)
            return;
        files->set_title("Save");
        arm_dialog();
        files->save(ui_saved, nullptr);
        return;
    }
    if (code == EDITOR_CHOOSE_OPEN) {
        if (files->pending != 0)
            return;
        files->set_title("Open");
        arm_dialog();
        files->open(ui_opened, nullptr);
        return;
    }
    if (code == EDITOR_FAILED
            && text_same(state->error(), "overwrite") == 1) {
        show_choice("Overwrite the file?", 1);
        return;
    }
    refresh();
}

void Ui::open_path(const char *path) {
    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0)
        return;
    note_folder(path);
    handle(state->open_file(path));
}

void Ui::save_path(const char *path) {
    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0) {
        handle(state->answer(EDITOR_CANCEL));
        return;
    }
    note_folder(path);
    pendingPath = new String();
    pendingPath->append(path);
    handle(state->provide_path(path));
}

void Ui::choice(int response) {
    if (choiceMode == 1) {
        choiceMode = 0;
        if (response == EDITOR_SAVE) {
            state->allow_overwrite(1);
            handle(state->provide_path(
                    pendingPath->c_str()));
            return;
        }
        handle(state->answer(EDITOR_CANCEL));
        return;
    }
    handle(state->answer(response));
    if (state->quit_ready() == 1)
        leave();
}

void Ui::user_begin(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].userDepth = pages[index].userDepth + 1;
}

void Ui::user_end(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].userDepth > 0)
        pages[index].userDepth =
                pages[index].userDepth - 1;
    if (pages[index].userDepth == 0)
        flush_sync(index);
}

void Ui::flush_sync(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].pendingIdle = 0;
    if (pages[index].pendingSync == 0)
        return;
    pages[index].pendingSync = 0;
    sync_view(index);
}

void Ui::sync_view(long index) {
    Document *doc;
    String *want;
    String *have;
    const char *wantRaw;
    const char *haveRaw;
    long wantN;
    long haveN;
    long prefix;
    long wantEnd;
    long haveEnd;
    long line;
    long column;
    long line2;
    long column2;
    TextIter *at;
    TextIter *bound;
    String *bit;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    want = new String();
    want->append(doc->buffer()->text());
    have = new String();
    have->append(pages[index].buffer->get_text());
    wantRaw = want->c_str();
    haveRaw = have->c_str();
    if (text_same(wantRaw, haveRaw) == 1) {
        place_cursor(index);
        return;
    }
    wantN = want->size();
    haveN = have->size();
    prefix = 0;
    while (prefix < wantN
            && prefix < haveN
            && wantRaw[prefix] == haveRaw[prefix])
        prefix = prefix + 1;
    wantEnd = wantN;
    haveEnd = haveN;
    while (wantEnd > prefix
            && haveEnd > prefix
            && wantRaw[wantEnd - 1] == haveRaw[haveEnd - 1]) {
        wantEnd = wantEnd - 1;
        haveEnd = haveEnd - 1;
    }
    applying = 1;
    if (haveEnd > prefix) {
        text_position(haveRaw, prefix, &line, &column);
        text_position(haveRaw, haveEnd, &line2, &column2);
        at = new TextIter(line, column);
        bound = new TextIter(line2, column2);
        pages[index].buffer->delete_range(at, bound);
    }
    if (wantEnd > prefix) {
        bit = slice_text(wantRaw, prefix, wantEnd);
        text_position(wantRaw, prefix, &line, &column);
        at = new TextIter(line, column);
        pages[index].buffer->insert(at, bit->c_str());
    }
    applying = 0;
    place_cursor(index);
    highlight(index);
    paint_line(index);
}

void Ui::changed(long index) {
    Document *doc;
    const char *text;
    int extra;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    text = pages[index].buffer->get_text();
    extra = doc->buffer()->note_external(text);
    if (extra == 1) {
        pages[index].pendingSync = 1;
        if (pages[index].userDepth == 0
                && pages[index].pendingIdle == 0) {
            pages[index].pendingIdle = 1;
            g_idle_add(
                    (void *)ui_sync_idle,
                    (void *)&refs[index]);
        }
    } else
        highlight(index);
    paint_status();
}

void Ui::moved(long index, long line, long offset) {
    Document *doc;

    if (applying == 1)
        return;
    if (index < 0 || index >= state->count())
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    doc->buffer()->move_to(line + 1, offset + 1);
    paint_line(index);
    paint_status();
}

void Ui::switched(long index) {
    state->set_index(index);
    paint_status();
}

TextBuffer *Ui::view_buffer(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return nullptr;
    return pages[index].buffer;
}

const char *Ui::page_text(long index) {
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].buffer == nullptr)
        return "";
    return pages[index].buffer->get_text();
}

const char *Ui::line_number_text(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].view == nullptr)
        return "";
    return pages[index].view->line_number_text();
}

long Ui::gutter_line_y(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return -1;
    if (pages[index].view == nullptr)
        return -1;
    return pages[index].view->line_number_origin(line);
}

void Ui::scroll_view(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    pages[index].view->scroll_to(line, 0);
}

void Ui::hide_settings(void) {
    if (settingsDialog == nullptr)
        return;
    settingsDialog->set_visible(false);
}

static int safe_color(const char *text) {
    long i;
    char ch;

    if (text == nullptr || text[0] == 0)
        return 0;
    i = 0;
    while (text[i] != 0) {
        if (i > 30)
            return 0;
        ch = text[i];
        if (ch >= 'a' && ch <= 'z') {
            i = i + 1;
            continue;
        }
        if (ch >= 'A' && ch <= 'Z') {
            i = i + 1;
            continue;
        }
        if (ch >= '0' && ch <= '9') {
            i = i + 1;
            continue;
        }
        if (ch == '#') {
            i = i + 1;
            continue;
        }
        return 0;
    }
    return 1;
}

void ui_line_toggle(void *data, bool value) {
    (void)data;
    if (value)
        editorUi->set_line_shown(1);
    else
        editorUi->set_line_shown(0);
}

void ui_margin_toggle(void *data, bool value) {
    (void)data;
    if (value)
        editorUi->set_margin_shown(1);
    else
        editorUi->set_margin_shown(0);
}

void ui_close_toggle(void *data, bool value) {
    (void)data;
    if (value)
        editorUi->set_close_shown(1);
    else
        editorUi->set_close_shown(0);
}

