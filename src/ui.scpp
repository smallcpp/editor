long Ui::panel_symbol_line(int index) {
    if (panel == nullptr)
        return (long)0;
    return panel->symbol_line(index);
}

void Ui::open_panel_symbol(int index) {
    Document *doc;
    long line;

    if (panel == nullptr || state == nullptr)
        return;
    line = panel->symbol_line(index);
    if (line < 1)
        return;
    doc = state->active();
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    doc->buffer()->move_to(line, 1);
    place_cursor(state->index());
    paint_status();
}

void Ui::prepare(void) {
    int opened;

    if (app != nullptr)
        return;
    opened = 0;
    if (state->count() > 1)
        opened = 1;
    if (state->count() == 1
            && state->at(0)->untitled() == 0)
        opened = 1;
    build();
    if (panel->root()[0] == 0) {
        char cwd[EDITOR_PATH];

        if (current_directory(cwd, EDITOR_PATH) == 1)
            show_folder(cwd);
    }
    if (opened == 0 && rememberFiles == 1 && openCount > 0)
        restore_files();
    else
        note_loaded();
    refresh();
}

MapColumn::MapColumn(void *owner, long index) : Widget() {
    void (*draw)(void *, void *, int, int, void *);
    void *click;

    this->owner = owner;
    page = index;
    pixels = 0;
    wide = 0;
    markAt = -1;
    markSize = 0;
    grab = 0;
    dragAt = 0;
    splitWide = 0;
    splitPos = -1;
    hooked = 0;
    markDrag = 0;
    adjust = nullptr;
    native = g_object_ref_sink(gtk_drawing_area_new());
    set_width_request(MAP_WIDTH);
    set_v_expand(true);
    set_h_expand(false);
    draw = map_draw;
    gtk_drawing_area_set_draw_func(
            native,
            (void *)draw,
            (void *)this,
            nullptr);
    click = gtk_event_controller_legacy_new();
    gtk_event_controller_set_propagation_phase(click, 1);
    g_signal_connect_data(
            click,
            "event",
            (void *)map_event,
            (void *)this,
            nullptr,
            0);
    gtk_widget_add_controller(native, click);
}

void MapColumn::redraw(void) {
    if (native == nullptr)
        return;
    gtk_widget_queue_draw(native);
}

void MapColumn::watch(void *view) {
    void (*typed)(void *, void *);
    void *next;

    if (view == nullptr || hooked != 0)
        return;
    next = gtk_scrollable_get_vadjustment(view);
    if (next == nullptr)
        return;
    adjust = next;
    typed = map_scrolled;
    g_signal_connect_data(
            adjust,
            "value-changed",
            (void *)typed,
            (void *)this,
            nullptr,
            0);
    hooked = 1;
}

void MapColumn::note_size(long width, long height) {
    if (width < 0)
        width = 0;
    if (height < 0)
        height = 0;
    wide = width;
    pixels = height;
}

long MapColumn::drawn_height(void) {
    return pixels;
}

long MapColumn::drawn_width(void) {
    return wide;
}

void Ui::redraw_map(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].map == nullptr)
        return;
    if (pages[index].view != nullptr)
        pages[index].map->watch(
                pages[index].view->native);
    pages[index].map->redraw();
}

void Ui::view_span(
        long index,
        long *first,
        long *count) {
    int rect[4];
    long words[12];
    long lines;
    long topLine;
    long endLine;
    int at;

    if (first != nullptr)
        *first = 0;
    if (count != nullptr)
        *count = 1;
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    if (state == nullptr || state->at(index) == nullptr)
        return;
    if (state->at(index)->buffer() == nullptr)
        return;
    lines = state->at(index)->buffer()->line_count();
    if (lines < 1)
        lines = 1;
    if (count != nullptr)
        *count = lines;
    if (gtk_widget_get_mapped(
                pages[index].view->native) == 0)
        return;
    rect[0] = 0;
    rect[1] = 0;
    rect[2] = 0;
    rect[3] = 0;
    gtk_text_view_get_visible_rect(
            pages[index].view->native,
            (void *)rect);
    if (rect[3] <= 0)
        return;
    at = 0;
    gtk_text_view_get_line_at_y(
            pages[index].view->native,
            (void *)words,
            rect[1],
            &at);
    topLine = gtk_text_iter_get_line((void *)words);
    at = 0;
    gtk_text_view_get_line_at_y(
            pages[index].view->native,
            (void *)words,
            rect[1] + rect[3] - 1,
            &at);
    endLine = gtk_text_iter_get_line((void *)words);
    if (topLine < 0)
        topLine = 0;
    if (endLine < topLine)
        endLine = topLine;
    if (endLine >= lines)
        endLine = lines - 1;
    if (first != nullptr)
        *first = topLine;
    if (count != nullptr)
        *count = endLine - topLine + 1;
}

static void copy_map_line(
        char *dest,
        long cap,
        const char *text,
        long line) {
    long i;
    long n;
    long row;
    long k;

    if (dest == nullptr || cap < 2)
        return;
    dest[0] = 0;
    if (text == nullptr || line < 0)
        return;
    n = text_length(text);
    i = 0;
    row = 0;
    while (i < n && row < line) {
        if (text[i] == '\n')
            row = row + 1;
        i = i + 1;
    }
    k = 0;
    while (i < n && text[i] != '\n' && k + 1 < cap) {
        int value;
        int step;

        value = byte_at(text, i);
        step = utf8_len(value);
        if (step < 1)
            step = 1;
        if (i + step > n)
            break;
        if (k + step >= cap)
            break;
        while (step > 0) {
            dest[k] = text[i];
            k = k + 1;
            i = i + 1;
            step = step - 1;
        }
    }
    dest[k] = 0;
}

static int text_pitch(void *widget, const char *face) {
    void *desc;
    void *sample;
    int wide;
    int tall;
    int pitch;

    pitch = 4;
    if (face == nullptr || face[0] == 0)
        face = "Monospace 3";
    desc = pango_font_description_from_string(face);
    sample = nullptr;
    if (widget != nullptr)
        sample = gtk_widget_create_pango_layout(widget, "Mg");
    if (sample != nullptr) {
        if (desc != nullptr)
            pango_layout_set_font_description(sample, desc);
        wide = 0;
        tall = 0;
        pango_layout_get_pixel_size(sample, &wide, &tall);
        g_object_unref(sample);
        if (tall > 1)
            pitch = tall;
    }
    if (desc != nullptr)
        pango_font_description_free(desc);
    if (pitch < 2)
        pitch = 2;
    return pitch;
}

static void draw_map_line(
        void *widget,
        void *cr,
        void *desc,
        const char *sample,
        long x,
        long y,
        long width,
        long clipH) {
    void *layout;

    if (widget == nullptr || cr == nullptr)
        return;
    if (sample == nullptr || sample[0] == 0)
        return;
    if (width < 4 || clipH < 1)
        return;
    layout = gtk_widget_create_pango_layout(widget, sample);
    if (layout == nullptr)
        return;
    if (desc != nullptr)
        pango_layout_set_font_description(layout, desc);
    pango_layout_set_width(layout, (int)((width - 2) * 1024));
    pango_layout_set_ellipsize(layout, 3);
    cairo_save(cr);
    cairo_rectangle(
            cr,
            (double)x,
            (double)y,
            (double)width,
            (double)clipH);
    cairo_clip(cr);
    cairo_set_source_rgba(cr, 0.16, 0.16, 0.18, 1.0);
    cairo_move_to(cr, (double)x, (double)y);
    pango_cairo_show_layout(cr, layout);
    cairo_restore(cr);
    g_object_unref(layout);
}

void Ui::paint_map_lines(
        void *widget,
        void *cr,
        int width,
        int height,
        const char *text,
        long lines) {
    void *desc;
    const char *face;
    int pitch;
    char row[160];

    if (widget == nullptr || cr == nullptr)
        return;
    if (width < 4 || height < 1 || lines < 1)
        return;
    face = mapFont;
    if (face[0] == 0)
        face = "Monospace 3";
    desc = pango_font_description_from_string(face);
    pitch = text_pitch(widget, face);
    if (pitch > height)
        pitch = height;
    if (map_fits(lines, (long)height, (long)pitch) == 1) {
        long line;
        long y;

        line = 0;
        while (line < lines) {
            y = line * (long)pitch;
            copy_map_line(row, 160, text, line);
            draw_map_line(
                    widget,
                    cr,
                    desc,
                    row,
                    1,
                    y,
                    (long)width - 2,
                    (long)pitch);
            line = line + 1;
        }
    } else {
        long y;

        y = 0;
        while (y + pitch <= height) {
            long line;

            line = map_line(lines, (long)height, y);
            copy_map_line(row, 160, text, line);
            draw_map_line(
                    widget,
                    cr,
                    desc,
                    row,
                    1,
                    y,
                    (long)width - 2,
                    (long)pitch);
            y = y + pitch;
        }
    }
    if (desc != nullptr)
        pango_font_description_free(desc);
}

int Ui::map_pitch(void *widget, long height) {
    const char *face;
    int pitch;

    face = mapFont;
    if (face == nullptr || face[0] == 0)
        face = "Monospace 3";
    pitch = text_pitch(widget, face);
    if (height > 0 && (long)pitch > height)
        pitch = (int)height;
    return pitch;
}

void Ui::scroll_line(long index, long line) {
    long words[12];
    int top;
    int tall;
    int i;
    void *adjust;
    double value;
    double upper;
    double page;
    double limit;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    if (pages[index].buffer == nullptr)
        return;
    if (line < 0)
        line = 0;
    i = 0;
    while (i < 12) {
        words[i] = 0;
        i = i + 1;
    }
    if (gtk_text_buffer_get_iter_at_line_offset(
                pages[index].buffer->native,
                (void *)words,
                (int)line,
                0) == 0) {
        pages[index].view->scroll_to(line, 0);
        return;
    }
    top = 0;
    tall = 0;
    gtk_text_view_get_line_yrange(
            pages[index].view->native,
            (void *)words,
            &top,
            &tall);
    adjust = gtk_scrollable_get_vadjustment(
            pages[index].view->native);
    if (adjust == nullptr) {
        pages[index].view->scroll_to(line, 0);
        return;
    }
    value = (double)top;
    upper = gtk_adjustment_get_upper(adjust);
    page = gtk_adjustment_get_page_size(adjust);
    limit = upper - page;
    if (limit < 0)
        limit = 0;
    if (value < 0)
        value = 0;
    if (value > limit)
        value = limit;
    gtk_adjustment_set_value(adjust, value);
}

int Ui::text_line_height(long index) {
    long words[12];
    int top;
    int tall;
    int i;

    tall = 16;
    if (index < 0 || index >= pageCount)
        return tall;
    if (pages[index].view == nullptr)
        return tall;
    if (pages[index].buffer == nullptr)
        return tall;
    i = 0;
    while (i < 12) {
        words[i] = 0;
        i = i + 1;
    }
    if (gtk_text_buffer_get_iter_at_line_offset(
                pages[index].buffer->native,
                (void *)words,
                0,
                0) == 0)
        return tall;
    top = 0;
    tall = 0;
    gtk_text_view_get_line_yrange(
            pages[index].view->native,
            (void *)words,
            &top,
            &tall);
    if (tall < 1)
        tall = 16;
    return tall;
}

void Ui::scroll_map_pixels(long index, double pixels) {
    void *adjust;
    double value;
    double upper;
    double page;
    double limit;

    if (pixels == 0)
        return;
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    adjust = gtk_scrollable_get_vadjustment(
            pages[index].view->native);
    if (adjust == nullptr)
        return;
    value = gtk_adjustment_get_value(adjust) + pixels;
    upper = gtk_adjustment_get_upper(adjust);
    page = gtk_adjustment_get_page_size(adjust);
    limit = upper - page;
    if (limit < 0)
        limit = 0;
    if (value < 0)
        value = 0;
    if (value > limit)
        value = limit;
    gtk_adjustment_set_value(adjust, value);
    redraw_map(index);
}

void Ui::scroll_map_wheel(long index, int steps) {
    int tall;

    if (steps == 0)
        return;
    tall = text_line_height(index);
    scroll_map_pixels(index, (double)steps * (double)tall);
}

void Ui::map_wheel(long index, void *event) {
    int direction;
    int unit;
    double across;
    double down;
    int tall;

    if (event == nullptr)
        return;
    if (gdk_scroll_event_is_stop(event) != 0)
        return;
    direction = gdk_scroll_event_get_direction(event);
    across = 0;
    down = 0;
    gdk_scroll_event_get_deltas(event, &across, &down);
    (void)across;
    if (direction == 4) {
        unit = gdk_scroll_event_get_unit(event);
        if (unit == 1) {
            scroll_map_pixels(index, down);
            return;
        }
        tall = text_line_height(index);
        scroll_map_pixels(
                index,
                down * (double)tall);
        return;
    }
    if (direction == 0)
        scroll_map_wheel(index, -1);
    if (direction == 1)
        scroll_map_wheel(index, 1);
}

static int wheel_steps(
        double *remain,
        int direction,
        int unit,
        double down,
        int tall) {
    double lines;
    int steps;

    if (direction == 0)
        return -1;
    if (direction == 1)
        return 1;
    if (direction != 4 || remain == nullptr)
        return 0;
    lines = down;
    if (unit == 1) {
        if (tall < 1)
            tall = 16;
        lines = down / (double)tall;
    }
    *remain = *remain + lines;
    steps = (int)*remain;
    *remain = *remain - (double)steps;
    return steps;
}

void Ui::scroll_view_delta(
        long index,
        int direction,
        int unit,
        double down) {
    int steps;

    steps = wheel_steps(
            &wheelRemain,
            direction,
            unit,
            down,
            text_line_height(index));
    if (steps == 0)
        return;
    wheel_lines(index, steps);
}

void Ui::buffer_wheel(long index, void *event) {
    int direction;
    int unit;
    double across;
    double down;

    if (event == nullptr)
        return;
    if (gdk_scroll_event_is_stop(event) != 0)
        return;
    direction = gdk_scroll_event_get_direction(event);
    across = 0;
    down = 0;
    gdk_scroll_event_get_deltas(event, &across, &down);
    (void)across;
    unit = 0;
    if (direction == 4)
        unit = gdk_scroll_event_get_unit(event);
    scroll_view_delta(index, direction, unit, down);
}

void Ui::wheel_lines(long index, int steps) {
    Document *doc;
    long line;
    long column;
    long first;
    long shown;
    long last;
    long fromTop;
    long fromBottom;
    long want;
    int margin;
    TextIter *at;

    if (steps == 0)
        return;
    if (index < 0 || index >= pageCount)
        return;
    if (state == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    if (pages[index].buffer == nullptr)
        return;
    if (pages[index].view != nullptr
            && pages[index].view->caret_count() > 1) {
        pages[index].view->clear_carets();
        doc->buffer()->clear_carets();
    }
    line = doc->buffer()->cursor_line() + (long)steps;
    column = doc->buffer()->cursor_column();
    if (line < 1)
        line = 1;
    if (line > doc->buffer()->line_count())
        line = doc->buffer()->line_count();
    doc->buffer()->move_to(line, column);
    applying = 1;
    {
        long zeroLine;
        long zeroCol;

        doc->buffer()->line_column_at(
                doc->buffer()->cursor_offset(),
                &zeroLine,
                &zeroCol);
        at = new TextIter(zeroLine, zeroCol);
        pages[index].buffer->place_cursor(at);
    }
    applying = 0;
    paint_brackets(index);
    paint_line(index);
    paint_status();
    margin = wheelMargin;
    if (margin < 0)
        margin = 0;
    view_span(index, &first, &shown);
    if (shown < 1)
        shown = 1;
    first = first + 1;
    last = first + shown - 1;
    fromTop = line - first;
    fromBottom = last - line;
    want = first;
    if (fromTop < (long)margin
            && (fromBottom >= (long)margin
                    || steps < 0)) {
        want = line - (long)margin;
        if (want < 1)
            want = 1;
    } else if (fromBottom < (long)margin) {
        want = line + (long)margin - shown + 1;
        if (want < 1)
            want = 1;
    }
    if (want != first)
        scroll_line(index, want - 1);
    redraw_map(index);
}

void Ui::show_first(long line) {
    long index;

    if (state == nullptr)
        return;
    index = state->index();
    if (line < 1)
        line = 1;
    scroll_line(index, line - 1);
    redraw_map(index);
}

long Ui::shown_first(void) {
    long index;
    long first;
    long count;

    if (state == nullptr)
        return (long)1;
    index = state->index();
    view_span(index, &first, &count);
    return first + 1;
}

long Ui::shown_count(void) {
    long index;
    long first;
    long count;

    if (state == nullptr)
        return (long)1;
    index = state->index();
    view_span(index, &first, &count);
    if (count < 1)
        return (long)1;
    return count;
}

void Ui::place_at(long line, long column) {
    long index;
    Document *doc;
    long zeroLine;
    long zeroCol;
    TextIter *at;

    if (state == nullptr)
        return;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc->buffer()->move_to(line, column);
    applying = 1;
    doc->buffer()->line_column_at(
            doc->buffer()->cursor_offset(),
            &zeroLine,
            &zeroCol);
    at = new TextIter(zeroLine, zeroCol);
    pages[index].buffer->place_cursor(at);
    applying = 0;
    paint_line(index);
    paint_status();
    redraw_map(index);
}

void Ui::paint_map(
        MapColumn *column,
        void *cr,
        int width,
        int height) {
    Document *doc;
    const char *text;
    long lines;
    long first;
    long count;
    long top;
    long band;
    long line;
    int pitch;
    int packed;

    if (column == nullptr || cr == nullptr)
        return;
    if (width < 1 || height < 1)
        return;
    cairo_set_source_rgba(cr, 0.93, 0.93, 0.94, 1.0);
    cairo_rectangle(cr, 0, 0, (double)width, (double)height);
    cairo_fill(cr);
    if (state == nullptr)
        return;
    doc = state->at(column->page);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    text = doc->buffer()->text();
    lines = doc->buffer()->line_count();
    if (lines < 1)
        lines = 1;
    pitch = map_pitch(column->native, (long)height);
    packed = map_fits(lines, (long)height, (long)pitch);
    if (column->native != nullptr)
        paint_map_lines(
                column->native,
                cr,
                width,
                height,
                text,
                lines);
    view_span(column->page, &first, &count);
    map_place_at(
            lines,
            (long)height,
            first,
            count,
            (long)pitch,
            &top,
            &band);
    cairo_set_source_rgba(cr, 0.25, 0.45, 0.75, 0.28);
    cairo_rectangle(
            cr,
            0,
            (double)top,
            (double)width,
            (double)band);
    cairo_fill(cr);
    line = doc->buffer()->cursor_line() - 1;
    if (line < 0)
        line = 0;
    if (line >= lines)
        line = lines - 1;
    top = map_top_at(lines, (long)height, line, (long)pitch);
    band = map_top_at(
            lines,
            (long)height,
            line + 1,
            (long)pitch) - top;
    if (packed == 0 && band < 4)
        band = 4;
    if (packed == 1 && band < 1)
        band = 1;
    if (top + band > (long)height)
        top = (long)height - band;
    if (top < 0)
        top = 0;
    column->markAt = top;
    column->markSize = band;
    cairo_set_source_rgba(cr, 0.86, 0.42, 0.10, 0.35);
    cairo_rectangle(
            cr,
            0,
            (double)top,
            (double)width,
            (double)band);
    cairo_fill(cr);
}

long Ui::map_height(void) {
    long index;

    if (state == nullptr)
        return (long)0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return (long)0;
    if (pages[index].map == nullptr)
        return (long)0;
    return pages[index].map->drawn_height();
}

long Ui::map_top(void) {
    long index;
    long lines;
    long height;
    long first;
    long count;
    long top;
    long band;

    if (state == nullptr)
        return (long)0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return (long)0;
    if (state->at(index) == nullptr)
        return (long)0;
    if (state->at(index)->buffer() == nullptr)
        return (long)0;
    height = map_height();
    if (height < 1)
        return (long)0;
    lines = state->at(index)->buffer()->line_count();
    view_span(index, &first, &count);
    map_place_at(
            lines,
            height,
            first,
            count,
            (long)map_pitch(pages[index].map->native, height),
            &top,
            &band);
    return top;
}

long Ui::map_band(void) {
    long index;
    long lines;
    long height;
    long first;
    long count;
    long top;
    long band;

    if (state == nullptr)
        return (long)0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return (long)0;
    if (state->at(index) == nullptr)
        return (long)0;
    if (state->at(index)->buffer() == nullptr)
        return (long)0;
    height = map_height();
    if (height < 1)
        return (long)0;
    lines = state->at(index)->buffer()->line_count();
    view_span(index, &first, &count);
    map_place_at(
            lines,
            height,
            first,
            count,
            (long)map_pitch(pages[index].map->native, height),
            &top,
            &band);
    return band;
}

int Ui::map_ink(long line) {
    Document *doc;

    if (state == nullptr)
        return 0;
    doc = state->active();
    if (doc == nullptr || doc->buffer() == nullptr)
        return 0;
    return map_ink_at(doc->buffer()->text(), line);
}

long Ui::map_mark(void) {
    long index;

    if (state == nullptr)
        return (long)-1;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return (long)-1;
    if (pages[index].map == nullptr)
        return (long)-1;
    return pages[index].map->markAt;
}

int Ui::on_map_mark(long page, long y) {
    long at;
    long size;

    if (page < 0 || page >= pageCount)
        return 0;
    if (pages[page].map == nullptr)
        return 0;
    at = pages[page].map->markAt;
    size = pages[page].map->markSize;
    if (at < 0)
        return 0;
    if (size < 4)
        size = 4;
    if (y >= at - 3 && y < at + size + 3)
        return 1;
    return 0;
}

void Ui::scroll_map_y(long index, long y) {
    long lines;
    long height;
    long line;
    Document *doc;

    if (state == nullptr)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    if (pages[index].map == nullptr)
        return;
    lines = doc->buffer()->line_count();
    height = pages[index].map->drawn_height();
    if (height < 1)
        height = 1;
    if (y < 0)
        y = 0;
    if (y >= height)
        y = height - 1;
    line = map_line_at(
            lines,
            height,
            y,
            (long)map_pitch(pages[index].map->native, height));
    scroll_line(index, line);
    redraw_map(index);
}

void Ui::drag_map_mark(long y) {
    if (state == nullptr)
        return;
    scroll_map_y(state->index(), y);
}

void Ui::map_button(long page, long y, int down) {
    int hit;

    if (page < 0 || page >= pageCount)
        return;
    if (pages[page].map == nullptr)
        return;
    if (down == 0) {
        pages[page].map->markDrag = 0;
        return;
    }
    hit = on_map_mark(page, y);
    if (hit == 0)
        hit = in_map_band(page, y);
    if (hit == 1) {
        pages[page].map->markDrag = 1;
        pages[page].map->grab = y;
        pages[page].map->dragAt = band_top(page);
        return;
    }
    map_click(y);
}

void Ui::map_drag(long page, long y) {
    long desired;

    if (page < 0 || page >= pageCount)
        return;
    if (pages[page].map == nullptr)
        return;
    if (pages[page].map->markDrag == 0)
        return;
    desired = pages[page].map->dragAt
            + (y - pages[page].map->grab);
    scroll_map_y(page, desired);
}

long Ui::band_top(long page) {
    long lines;
    long height;
    long first;
    long count;
    long top;
    long band;

    if (page < 0 || page >= pageCount)
        return (long)0;
    if (pages[page].map == nullptr)
        return (long)0;
    if (state == nullptr || state->at(page) == nullptr)
        return (long)0;
    if (state->at(page)->buffer() == nullptr)
        return (long)0;
    height = pages[page].map->drawn_height();
    if (height < 1)
        return (long)0;
    lines = state->at(page)->buffer()->line_count();
    view_span(page, &first, &count);
    map_place_at(
            lines,
            height,
            first,
            count,
            (long)map_pitch(pages[page].map->native, height),
            &top,
            &band);
    return top;
}

int Ui::in_map_band(long page, long y) {
    long lines;
    long height;
    long first;
    long count;
    long top;
    long band;

    if (page < 0 || page >= pageCount)
        return 0;
    if (pages[page].map == nullptr)
        return 0;
    if (state == nullptr || state->at(page) == nullptr)
        return 0;
    if (state->at(page)->buffer() == nullptr)
        return 0;
    height = pages[page].map->drawn_height();
    if (height < 1)
        return 0;
    lines = state->at(page)->buffer()->line_count();
    view_span(page, &first, &count);
    map_place_at(
            lines,
            height,
            first,
            count,
            (long)map_pitch(pages[page].map->native, height),
            &top,
            &band);
    if (band < 8)
        band = 8;
    if (y >= top - 3 && y < top + band + 3)
        return 1;
    return 0;
}

long Ui::map_width(void) {
    long index;

    if (state == nullptr)
        return mapWide;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return mapWide;
    if (pages[index].map == nullptr
            || pages[index].map->native == nullptr)
        return mapWide;
    if (gtk_widget_get_width(pages[index].map->native) > 0)
        return (long)gtk_widget_get_width(
                pages[index].map->native);
    if (pages[index].map->drawn_width() > 0)
        return pages[index].map->drawn_width();
    return mapWide;
}

void Ui::note_map_split(long index) {
    int wide;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].map == nullptr
            || pages[index].mapSplit == nullptr)
        return;
    if (pages[index].mapSplit->native == nullptr)
        return;
    wide = gtk_widget_get_width(
            pages[index].mapSplit->native);
    pages[index].map->splitWide = (long)wide;
    pages[index].map->splitPos =
            pages[index].mapSplit->position();
}

void Ui::sync_map_spin(void) {
    if (mapWidthSpin == nullptr)
        return;
    if ((long)mapWidthSpin->value() == mapWide)
        return;
    mapSpinHold = 1;
    mapWidthSpin->set_value((double)mapWide);
    mapSpinHold = 0;
}

void Ui::remember_map_width(void) {
    if (mapSave == 1)
        return;
    mapSave = 1;
    g_idle_add((void *)map_save_idle, nullptr);
}

void Ui::save_map_width(void) {
    mapSave = 0;
    if (settingsHold != 0 || leaving == 1)
        return;
    apply_settings();
}

int Ui::map_spin_locked(void) {
    return mapSpinHold;
}

void Ui::place_map(long index) {
    int wide;
    int held;
    long room;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].mapSplit == nullptr)
        return;
    if (pages[index].mapSplit->native == nullptr)
        return;
    wide = gtk_widget_get_width(
            pages[index].mapSplit->native);
    room = (long)wide - mapGap - mapWide;
    if (room < 80) {
        note_map_split(index);
        return;
    }
    if (pages[index].mapSplit->position() == room) {
        note_map_split(index);
        return;
    }
    held = mapHold;
    mapHold = 1;
    pages[index].mapSplit->set_position(room);
    mapHold = held;
    note_map_split(index);
}

void Ui::keep_map_width(long index) {
    int panedWide;
    long pos;
    long end;

    if (mapHold != 0)
        return;
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].map == nullptr
            || pages[index].mapSplit == nullptr)
        return;
    if (pages[index].mapSplit->native == nullptr)
        return;
    panedWide = gtk_widget_get_width(
            pages[index].mapSplit->native);
    if (panedWide < 1)
        return;
    pos = pages[index].mapSplit->position();
    if (pages[index].map->splitWide == (long)panedWide
            && pos == pages[index].map->splitPos)
        return;
    if (pages[index].map->splitWide == (long)panedWide) {
        pages[index].map->splitPos = pos;
        end = (long)panedWide - mapGap - pos;
        if (end < MAP_WIDE_MIN)
            end = MAP_WIDE_MIN;
        if (end > MAP_WIDE_MAX)
            end = MAP_WIDE_MAX;
        if (end == mapWide)
            return;
        mapWide = end;
        mapHold = 1;
        pages[index].map->set_width_request(mapWide);
        mapHold = 0;
        sync_map_spin();
        remember_map_width();
        mapFollow = 1;
        if ((long)panedWide - mapGap - pos != end)
            place_map(index);
        return;
    }
    mapFollow = 0;
    mapHold = 1;
    pages[index].map->set_width_request(mapWide);
    mapHold = 0;
    place_map(index);
}

void Ui::pin_map(long index) {
    int got;
    int panedWide;
    long pos;
    long gap;
    long end;

    if (mapHold != 0)
        return;
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].map == nullptr
            || pages[index].map->native == nullptr)
        return;
    got = gtk_widget_get_width(pages[index].map->native);
    if (got < 1)
        return;
    if (pages[index].mapSplit != nullptr
            && pages[index].mapSplit->native != nullptr) {
        panedWide = gtk_widget_get_width(
                pages[index].mapSplit->native);
        pos = pages[index].mapSplit->position();
        if (panedWide > 0 && (long)panedWide > pos) {
            gap = (long)panedWide - pos - (long)got;
            if (gap >= 0 && gap < 48)
                mapGap = gap;
        }
    }
    if (mapFollow == 1) {
        end = (long)got;
        if (end < MAP_WIDE_MIN)
            end = MAP_WIDE_MIN;
        if (end > MAP_WIDE_MAX)
            end = MAP_WIDE_MAX;
        mapFollow = 0;
        if (end != mapWide) {
            mapWide = end;
            mapHold = 1;
            pages[index].map->set_width_request(mapWide);
            mapHold = 0;
            sync_map_spin();
            remember_map_width();
        }
        if ((long)got != mapWide)
            place_map(index);
        else
            note_map_split(index);
        return;
    }
    if (got > (int)mapWide - 3 && got < (int)mapWide + 3) {
        note_map_split(index);
        return;
    }
    mapHold = 1;
    pages[index].map->set_width_request(mapWide);
    mapHold = 0;
    place_map(index);
}

void Ui::set_map_spin(long width) {
    if (mapWidthSpin == nullptr)
        return;
    mapWidthSpin->set_value((double)width);
}

long Ui::map_spin(void) {
    if (mapWidthSpin == nullptr)
        return mapWide;
    return (long)mapWidthSpin->value();
}

void Ui::move_map_bar(long endWidth) {
    long index;
    int wide;
    long room;

    if (state == nullptr)
        return;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].mapSplit == nullptr
            || pages[index].mapSplit->native == nullptr)
        return;
    wide = gtk_widget_get_width(
            pages[index].mapSplit->native);
    room = (long)wide - mapGap - endWidth;
    if (room < 80)
        return;
    pages[index].mapSplit->set_position(room);
}

void Ui::set_map_width(long width) {
    long i;

    if (width < MAP_WIDE_MIN)
        width = MAP_WIDE_MIN;
    if (width > MAP_WIDE_MAX)
        width = MAP_WIDE_MAX;
    mapWide = width;
    i = 0;
    while (i < pageCount) {
        if (pages[i].map != nullptr) {
            mapHold = 1;
            pages[i].map->set_width_request(width);
            mapHold = 0;
        }
        place_map(i);
        i = i + 1;
    }
    sync_map_spin();
}

long Ui::panel_width(void) {
    int box[4];

    if (panelFrame == nullptr || panelFrame->native == nullptr)
        return (long)0;
    box[0] = 0;
    box[1] = 0;
    box[2] = 0;
    box[3] = 0;
    gtk_widget_get_allocation(panelFrame->native, box);
    return (long)box[2];
}

void Ui::set_panel_width(long width) {
    if (editorSplit == nullptr)
        return;
    if (width < 64)
        width = 64;
    leftWidth = (int)width;
    panelHold = 1;
    editorSplit->set_position(width);
    panelHold = 0;
}

void Ui::map_click(long y) {
    long index;
    long lines;
    long height;
    long line;

    if (state == nullptr)
        return;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (state->at(index) == nullptr)
        return;
    if (state->at(index)->buffer() == nullptr)
        return;
    lines = state->at(index)->buffer()->line_count();
    height = map_height();
    if (height < 1)
        height = 1;
    line = map_line(lines, height, y);
    scroll_view(line);
    redraw_map(index);
}

void Ui::add_page(long index) {
    Document *doc;
    char title[256];
    ScrolledWindow *scroll;

    doc = state->at(index);
    if (doc == nullptr)
        return;
    pages[index].buffer = new TextBuffer();
    pages[index].view = new TextView(pages[index].buffer);
    pages[index].view->set_monospace(true);
    pages[index].view->set_editable(true);
    pages[index].view->set_line_numbers(true);
    arm_buffer_menu(pages[index].view->native);
    {
        void *wheel;
        int (*on_wheel)(void *, void *, void *);

        wheel = gtk_event_controller_legacy_new();
        gtk_event_controller_set_propagation_phase(
                wheel,
                1);
        on_wheel = view_scroll_event;
        g_signal_connect_data(
                wheel,
                "event",
                (void *)on_wheel,
                (void *)&refs[index],
                nullptr,
                0);
        gtk_widget_add_controller(
                pages[index].view->native,
                wheel);
    }
    pages[index].userDepth = 0;
    pages[index].pendingSync = 0;
    pages[index].pendingIdle = 0;
    scroll = new ScrolledWindow();
    scroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    scroll->set_child((Widget *)pages[index].view);
    scroll->set_h_expand(true);
    scroll->set_v_expand(true);
    pages[index].scroll = scroll;
    pages[index].map = new MapColumn((void *)this, index);
    pages[index].map->set_width_request(mapWide);
    pages[index].map->watch(pages[index].view->native);
    g_signal_connect_data(
            pages[index].view->native,
            "map",
            (void *)map_mapped,
            (void *)pages[index].map,
            nullptr,
            0);
    pages[index].tags = 0;
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    applying = 0;
    pages[index].buffer->on_changed(
            ui_changed,
            (void *)&refs[index]);
    g_signal_connect_data(
            pages[index].buffer->native,
            "begin-user-action",
            (void *)ui_user_begin,
            (void *)&refs[index],
            nullptr,
            0);
    g_signal_connect_data(
            pages[index].buffer->native,
            "end-user-action",
            (void *)ui_user_end,
            (void *)&refs[index],
            nullptr,
            0);
    pages[index].view->on_move_cursor(
            ui_moved,
            (void *)&refs[index]);
    g_signal_connect_data(
            pages[index].buffer->native,
            "mark-set",
            (void *)ui_mark,
            (void *)&refs[index],
            nullptr,
            0);
    text_copy(title, 256, doc->title());
    {
        Paned *split;

        split = new Paned(GTK_HORIZONTAL);
        split->set_h_expand(true);
        split->set_v_expand(true);
        gtk_paned_set_resize_start_child(split->native, 1);
        gtk_paned_set_shrink_start_child(split->native, 1);
        gtk_paned_set_resize_end_child(split->native, 0);
        gtk_paned_set_shrink_end_child(split->native, 1);
        gtk_paned_set_wide_handle(split->native, 1);
        split->set_start_child((Widget *)scroll);
        split->set_end_child((Widget *)pages[index].map);
        pages[index].mapSplit = split;
        g_signal_connect_data(
                split->native,
                "notify::position",
                (void *)map_split_moved,
                (void *)&refs[index],
                nullptr,
                0);
        if (showMap == 0)
            pages[index].map->set_visible(false);
        book->append_page((Widget *)split, title);
    }
    pageCount = pageCount + 1;
    mount_tab(index, title);
    apply_view(index);
    highlight(index);
    place_cursor(index);
    paint_line(index);
}

void Ui::rebuild(void) {
    long i;
    long n;
    long want;

    want = state->index();
    building = 1;
    while (pageCount > 0) {
        book->remove_page(0);
        pageCount = pageCount - 1;
    }
    i = 0;
    while (i < EDITOR_PAGES) {
        pages[i].buffer = nullptr;
        pages[i].view = nullptr;
        pages[i].scroll = nullptr;
        pages[i].map = nullptr;
        pages[i].mapSplit = nullptr;
        pages[i].tags = 0;
        pages[i].userDepth = 0;
        pages[i].pendingSync = 0;
        pages[i].pendingIdle = 0;
        tabTitle[i] = nullptr;
        i = i + 1;
    }
    n = state->count();
    if (n > EDITOR_PAGES)
        n = EDITOR_PAGES;
    i = 0;
    while (i < n) {
        add_page(i);
        i = i + 1;
    }
    building = 0;
    if (pageCount == 0)
        return;
    if (want < 0 || want >= pageCount)
        want = 0;
    state->set_index(want);
    book->set_current_page(want);
}

void Ui::place_cursor(long index) {
    Document *doc;
    TextIter *at;
    TextIter *bound;
    long line;
    long column;
    long line2;
    long column2;
    long lo;
    long hi;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    if (doc->buffer()->has_selection() == false) {
        doc->buffer()->line_column_at(
                doc->buffer()->cursor_offset(),
                &line,
                &column);
        at = new TextIter(line, column);
        pages[index].buffer->place_cursor(at);
        if (pages[index].view != nullptr)
            pages[index].view->scroll_to(line, column);
        return;
    }
    lo = doc->buffer()->sel_lo();
    hi = doc->buffer()->sel_hi();
    doc->buffer()->line_column_at(lo, &line, &column);
    doc->buffer()->line_column_at(hi, &line2, &column2);
    at = new TextIter(line, column);
    bound = new TextIter(line2, column2);
    pages[index].buffer->select_range(at, bound);
    doc->buffer()->line_column_at(
            doc->buffer()->cursor_offset(),
            &line,
            &column);
    if (pages[index].view != nullptr)
        pages[index].view->scroll_to(line, column);
}

TextView *Ui::current_view(void) {
    long index;

    if (state == nullptr)
        return nullptr;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return nullptr;
    return pages[index].view;
}

void Ui::record_macro(int on) {
    TextView *view;

    view = current_view();
    if (view == nullptr)
        return;
    view->record(on);
}

void Ui::record_key(const char *accel) {
    TextView *view;

    view = current_view();
    if (view == nullptr || accel == nullptr)
        return;
    view->record_key(accel);
}

int Ui::recorded_keys(void) {
    TextView *view;

    view = current_view();
    if (view == nullptr)
        return 0;
    return view->recorded();
}

void Ui::play_macro(void) {
    TextView *view;
    int n;
    int i;

    view = current_view();
    if (view == nullptr)
        return;
    view->record(0);
    n = view->recorded();
    i = 0;
    while (i < n) {
        char key[64];
        const char *raw;
        int handled;
        int slot;

        raw = view->recorded_key(i);
        if (raw == nullptr)
            raw = "";
        text_copy(key, 64, raw);
        handled = view->play_key(key);
        if (handled == 0 && state != nullptr) {
            slot = 0;
            while (slot < EDITOR_KEY_COUNT) {
                const char *label;
                const char *command;
                const char *config;
                const char *accel;

                key_info(
                        slot,
                        &label,
                        &command,
                        &config,
                        &accel);
                (void)label;
                (void)config;
                (void)accel;
                if (text_same(keyAccel[slot], key) == 1) {
                    if (text_same(command, "select-all") == 1)
                        select_file();
                    else
                        handle(state->run(command));
                    break;
                }
                slot = slot + 1;
            }
        }
        i = i + 1;
    }
}

void Ui::take_carets(long index) {
    TextView *view;
    EditBuffer *buf;
    int n;
    int i;
    long line;
    long column;

    if (index < 0 || index >= pageCount)
        return;
    view = pages[index].view;
    if (view == nullptr || state == nullptr)
        return;
    if (state->at(index) == nullptr)
        return;
    buf = state->at(index)->buffer();
    if (buf == nullptr)
        return;
    n = view->caret_count();
    if (n < 1)
        return;
    if (view->caret_at(0, &line, &column) != 0)
        buf->move_to(line + 1, column + 1);
    buf->clear_carets();
    i = 1;
    while (i < n) {
        if (view->caret_at(i, &line, &column) != 0)
            buf->add_caret(line, column);
        i = i + 1;
    }
}

void Ui::apply_carets(long index) {
    TextView *view;
    EditBuffer *buf;
    int i;
    long line;
    long column;

    if (index < 0 || index >= pageCount)
        return;
    view = pages[index].view;
    if (view == nullptr || state == nullptr)
        return;
    if (state->at(index) == nullptr)
        return;
    buf = state->at(index)->buffer();
    if (buf == nullptr)
        return;
    view->clear_carets();
    i = 0;
    while (i < buf->caret_count()) {
        if (buf->caret_at(i, &line, &column) != 0)
            view->add_caret(line, column);
        i = i + 1;
    }
}

void Ui::add_caret(long line, long column) {
    Document *doc;
    TextView *view;
    long index;
    long byte;
    long useLine;
    long useCol;
    long primaryLine;
    long primaryCol;

    if (state == nullptr)
        return;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    if (line < 0 || column < 0)
        return;
    if (line >= doc->buffer()->line_count())
        return;
    view = pages[index].view;
    if (view != nullptr
            && view->caret_at(
                    0,
                    &primaryLine,
                    &primaryCol) != 0)
        doc->buffer()->move_to(
                primaryLine + 1,
                primaryCol + 1);
    byte = doc->buffer()->byte_at_line(line, column);
    doc->buffer()->line_column_at(byte, &useLine, &useCol);
    if (view != nullptr) {
        if (view->add_caret(useLine, useCol) == 0)
            return;
    }
    doc->buffer()->add_caret(useLine, useCol);
}

void Ui::add_next_caret(void) {
    Document *doc;
    long index;
    long line;
    long column;

    if (state == nullptr)
        return;
    index = state->index();
    if (index < 0 || index >= state->count())
        return;
    doc = state->at(index);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    if (pages[index].view != nullptr) {
        long primaryLine;
        long primaryCol;

        if (pages[index].view->caret_at(
                    0,
                    &primaryLine,
                    &primaryCol) != 0)
            doc->buffer()->move_to(
                    primaryLine + 1,
                    primaryCol + 1);
    }
    doc->buffer()->line_column_at(
            doc->buffer()->cursor_offset(),
            &line,
            &column);
    if (line + 1 >= doc->buffer()->line_count())
        return;
    add_caret(line + 1, column);
}

void Ui::clear_carets(void) {
    long index;

    if (state == nullptr)
        return;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view != nullptr)
        pages[index].view->clear_carets();
    if (state->at(index) != nullptr
            && state->at(index)->buffer() != nullptr)
        state->at(index)->buffer()->clear_carets();
}

int Ui::caret_count(void) {
    long index;

    if (state == nullptr)
        return 0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return 0;
    if (pages[index].view == nullptr)
        return 1;
    return pages[index].view->caret_count();
}

void Ui::push_active(void) {
    long index;
    Document *doc;

    index = state->index();
    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->active();
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    retitle(index);
    if (text_same(
                pages[index].buffer->get_text(),
                doc->buffer()->text()) == 1) {
        place_cursor(index);
        paint_line(index);
        return;
    }
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    place_cursor(index);
    applying = 0;
    highlight(index);
    paint_line(index);
}

void Ui::take_selection(void) {
    TextBuffer *gtkBuf;
    TextIter *start;
    TextIter *end;
    Document *doc;
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    gtkBuf = pages[index].buffer;
    if (gtkBuf == nullptr)
        return;
    doc = state->active();
    if (doc == nullptr)
        return;
    start = new TextIter(0, 0);
    end = new TextIter(0, 0);
    if (gtkBuf->selection_bounds(start, end) == false)
        return;
    doc->buffer()->select_span(
            start->line() + 1,
            start->offset() + 1,
            end->line() + 1,
            end->offset() + 1);
}

static void seek_offset(
        const char *text,
        long n,
        long target,
        long *at,
        long *line,
        long *column) {
    int value;
    int step;

    if (target < *at) {
        *at = 0;
        *line = 0;
        *column = 0;
    }
    if (target > n)
        target = n;
    while (*at < target) {
        value = byte_at(text, *at);
        if (value == '\n') {
            *line = *line + 1;
            *column = 0;
            *at = *at + 1;
            continue;
        }
        step = utf8_len(value);
        if (*at + step > target) {
            *at = target;
            return;
        }
        *column = *column + 1;
        *at = *at + step;
    }
}

void Ui::highlight(long index) {
    Highlighter *scan;
    Document *doc;
    const char *text;
    long i;
    long byte;
    long line;
    long col;
    long line2;
    long col2;
    long n;
    TextIter *start;
    TextIter *end;
    const char *name;
    const char *color;
    Span *span;
    int kind;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    doc->apply_language();
    text = pages[index].buffer->get_text();
    n = text_length(text);
    if (n > 200000)
        return;
    text_position(text, n, &line2, &col2);
    start = new TextIter(0, 0);
    end = new TextIter(line2, col2);
    kind = SPAN_KEYWORD;
    while (kind <= SPAN_OPERATOR) {
        name = span_tag(kind);
        color = theme_color(
                themeConfig,
                doc->language(),
                name);
        pages[index].buffer->set_tag_foreground(
                name,
                color);
        {
            bool heavy;

            heavy = false;
            if (theme_bold(
                    themeConfig,
                    doc->language(),
                    name) == 1)
                heavy = true;
            pages[index].buffer->set_tag_bold(
                    name,
                    heavy);
        }
        {
            char backName[40];
            const char *back;
            long at;

            at = 0;
            while (name[at] != 0 && at < 30) {
                backName[at] = name[at];
                at = at + 1;
            }
            backName[at] = '-';
            backName[at + 1] = 'b';
            backName[at + 2] = 'a';
            backName[at + 3] = 'c';
            backName[at + 4] = 'k';
            backName[at + 5] = 0;
            back = theme_color(
                    themeConfig,
                    doc->language(),
                    backName);
            if (back[0] != 0
                    && text_same(back, "none") == 0)
                pages[index].buffer->set_tag_text_background(
                        name,
                        back);
        }
        if (n > 0)
            pages[index].buffer->remove_tag(
                    name,
                    start,
                    end);
        kind = kind + 1;
    }
    pages[index].tags = 1;
    scan = new Highlighter();
    scan->scan(text, doc->language());
    byte = 0;
    line = 0;
    col = 0;
    i = 0;
    while (i < scan->count()) {
        span = scan->at(i);
        seek_offset(text, n, span->start, &byte, &line, &col);
        line2 = line;
        col2 = col;
        seek_offset(text, n, span->end, &byte, &line, &col);
        start = new TextIter(line2, col2);
        end = new TextIter(line, col);
        name = span->tag;
        if (name != nullptr && name[0] != 0)
            pages[index].buffer->apply_tag(
                    name,
                    start,
                    end);
        i = i + 1;
    }
    paint_brackets(index);
}

static void paint_one(
        TextBuffer *buffer,
        const char *text,
        long n,
        long offset,
        const char *name) {
    long at;
    long line;
    long column;
    long line2;
    long column2;
    TextIter *start;
    TextIter *end;

    at = 0;
    line = 0;
    column = 0;
    seek_offset(
            text,
            n,
            offset,
            &at,
            &line,
            &column);
    line2 = line;
    column2 = column;
    seek_offset(
            text,
            n,
            offset + 1,
            &at,
            &line,
            &column);
    start = new TextIter(line2, column2);
    end = new TextIter(line, column);
    buffer->apply_tag(name, start, end);
}

static void prepare_bracket_tag(
        TextBuffer *buffer,
        const EditorConfig *theme,
        const char *language,
        const char *name,
        const char *back,
        TextIter *start,
        TextIter *end,
        int clear) {
    buffer->set_tag_foreground(
            name,
            theme_color(theme, language, name));
    {
        bool heavy;

        heavy = false;
        if (theme_bold(theme, language, name) == 1)
            heavy = true;
        buffer->set_tag_bold(name, heavy);
    }
    buffer->set_tag_text_background(
            name,
            theme_color(theme, language, back));
    if (clear == 1)
        buffer->remove_tag(name, start, end);
}

void Ui::paint_brackets(long index) {
    Document *doc;
    const char *text;
    const char *language;
    const char *name;
    long n;
    long here;
    long other;
    long line;
    long column;
    TextIter *start;
    TextIter *end;
    int clear;
    int matched;

    if (bracketPainting == 1)
        return;
    bracketPainting = 1;
    if (index < 0 || index >= pageCount) {
        bracketPainting = 0;
        return;
    }
    if (pages[index].buffer == nullptr) {
        bracketPainting = 0;
        return;
    }
    doc = state->at(index);
    if (doc == nullptr) {
        bracketPainting = 0;
        return;
    }
    text = pages[index].buffer->get_text();
    if (text == nullptr)
        text = "";
    n = text_length(text);
    language = doc->language();
    line = 0;
    column = 0;
    text_position(text, n, &line, &column);
    start = new TextIter(0, 0);
    end = new TextIter(line, column);
    clear = 0;
    if (n > 0)
        clear = 1;
    prepare_bracket_tag(
            pages[index].buffer,
            themeConfig,
            language,
            "brackets",
            "brackets-back",
            start,
            end,
            clear);
    prepare_bracket_tag(
            pages[index].buffer,
            themeConfig,
            language,
            "brackets-unmatched",
            "brackets-unmatched-back",
            start,
            end,
            clear);
    if (n > 200000) {
        bracketPainting = 0;
        return;
    }
    matched = match_bracket(
            text,
            language,
            doc->buffer()->cursor_offset(),
            &here,
            &other);
    if (matched == 0) {
        bracketPainting = 0;
        return;
    }
    if (other < 0)
        name = "brackets-unmatched";
    else
        name = "brackets";
    paint_one(
            pages[index].buffer,
            text,
            n,
            here,
            name);
    if (other >= 0)
        paint_one(
                pages[index].buffer,
                text,
                n,
                other,
                name);
    bracketPainting = 0;
}

void Ui::paint_status(void) {
    status->set_text(state->status());
}

void Ui::refresh(void) {
    long i;
    long want;

    want = state->index();
    if (pageCount != state->count())
        rebuild();
    else {
        push_active();
        if (book != nullptr
                && want >= 0
                && want < pageCount)
            book->set_current_page(want);
    }
    i = 0;
    while (i < pageCount) {
        retitle(i);
        paint_line(i);
        i = i + 1;
    }
    fill_documents();
    paint_status();
    fill_symbols();
}

void Ui::show_main(void) {
    if (sessionAsk == 1) {
        if (app != nullptr
                && app->native != nullptr
                && mainWindow != nullptr
                && mainWindow->native != nullptr) {
            gtk_application_add_window(
                    app->native,
                    mainWindow->native);
            gtk_widget_set_visible(
                    mainWindow->native,
                    0);
        }
        show_sessions();
        return;
    }
    present_editor();
}

void Ui::show_choice(const char *title, int mode) {
    choiceMode = mode;
    choiceDialog->set_title(title);
    choiceDialog->present();
}

void Ui::handle(int code) {
    if (code == EDITOR_NEEDS_CHOICE) {
        show_dirty();
        return;
    }
    if (code == EDITOR_NEEDS_PATH
            || code == EDITOR_CHOOSE_SAVE) {
        if (files->pending != 0)
            return;
        files->set_title("Save");
        arm_dialog();
        files->save(ui_saved, nullptr);
        return;
    }
    if (code == EDITOR_CHOOSE_OPEN) {
        if (files->pending != 0)
            return;
        files->set_title("Open");
        arm_dialog();
        files->open(ui_opened, nullptr);
        return;
    }
    if (code == EDITOR_FAILED
            && text_same(state->error(), "overwrite") == 1) {
        show_choice("Overwrite the file?", 1);
        return;
    }
    mirror_pages();
    refresh();
}

static void missing_line(
        char *dest,
        long cap,
        const char *name,
        const char *suffix) {
    const char *prefix;
    long n;
    long i;

    prefix = "File \"";
    if (suffix == nullptr)
        suffix = "";
    n = 0;
    i = 0;
    if (name == nullptr)
        name = "";
    while (prefix[i] != 0 && n + 1 < cap) {
        dest[n] = prefix[i];
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (name[i] != 0 && n + 1 < cap) {
        dest[n] = name[i];
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (suffix[i] != 0 && n + 1 < cap) {
        dest[n] = suffix[i];
        n = n + 1;
        i = i + 1;
    }
    dest[n] = 0;
}

void Ui::open_recent(const char *path) {
    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0)
        return;
    if (file_exists(path) == 0) {
        show_missing(path);
        return;
    }
    open_path(path);
}

void Ui::show_missing(const char *path) {
    void *parent;
    void (*typed)(void *, int, void *);
    const char *base;

    if (path == nullptr || path[0] == 0)
        return;
    base = path_base(path);
    if (base == nullptr || base[0] == 0)
        base = path;
    missing_line(
            missingNote,
            EDITOR_PATH,
            base,
            "\" not found.");
    parent = nullptr;
    if (mainWindow != nullptr)
        parent = mainWindow->native;
    missingNative = gtk_message_dialog_new(
            parent,
            3,
            3,
            2,
            "%s",
            missingNote);
    if (missingNative == nullptr)
        return;
    typed = ui_message_response;
    g_signal_connect_data(
            missingNative,
            "response",
            (void *)typed,
            nullptr,
            nullptr,
            0);
    missingOpen = 1;
    gtk_window_present(missingNative);
}

void Ui::answer_missing(int response) {
    void *dialog;

    (void)response;
    missingOpen = 0;
    dialog = missingNative;
    missingNative = nullptr;
    if (dialog != nullptr)
        gtk_widget_set_visible(dialog, 0);
}

int Ui::missing_prompt(void) {
    return missingOpen;
}

const char *Ui::missing_text(void) {
    return missingNote;
}

void Ui::queue_recover(const char *path) {
    char dir[EDITOR_PATH];
    char leaf[128];
    char full[EDITOR_PATH];
    long i;
    Document *doc;

    if (path == nullptr || path[0] == 0)
        return;
    if (recoverCount >= EDITOR_RECENT_MAX)
        return;
    if (file_exists(path) == 1)
        return;
    i = 0;
    while (i < state->count()) {
        doc = state->at(i);
        if (doc != nullptr
                && doc->untitled() == 0
                && text_same(doc->path(), path) == 1)
            return;
        i = i + 1;
    }
    i = 0;
    while (i < recoverCount) {
        if (text_same(recoverPath[i], path) == 1)
            return;
        i = i + 1;
    }
    if (recovery_leaf_for(path, leaf, 128) == 0)
        return;
    if (recovery_place(dir, EDITOR_PATH) == 0)
        return;
    path_join(full, EDITOR_PATH, dir, leaf);
    if (full[0] == 0 || file_exists(full) == 0)
        return;
    text_copy(
            recoverPath[recoverCount],
            EDITOR_PATH,
            path);
    recoverCount = recoverCount + 1;
}

void Ui::show_next_recover(void) {
    const char *base;
    const char *path;

    if (recoverAt < 0 || recoverAt >= recoverCount) {
        recoverOpen = 0;
        return;
    }
    path = recoverPath[recoverAt];
    base = path_base(path);
    if (base == nullptr || base[0] == 0)
        base = path;
    missing_line(
            recoverNote,
            EDITOR_PATH,
            base,
            "\" is gone.");
    if (recoverDialog == nullptr) {
        recoverDialog = new Dialog("Recover file");
        recoverDialog->set_transient(mainWindow);
        recoverLabel = new Label("");
        recoverDialog->set_content((Widget *)recoverLabel);
        recoverDialog->add_button("Open", 1);
        recoverDialog->add_button("Ignore", 2);
        recoverDialog->on_response(
                ui_recover_response,
                nullptr);
    }
    recoverLabel->set_text(recoverNote);
    recoverOpen = 1;
    recoverDialog->present();
}

void Ui::show_restored(const char *path) {
    void *parent;
    void (*typed)(void *, int, void *);
    const char *base;

    base = path_base(path);
    if (base == nullptr || base[0] == 0)
        base = path;
    missing_line(
            restoredNote,
            EDITOR_PATH,
            base,
            "\" was restored.");
    parent = nullptr;
    if (mainWindow != nullptr)
        parent = mainWindow->native;
    restoredNative = gtk_message_dialog_new(
            parent,
            3,
            3,
            2,
            "%s",
            restoredNote);
    restoredOpen = 1;
    if (restoredNative == nullptr)
        return;
    typed = ui_restored_response;
    g_signal_connect_data(
            restoredNative,
            "response",
            (void *)typed,
            nullptr,
            nullptr,
            0);
    gtk_window_present(restoredNative);
}

void Ui::offer_recovery(void) {
    int i;

    if (leaving == 1 || state == nullptr)
        return;
    if (recoveryOn == 0)
        return;
    if (recoverOpen != 0 || restoredOpen != 0)
        return;
    recoverCount = 0;
    recoverAt = 0;
    i = 0;
    while (i < recentUsed && i < recentCount) {
        queue_recover(recentPath[i]);
        i = i + 1;
    }
    i = 0;
    while (i < openCount && i < EDITOR_OPEN_MAX) {
        queue_recover(openPath[i]);
        i = i + 1;
    }
    show_next_recover();
}

void Ui::drop_recovery_copy(const char *path) {
    char dir[EDITOR_PATH];
    char leaf[128];
    char full[EDITOR_PATH];

    if (path == nullptr || path[0] == 0)
        return;
    if (recovery_place(dir, EDITOR_PATH) == 0)
        return;
    if (recovery_leaf_for(path, leaf, 128) == 0)
        return;
    path_join(full, EDITOR_PATH, dir, leaf);
    if (full[0] != 0)
        unlink(full);
}

void Ui::answer_recovery(int response) {
    char path[EDITOR_PATH];
    char dir[EDITOR_PATH];
    char leaf[128];
    char full[EDITOR_PATH];
    char *raw;
    long n;
    const char *io;
    int open;

    if (recoverOpen == 0)
        return;
    if (recoverAt < 0 || recoverAt >= recoverCount) {
        recoverOpen = 0;
        return;
    }
    open = 0;
    if (response == 1)
        open = 1;
    text_copy(path, EDITOR_PATH, recoverPath[recoverAt]);
    recoverAt = recoverAt + 1;
    recoverOpen = 0;
    if (recoverDialog != nullptr)
        recoverDialog->set_visible(false);
    if (open == 0) {
        drop_recovery_copy(path);
        show_next_recover();
        return;
    }
    io = "";
    n = 0;
    raw = nullptr;
    if (recovery_place(dir, EDITOR_PATH) == 1
            && recovery_leaf_for(path, leaf, 128) == 1) {
        path_join(full, EDITOR_PATH, dir, leaf);
        if (full[0] != 0)
            raw = read_file(full, &n, &io);
    }
    if (raw != nullptr && state != nullptr) {
        state->open_recovery(path, raw);
        refresh();
    }
    show_restored(path);
}

int Ui::recovery_prompt(void) {
    return recoverOpen;
}

const char *Ui::recovery_text(void) {
    return recoverNote;
}

void Ui::answer_restored(int response) {
    void *dialog;

    (void)response;
    if (restoredOpen == 0)
        return;
    restoredOpen = 0;
    dialog = restoredNative;
    restoredNative = nullptr;
    if (dialog != nullptr)
        gtk_widget_set_visible(dialog, 0);
    show_next_recover();
}

int Ui::restored_prompt(void) {
    return restoredOpen;
}

const char *Ui::restored_text(void) {
    return restoredNote;
}

void Ui::open_path(const char *path) {
    int code;

    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0)
        return;
    note_folder(path);
    code = state->open_file(path);
    if (code == EDITOR_OK)
        note_recent(path);
    handle(code);
}

void Ui::save_path(const char *path) {
    int code;

    if (leaving == 1)
        return;
    if (path == nullptr || path[0] == 0) {
        finish_choice(state->answer(EDITOR_CANCEL));
        return;
    }
    note_folder(path);
    pendingPath = new String();
    pendingPath->append(path);
    code = state->provide_path(path);
    if (code == EDITOR_OK)
        note_recent(path);
    finish_choice(code);
}

void Ui::finish_choice(int code) {
    if (code != EDITOR_NEEDS_CHOICE
            && dirtyDialog != nullptr) {
        dirtyOpen = 0;
        dirtyDialog->set_visible(false);
    }
    handle(code);
    if (code == EDITOR_CANCELLED)
        sessionHold = 0;
    else if (code == EDITOR_OK)
        complete_held_session();
    if (state->quit_ready() == 1)
        leave();
}

void Ui::choice(int response) {
    if (choiceMode == 1) {
        choiceMode = 0;
        if (response == EDITOR_SAVE) {
            state->allow_overwrite(1);
            handle(state->provide_path(
                    pendingPath->c_str()));
            return;
        }
        handle(state->answer(EDITOR_CANCEL));
        return;
    }
    if (response == EDITOR_CANCEL) {
        if (dirtyDialog != nullptr)
            dirtyDialog->set_visible(false);
        finish_choice(state->answer(EDITOR_CANCEL));
        return;
    }
    if (response == EDITOR_SAVE) {
        finish_choice(state->save_every());
        return;
    }
    if (response == EDITOR_DISCARD) {
        finish_choice(state->discard_every());
        return;
    }
    finish_choice(state->answer(response));
}

void Ui::user_begin(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].userDepth = pages[index].userDepth + 1;
}

void Ui::user_end(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].userDepth > 0)
        pages[index].userDepth =
                pages[index].userDepth - 1;
    if (pages[index].userDepth == 0)
        flush_sync(index);
}

void Ui::flush_sync(long index) {
    if (index < 0 || index >= pageCount)
        return;
    pages[index].pendingIdle = 0;
    if (pages[index].pendingSync == 0)
        return;
    pages[index].pendingSync = 0;
    sync_view(index);
}

void Ui::mirror_pages(void) {
    long i;

    if (state == nullptr)
        return;
    i = 0;
    while (i < pageCount && i < state->count()) {
        Document *doc;
        const char *shown;

        doc = state->at(i);
        if (doc != nullptr
                && pages[i].buffer != nullptr) {
            shown = pages[i].buffer->get_text();
            if (shown == nullptr)
                shown = "";
            if (text_same(
                        shown,
                        doc->buffer()->text()) == 0)
                show_buffer(i);
        }
        i = i + 1;
    }
}

void Ui::sync_view(long index) {
    Document *doc;
    String *want;
    String *have;
    const char *wantRaw;
    const char *haveRaw;
    long wantN;
    long haveN;
    long prefix;
    long wantEnd;
    long haveEnd;
    long line;
    long column;
    long line2;
    long column2;
    TextIter *at;
    TextIter *bound;
    String *bit;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    want = new String();
    want->append(doc->buffer()->text());
    have = new String();
    have->append(pages[index].buffer->get_text());
    wantRaw = want->c_str();
    haveRaw = have->c_str();
    if (text_same(wantRaw, haveRaw) == 1) {
        applying = 1;
        place_cursor(index);
        apply_carets(index);
        applying = 0;
        return;
    }
    wantN = want->size();
    haveN = have->size();
    prefix = 0;
    while (prefix < wantN
            && prefix < haveN
            && wantRaw[prefix] == haveRaw[prefix])
        prefix = prefix + 1;
    wantEnd = wantN;
    haveEnd = haveN;
    while (wantEnd > prefix
            && haveEnd > prefix
            && wantRaw[wantEnd - 1] == haveRaw[haveEnd - 1]) {
        wantEnd = wantEnd - 1;
        haveEnd = haveEnd - 1;
    }
    applying = 1;
    if (pages[index].view != nullptr)
        pages[index].view->hold_carets(1);
    if (haveEnd > prefix) {
        text_position(haveRaw, prefix, &line, &column);
        text_position(haveRaw, haveEnd, &line2, &column2);
        at = new TextIter(line, column);
        bound = new TextIter(line2, column2);
        pages[index].buffer->delete_range(at, bound);
    }
    if (wantEnd > prefix) {
        bit = slice_text(wantRaw, prefix, wantEnd);
        text_position(wantRaw, prefix, &line, &column);
        at = new TextIter(line, column);
        pages[index].buffer->insert(at, bit->c_str());
    }
    if (pages[index].view != nullptr)
        pages[index].view->hold_carets(0);
    place_cursor(index);
    apply_carets(index);
    applying = 0;
    highlight(index);
    paint_line(index);
}

void Ui::changed(long index) {
    Document *doc;
    const char *text;
    int extra;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    if (pages[index].view != nullptr
            && pages[index].view->caret_deferred() != 0)
        return;
    text = pages[index].buffer->get_text();
    extra = doc->buffer()->note_external(text);
    if (pages[index].view != nullptr
            && pages[index].view->caret_count() > 1)
        take_carets(index);
    if (pages[index].view != nullptr)
        pages[index].view->ack_edit();
    if (extra == 1) {
        pages[index].pendingSync = 1;
        if (pages[index].userDepth == 0
                && pages[index].pendingIdle == 0) {
            pages[index].pendingIdle = 1;
            g_idle_add(
                    (void *)ui_sync_idle,
                    (void *)&refs[index]);
        }
    } else
        highlight(index);
    retitle(index);
    paint_status();
    if (index == state->index()) {
        redraw_map(index);
        fill_symbols();
    }
}

void Ui::moved(long index, long line, long offset) {
    Document *doc;

    if (applying == 1)
        return;
    if (index < 0 || index >= state->count())
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    if (index < pageCount
            && pages[index].view != nullptr
            && pages[index].view->edit_motion() == 0
            && pages[index].view->caret_count() > 1) {
        pages[index].view->clear_carets();
        doc->buffer()->clear_carets();
    }
    doc->buffer()->move_to(line + 1, offset + 1);
    paint_brackets(index);
    paint_line(index);
    paint_status();
    redraw_map(index);
}

void Ui::switched(long index) {
    long previous;

    if (building == 1)
        return;
    previous = state->index();
    if (saveOnTab == 1 && previous != index)
        save_quiet(previous);
    state->set_index(index);
    paint_status();
    redraw_map(index);
    fill_symbols();
}

TextBuffer *Ui::view_buffer(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return nullptr;
    return pages[index].buffer;
}

const char *Ui::page_text(long index) {
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].buffer == nullptr)
        return "";
    return pages[index].buffer->get_text();
}

const char *Ui::line_number_text(void) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return "";
    if (pages[index].view == nullptr)
        return "";
    return pages[index].view->line_number_text();
}

long Ui::gutter_line_y(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return (long)-1;
    if (pages[index].view == nullptr)
        return (long)-1;
    return pages[index].view->line_number_origin(line);
}

void Ui::scroll_view(long line) {
    long index;

    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    pages[index].view->scroll_to(line, 0);
}

void Ui::hide_settings(void) {
    if (settingsDialog == nullptr)
        return;
    settingsDialog->set_visible(false);
}

static void minutes_text(char *dest, int value) {
    char digits[8];
    long n;
    long i;

    if (value < 1)
        value = 1;
    n = 0;
    while (value > 0 && n < 7) {
        digits[n] = (char)('0' + (value % 10));
        value = value / 10;
        n = n + 1;
    }
    i = 0;
    while (n > 0) {
        n = n - 1;
        dest[i] = digits[n];
        i = i + 1;
    }
    dest[i] = 0;
}

static void set_box(CheckButton *box, int on) {
    if (box == nullptr)
        return;
    if (on == 0)
        box->set_active(false);
    else
        box->set_active(true);
}

void Ui::sync_boxes(void) {
    long i;

    applying = 1;
    set_box(wrapCheck, searchWrap);
    set_box(backCheck, searchBack);
    set_box(wholeCheck, searchWhole);
    set_box(caseCheck, searchCase);
    set_box(spaceCheck, showSpace);
    set_box(endCheck, showEnds);
    set_box(stopCheck, showStops);
    set_box(rememberCheck, rememberFiles);
    set_box(saveTabCheck, saveOnTab);
    set_box(saveWinCheck, saveOnWindow);
    set_box(trimCheck, trimOn);
    set_box(newlineCheck, newlineOn);
    set_box(pathCheck, pathOn);
    set_box(recoverCheck, recoveryOn);
    if (recoverEntry != nullptr) {
        char shown[8];

        minutes_text(shown, recoveryMinutes);
        recoverEntry->set_text(shown);
    }
    if (keepEntry != nullptr) {
        char shown[8];

        minutes_text(shown, recoveryKeep);
        keepEntry->set_text(shown);
    }
    if (recentSpin != nullptr)
        recentSpin->set_value((double)recentCount);
    if (pathSpin != nullptr)
        pathSpin->set_value((double)pathDepth);
    if (caretSpin != nullptr)
        caretSpin->set_value((double)wheelMargin);
    applying = 0;
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::push_options(void) {
    applying = 1;
    if (menuBar != nullptr) {
        menuBar->set_check(searchMenu, 2, searchBack);
        menuBar->set_check(searchMenu, 3, searchWhole);
        menuBar->set_check(searchMenu, 4, searchCase);
        menuBar->set_check(searchMenu, 5, searchWrap);
        menuBar->set_check(viewMenu, 0, showSpace);
        menuBar->set_check(viewMenu, 1, showEnds);
        menuBar->set_check(viewMenu, 2, showStops);
        menuBar->set_check(viewMenu, 3, rememberFiles);
        menuBar->set_check(viewMenu, 4, showLeft);
        menuBar->set_check(viewMenu, 5, showMap);
    }
    applying = 0;
    sync_boxes();
    apply_panels();
}

void Ui::set_option(const char *label, int on) {
    int value;

    if (applying == 1)
        return;
    if (label == nullptr)
        return;
    value = 0;
    if (on != 0)
        value = 1;
    if (text_same(label, "Wrap") == 1)
        searchWrap = value;
    if (text_same(label, "Reverse") == 1)
        searchBack = value;
    if (text_same(label, "Whole word") == 1)
        searchWhole = value;
    if (text_same(label, "Match case") == 1)
        searchCase = value;
    if (text_same(label, "Whitespace") == 1)
        showSpace = value;
    if (text_same(label, "Line ends") == 1)
        showEnds = value;
    if (text_same(label, "Indent stops") == 1)
        showStops = value;
    if (text_same(label, "Left panel") == 1)
        showLeft = value;
    if (text_same(label, "Right panel") == 1)
        showMap = value;
    if (text_same(label, "Remember files") == 1)
        rememberFiles = value;
    if (text_same(label, "Save when a tab loses focus") == 1)
        saveOnTab = value;
    if (text_same(
                label,
                "Save when the window loses focus") == 1)
        saveOnWindow = value;
    if (text_same(
                label,
                "Trim trailing spaces on save") == 1) {
        trimOn = value;
        state->set_trim(value);
    }
    if (text_same(
                label,
                "Ensure newline at end of file") == 1) {
        newlineOn = value;
        state->set_newline(value);
    }
    if (text_same(
                label,
                "Show path in file tab") == 1) {
        if (value == 0)
            pathOn = 0;
        else
            pathOn = 1;
    }
    if (text_same(label, "Write recovery files") == 1) {
        recoveryOn = value;
        if (value != 0)
            recoveryMark = (long)time(nullptr);
    }
    push_options();
    apply_settings();
}

int Ui::shows_space(void) {
    return showSpace;
}

int Ui::shows_ends(void) {
    return showEnds;
}

int Ui::shows_stops(void) {
    return showStops;
}

void Ui::apply_panels(void) {
    long i;
    Widget *panelWidget;

    panelWidget = panelFrame;
    if (panelWidget == nullptr)
        panelWidget = (Widget *)panelBook;
    if (panelWidget != nullptr) {
        if (showLeft == 0)
            panelWidget->set_visible(false);
        else
            panelWidget->set_visible(true);
    }
    if (editorSplit != nullptr) {
        if (showLeft == 0) {
            if (editorSplit->position() >= 64)
                leftWidth = (int)editorSplit->position();
            editorSplit->set_position(0);
        } else if (editorSplit->position() < 40) {
            if (leftWidth < 64)
                leftWidth = 200;
            editorSplit->set_position((long)leftWidth);
        }
    }
    i = 0;
    while (i < pageCount) {
        if (pages[i].map != nullptr) {
            if (showMap == 0)
                pages[i].map->set_visible(false);
            else
                pages[i].map->set_visible(true);
        }
        i = i + 1;
    }
}

int Ui::shows_left(void) {
    Widget *panelWidget;

    panelWidget = panelFrame;
    if (panelWidget == nullptr)
        panelWidget = (Widget *)panelBook;
    if (panelWidget == nullptr || panelWidget->native == nullptr)
        return showLeft;
    if (gtk_widget_get_visible(panelWidget->native) == 0)
        return 0;
    return 1;
}

int Ui::left_checked(void) {
    if (menuBar == nullptr)
        return showLeft;
    return menuBar->is_checked(viewMenu, 4);
}

int Ui::map_checked(void) {
    if (menuBar == nullptr)
        return showMap;
    return menuBar->is_checked(viewMenu, 5);
}

int Ui::shows_map(void) {
    long index;

    index = 0;
    if (state != nullptr)
        index = state->index();
    if (index < 0 || index >= pageCount)
        return showMap;
    if (pages[index].map == nullptr
            || pages[index].map->native == nullptr)
        return showMap;
    if (gtk_widget_get_visible(pages[index].map->native) == 0)
        return 0;
    return 1;
}

int Ui::search_wrap(void) {
    return searchWrap;
}

void Ui::select_file(void) {
    Document *doc;
    int held;

    if (state == nullptr)
        return;
    doc = state->active();
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    doc->buffer()->select_all();
    held = applying;
    applying = 1;
    place_cursor(state->index());
    applying = held;
}

void Ui::claim_select_key(void) {
    int n;
    int which;
    char want[64];
    char mine[64];
    char other[64];
    const char *label;
    const char *command;
    const char *config;
    const char *accel;

    which = -1;
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        key_info(n, &label, &command, &config, &accel);
        if (text_same(command, "select-all") == 1)
            which = n;
        n = n + 1;
    }
    if (which < 0)
        return;
    if (keyAccel[which][0] == 0)
        return;
    if (mainWindow == nullptr)
        return;
    if (mainWindow->normalize_accel("<Control>a", want, 64) == 0)
        return;
    if (mainWindow->normalize_accel(
                keyAccel[which],
                mine,
                64) == 0)
        return;
    if (text_same(want, mine) == 0)
        return;
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        if (n != which && keyAccel[n][0] != 0) {
            if (mainWindow->normalize_accel(
                        keyAccel[n],
                        other,
                        64) == 1) {
                if (text_same(want, other) == 1) {
                    keyAccel[n][0] = 0;
                    if (keyButton[n] != nullptr)
                        keyButton[n]->set_label("none");
                }
            }
        }
        n = n + 1;
    }
}

void Ui::bind_keys(void) {
    int n;

    if (mainWindow == nullptr)
        return;
    claim_select_key();
    mainWindow->clear_shortcuts();
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        const char *label;
        const char *command;
        const char *config;
        const char *accel;
        long menu;
        long item;

        key_info(n, &label, &command, &config, &accel);
        (void)command;
        (void)config;
        (void)accel;
        if (keyAccel[n][0] != 0
                && mainWindow->shortcut_ok(keyAccel[n]) == 1)
            mainWindow->add_shortcut(
                    keyAccel[n],
                    ui_key,
                    (void *)label);
        if (menuBar != nullptr
                && key_place(n, &menu, &item) == 1)
            menuBar->set_shortcut(menu, item, keyAccel[n]);
        n = n + 1;
    }
    mainWindow->add_shortcut(
            "<Control><Shift>z",
            ui_key,
            (void *)"Redo");
    mainWindow->add_shortcut("Tab", ui_key, (void *)"Indent");
    mainWindow->add_shortcut(
            "<Shift>Tab",
            ui_key,
            (void *)"Unindent");
    mainWindow->add_shortcut(
            "ISO_Left_Tab",
            ui_key,
            (void *)"Unindent");
}

static void fill_span(
        char *buf,
        long cap,
        const char *left,
        const char *mid,
        const char *right) {
    long n;
    long i;
    const char *part;
    int which;

    n = 0;
    which = 0;
    while (which < 3) {
        part = left;
        if (which == 1)
            part = mid;
        if (which == 2)
            part = right;
        if (part != nullptr) {
            i = 0;
            while (part[i] != 0 && n + 1 < cap) {
                buf[n] = part[i];
                n = n + 1;
                i = i + 1;
            }
        }
        which = which + 1;
    }
    buf[n] = 0;
}

static void add_dot(char *buf, long cap) {
    long n;

    n = 0;
    while (buf[n] != 0)
        n = n + 1;
    if (n + 1 < cap) {
        buf[n] = '.';
        n = n + 1;
        buf[n] = 0;
    }
}

static void add_text(char *buf, long cap, const char *extra) {
    long n;
    long i;

    n = 0;
    while (buf[n] != 0)
        n = n + 1;
    if (extra == nullptr)
        return;
    i = 0;
    while (extra[i] != 0 && n + 1 < cap) {
        buf[n] = extra[i];
        n = n + 1;
        i = i + 1;
    }
    buf[n] = 0;
}

static void button_text(const char *accel, char *buf, long cap) {
    accel_shown(buf, cap, accel);
}

void Ui::show_key_note(void) {
    if (keyState == nullptr)
        return;
    if (keyCapture >= 0)
        keyState->set_text(keyPrompt);
    else
        keyState->set_text(keyWarn);
}

static char keyHelpText[96];
static int keyHelpReady;

const char *Ui::key_help(void) {
    if (keyHelpReady == 0) {
        text_copy(
                keyHelpText,
                96,
                "Click a shortcut, press the new keys. ");
        add_text(
                keyHelpText,
                96,
                "Escape cancels. Default restores it.");
        keyHelpReady = 1;
    }
    return keyHelpText;
}

const char *Ui::key_warning(void) {
    return keyWarn;
}

const char *Ui::key_text(int index) {
    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return "";
    return keyAccel[index];
}

void Ui::arm_key(int index) {
    const char *label;
    const char *command;
    const char *config;
    const char *accel;

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return;
    key_info(index, &label, &command, &config, &accel);
    keyCapture = index;
    fill_span(
            keyPrompt,
            160,
            "Press the new keys for ",
            label,
            ". Escape cancels.");
    show_key_note();
}

int Ui::take_key(const char *accel, int escape) {
    int index;

    if (keyCapture < 0)
        return 0;
    index = keyCapture;
    keyCapture = -1;
    keyPrompt[0] = 0;
    if (escape != 0) {
        show_key_note();
        return 1;
    }
    if (accel == nullptr)
        accel = "";
    assign_key(index, accel);
    return 1;
}

void Ui::write_key(int index, const char *accel) {
    char shown[64];

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return;
    if (accel == nullptr)
        accel = "";
    text_copy(keyAccel[index], 64, accel);
    if (keyButton[index] == nullptr)
        return;
    button_text(accel, shown, 64);
    keyButton[index]->set_label(shown);
}

void Ui::finish_keys(void) {
    keyWarn[0] = 0;
    show_key_note();
    apply_settings();
}

void Ui::ask_key_clash(
        int index,
        int other,
        const char *accel) {
    const char *label;
    const char *command;
    const char *config;
    const char *saved;
    char shown[64];
    char text[160];

    key_info(other, &label, &command, &config, &saved);
    keyClashIndex = index;
    keyClashOther = other;
    text_copy(keyClashNext, 64, accel);
    button_text(accel, shown, 64);
    fill_span(text, 160, label, " already uses ", shown);
    add_text(
            text,
            160,
            ". Assign it here and clear that one?");
    if (keyClashLabel != nullptr)
        keyClashLabel->set_text(text);
    keyWarn[0] = 0;
    show_key_note();
    keyClashWait = 1;
    if (keyClashDialog != nullptr)
        keyClashDialog->present();
}

int Ui::assign_key(int index, const char *accel) {
    char next[64];
    char other[64];
    int i;

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return 0;
    if (mainWindow == nullptr)
        return 0;
    if (accel == nullptr)
        accel = "";
    if (mainWindow->normalize_accel(accel, next, 64) == 0) {
        text_copy(keyWarn, 160, "That shortcut is not valid.");
        show_key_note();
        return 0;
    }
    i = 0;
    while (i < EDITOR_KEY_COUNT) {
        if (i != index && next[0] != 0) {
            int same;

            same = mainWindow->normalize_accel(
                    keyAccel[i],
                    other,
                    64);
            if (same == 1 && text_same(next, other) == 1) {
                ask_key_clash(index, i, next);
                return 0;
            }
        }
        i = i + 1;
    }
    write_key(index, next);
    finish_keys();
    return 1;
}

void Ui::reset_key(int index) {
    const char *label;
    const char *command;
    const char *config;
    const char *accel;

    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return;
    key_info(index, &label, &command, &config, &accel);
    assign_key(index, accel);
}

int Ui::key_clash(void) {
    return keyClashWait;
}

const char *Ui::key_clash_text(void) {
    if (keyClashLabel == nullptr)
        return "";
    return keyClashLabel->text();
}

void Ui::answer_key_clash(int response) {
    int index;
    int other;
    char next[64];

    if (keyClashWait == 0)
        return;
    keyClashWait = 0;
    index = keyClashIndex;
    other = keyClashOther;
    text_copy(next, 64, keyClashNext);
    if (keyClashDialog != nullptr)
        keyClashDialog->set_visible(false);
    if (response != 1)
        return;
    if (other >= 0 && other < EDITOR_KEY_COUNT
            && other != index)
        write_key(other, "");
    write_key(index, next);
    finish_keys();
}

const char *Ui::key_shown(int index) {
    if (index < 0 || index >= EDITOR_KEY_COUNT)
        return "";
    if (keyButton[index] != nullptr)
        return keyButton[index]->label();
    return "";
}

long Ui::key_button_width(void) {
    return keyButtonWide;
}

int Ui::key_button_grows(void) {
    if (keyButton[0] == nullptr || keyButton[0]->native == nullptr)
        return 1;
    return gtk_widget_get_hexpand(keyButton[0]->native);
}

void Ui::read_keys(void) {
    char next[EDITOR_KEY_COUNT][64];
    char shown[64];
    int n;
    int i;

    keyCapture = -1;
    keyPrompt[0] = 0;
    keyWarn[0] = 0;
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        const char *text;

        text = keyAccel[n];
        if (keyButton[n] != nullptr)
            text = keyButton[n]->label();
        if (text_same(text, "none") == 1)
            text = "";
        if (mainWindow == nullptr
                || mainWindow->normalize_accel(
                        text,
                        next[n],
                        64) == 0)
            text_copy(next[n], 64, keyAccel[n]);
        n = n + 1;
    }
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        int clash;

        clash = -1;
        i = 0;
        while (i < n) {
            if (next[n][0] != 0
                    && text_same(next[n], next[i]) == 1)
                clash = i;
            i = i + 1;
        }
        if (clash >= 0) {
            const char *label;
            const char *command;
            const char *config;
            const char *accel;
            int kept;

            key_info(
                    clash,
                    &label,
                    &command,
                    &config,
                    &accel);
            fill_span(
                    keyWarn,
                    160,
                    label,
                    " already uses ",
                    next[clash]);
            add_dot(keyWarn, 160);
            kept = 0;
            if (mainWindow != nullptr)
                kept = mainWindow->normalize_accel(
                        keyAccel[n],
                        next[n],
                        64);
            if (kept == 0)
                next[n][0] = 0;
            i = 0;
            while (i < n) {
                if (next[n][0] != 0
                        && text_same(next[n], next[i]) == 1)
                    next[n][0] = 0;
                i = i + 1;
            }
        }
        n = n + 1;
    }
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        text_copy(keyAccel[n], 64, next[n]);
        if (keyButton[n] != nullptr) {
            button_text(keyAccel[n], shown, 64);
            keyButton[n]->set_label(shown);
        }
        n = n + 1;
    }
    claim_select_key();
    show_key_note();
}

static void search_flags(
        int match,
        int word,
        int scope,
        int back,
        bool *matchCase,
        bool *whole,
        bool *inSel,
        bool *backward) {
    *matchCase = false;
    *whole = false;
    *inSel = false;
    *backward = false;
    if (match != 0)
        *matchCase = true;
    if (word != 0)
        *whole = true;
    if (scope != 0)
        *inSel = true;
    if (back != 0)
        *backward = true;
}

void Ui::find_query(const char *query) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;
    bool wrap;

    if (query == nullptr)
        query = "";
    text_copy(searchText, 256, query);
    if (searchEntry != nullptr)
        searchEntry->set_text(searchText);
    if (searchText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    wrap = false;
    if (searchWrap != 0)
        wrap = true;
    buffer->find_next(
            searchText,
            matchCase,
            whole,
            inSel,
            backward,
            wrap);
    refresh();
}

void Ui::find_again(void) {
    if (searchEntry != nullptr)
        text_copy(searchText, 256, searchEntry->text());
    find_query(searchText);
}

void Ui::replace_query(const char *query, const char *repl) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;
    bool wrap;

    if (query == nullptr)
        query = "";
    if (repl == nullptr)
        repl = "";
    text_copy(replaceText, 256, query);
    text_copy(withText, 256, repl);
    if (replaceFind != nullptr)
        replaceFind->set_text(replaceText);
    if (replaceWith != nullptr)
        replaceWith->set_text(withText);
    if (replaceText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    wrap = false;
    if (searchWrap != 0)
        wrap = true;
    buffer->replace_next(
            replaceText,
            withText,
            matchCase,
            whole,
            inSel,
            backward,
            wrap);
    refresh();
}

void Ui::replace_every(const char *query, const char *repl) {
    EditBuffer *buffer;
    bool matchCase;
    bool whole;
    bool inSel;
    bool backward;

    if (query == nullptr)
        query = "";
    if (repl == nullptr)
        repl = "";
    text_copy(replaceText, 256, query);
    text_copy(withText, 256, repl);
    if (replaceText[0] == 0)
        return;
    if (state == nullptr || state->active() == nullptr)
        return;
    take_selection();
    buffer = state->active()->buffer();
    buffer->limit_scope();
    search_flags(
            searchCase,
            searchWhole,
            0,
            searchBack,
            &matchCase,
            &whole,
            &inSel,
            &backward);
    if (buffer->scope_active() == true)
        inSel = true;
    (void)backward;
    buffer->replace_all(
            replaceText,
            withText,
            matchCase,
            whole,
            inSel);
    refresh();
}

void Ui::replace_again(void) {
    if (replaceFind != nullptr)
        text_copy(replaceText, 256, replaceFind->text());
    if (replaceWith != nullptr)
        text_copy(withText, 256, replaceWith->text());
    replace_query(replaceText, withText);
}

void Ui::replace_all_again(void) {
    if (replaceFind != nullptr)
        text_copy(replaceText, 256, replaceFind->text());
    if (replaceWith != nullptr)
        text_copy(withText, 256, replaceWith->text());
    replace_every(replaceText, withText);
}

