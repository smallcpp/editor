static void map_draw(
        void *area,
        void *cr,
        int width,
        int height,
        void *data) {
    MapColumn *column;

    (void)area;
    column = (MapColumn *)data;
    if (column == nullptr || column->owner == nullptr)
        return;
    column->note_size((long)width, (long)height);
    ((Ui *)column->owner)->pin_map(column->page);
    ((Ui *)column->owner)->paint_map(
            column,
            cr,
            width,
            height);
}

/* GdkEventType: motion 1, press 2, release 3, scroll 15.
 * ScrollDirection: up 0, down 1, smooth 4.
 * ScrollUnit: wheel 0, surface 1.
 * Capture phase is 1. Motion keeps scrolling until release.
 */
static int map_event(
        void *controller,
        void *event,
        void *data) {
    MapColumn *column;
    Ui *ui;
    int kind;
    int button;
    double x;
    double y;

    (void)controller;
    column = (MapColumn *)data;
    if (column == nullptr || column->owner == nullptr)
        return 0;
    if (event == nullptr)
        return 0;
    ui = (Ui *)column->owner;
    kind = gdk_event_get_event_type(event);
    if (kind == 15) {
        ui->map_wheel(column->page, event);
        return 1;
    }
    x = 0;
    y = 0;
    if (gdk_event_get_position(event, &x, &y) == 0) {
        if (kind == 3)
            column->markDrag = 0;
        return 0;
    }
    if (kind == 2) {
        button = gdk_button_event_get_button(event);
        if (button == 3) {
            ui->show_map_font_dialog();
            return 1;
        }
        if (button != 1)
            return 0;
        ui->map_button(column->page, (long)y, 1);
        return 1;
    }
    if (kind == 3) {
        column->markDrag = 0;
        return 1;
    }
    if (kind != 1)
        return 0;
    if (column->markDrag == 0)
        return 0;
    ui->map_drag(column->page, (long)y);
    return 1;
}

static int map_save_idle(void *data) {
    (void)data;
    if (editorUi != nullptr)
        editorUi->save_map_width();
    return 0;
}

static void map_split_moved(
        void *paned,
        void *spec,
        void *data) {
    PageRef *ref;

    (void)paned;
    (void)spec;
    ref = (PageRef *)data;
    if (editorUi == nullptr || ref == nullptr)
        return;
    editorUi->keep_map_width(ref->index);
}

static int view_scroll_event(
        void *controller,
        void *event,
        void *data) {
    PageRef *ref;
    int kind;

    (void)controller;
    if (editorUi == nullptr || data == nullptr)
        return 0;
    if (event == nullptr)
        return 0;
    kind = gdk_event_get_event_type(event);
    if (kind != 15)
        return 0;
    ref = (PageRef *)data;
    editorUi->buffer_wheel(ref->index, event);
    return 1;
}

static void map_scrolled(void *adjust, void *data) {
    MapColumn *column;

    (void)adjust;
    column = (MapColumn *)data;
    if (column != nullptr)
        column->redraw();
}

static void map_mapped(void *widget, void *data) {
    MapColumn *column;

    column = (MapColumn *)data;
    if (column == nullptr)
        return;
    column->watch(widget);
    column->redraw();
}

