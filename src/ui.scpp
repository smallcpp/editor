}

void Ui::show_theme(void) {
    Grid *grid;
    int i;
    int row;
    int pick;
    const char *labels[7];
    Document *doc;
    Entry *entry;
    Button *button;
    CheckButton *bold;
    Box *shell;
    int slot;

    if (themeDialog == nullptr) {
        themeDialog = new Dialog("Syntax colors");
        themeDialog->set_transient(mainWindow);
        grid = new Grid();
        grid->set_spacing(12, 4);
        themeDrop = new DropDown();
        i = 0;
        while (i < theme_type_count()) {
            labels[i] = theme_type_label(i);
            i = i + 1;
        }
        themeDrop->set_items(labels, theme_type_count());
        themeDrop->on_changed(ui_theme_type, nullptr);
        grid->attach(
                (Widget *)new Label("File type"),
                0,
                0,
                1,
                1);
        grid->attach(
                (Widget *)themeDrop,
                1,
                0,
                3,
                1);
        grid->attach(
                (Widget *)new Label("Buffer background"),
                0,
                1,
                1,
                1);
        if (themeSlotsReady == 0) {
            i = 0;
            while (i < THEME_ALL) {
                themeSlots[i] = i;
                i = i + 1;
            }
            themeSlotsReady = 1;
        }
        i = 0;
        while (i < THEME_ALL) {
            themeEntry[i] = nullptr;
            themeColorButton[i] = nullptr;
            i = i + 1;
        }
        i = 0;
        while (i < 10) {
            themeBold[i] = nullptr;
            i = i + 1;
        }
        grid->attach(
                (Widget *)theme_field(
                        12,
                        &entry,
                        &button),
                1,
                1,
                1,
                1);
        themeEntry[12] = entry;
        themeColorButton[12] = button;
        grid->attach(
                (Widget *)new Label("Foreground"),
                1,
                2,
                1,
                1);
        grid->attach(
                (Widget *)new Label("Background"),
                2,
                2,
                1,
                1);
        grid->attach(
                (Widget *)new Label("Bold"),
                3,
                2,
                1,
                1);
        i = 0;
        while (i < THEME_TAGS) {
            row = i + 3;
            grid->attach(
                    (Widget *)new Label(span_tag(i + 1)),
                    0,
                    row,
                    1,
                    1);
            grid->attach(
                    (Widget *)theme_field(
                            i,
                            &entry,
                            &button),
                    1,
                    row,
                    1,
                    1);
            themeEntry[i] = entry;
            themeColorButton[i] = button;
            slot = theme_bold_slot(i);
            bold = new CheckButton("Bold");
            bold->on_toggled(
                    ui_theme_bold,
                    (void *)&themeSlots[slot]);
            grid->attach((Widget *)bold, 3, row, 1, 1);
            themeBold[i] = bold;
            i = i + 1;
        }
        row = THEME_TAGS + 3;
        grid->attach(
                (Widget *)new Label(theme_name(8)),
                0,
                row,
                1,
                1);
        grid->attach(
                (Widget *)theme_field(8, &entry, &button),
                1,
                row,
                1,
                1);
        themeEntry[8] = entry;
        themeColorButton[8] = button;
        grid->attach(
                (Widget *)theme_field(9, &entry, &button),
                2,
                row,
                1,
                1);
        themeEntry[9] = entry;
        themeColorButton[9] = button;
        slot = theme_bold_slot(8);
        bold = new CheckButton("Bold");
        bold->on_toggled(
                ui_theme_bold,
                (void *)&themeSlots[slot]);
        grid->attach((Widget *)bold, 3, row, 1, 1);
        themeBold[8] = bold;
        row = row + 1;
        grid->attach(
                (Widget *)new Label(theme_name(10)),
                0,
                row,
                1,
                1);
        grid->attach(
                (Widget *)theme_field(
                        10,
                        &entry,
                        &button),
                1,
                row,
                1,
                1);
        themeEntry[10] = entry;
        themeColorButton[10] = button;
        grid->attach(
                (Widget *)theme_field(
                        11,
                        &entry,
                        &button),
                2,
                row,
                1,
                1);
        themeEntry[11] = entry;
        themeColorButton[11] = button;
        slot = theme_bold_slot(10);
        bold = new CheckButton("Bold");
        bold->on_toggled(
                ui_theme_bold,
                (void *)&themeSlots[slot]);
        grid->attach((Widget *)bold, 3, row, 1, 1);
        themeBold[9] = bold;
        shell = new Box(GTK_VERTICAL, 8);
        shell->append((Widget *)grid);
        shell->append(
                (Widget *)ruled_close(ui_theme_close));
        themeDialog->set_content((Widget *)shell);
        themeDialog->on_response(
                ui_theme_response,
                nullptr);
        g_signal_connect_data(
                themeDialog->native,
                "close-request",
                (void *)ui_theme_stop,
                nullptr,
                nullptr,
                0);
        themeDialog->set_default_size(960, 760);
    }
    pick = 0;
    doc = nullptr;
    if (state != nullptr)
        doc = state->at(state->index());
    if (doc != nullptr) {
        i = 0;
        while (i < theme_type_count()) {
            if (text_same(
                    doc->language(),
                    theme_type_name(i)) == 1)
                pick = i;
            i = i + 1;
        }
    }
    themeFill = 1;
    themeDrop->set_selected((long)pick);
    themeFill = 0;
    fill_theme();
    themeDialog->present();
}

void Ui::fill_theme(void) {
    int which;
    int i;
    int slot;
    const char *language;
    const char *color;

    if (themeDrop == nullptr)
        return;
    which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    themeFill = 1;
    i = 0;
    while (i < THEME_ALL) {
        if (themeEntry[i] != nullptr) {
            color = theme_color(
                    themeConfig,
                    language,
                    theme_name(i));
            themeEntry[i]->set_text(color);
        }
        i = i + 1;
    }
    i = 0;
    while (i < 10) {
        if (themeBold[i] != nullptr) {
            slot = 0;
            if (i < 8)
                slot = theme_bold_slot(i);
            if (i == 8)
                slot = theme_bold_slot(8);
            if (i == 9)
                slot = theme_bold_slot(10);
            color = theme_color(
                    themeConfig,
                    language,
                    theme_name(slot));
            if (color[0] == '1' && color[1] == 0)
                themeBold[i]->set_active(true);
            else
                themeBold[i]->set_active(false);
        }
        i = i + 1;
    }
    themeFill = 0;
}

void Ui::take_theme_entry(int slot) {
    int which;
    const char *language;
    const char *color;

    if (themeFill != 0)
        return;
    if (slot < 0 || slot >= THEME_ALL)
        return;
    if (themeEntry[slot] == nullptr)
        return;
    which = 0;
    if (themeDrop != nullptr)
        which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    color = themeEntry[slot]->text();
    if (theme_set(
            themeConfig,
            language,
            theme_name(slot),
            color) == 0)
        return;
    paint_theme(language);
    if (text_same(
            theme_name(slot),
            "background") == 1) {
        long n;
        Document *doc;

        n = 0;
        while (n < pageCount) {
            doc = state->at(n);
            if (doc != nullptr
                    && text_same(
                            doc->language(),
                            language) == 1)
                paint_paper(n);
            n = n + 1;
        }
    }
    apply_settings();
}

void Ui::take_theme_bold(int slot, int on) {
    int which;
    const char *language;
    const char *flag;

    if (themeFill != 0)
        return;
    if (slot < 0 || slot >= THEME_ALL)
        return;
    which = 0;
    if (themeDrop != nullptr)
        which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    flag = "0";
    if (on != 0)
        flag = "1";
    if (theme_set(
            themeConfig,
            language,
            theme_name(slot),
            flag) == 0)
        return;
    paint_theme(language);
    apply_settings();
}

void Ui::open_theme_color(int slot) {
    const char *color;

    if (leaving == 1)
        return;
    if (colors == nullptr || mainWindow == nullptr)
        return;
    if (colors->pending != 0)
        return;
    if (slot < 0 || slot >= THEME_ALL)
        return;
    if (themeEntry[slot] == nullptr)
        return;
    themeTag = slot;
    colorKind = 2;
    color = themeEntry[slot]->text();
    colors->choose(
            mainWindow,
            color,
            ui_color,
            nullptr);
}

void Ui::paint_theme(const char *language) {
    long i;
    Document *doc;

    if (language == nullptr)
        return;
    i = 0;
    while (i < pageCount) {
        doc = state->at(i);
        if (doc != nullptr
                && text_same(
                        doc->language(),
                        language) == 1)
            highlight(i);
        i = i + 1;
    }
}

void Ui::show_settings(void) {
    Box *box;
    Box *search;
    Box *view;
    Grid *keys;
    Notebook *pages;
    Button *fontButton;
    Box *indentGroup;
    Box *lineGroup;
    Box *marginGroup;
    Box *saveGroup;
    Box *markGroup;
    const char *kinds[3];
    int n;

    if (settingsDialog == nullptr) {
        settingsDialog = new Dialog("Settings");
        settingsDialog->set_transient(mainWindow);
        pages = new Notebook();
        pages->set_tabs_left();
        box = new Box(GTK_VERTICAL, 8);
        keys = new Grid();
        keys->set_spacing(12, 4);
        bracketCheck = new CheckButton("Autoclose brackets");
        indentCheck = new CheckButton("Autoindent");
        lineCheck = new CheckButton(
                "Highlight the current line");
        marginCheck = new CheckButton("Right column marker");
        closeCheck = new CheckButton(
                "Close button on file tabs");
        trimCheck = new CheckButton(
