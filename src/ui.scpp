static int pairFill = 0;

void ui_pairs(void *data) {
    Entry *entry;
    char copy[64];

    if (pairFill != 0)
        return;
    entry = (Entry *)data;
    copy_bracket_pairs(copy, 64, entry->text());
    editorUi->editor()->set_bracket_pairs(copy);
    editorUi->apply_settings();
}

void ui_brackets(void *data, bool value) {
    (void)data;
    if (value)
        editorUi->editor()->use_brackets(1);
    else
        editorUi->editor()->use_brackets(0);
    editorUi->apply_settings();
}

void ui_indent(void *data, bool value) {
    (void)data;
    if (value)
        editorUi->editor()->use_indent(1);
