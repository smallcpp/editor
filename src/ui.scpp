        editorUi->find_again();
        return;
    }
    editorUi->hide_search();
}

void ui_replace_response(void *data, int response) {
    (void)data;
    if (response == 2) {
        editorUi->replace_again();
        return;
    }
    if (response == 3) {
        editorUi->replace_all_again();
        return;
    }
    editorUi->hide_replace();
}

