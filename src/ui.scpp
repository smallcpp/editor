static int pairFill = 0;

void ui_pairs(void *data) {
    Entry *entry;
    char copy[64];

    if (pairFill != 0)
        return;
    entry = (Entry *)data;
    copy_bracket_pairs(copy, 64, entry->text());
    editorUi->editor()->set_bracket_pairs(copy);
    editorUi->apply_settings();
}

