void Ui::ask_session_name(int mode) {
    const char *title;
    Box *box;
    void (*fn)(void *, int);

    if (sessionPick < 0 || sessionPick >= sessionUsed)
        return;
    if (sessionNames[sessionPick][0] == 0)
        return;
    text_copy(
            sessionNameFrom,
            SESSION_NAME,
            sessionNames[sessionPick]);
    sessionNameMode = mode;
    title = "Rename";
    if (mode == 6)
        title = "Duplicate";
    if (sessionNameDialog == nullptr) {
        box = new Box(GTK_VERTICAL, 8);
        sessionNameEntry = new Entry("");
        box->append((Widget *)new Label("Name"));
        box->append((Widget *)sessionNameEntry);
        sessionNameDialog = new Dialog(title);
        sessionNameDialog->set_content((Widget *)box);
        sessionNameDialog->add_button("Cancel", 0);
        sessionNameDialog->add_button("OK", 1);
        fn = session_name_response;
        sessionNameDialog->on_response(fn, nullptr);
        sessionNameDialog->set_transient(mainWindow);
        sessionNameDialog->set_default_size(360, 140);
    }
    sessionNameDialog->set_title(title);
    if (sessionNameEntry != nullptr)
        sessionNameEntry->set_text("");
    sessionNameShown = 1;
    sessionNameDialog->present();
}

void Ui::accept_session_name(void) {
    const char *name;
    int ok;

    name = "";
    if (sessionNameEntry != nullptr)
        name = sessionNameEntry->text();
    ok = 0;
    if (sessionNameMode == 5)
        ok = rename_session(sessionNameFrom, name);
    else if (sessionNameMode == 6)
        ok = duplicate_session(sessionNameFrom, name);
    if (ok == 1)
        hide_session_name();
}

void Ui::hide_session_name(void) {
    sessionNameMode = 0;
    sessionNameShown = 0;
    if (sessionNameDialog != nullptr)
        sessionNameDialog->set_visible(false);
}

int Ui::session_name_open(void) {
    return sessionNameShown;
}

