static int safe_color(const char *text) {
    long i;
    char ch;

    if (text == nullptr || text[0] == 0)
        return 0;
    i = 0;
    while (text[i] != 0) {
        if (i > 30)
            return 0;
        ch = text[i];
        if (ch >= 'a' && ch <= 'z') {
            i = i + 1;
            continue;
        }
        if (ch >= 'A' && ch <= 'Z') {
            i = i + 1;
            continue;
        }
        if (ch >= '0' && ch <= '9') {
            i = i + 1;
            continue;
        }
        if (ch == '#') {
            i = i + 1;
            continue;
        }
        return 0;
    }
    return 1;
}

