    (void)data;
    editorUi->show_theme();
}

void ui_theme_type(void *data) {
    (void)data;
    editorUi->fill_theme();
}

void ui_theme_entry(void *data) {
    int slot;

    slot = *(int *)data;
    editorUi->take_theme_entry(slot);
}

void ui_theme_color(void *data) {
    int slot;

    slot = *(int *)data;
    editorUi->open_theme_color(slot);
}

void ui_theme_response(void *data, int response) {
    (void)data;
    (void)response;
    editorUi->hide_theme();
}

void Ui::hide_theme(void) {
    if (themeDialog == nullptr)
        return;
    themeDialog->set_visible(false);
}

void Ui::show_theme(void) {
    Box *box;
    int i;
    int pick;
    const char *labels[7];
    Document *doc;

    if (themeDialog == nullptr) {
        themeDialog = new Dialog("Syntax colors");
        themeDialog->set_transient(mainWindow);
        box = new Box(GTK_VERTICAL, 8);
        themeDrop = new DropDown();
        i = 0;
        while (i < theme_type_count()) {
            labels[i] = theme_type_label(i);
            i = i + 1;
        }
        themeDrop->set_items(labels, theme_type_count());
        themeDrop->on_changed(ui_theme_type, nullptr);
        box->append((Widget *)labeled_field(
                "File type",
                (Widget *)themeDrop));
        if (themeSlotsReady == 0) {
            i = 0;
            while (i < THEME_TAGS) {
                themeSlots[i] = i;
                i = i + 1;
            }
            themeSlotsReady = 1;
        }
        i = 0;
        while (i < THEME_TAGS) {
            Entry *entry;
            Button *button;

            entry = new Entry("#000000");
            entry->set_width_chars(12);
            entry->on_changed(
                    ui_theme_entry,
                    (void *)&themeSlots[i]);
            button = new Button("Color");
            button->on_clicked(
                    ui_theme_color,
                    (void *)&themeSlots[i]);
            themeEntry[i] = entry;
            themeColorButton[i] = button;
            box->append((Widget *)labeled_field(
                    span_tag(i + 1),
                    (Widget *)color_field(
                            entry,
                            button)));
            i = i + 1;
        }
        themeDialog->set_content((Widget *)box);
        themeDialog->add_button("Close", 1);
        themeDialog->on_response(
                ui_theme_response,
                nullptr);
        themeDialog->set_default_size(520, 480);
    }
    pick = 0;
    doc = nullptr;
    if (state != nullptr)
        doc = state->at(state->index());
    if (doc != nullptr) {
        i = 0;
        while (i < theme_type_count()) {
            if (text_same(
                    doc->language(),
                    theme_type_name(i)) == 1)
                pick = i;
            i = i + 1;
        }
    }
    themeFill = 1;
    themeDrop->set_selected((long)pick);
    themeFill = 0;
    fill_theme();
    themeDialog->present();
}

void Ui::fill_theme(void) {
    int which;
    int i;
    const char *language;
    const char *color;

    if (themeDrop == nullptr)
        return;
    which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    themeFill = 1;
    i = 0;
    while (i < THEME_TAGS) {
        if (themeEntry[i] != nullptr) {
            color = theme_color(
                    themeConfig,
                    language,
                    span_tag(i + 1));
            themeEntry[i]->set_text(color);
        }
        i = i + 1;
    }
    themeFill = 0;
}

void Ui::take_theme_entry(int slot) {
    int which;
    const char *language;
    const char *color;

    if (themeFill != 0)
        return;
    if (slot < 0 || slot >= THEME_TAGS)
        return;
    if (themeEntry[slot] == nullptr)
        return;
    which = 0;
    if (themeDrop != nullptr)
        which = (int)themeDrop->selected();
    if (which < 0 || which >= theme_type_count())
        which = 0;
    language = theme_type_name(which);
    color = themeEntry[slot]->text();
    if (theme_set(
            themeConfig,
            language,
            span_tag(slot + 1),
            color) == 0)
        return;
    paint_theme(language);
    apply_settings();
}

void Ui::open_theme_color(int slot) {
    const char *color;

    if (leaving == 1)
        return;
    if (colors == nullptr || mainWindow == nullptr)
        return;
    if (colors->pending != 0)
        return;
    if (slot < 0 || slot >= THEME_TAGS)
        return;
    if (themeEntry[slot] == nullptr)
        return;
    themeTag = slot;
    colorKind = 2;
    color = themeEntry[slot]->text();
    colors->choose(
            mainWindow,
            color,
            ui_color,
            nullptr);
}

void Ui::paint_theme(const char *language) {
    long i;
    Document *doc;

    if (language == nullptr)
        return;
    i = 0;
    while (i < pageCount) {
        doc = state->at(i);
        if (doc != nullptr
                && text_same(
                        doc->language(),
                        language) == 1)
            highlight(i);
        i = i + 1;
    }
}

