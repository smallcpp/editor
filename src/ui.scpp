        return panelTabLeft->label();
    if (side == 1 && panelTabRight != nullptr)
        return panelTabRight->label();
    return "";
}

void Ui::scroll_panel_tabs(int direction) {
    void *adjust;
    double value;
    double upper;
    double page;
    double step;

    if (panelTabScroll == nullptr
            || panelTabScroll->native == nullptr)
        return;
    adjust = gtk_scrolled_window_get_hadjustment(
            panelTabScroll->native);
    if (adjust == nullptr)
        return;
    value = gtk_adjustment_get_value(adjust);
    upper = gtk_adjustment_get_upper(adjust);
    page = gtk_adjustment_get_page_size(adjust);
    step = 48;
    if (direction < 0)
        value = value - step;
    else
        value = value + step;
    if (value < 0)
        value = 0;
    if (page < upper && value > upper - page)
        value = upper - page;
    if (value < 0)
        value = 0;
    gtk_adjustment_set_value(adjust, value);
}

void Ui::show_panel_page(int index) {
    if (panelBook == nullptr)
        return;
    if (index < 0 || index > 2)
        return;
    panelBook->set_current_page((long)index);
}

int Ui::panel_page(void) {
    if (panelBook == nullptr)
        return -1;
    return (int)panelBook->current_page();
}

static void align_labels(void *widget) {
    const char *name;
    void *child;

    if (widget == nullptr)
        return;
    name = gtk_widget_get_css_name(widget);
    if (name != nullptr && text_same(name, "label") == 1) {
        gtk_label_set_xalign(widget, (float)0);
        gtk_widget_set_halign(widget, 1);
    }
    child = gtk_widget_get_first_child(widget);
    while (child != nullptr) {
        align_labels(child);
        child = gtk_widget_get_next_sibling(child);
    }
}

static int labels_left(void *widget, int *seen) {
    const char *name;
    void *child;
    float xalign;

    if (widget == nullptr)
        return 1;
    name = gtk_widget_get_css_name(widget);
    if (name != nullptr && text_same(name, "label") == 1) {
        *seen = 1;
        xalign = gtk_label_get_xalign(widget);
        if (xalign > (float)0.01)
            return 0;
    }
    child = gtk_widget_get_first_child(widget);
    while (child != nullptr) {
        if (labels_left(child, seen) == 0)
            return 0;
        child = gtk_widget_get_next_sibling(child);
    }
    return 1;
}

void Ui::align_file_names(void) {
    if (fileView != nullptr && fileView->native != nullptr)
        align_labels(fileView->native);
    if (docView != nullptr && docView->native != nullptr)
        align_labels(docView->native);
}

int Ui::files_left(void) {
    int seen;

    if (fileView == nullptr || fileView->native == nullptr)
        return 0;
    seen = 0;
    if (labels_left(fileView->native, &seen) == 0)
        return 0;
    return seen;
}

