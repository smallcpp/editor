        newlineCheck = new CheckButton(
                "Ensure newline at end of file");
        tabSpin = new SpinButton(1, 32, 4);
        marginSpin = new SpinButton(1, 400, 80);
        lineEntry = new Entry(lineColor);
        marginEntry = new Entry(marginColor);
        bracketEntry = new Entry(bracket_list());
