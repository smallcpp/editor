void Ui::use_config(EditorConfig *item) {
    if (item == nullptr)
        return;
    if (item->brackets == 0)
        state->use_brackets(0);
    else
        state->use_brackets(1);
    if (item->indent == 0)
        state->use_indent(0);
    else
        state->use_indent(1);
    if (item->spaces == 0)
        state->use_spaces(0);
    else
        state->use_spaces(1);
    state->set_tab_width(item->tabWidth);
    set_line_shown(item->showLine);
    set_margin_shown(item->showMargin);
    set_close_shown(item->showClose);
    set_margin_count(item->marginCols);
    set_line_color(item->lineColor);
    set_margin_color(item->marginColor);
    if (item->font[0] != 0)
        choose_font(item->font);
    {
        int n;

        n = 0;
        while (n < EDITOR_KEY_COUNT) {
            text_copy(keyAccel[n], 64, item->accel[n]);
            if (keyEntry[n] != nullptr)
                keyEntry[n]->set_text(keyAccel[n]);
            n = n + 1;
        }
    }
    if (mainWindow != nullptr)
        bind_keys();
}

void Ui::load_settings(void) {
    EditorConfig item;
    char path[EDITOR_PATH];

    config_defaults(&item);
    if (config_path(path, EDITOR_PATH) == 0)
        return;
    if (config_read(path, &item) == 0)
        return;
    use_config(&item);
}

void Ui::apply_settings(void) {
    EditorConfig item;
    char path[EDITOR_PATH];

    config_defaults(&item);
    item.brackets = state->uses_brackets();
    item.indent = state->uses_indent();
    item.spaces = state->uses_spaces();
    item.tabWidth = state->tab_width();
    item.showLine = showLine;
    item.showMargin = showMargin;
    item.showClose = showClose;
    item.marginCols = marginCols;
    text_copy(item.lineColor, 32, lineColor);
    text_copy(item.marginColor, 32, marginColor);
    text_copy(item.font, 128, fontDesc);
    read_keys();
    {
        int n;

        n = 0;
        while (n < EDITOR_KEY_COUNT) {
            text_copy(item.accel[n], 64, keyAccel[n]);
            n = n + 1;
        }
    }
    if (bracketCheck != nullptr) {
        if (bracketCheck->active() == true)
            item.brackets = 1;
        else
            item.brackets = 0;
        if (indentCheck->active() == true)
            item.indent = 1;
        else
            item.indent = 0;
        if (spacesCheck->active() == true)
            item.spaces = 1;
        else
            item.spaces = 0;
        if (lineCheck->active() == true)
            item.showLine = 1;
        else
            item.showLine = 0;
        if (marginCheck->active() == true)
            item.showMargin = 1;
        else
            item.showMargin = 0;
        if (closeCheck->active() == true)
            item.showClose = 1;
        else
            item.showClose = 0;
        item.tabWidth = (int)tabSpin->value();
        item.marginCols = (int)marginSpin->value();
        text_copy(item.lineColor, 32, lineEntry->text());
        text_copy(item.marginColor, 32, marginEntry->text());
    }
    use_config(&item);
    if (config_path(path, EDITOR_PATH) == 1)
        config_write(path, &item);
}

void Ui::show_settings(void) {
    Box *box;
    Box *keys;
    Notebook *pages;
    Button *fontButton;
    Label *tabLabel;
    Label *lineLabel;
    Label *marginLabel;
    int n;

    if (settingsDialog == nullptr) {
        settingsDialog = new Dialog("Settings");
        settingsDialog->set_transient(mainWindow);
        pages = new Notebook();
        box = new Box(GTK_VERTICAL, 8);
        keys = new Box(GTK_VERTICAL, 4);
        bracketCheck = new CheckButton("Close brackets");
        indentCheck = new CheckButton("Indent a new line");
        spacesCheck = new CheckButton("Indent with spaces");
        lineCheck = new CheckButton("Highlight the current line");
        marginCheck = new CheckButton("Right column marker");
        closeCheck = new CheckButton("Tab close marks");
        tabLabel = new Label("Spaces per indent");
        lineLabel = new Label("Current line color");
        marginLabel = new Label("Column marker color");
        tabSpin = new SpinButton(1, 32, 4);
        marginSpin = new SpinButton(1, 400, 80);
        lineEntry = new Entry(lineColor);
        marginEntry = new Entry(marginColor);
        fontButton = new Button("Font");
        bracketCheck->set_active(true);
        indentCheck->set_active(true);
        spacesCheck->set_active(true);
        lineCheck->set_active(true);
        marginCheck->set_active(false);
        closeCheck->set_active(true);
        bracketCheck->on_toggled(ui_brackets, nullptr);
        indentCheck->on_toggled(ui_indent, nullptr);
        spacesCheck->on_toggled(ui_spaces, nullptr);
        lineCheck->on_toggled(ui_line_toggle, nullptr);
        marginCheck->on_toggled(ui_margin_toggle, nullptr);
        closeCheck->on_toggled(ui_close_toggle, nullptr);
        tabSpin->on_changed(ui_tab_spin, (void *)tabSpin);
        marginSpin->on_changed(
                ui_margin_spin,
                (void *)marginSpin);
        lineEntry->on_changed(
                ui_line_entry,
                (void *)lineEntry);
        marginEntry->on_changed(
                ui_margin_entry,
                (void *)marginEntry);
        fontButton->on_clicked(ui_font_button, nullptr);
        box->append((Widget *)bracketCheck);
        box->append((Widget *)indentCheck);
        box->append((Widget *)spacesCheck);
        box->append((Widget *)tabLabel);
        box->append((Widget *)tabSpin);
        box->append((Widget *)lineCheck);
        box->append((Widget *)lineLabel);
        box->append((Widget *)lineEntry);
        box->append((Widget *)marginCheck);
        box->append((Widget *)marginSpin);
        box->append((Widget *)marginLabel);
        box->append((Widget *)marginEntry);
        box->append((Widget *)closeCheck);
        box->append((Widget *)fontButton);
        n = 0;
        while (n < EDITOR_KEY_COUNT) {
            const char *label;
            const char *command;
            const char *config;
            const char *accel;
            Label *name;
            Entry *entry;

            key_info(
                    n,
                    &label,
                    &command,
                    &config,
                    &accel);
            name = new Label(label);
            entry = new Entry(keyAccel[n]);
            keyEntry[n] = entry;
            keys->append((Widget *)name);
            keys->append((Widget *)entry);
            n = n + 1;
        }
        pages->append_page((Widget *)box, "General");
        pages->append_page((Widget *)keys, "Keyboard");
        settingsDialog->set_content((Widget *)pages);
        settingsDialog->add_button("Apply", 2);
        settingsDialog->add_button("Close", 1);
        settingsDialog->on_response(
                ui_settings_response,
                nullptr);
    }
    if (state->uses_brackets() == 0)
        bracketCheck->set_active(false);
    else
        bracketCheck->set_active(true);
    if (state->uses_indent() == 0)
        indentCheck->set_active(false);
    else
        indentCheck->set_active(true);
    if (state->uses_spaces() == 0)
        spacesCheck->set_active(false);
    else
        spacesCheck->set_active(true);
    if (showLine == 0)
        lineCheck->set_active(false);
    else
        lineCheck->set_active(true);
    if (showMargin == 0)
        marginCheck->set_active(false);
    else
        marginCheck->set_active(true);
    if (showClose == 0)
        closeCheck->set_active(false);
    else
        closeCheck->set_active(true);
    tabSpin->set_value((double)state->tab_width());
    marginSpin->set_value((double)marginCols);
    n = 0;
    while (n < EDITOR_KEY_COUNT) {
        if (keyEntry[n] != nullptr)
            keyEntry[n]->set_text(keyAccel[n]);
        n = n + 1;
    }
    settingsDialog->present();
}

void Ui::on_menu(const char *label) {
    if (label == nullptr)
        return;
    if (text_same(label, "New") == 1) {
        handle(state->run("new"));
        return;
    }
    if (text_same(label, "Open") == 1) {
        handle(state->run("open"));
        return;
    }
    if (text_same(label, "Save") == 1) {
        handle(state->run("save"));
        return;
    }
    if (text_same(label, "Save As") == 1) {
        handle(state->run("save-as"));
        return;
    }
    if (text_same(label, "Save All") == 1) {
        handle(state->run("save-all"));
        return;
    }
    if (text_same(label, "Close") == 1) {
        handle(state->run("close"));
        return;
    }
    if (text_same(label, "Close All") == 1) {
        handle(state->run("close-all"));
        return;
    }
    if (text_same(label, "Search") == 1) {
        show_search();
        return;
    }
    if (text_same(label, "Replace") == 1) {
        show_replace();
        return;
    }
    if (text_same(label, "Reverse") == 1) {
        searchBack = menuBar->is_checked(searchMenu, 2);
        return;
    }
    if (text_same(label, "Whole word") == 1) {
        searchWhole = menuBar->is_checked(searchMenu, 3);
        return;
    }
    if (text_same(label, "Match case") == 1) {
        searchCase = menuBar->is_checked(searchMenu, 4);
        return;
    }
    if (text_same(label, "Settings") == 1) {
        show_settings();
        return;
    }
    if (text_same(label, "Quit") == 1) {
        handle(state->run("quit"));
        if (state->quit_ready() == 1)
            leave();
        return;
    }
    if (text_same(label, "Undo") == 1) {
        handle(state->run("undo"));
        return;
    }
    if (text_same(label, "Redo") == 1) {
        handle(state->run("redo"));
        return;
    }
    if (text_same(label, "Cut") == 1
            || text_same(label, "Copy") == 1
            || text_same(label, "Indent") == 1
            || text_same(label, "Unindent") == 1)
        take_selection();
    if (text_same(label, "Cut") == 1) {
        handle(state->run("cut"));
        return;
    }
    if (text_same(label, "Copy") == 1) {
        handle(state->run("copy"));
        return;
    }
    if (text_same(label, "Paste") == 1) {
        handle(state->run("paste"));
        return;
    }
    if (text_same(label, "Indent") == 1) {
        handle(state->run("indent"));
        return;
    }
    if (text_same(label, "Unindent") == 1) {
        handle(state->run("unindent"));
        return;
    }
}

void Ui::mount_tab(long index, const char *title) {
    Box *row;
    Label *label;
    Button *mark;

    if (index < 0 || index >= pageCount)
        return;
    row = new Box(GTK_HORIZONTAL, 4);
    row->add_css("box { border: 1px solid #222222; }");
    row->add_css("box { padding: 1px 4px; }");
    label = new Label(title);
    tabTitle[index] = label;
    row->append((Widget *)label);
    if (showClose == 1) {
        mark = new Button("x");
        mark->add_css_class("flat");
        mark->add_css("button{padding:0;min-width:0;min-height:0;}");
        mark->add_css("button{border:none;background:none;}");
        mark->add_css("button{box-shadow:none;}");
        mark->on_clicked(ui_tab_close, (void *)&refs[index]);
        row->append((Widget *)mark);
    }
    book->set_tab(index, (Widget *)row);
}

void Ui::retitle(long index) {
    Document *doc;
    char title[256];

    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    text_copy(title, 256, doc->title());
    if (tabTitle[index] != nullptr)
        tabTitle[index]->set_text(title);
    else
        book->set_tab_label(index, title);
}

const char *Ui::tab_text(long index) {
    if (index < 0 || index >= pageCount)
        return "";
    if (tabTitle[index] == nullptr)
        return "";
    return tabTitle[index]->text();
}

void Ui::fill_documents(void) {
    const char *labels[EDITOR_PAGES];
    long n;
    long i;
    long j;
    int clash;

    if (menuBar == nullptr)
        return;
    n = state->count();
    if (n > EDITOR_PAGES)
        n = EDITOR_PAGES;
    i = 0;
    while (i < n) {
        text_copy(docName[i], 80, state->at(i)->title());
        clash = 0;
        j = 0;
        while (j < i) {
            if (text_same(docName[j], docName[i]) == 1)
                clash = 1;
            j = j + 1;
        }
        if (clash == 1) {
            long used;
            char extra[8];
            long v;

            used = 0;
            while (docName[i][used] != 0
                    && used + 4 < 80)
                used = used + 1;
            docName[i][used] = ' ';
            used = used + 1;
            v = i + 1;
            extra[0] = (char)('0' + (int)(v % 10));
            extra[1] = 0;
            docName[i][used] = extra[0];
            docName[i][used + 1] = 0;
        }
        labels[i] = docName[i];
        i = i + 1;
    }
    menuBar->set_menu(documentsMenu, labels, n);
}

void Ui::select_named(const char *title) {
    long i;

    if (leaving == 1 || title == nullptr)
        return;
    i = 0;
    while (i < state->count() && i < EDITOR_PAGES) {
        if (text_same(docName[i], title) == 1
                || text_same(
                        state->at(i)->title(),
                        title) == 1) {
            state->set_index(i);
            if (book != nullptr && i < pageCount)
                book->set_current_page(i);
            paint_status();
            return;
        }
        i = i + 1;
    }
}

void Ui::paint_line(long index) {
    int on;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    on = 0;
    if (showLine != 0)
        on = 1;
    pages[index].view->set_line_shade(on, lineColor);
}

void Ui::apply_view(long index) {
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].view == nullptr)
        return;
    if (fontDesc[0] != 0)
        pages[index].view->set_font(fontDesc);
    if (showMargin == 1)
        pages[index].view->set_column_marker(
                marginCols,
                marginColor);
    else
        pages[index].view->set_column_marker(
                0,
                marginColor);
}

void Ui::arm_dialog(void) {
    char folder[EDITOR_PATH];
    void *file;
    const char *remembered;

    if (files == nullptr || files->native == nullptr)
        return;
    files->set_parent(mainWindow);
    remembered = nullptr;
    if (hasLastDir == 1)
        remembered = lastDir;
    if (dialog_folder(
                folder,
                EDITOR_PATH,
                remembered) == 0)
        return;
    file = g_file_new_for_path(folder);
    if (file == nullptr)
        return;
    gtk_file_dialog_set_initial_folder(
            files->native,
            file);
    g_object_unref(file);
}

void Ui::note_folder(const char *path) {
    char dir[EDITOR_PATH];

    path_dir(dir, EDITOR_PATH, path);
    if (dir[0] == 0 || text_same(dir, ".") == 1)
        return;
    text_copy(lastDir, EDITOR_PATH, dir);
    hasLastDir = 1;
}

void Ui::leave(void) {
    if (leaving == 1)
        return;
    leaving = 1;
    if (settingsDialog != nullptr)
        settingsDialog->set_visible(false);
    if (choiceDialog != nullptr)
        choiceDialog->set_visible(false);
    if (mainWindow != nullptr)
        mainWindow->destroy();
    if (app != nullptr)
        app->quit();
}

void Ui::close_at(long index) {
    if (leaving == 1)
        return;
    if (index < 0 || index >= state->count())
        return;
    state->set_index(index);
    if (book != nullptr && index < pageCount)
        book->set_current_page(index);
    handle(state->run("close"));
}

int Ui::tab_marks(void) {
    return showClose;
}

int Ui::shows_line(void) {
    return showLine;
}

int Ui::shows_margin(void) {
    return showMargin;
}

int Ui::margin_columns(void) {
    return marginCols;
}

int Ui::is_leaving(void) {
    return leaving;
}

void Ui::choose_font(const char *description) {
    long i;

    if (description == nullptr || description[0] == 0)
        return;
    text_copy(fontDesc, 128, description);
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::set_line_shown(int value) {
    long i;

    if (value == 0)
        showLine = 0;
    else
        showLine = 1;
    i = 0;
    while (i < pageCount) {
        paint_line(i);
        i = i + 1;
    }
}

void Ui::set_margin_shown(int value) {
    long i;

    if (value == 0)
        showMargin = 0;
    else
        showMargin = 1;
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::set_close_shown(int value) {
    int next;

    next = 0;
    if (value != 0)
        next = 1;
    if (next == showClose)
        return;
    showClose = next;
    if (book == nullptr)
        return;
    rebuild();
    fill_documents();
}

void Ui::set_line_color(const char *color) {
    long i;

    if (safe_color(color) == 0)
        return;
    text_copy(lineColor, 32, color);
    i = 0;
    while (i < pageCount) {
        paint_line(i);
        i = i + 1;
    }
}

void Ui::set_margin_color(const char *color) {
    long i;

    if (safe_color(color) == 0)
        return;
    text_copy(marginColor, 32, color);
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::set_margin_count(int value) {
    long i;

    if (value < 1)
        value = 1;
    if (value > 400)
        value = 400;
    marginCols = value;
    i = 0;
    while (i < pageCount) {
        apply_view(i);
        i = i + 1;
    }
}

void Ui::set_width(int value) {
    state->set_tab_width(value);
}

void Ui::open_font(void) {
    if (leaving == 1)
        return;
    if (fonts == nullptr || mainWindow == nullptr)
        return;
    if (fonts->pending != 0)
        return;
    fonts->choose(mainWindow, ui_font, nullptr);
}

int Ui::start(void) {
    prepare();
    app->on_activate(ui_activate, nullptr);
    return app->run();
}
