    menuBar->set_separator(fileMenu, 6);
    menuBar->set_separator(fileMenu, 8);
    menuBar->set_separator(editMenu, 2);
    menuBar->set_separator(editMenu, 6);
    menuBar->set_separator(editMenu, 10);
    menuBar->set_separator(editMenu, 12);
    menuBar->set_separator(editMenu, 15);
    menuBar->set_separator(searchMenu, 2);
