static void map_draw(
        void *area,
        void *cr,
        int width,
        int height,
        void *data) {
    MapColumn *column;

    (void)area;
    column = (MapColumn *)data;
    if (column == nullptr || column->owner == nullptr)
        return;
    column->note_size((long)width, (long)height);
    ((Ui *)column->owner)->paint_map(
            column,
            cr,
            width,
            height);
}

static void map_pressed(
        void *gesture,
        int count,
        double x,
        double y,
        void *data) {
    MapColumn *column;

    (void)gesture;
    (void)count;
    (void)x;
    column = (MapColumn *)data;
    if (column == nullptr || column->owner == nullptr)
        return;
    ((Ui *)column->owner)->map_click((long)y);
}

static void map_scrolled(void *adjust, void *data) {
    MapColumn *column;

    (void)adjust;
    column = (MapColumn *)data;
    if (column != nullptr)
        column->redraw();
}

static void map_mapped(void *widget, void *data) {
    MapColumn *column;

    column = (MapColumn *)data;
    if (column == nullptr)
        return;
    column->watch(widget);
    column->redraw();
}

