    if (leaving == 1)
        return;
    if (colors == nullptr || mainWindow == nullptr)
        return;
    if (colors->pending != 0)
        return;
    colorKind = 3;
    colors->choose(
            mainWindow,
            "#808080",
            ui_color,
            nullptr);
}

void Ui::arm_buffer_menu(void *view) {
    void *group;
    void *dateAct;
    void *colorAct;
    int hints;

    if (view == nullptr)
        return;
    hints = gtk_text_view_get_input_hints(view);
    hints = hints | 1024;
    gtk_text_view_set_input_hints(view, hints);
    group = g_simple_action_group_new();
    if (group == nullptr)
        return;
    dateAct = g_simple_action_new("date", nullptr);
    if (dateAct != nullptr) {
        g_signal_connect_data(
                dateAct,
                "activate",
                (void *)text_insert_date,
                nullptr,
                nullptr,
                0);
        g_action_map_add_action(group, dateAct);
    }
    colorAct = g_simple_action_new("color", nullptr);
    if (colorAct != nullptr) {
        g_signal_connect_data(
                colorAct,
                "activate",
                (void *)text_insert_color,
                nullptr,
                nullptr,
                0);
        g_action_map_add_action(group, colorAct);
    }
    gtk_widget_insert_action_group(view, "insert", group);
    if (textMenu == nullptr) {
        textMenu = g_menu_new();
        g_menu_append(
                textMenu,
                "Insert date",
                "insert.date");
        g_menu_append(
                textMenu,
                "Insert color",
                "insert.color");
    }
    gtk_text_view_set_extra_menu(view, textMenu);
}

int Ui::text_hides_emoji(void) {
    long index;
    int hints;

    if (state == nullptr)
        return 0;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return 0;
    if (pages[index].view == nullptr)
        return 0;
    if (pages[index].view->native == nullptr)
        return 0;
    hints = gtk_text_view_get_input_hints(
            pages[index].view->native);
    if ((hints & 1024) == 0)
        return 0;
    return 1;
}

const char *Ui::text_extra_label(int index) {
    return model_label(textMenu, index);
}

int Ui::row_path(
        int page,
        int row,
        char *dest,
        long cap) {
    Document *doc;

    if (dest == nullptr || cap < 2)
        return 0;
    dest[0] = 0;
    if (row < 0)
        return 0;
    if (page == 0) {
        if (panel == nullptr)
            return 0;
        if (panel->row_dir(row) == 1)
            return 0;
        return panel->file_path(row, dest, cap);
    }
    if (page == 3) {
        if (state == nullptr || row >= state->count())
            return 0;
        doc = state->at(row);
        if (doc == nullptr || doc->untitled() == 1)
            return 0;
        if (doc->path()[0] == 0)
            return 0;
        text_copy(dest, cap, doc->path());
        return 1;
    }
    return 0;
}

int Ui::row_is_file(int page, int row) {
    char path[EDITOR_PATH];

    if (row_path(page, row, path, EDITOR_PATH) == 0)
        return 0;
    if (file_is_reg(path) == 0)
        return 0;
    return 1;
}

int Ui::can_make_file(void) {
    if (leaving == 1 || state == nullptr)
        return 0;
    if (menuPage == 0) {
        if (panel == nullptr)
            return 0;
        if (panel->listed()[0] == 0)
            return 0;
        if (file_is_dir(panel->listed()) == 0)
            return 0;
        return 1;
    }
    return 1;
}

void Ui::tune_panel_actions(void) {
    int file;

    file = row_is_file(menuPage, menuRow);
    if (actOpen != nullptr)
        g_simple_action_set_enabled(actOpen, file);
    if (actClose != nullptr)
        g_simple_action_set_enabled(actClose, file);
    if (actSave != nullptr)
        g_simple_action_set_enabled(actSave, file);
    if (actRemove != nullptr)
        g_simple_action_set_enabled(actRemove, file);
    if (actNew != nullptr)
        g_simple_action_set_enabled(
                actNew,
                can_make_file());
}

void Ui::arm_panel(int page, int row) {
    menuPage = page;
    menuRow = row;
    tune_panel_actions();
}

int Ui::row_at(int page, double x, double y) {
    ColumnView *view;
    void *picked;
    const char *text;
    long i;

    view = nullptr;
    if (page == 0)
        view = fileView;
    if (page == 3)
        view = docView;
    if (view == nullptr || view->native == nullptr)
        return -1;
    picked = gtk_widget_pick(view->native, x, y, 0);
    text = label_on(picked);
    if (text == nullptr || text[0] == 0)
        return -1;
    i = 0;
    while (i < view->row_count()) {
        if (text_same(view->cell(i, 0), text) == 1)
            return (int)i;
        i = i + 1;
    }
    return -1;
}

void *Ui::hook_row_menu(ColumnView *view, void *page) {
    void *click;
    void *pop;

    if (view == nullptr || view->native == nullptr)
        return nullptr;
    gtk_widget_insert_action_group(
            view->native,
            "panel",
            panelGroup);
    pop = gtk_popover_menu_new_from_model(panelMenu);
    if (pop == nullptr)
        return nullptr;
    gtk_widget_set_parent(pop, view->native);
    gtk_popover_set_has_arrow(pop, 0);
    click = gtk_gesture_click_new();
    gtk_gesture_single_set_button(click, 3);
    gtk_event_controller_set_propagation_phase(click, 1);
    g_signal_connect_data(
            click,
            "pressed",
            (void *)panel_pressed,
            page,
            nullptr,
            0);
    gtk_widget_add_controller(view->native, click);
    return pop;
}

void Ui::drop_row_menus(void) {
    if (filePop != nullptr) {
        gtk_widget_unparent(filePop);
        filePop = nullptr;
    }
    if (docPop != nullptr) {
        gtk_widget_unparent(docPop);
        docPop = nullptr;
    }
}

void Ui::mount_row_menus(void) {
    if (panelGroup != nullptr)
        return;
    panelGroup = g_simple_action_group_new();
    if (panelGroup == nullptr)
        return;
    actNew = menu_action(panelGroup, "new", "New");
    actOpen = menu_action(panelGroup, "open", "Open");
    actClose = menu_action(panelGroup, "close", "Close");
    actSave = menu_action(panelGroup, "save", "Save");
    actRemove = menu_action(
            panelGroup,
            "remove",
            "Remove");
    panelMenu = g_menu_new();
    g_menu_append(panelMenu, "New", "panel.new");
    g_menu_append(panelMenu, "Open", "panel.open");
    g_menu_append(panelMenu, "Close", "panel.close");
    g_menu_append(panelMenu, "Save", "panel.save");
    g_menu_append(panelMenu, "Remove", "panel.remove");
    filePop = hook_row_menu(
            fileView,
            (void *)&menuFilesPage);
    docPop = hook_row_menu(
            docView,
            (void *)&menuDocsPage);
    menuPage = 0;
    menuRow = -1;
    tune_panel_actions();
}

void Ui::show_row_menu(int page, double x, double y) {
    void *pop;
    int rect[4];

    arm_panel(page, row_at(page, x, y));
    pop = nullptr;
    if (page == 0)
        pop = filePop;
    if (page == 3)
        pop = docPop;
    if (pop == nullptr)
        return;
    rect[0] = (int)x;
    rect[1] = (int)y;
    rect[2] = 1;
    rect[3] = 1;
    gtk_popover_set_pointing_to(pop, (void *)rect);
    gtk_popover_popup(pop);
}

int Ui::panel_item_count(void) {
    if (panelMenu == nullptr)
        return 0;
    return g_menu_model_get_n_items(panelMenu);
}

const char *Ui::panel_item_label(int index) {
    return model_label(panelMenu, index);
}

int Ui::panel_item_on(const char *label) {
    void *act;

    act = nullptr;
    if (label == nullptr)
        return 0;
    if (text_same(label, "New") == 1)
        act = actNew;
    if (text_same(label, "Open") == 1)
        act = actOpen;
    if (text_same(label, "Close") == 1)
        act = actClose;
    if (text_same(label, "Save") == 1)
        act = actSave;
    if (text_same(label, "Remove") == 1)
        act = actRemove;
    if (act == nullptr)
        return 0;
    if (g_action_get_enabled(act) == 0)
        return 0;
    return 1;
}

int Ui::close_named_path(const char *path, int force) {
    long i;

    if (state == nullptr || path == nullptr)
        return 0;
    if (path[0] == 0)
        return 0;
    i = 0;
    while (i < state->count()) {
        Document *doc;

        doc = state->at(i);
        if (doc != nullptr
                && text_same(doc->path(), path) == 1) {
            if (force == 1 && doc->buffer() != nullptr)
                doc->buffer()->mark_clean();
            close_at(i);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

void Ui::save_row_path(const char *path) {
    long i;

    if (state == nullptr || path == nullptr)
        return;
    if (path[0] == 0)
        return;
    i = 0;
    while (i < state->count()) {
        Document *doc;

        doc = state->at(i);
        if (doc != nullptr
                && text_same(doc->path(), path) == 1) {
            state->set_index(i);
            if (book != nullptr && i < pageCount)
                book->set_current_page(i);
            handle(state->run("save"));
            return;
        }
        i = i + 1;
    }
    open_path(path);
    if (state->active() == nullptr)
        return;
    if (text_same(state->active()->path(), path) == 0)
        return;
    handle(state->run("save"));
}

void Ui::ask_remove(const char *path) {
    char leaf[96];
    char note[160];
    const char *prefix;
    long n;
    long i;

    leaf_of(leaf, 96, path);
    prefix = "Remove ";
    n = 0;
    i = 0;
    while (prefix[i] != 0 && n + 1 < 160) {
        note[n] = prefix[i];
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (leaf[i] != 0 && n + 1 < 160) {
        note[n] = leaf[i];
        n = n + 1;
        i = i + 1;
    }
    if (n + 1 < 160) {
        note[n] = '?';
        n = n + 1;
    }
    note[n] = 0;
    removeWait = 1;
    if (removeLabel != nullptr)
        removeLabel->set_text(note);
    if (removeDialog != nullptr)
        removeDialog->present();
}

void Ui::apply_remove(int mode) {
    char path[EDITOR_PATH];
    char name[PANEL_NAME];
    int page;
    int row;
    int disk;

    page = menuPage;
    row = menuRow;
    disk = 0;
    if (mode == 2)
        disk = 1;
    path[0] = 0;
    name[0] = 0;
    if (row_path(page, row, path, EDITOR_PATH) == 0)
        return;
    if (page == 0 && panel != nullptr)
        text_copy(name, PANEL_NAME, panel->file_name(row));
    if (page == 0) {
        if (panel == nullptr || name[0] == 0)
            return;
        if (panel->hide_file(name) == 0)
            return;
        fill_files();
    } else if (page == 3)
        close_named_path(path, 1);
    else
        return;
    if (disk == 0)
        return;
    if (page != 3)
        close_named_path(path, 1);
    if (file_is_reg(path) == 1)
        unlink(path);
}

void Ui::run_panel_item(const char *label) {
    char path[EDITOR_PATH];

    if (label == nullptr)
        return;
    if (text_same(label, "New") == 1) {
        if (can_make_file() == 0)
            return;
        on_menu("New");
        return;
    }
    if (panel_item_on(label) == 0)
        return;
    if (row_path(menuPage, menuRow, path, EDITOR_PATH) == 0)
        return;
    if (text_same(label, "Open") == 1) {
        open_path(path);
        return;
    }
    if (text_same(label, "Close") == 1) {
        close_named_path(path, 0);
        return;
    }
    if (text_same(label, "Save") == 1) {
        save_row_path(path);
        return;
    }
    if (text_same(label, "Remove") == 1)
        ask_remove(path);
}

void Ui::answer_remove(int response) {
    int waiting;
    int mode;

    waiting = removeWait;
    removeWait = 0;
    if (removeDialog != nullptr)
        removeDialog->set_visible(false);
    if (waiting == 0)
        return;
    mode = 0;
    if (response == 1)
        mode = 1;
    if (response == 2)
        mode = 2;
    if (mode == 0)
        return;
    if (row_is_file(menuPage, menuRow) == 0)
        return;
    apply_remove(mode);
    menuRow = -1;
    tune_panel_actions();
}

int Ui::remove_waiting(void) {
    return removeWait;
}

int Ui::start(void) {
    prepare();
    app->on_activate(ui_activate, nullptr);
    return app->run();
}
