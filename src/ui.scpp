static void leaf_of(
        char *dest,
        long cap,
        const char *path) {
    long i;
    long slash;
    long n;

    if (dest == nullptr || cap < 2)
        return;
    dest[0] = 0;
    if (path == nullptr)
        return;
    slash = -1;
    i = 0;
    while (path[i] != 0) {
        if (path[i] == '/')
            slash = i;
        i = i + 1;
    }
    i = 0;
    if (slash >= 0)
        i = slash + 1;
    n = 0;
    while (path[i] != 0 && n + 1 < cap) {
        dest[n] = path[i];
        n = n + 1;
        i = i + 1;
    }
    dest[n] = 0;
}

static const char *label_on(void *widget) {
    void *at;

    at = widget;
    while (at != nullptr) {
        const char *name;

        name = gtk_widget_get_css_name(at);
        if (name != nullptr
                && text_same(name, "label") == 1)
            return gtk_label_get_text(at);
        at = gtk_widget_get_parent(at);
    }
    return nullptr;
}

static const char *model_label(void *model, int index) {
    void *value;
    const char *text;

    menuShown[0] = 0;
    if (model == nullptr || index < 0)
        return "";
    if (index >= g_menu_model_get_n_items(model))
        return "";
    value = g_menu_model_get_item_attribute_value(
            model,
            index,
            "label",
            nullptr);
    if (value == nullptr)
        return "";
    text = g_variant_get_string(value, nullptr);
    text_copy(menuShown, 64, text);
    g_variant_unref(value);
    return menuShown;
}

static void *menu_action(
        void *group,
        const char *name,
        const char *label) {
    void *action;

    action = g_simple_action_new(name, nullptr);
    if (action == nullptr)
        return nullptr;
    g_signal_connect_data(
            action,
            "activate",
            (void *)panel_activated,
            (void *)label,
            nullptr,
            0);
    g_action_map_add_action(group, action);
    return action;
}

void Ui::insert_at_caret(const char *text) {
    long index;
    Document *doc;

    if (leaving == 1 || state == nullptr)
        return;
    if (text == nullptr || text[0] == 0)
        return;
    index = state->index();
    if (index < 0)
        return;
    doc = state->at(index);
    if (doc == nullptr || doc->buffer() == nullptr)
        return;
    doc->buffer()->insert_text(text);
    sync_view(index);
    paint_status();
}

void Ui::insert_date(void) {
    char when[16];
    File *pipe;
    char *got;
    int i;

    pipe = popen("date +%Y-%m-%d", "r");
    if (pipe == nullptr)
        return;
    got = fgets(when, 16, pipe);
    pclose(pipe);
    if (got == nullptr)
        return;
    i = 0;
    while (when[i] != 0
            && when[i] != '\n'
            && when[i] != '\r')
        i = i + 1;
    when[i] = 0;
    if (i != 10)
        return;
    insert_at_caret(when);
}

void Ui::insert_color_text(const char *color) {
    if (safe_color(color) == 0)
        return;
    insert_at_caret(color);
}

