bool ui_close(void *data) {
    int code;

    (void)data;
    if (editorUi->is_leaving() == 1)
        return false;
    if (editorUi->editor()->quit_ready() == 1) {
        editorUi->leave();
        return false;
    }
    code = editorUi->editor()->quit();
    if (editorUi->editor()->quit_ready() == 1) {
        editorUi->leave();
        return false;
    }
    editorUi->handle(code);
    return true;
}

