void ui_mark(
        void *buffer,
        void *iter,
        void *mark,
        void *data) {
    PageRef *ref;
    void *insert;

    if (editorUi == nullptr)
        return;
    if (editorUi->is_leaving() == 1)
        return;
    insert = gtk_text_buffer_get_insert(buffer);
    if (insert != mark)
        return;
    ref = (PageRef *)data;
    editorUi->moved(
            ref->index,
            (long)gtk_text_iter_get_line(iter),
            (long)gtk_text_iter_get_line_offset(iter));
}

