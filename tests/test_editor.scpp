#include "../src/editor.shpp"
#include "../src/minimap.shpp"
#include "../src/panel.shpp"
#include "../src/language.shpp"
#include "../src/project.shpp"
#include "../src/settings.shpp"
#include "../src/syntax.shpp"

extern int system(const char *command);
extern int chdir(const char *path);

extern int setenv(
        const char *name,
        const char *value,
        int overwrite);

static int failures;

struct FileTime {
    long sec;
    long nsec;
};

extern int utimensat(
        int dirfd,
        const char *path,
        struct FileTime *times,
        int flags);

static void stamp_file(const char *path, long sec) {
    struct FileTime times[2];

    times[0].sec = sec;
    times[0].nsec = 0;
    times[1].sec = sec;
    times[1].nsec = 0;
    utimensat(-100, path, times, 0);
}

static void style_is(
        const char *language,
        const char *path,
        const char *text,
        const char *leader,
        int block,
        const char *msg) {
    const char *got;
    int flag;

    got = "";
    flag = 0;
    comment_style(language, path, text, &got, &flag);
    expect(text_same(got, leader) == 1, msg);
    if (block == 0)
        expect(flag == 0, msg);
    else
        expect(flag == 1, msg);
}

void expect(int cond, const char *msg) {
    if (cond == 0) {
        print("fail {:s}\n", msg);
        failures = failures + 1;
    }
}

static int row_named(EditProject *project, const char *name) {
    int i;

    i = 0;
    while (i < project->row_count()) {
        if (text_same(project->row_name(i), name) == 1)
            return i;
        i = i + 1;
    }
    return -1;
}

void check_map_width(void) {
    EditorConfig item;
    EditorConfig back;
    char path[EDITOR_PATH];

    config_defaults(&item);
    item.mapWidth = 48;
    expect(config_path(path, EDITOR_PATH) == 1,
            "map width path");
    expect(config_write(path, &item) == 1,
            "write saved map width");
    config_defaults(&back);
    expect(config_read(path, &back) == 1,
            "read saved map width");
    expect(back.mapWidth == 48, "saved width stays");
    item.mapWidth = 500;
    expect(config_write(path, &item) == 1,
            "write map width 500");
    config_defaults(&back);
    expect(config_read(path, &back) == 1,
            "read map width 500");
    expect(back.mapWidth == 500, "map width accepts 500");
    item.mapWidth = 900;
    expect(config_write(path, &item) == 1,
            "write wide map");
    config_defaults(&back);
    expect(config_read(path, &back) == 1,
            "read wide map");
    expect(back.mapWidth == 500, "map width stops at 500");
    unlink(path);
}

void check_project(const char *dir, const char *io) {
    EditProject *project;
    Document *doc;
    char folder[EDITOR_PATH];
    char side[EDITOR_PATH];
    char home[EDITOR_PATH];
    char fileA[EDITOR_PATH];
    char fileB[EDITOR_PATH];
    char sub[EDITOR_PATH];
    char subFile[EDITOR_PATH];
    char lists[EDITOR_PATH];
    char store[EDITOR_PATH];
    char other[EDITOR_PATH];
    char leaf[128];
    char rec[EDITOR_PATH];
    char *body;
    long n;
    int row;
    int child;

    path_join(folder, EDITOR_PATH, dir, "job");
    path_join(side, EDITOR_PATH, dir, "side");
    expect(mkdir(folder, 448) == 0, "job dir");
    expect(mkdir(side, 448) == 0, "side dir");
    path_join(fileA, EDITOR_PATH, folder, "a.scpp");
    path_join(fileB, EDITOR_PATH, side, "b.scpp");
    expect(write_file(fileA, "int a;\n", &io) == 1, "job source");
    expect(write_file(fileB, "int b;\n", &io) == 1, "side source");
    path_join(sub, EDITOR_PATH, folder, "sub");
    expect(mkdir(sub, 448) == 0, "sub dir");
    path_join(subFile, EDITOR_PATH, sub, "c.scpp");
    expect(write_file(subFile, "int c;\n", &io) == 1, "sub source");
    project = new EditProject();
    expect(project->make("job", "directory", folder) == 1,
            "make job");
    expect(project->make("also", "directory", folder) == 1,
            "second project");
    expect(project->store_path(store, EDITOR_PATH) == 1,
            "also path");
    expect(text_has(store, "/.config/smallcpp/projects/") == 1,
            "catalog directory");
    expect(text_has(store, "also.project") == 1, "also file");
    expect(project->load("job") == 1, "load job");
    expect(text_same(project->name(), "job") == 1, "job name");
    expect(text_same(project->kind_name(), "directory") == 1,
            "job kind");
    row = row_named(project, "a.scpp");
    expect(row >= 0, "tree has a");
    expect(project->row_is_dir(row) == 0, "a is a file");
    expect(text_has(project->row_label(row), "/") == 0,
            "a has no path");
    row = row_named(project, "sub");
    expect(row >= 0, "tree has sub");
    expect(project->row_is_dir(row) == 1, "sub is a directory");
    expect(row_named(project, "c.scpp") < 0, "sub starts closed");
    expect(project->toggle_row(row) == 1, "open sub");
    child = row_named(project, "c.scpp");
    expect(child >= 0, "sub shows c");
    expect(text_has(project->row_label(child), "/") == 0,
            "c has no path");
    expect(project->toggle_row(row_named(project, "sub")) == 1,
            "close sub");
    expect(row_named(project, "c.scpp") < 0, "sub closes");
    expect(project->make("picked", "files", fileA) == 1,
            "explicit files");
    expect(project->add_file(fileB) == 1, "add another file");
    row = row_named(project, "job");
    expect(row >= 0, "picked groups job");
    expect(project->row_is_dir(row) == 1, "job group is a directory");
    expect(project->toggle_row(row) == 1, "open picked job");
    expect(row_named(project, "a.scpp") >= 0, "picked a");
    row = row_named(project, "side");
    expect(project->toggle_row(row) == 1, "open picked side");
    expect(row_named(project, "b.scpp") >= 0, "picked b");
    expect(text_has(
                project->row_label(row_named(project, "a.scpp")),
                "/") == 0,
            "picked row is not a path");
    path_join(lists, EDITOR_PATH, folder, "CMakeLists.txt");
    expect(write_file(
                lists,
                "add_executable(demo a.scpp)\n",
                &io) == 1,
            "cmake file");
    expect(project->make("built", "cmake", folder) == 1,
            "cmake project");
    expect(row_named(project, "a.scpp") >= 0, "cmake has a");
    expect(project->store_path(store, EDITOR_PATH) == 1,
            "cmake path");
    n = 0;
    body = read_file(store, &n, &io);
    expect(body != nullptr, "cmake text");
    if (body != nullptr) {
        expect(text_has(body, "kind=cmake") == 1, "cmake kind");
        expect(text_has(body, "add_executable") == 0,
                "cmake stores no targets");
    }
    project->clear_opens();
    expect(project->note_open(fileA) == 1, "note open");
    project->note_active(fileA, 4);
    expect(project->save() == 1, "save place");
    expect(project->load("built") == 1, "load place");
    expect(project->active_line() == 4, "saved line");
    expect(project->open_count() == 1, "saved opens");
    expect(text_same(project->active_path(), fileA) == 1,
            "saved file");
    expect(project->save_as("built-copy") == 1, "save as");
    expect(project->store_path(other, EDITOR_PATH) == 1,
            "copy path");
    expect(file_exists(store) == 1, "original remains");
    expect(file_exists(other) == 1, "copy exists");
    expect(project->remove_store() == 1, "delete copy");
    expect(file_exists(other) == 0, "copy is gone");
    expect(file_exists(store) == 1, "original stays");
    path_join(home, EDITOR_PATH, dir, "keep");
    expect(mkdir(home, 448) == 0, "keep dir");
    doc = new Document();
    expect(doc->load_path(fileA) == 1, "load for recovery");
    doc->buffer()->set_text("kept work\n");
    expect(doc->write_recovery(home) == 1, "write recovery");
    expect(doc->recovery_leaf(leaf, 128) == 1, "recovery leaf");
    path_join(rec, EDITOR_PATH, home, leaf);
    expect(file_exists(rec) == 1, "recovery file");
    unlink(rec);
    if (system("git --version > /dev/null 2>&1") == 0) {
        String *cmd;

        cmd = new String();
        cmd->append("git -C '");
        cmd->append(folder);
        cmd->append("' init -q");
        expect(system(cmd->c_str()) == 0, "git init");
        cmd = new String();
        cmd->append("git -C '");
        cmd->append(folder);
        cmd->append("' add a.scpp");
        expect(system(cmd->c_str()) == 0, "git add");
        expect(project->make("repo", "git", folder) == 1,
                "git project");
        expect(row_named(project, "a.scpp") >= 0, "git lists a");
        expect(text_same(project->kind_name(), "git") == 1,
                "git kind");
    }
    expect(startup_directory(home, EDITOR_PATH) == 1,
            "start directory");
    path_join(folder, EDITOR_PATH, home, "anchor-proj");
    path_join(fileA, EDITOR_PATH, folder, "hello.txt");
    unlink(fileA);
    rmdir(folder);
    expect(mkdir(folder, 448) == 0, "anchor folder");
    expect(write_file(fileA, "hi\n", &io) == 1, "anchor hello");
    expect(project->make(
                "anchor",
                "directory",
                "anchor-proj") == 1,
            "relative create");
    expect(project->store_path(store, EDITOR_PATH) == 1,
            "anchor store");
    n = 0;
    body = read_file(store, &n, &io);
    expect(body != nullptr, "anchor text");
    if (body != nullptr) {
        expect(text_has(body, home) == 1,
                "root keeps the start directory");
        expect(text_has(body, "anchor-proj") == 1,
                "root keeps the chosen folder");
    }
    expect(current_directory(other, EDITOR_PATH) == 1,
            "remember directory");
    expect(chdir(side) == 0, "start elsewhere");
    project = new EditProject();
    row = project->load("anchor");
    expect(chdir(other) == 0, "restore cwd");
    expect(row == 1, "open from another directory");
    row = row_named(project, "hello.txt");
    expect(row >= 0, "hello from the chosen directory");
    if (row >= 0) {
        expect(text_starts(project->row_path(row), home) == 1,
                "path stays in the start directory");
        expect(file_exists(project->row_path(row)) == 1,
                "chosen file still exists");
    }
    project->remove_store();
    unlink(fileA);
    rmdir(folder);
}

void check_template(const char *dir, const char *io) {
    char src[EDITOR_PATH];
    char dest[EDITOR_PATH];
    char file[EDITOR_PATH];
    char archive[EDITOR_PATH];
    char config[EDITOR_PATH];
    char small[EDITOR_PATH];
    char got[EDITOR_PATH];
    EditProject *project;
    String *cmd;

    path_join(src, EDITOR_PATH, dir, "packsrc");
    expect(mkdir(src, 448) == 0, "template source");
    path_join(file, EDITOR_PATH, src, "hello.txt");
    expect(write_file(file, "hello\n", &io) == 1, "template hello");
    path_join(config, EDITOR_PATH, dir, ".config");
    if (file_is_dir(config) == 0)
        expect(mkdir(config, 448) == 0, "config dir");
    path_join(small, EDITOR_PATH, config, "smallcpp");
    if (file_is_dir(small) == 0)
        expect(mkdir(small, 448) == 0, "smallcpp dir");
    expect(template_archive(archive, EDITOR_PATH) == 1,
            "template path");
    expect(text_has(
                archive,
                "/.config/smallcpp/template.tar.gz") == 1,
            "template location");
    cmd = new String();
    cmd->append("tar -C '");
    cmd->append(src);
    cmd->append("' -czf '");
    cmd->append(archive);
    cmd->append("' .");
    expect(system(cmd->c_str()) == 0, "pack template");
    path_join(dest, EDITOR_PATH, dir, "fresh");
    expect(unpack_template(dest) == 1, "unpack template");
    path_join(got, EDITOR_PATH, dest, "hello.txt");
    expect(file_exists(got) == 1, "unpacked hello");
    project = new EditProject();
    expect(project->make("fresh", "directory", dest) == 1,
            "open unpacked");
    expect(row_named(project, "hello.txt") >= 0,
            "template file");
}

int main(void) {
    char pattern[64];
    char pathA[EDITOR_PATH];
    char pathB[EDITOR_PATH];
    char pathC[EDITOR_PATH];
    char was[EDITOR_PATH];
    char now[EDITOR_PATH];
    char tiny[1];
    char *dir;
    Editor *editor;
    const char *io;
    char *raw;
    long n;

    failures = 0;
    text_copy(pattern, 64, "/tmp/editor-ed-XXXXXX");
    dir = mkdtemp(pattern);
    expect(dir != nullptr, "temp");
    if (dir == nullptr)
        return 1;
    expect(current_directory(was, EDITOR_PATH) == 1,
            "read cwd");
    expect(chdir(dir) == 0, "enter temp");
    expect(current_directory(now, EDITOR_PATH) == 1,
            "cwd after chdir");
    expect(text_same(now, dir) == 1, "open starts in cwd");
    expect(current_directory(nullptr, EDITOR_PATH) == 0,
            "cwd needs a buffer");
    tiny[0] = 'x';
    expect(current_directory(tiny, 1) == 0, "cwd needs room");
    expect(chdir(was) == 0, "restore cwd");
    path_join(pathA, EDITOR_PATH, dir, "a.scpp");
    path_join(pathB, EDITOR_PATH, dir, "b.scpp");
    path_join(pathC, EDITOR_PATH, dir, "c.scpp");
    io = "";
    expect(write_file(pathA, "int main\n", &io) == 1, "seed a");
    expect(write_file(pathB, "class Box\n", &io) == 1, "seed b");
    expect(write_file(pathC, "old\n", &io) == 1, "seed c");
    editor = new Editor();
    expect(editor->new_file() == EDITOR_OK, "untitled");
    expect(editor->active()->untitled() == 1, "starts blank");
    expect(editor->open_argument(dir) == EDITOR_FAILED,
            "reject directory");
    expect(text_same(editor->error(), "not a file") == 1,
            "directory message");
    expect(editor->count() == 1, "directory kept the blank");
    expect(editor->open_file(pathA) == EDITOR_OK, "open a");
    expect(editor->count() == 1, "blank replaced");
    expect(text_same(editor->active()->title(), "a.scpp") == 1,
            "title a");
    expect(editor->open_file(pathB) == EDITOR_OK, "open b");
    expect(editor->count() == 2, "two files");
    expect(editor->open_file(pathA) == EDITOR_OK, "focus a");
    expect(editor->index() == 0, "switched to a");
    expect(editor->new_file() == EDITOR_OK, "second untitled");
    expect(editor->count() == 3, "three documents");
    editor->set_index(0);
    editor->active()->buffer()->insert_text("X");
    expect(editor->active()->buffer()->dirty() == true, "dirty");
    expect(editor->save_active() == EDITOR_OK, "save");
    expect(editor->active()->buffer()->dirty() == false, "clean");
    raw = read_file(pathA, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "Xint main\n") == 1,
            "saved bytes");
    editor->set_index(2);
    editor->active()->buffer()->insert_text("U");
    expect(editor->save_active() == EDITOR_NEEDS_PATH,
            "untitled save");
    editor->set_index(1);
    editor->active()->buffer()->insert_text("Y");
    expect(editor->save_all() == EDITOR_OK, "save all");
    raw = read_file(pathB, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "Yclass Box\n") == 1,
            "saved b");
    editor->set_index(2);
    expect(editor->active()->buffer()->dirty() == true,
            "untitled skipped");
    expect(editor->save_as(pathB) == EDITOR_FAILED,
            "save as open");
    expect(text_same(editor->error(), "open document") == 1,
            "open document");
    expect(editor->active()->untitled() == 1, "still untitled");
    expect(editor->save_as(pathC) == EDITOR_FAILED, "needs overwrite");
    expect(text_same(editor->error(), "overwrite") == 1,
            "overwrite message");
    editor->allow_overwrite(1);
    expect(editor->save_as(pathC) == EDITOR_OK, "save as");
    expect(text_same(editor->active()->path(), pathC) == 1,
            "renamed");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr && text_same(raw, "U") == 1,
            "save as bytes");
    editor->active()->buffer()->set_text("abcdef");
    editor->active()->buffer()->select_span(1, 1, 1, 4);
    expect(editor->clipboard_copy() == EDITOR_OK, "copy");
    expect(text_same(editor->clipboard(), "abc") == 1,
            "copied");
    editor->active()->buffer()->move_to(1, 7);
    expect(editor->clipboard_paste() == EDITOR_OK, "paste");
    expect(text_same(
                editor->active()->buffer()->text(),
                "abcdefabc") == 1,
            "pasted");
    editor->run("undo");
    expect(text_same(
                editor->active()->buffer()->text(),
                "abcdef") == 1,
            "undo paste");
    editor->run("redo");
    expect(text_same(
                editor->active()->buffer()->text(),
                "abcdefabc") == 1,
            "redo paste");
    editor->active()->buffer()->select_span(1, 1, 1, 4);
    expect(editor->clipboard_cut() == EDITOR_OK, "cut");
    expect(text_same(editor->clipboard(), "abc") == 1, "cut text");
    expect(text_same(
                editor->active()->buffer()->text(),
                "defabc") == 1,
            "after cut");
    editor->active()->buffer()->set_text("line");
    editor->active()->buffer()->select_all();
    editor->run("indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "    line") == 1,
            "indent");
    editor->active()->buffer()->select_all();
    editor->run("unindent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "line") == 1,
            "unindent");
    expect(editor->save_active() == EDITOR_OK, "save edits");
    editor->set_index(0);
    editor->active()->buffer()->insert_text("Z");
    expect(editor->close_active() == EDITOR_NEEDS_CHOICE,
            "dirty close");
    expect(editor->pending() == PEND_CLOSE, "close pending");
    expect(editor->answer(EDITOR_CANCEL) == EDITOR_CANCELLED,
            "cancel close");
    expect(editor->pending() == PEND_NONE, "close cleared");
    expect(editor->count() == 3, "cancel kept documents");
    expect(editor->active()->buffer()->dirty() == true,
            "still dirty");
    expect(editor->close_active() == EDITOR_NEEDS_CHOICE,
            "close again");
    expect(editor->answer(EDITOR_DISCARD) == EDITOR_OK,
            "discard");
    expect(editor->count() == 2, "discard dropped one");
    editor->set_index(0);
    editor->active()->buffer()->insert_text("Q");
    expect(editor->quit() == EDITOR_NEEDS_CHOICE, "dirty quit");
    expect(editor->quit_ready() == 0, "quit waits");
    expect(editor->answer(EDITOR_CANCEL) == EDITOR_CANCELLED,
            "cancel quit");
    expect(editor->quit_ready() == 0, "quit cancelled");
    expect(editor->quit() == EDITOR_NEEDS_CHOICE, "quit again");
    expect(editor->answer(EDITOR_DISCARD) == EDITOR_OK,
            "discard quit");
    expect(editor->quit_ready() == 1, "quit ready");
    {
        Editor *many;
        char *body;
        long bytes;
        const char *err;

        many = new Editor();
        expect(many->open_file(pathA) == EDITOR_OK,
                "list open a");
        expect(many->open_file(pathB) == EDITOR_OK,
                "list open b");
        many->set_index(0);
        many->active()->buffer()->set_text("alpha\n");
        many->active()->buffer()->mark_dirty();
        many->set_index(1);
        many->active()->buffer()->set_text("beta\n");
        many->active()->buffer()->mark_dirty();
        expect(many->close_all() == EDITOR_NEEDS_CHOICE,
                "list choice");
        expect(many->save_at(0) == EDITOR_NEEDS_CHOICE,
                "one remains");
        expect(many->at(0)->buffer()->dirty() == false,
                "first saved");
        expect(many->discard_at(1) == EDITOR_OK,
                "discard rest");
        expect(many->pending() == PEND_NONE,
                "close all done");
        expect(many->count() == 1, "close all left one");
        err = "";
        bytes = 0;
        body = read_file(pathA, &bytes, &err);
        expect(body != nullptr
                && text_same(body, "alpha\n") == 1,
                "saved alpha");
        many = new Editor();
        many->new_file();
        many->active()->buffer()->insert_text("U");
        expect(many->quit() == EDITOR_NEEDS_CHOICE,
                "untitled choice");
        expect(many->save_at(0) == EDITOR_NEEDS_PATH,
                "untitled asks");
        expect(many->discard_at(0) == EDITOR_OK,
                "discard untitled");
        expect(many->quit_ready() == 1,
                "quit after discard");
    }
    editor->use_brackets(0);
    editor->new_file();
    editor->active()->buffer()->insert_text("(");
    expect(text_same(
                editor->active()->buffer()->text(),
                "(") == 1,
            "brackets setting");
    editor->use_brackets(1);
    editor->active()->buffer()->set_text("");
    editor->active()->buffer()->insert_text("(");
    expect(text_same(
                editor->active()->buffer()->text(),
                "()") == 1,
            "brackets restored");
    editor->set_bracket_pairs("<>");
    editor->active()->buffer()->set_text("");
    editor->active()->buffer()->insert_text("<");
    expect(text_same(
                editor->active()->buffer()->text(),
                "<>") == 1,
            "custom pairs");
    editor->active()->buffer()->set_text("");
    editor->active()->buffer()->insert_text("(");
    expect(text_same(
                editor->active()->buffer()->text(),
                "(") == 1,
            "pairs omit parens");
    editor->set_bracket_pairs(bracket_list());
    expect(editor->tab_width() == 4, "tab default");
    editor->set_tab_width(2);
    expect(editor->tab_width() == 2, "tab width");
    editor->active()->buffer()->set_text("");
    expect(editor->run("indent") == EDITOR_OK, "indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "  ") == 1,
            "two spaces");
    editor->set_tab_width(0);
    expect(editor->tab_width() == 1, "tab clamps");
    expect(editor->uses_spaces() == 1, "spaces default");
    editor->set_tab_width(4);
    editor->use_spaces(0);
    editor->active()->buffer()->set_text("line");
    editor->active()->buffer()->select_all();
    expect(editor->run("indent") == EDITOR_OK, "tab indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "\tline") == 1,
            "indent inserts a tab");
    editor->active()->buffer()->select_all();
    expect(editor->run("unindent") == EDITOR_OK, "tab unindent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "line") == 1,
            "unindent removes a tab");
    editor->use_spaces(1);
    editor->set_indent_style(2);
    expect(editor->indent_style() == 2, "both indent");
    expect(editor->uses_spaces() == 0, "both is not spaces");
    editor->active()->buffer()->set_text("");
    expect(editor->run("indent") == EDITOR_OK, "both indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "\t") == 1,
            "both inserts a tab");
    editor->active()->buffer()->set_text("  x");
    editor->active()->buffer()->select_all();
    expect(editor->run("indent") == EDITOR_OK,
            "both widens");
    expect(text_same(
                editor->active()->buffer()->text(),
                "\t  x") == 1,
            "both uses a tab and spaces");
    editor->set_indent_style(1);
    expect(editor->trims() == 0, "trim default");
    editor->set_trim(1);
    editor->active()->buffer()->set_text("keep  \n");
    path_join(pathC, EDITOR_PATH, dir, "trim.scpp");
    expect(editor->save_as(pathC) == EDITOR_OK, "trim save");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "keep\n") == 1,
            "trimmed spaces");
    editor->set_trim(0);
    editor->active()->buffer()->set_text("keep  \n");
    expect(editor->save_active() == EDITOR_OK,
            "plain save");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "keep  \n") == 1,
            "kept spaces");
    expect(editor->ensures_newline() == 0, "newline default");
    editor->active()->buffer()->set_text("plain");
    expect(editor->save_active() == EDITOR_OK,
            "save without a newline");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "plain") == 1,
            "leaves a missing newline");
    editor->set_newline(1);
    editor->active()->buffer()->set_text("plain");
    expect(editor->save_active() == EDITOR_OK,
            "save with a newline");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "plain\n") == 1,
            "appends a newline");
    expect(text_same(
                editor->active()->buffer()->text(),
                "plain\n") == 1,
            "buffer ends with a newline");
    editor->active()->buffer()->set_text("plain\n");
    expect(editor->save_active() == EDITOR_OK,
            "save an ending newline");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "plain\n") == 1,
            "does not add a second newline");
    editor->active()->buffer()->set_text("");
    expect(editor->save_active() == EDITOR_OK,
            "save an empty buffer");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr && text_same(raw, "\n") == 1,
            "empty buffer gains a newline");
    editor->set_newline(0);
