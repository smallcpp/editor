#include "../src/editor.shpp"
#include "../src/settings.shpp"

extern int setenv(
        const char *name,
        const char *value,
        int overwrite);

static int failures;

void expect(int cond, const char *msg) {
    if (cond == 0) {
        print("fail {:s}\n", msg);
        failures = failures + 1;
    }
}

int main(void) {
    char pattern[64];
    char pathA[EDITOR_PATH];
    char pathB[EDITOR_PATH];
    char pathC[EDITOR_PATH];
    char was[EDITOR_PATH];
    char now[EDITOR_PATH];
    char tiny[1];
    char *dir;
    Editor *editor;
    const char *io;
    char *raw;
    long n;

    failures = 0;
    text_copy(pattern, 64, "/tmp/editor-ed-XXXXXX");
    dir = mkdtemp(pattern);
    expect(dir != nullptr, "temp");
    if (dir == nullptr)
        return 1;
    expect(current_directory(was, EDITOR_PATH) == 1,
            "read cwd");
    expect(chdir(dir) == 0, "enter temp");
    expect(current_directory(now, EDITOR_PATH) == 1,
            "cwd after chdir");
    expect(text_same(now, dir) == 1, "open starts in cwd");
    expect(current_directory(nullptr, EDITOR_PATH) == 0,
            "cwd needs a buffer");
    tiny[0] = 'x';
    expect(current_directory(tiny, 1) == 0, "cwd needs room");
    expect(chdir(was) == 0, "restore cwd");
    path_join(pathA, EDITOR_PATH, dir, "a.scpp");
    path_join(pathB, EDITOR_PATH, dir, "b.scpp");
    path_join(pathC, EDITOR_PATH, dir, "c.scpp");
    io = "";
    expect(write_file(pathA, "int main\n", &io) == 1, "seed a");
    expect(write_file(pathB, "class Box\n", &io) == 1, "seed b");
    expect(write_file(pathC, "old\n", &io) == 1, "seed c");
    editor = new Editor();
    expect(editor->new_file() == EDITOR_OK, "untitled");
    expect(editor->active()->untitled() == 1, "starts blank");
    expect(editor->open_argument(dir) == EDITOR_FAILED,
            "reject directory");
    expect(text_same(editor->error(), "not a file") == 1,
            "directory message");
    expect(editor->count() == 1, "directory kept the blank");
    expect(editor->open_file(pathA) == EDITOR_OK, "open a");
    expect(editor->count() == 1, "blank replaced");
    expect(text_same(editor->active()->title(), "a.scpp") == 1,
            "title a");
    expect(editor->open_file(pathB) == EDITOR_OK, "open b");
    expect(editor->count() == 2, "two files");
    expect(editor->open_file(pathA) == EDITOR_OK, "focus a");
    expect(editor->index() == 0, "switched to a");
    expect(editor->new_file() == EDITOR_OK, "second untitled");
    expect(editor->count() == 3, "three documents");
    editor->set_index(0);
    editor->active()->buffer()->insert_text("X");
    expect(editor->active()->buffer()->dirty() == true, "dirty");
    expect(editor->save_active() == EDITOR_OK, "save");
    expect(editor->active()->buffer()->dirty() == false, "clean");
    raw = read_file(pathA, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "Xint main\n") == 1,
            "saved bytes");
    editor->set_index(2);
    editor->active()->buffer()->insert_text("U");
    expect(editor->save_active() == EDITOR_NEEDS_PATH,
            "untitled save");
    editor->set_index(1);
    editor->active()->buffer()->insert_text("Y");
    expect(editor->save_all() == EDITOR_OK, "save all");
    raw = read_file(pathB, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "Yclass Box\n") == 1,
            "saved b");
    editor->set_index(2);
    expect(editor->active()->buffer()->dirty() == true,
            "untitled skipped");
    expect(editor->save_as(pathB) == EDITOR_FAILED,
            "save as open");
    expect(text_same(editor->error(), "open document") == 1,
            "open document");
    expect(editor->active()->untitled() == 1, "still untitled");
    expect(editor->save_as(pathC) == EDITOR_FAILED, "needs overwrite");
    expect(text_same(editor->error(), "overwrite") == 1,
            "overwrite message");
    editor->allow_overwrite(1);
    expect(editor->save_as(pathC) == EDITOR_OK, "save as");
    expect(text_same(editor->active()->path(), pathC) == 1,
            "renamed");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr && text_same(raw, "U") == 1,
            "save as bytes");
    editor->active()->buffer()->set_text("abcdef");
    editor->active()->buffer()->select_span(1, 1, 1, 4);
    expect(editor->clipboard_copy() == EDITOR_OK, "copy");
    expect(text_same(editor->clipboard(), "abc") == 1,
            "copied");
    editor->active()->buffer()->move_to(1, 7);
    expect(editor->clipboard_paste() == EDITOR_OK, "paste");
    expect(text_same(
                editor->active()->buffer()->text(),
                "abcdefabc") == 1,
            "pasted");
    editor->run("undo");
    expect(text_same(
                editor->active()->buffer()->text(),
                "abcdef") == 1,
            "undo paste");
    editor->run("redo");
    expect(text_same(
                editor->active()->buffer()->text(),
                "abcdefabc") == 1,
            "redo paste");
    editor->active()->buffer()->select_span(1, 1, 1, 4);
    expect(editor->clipboard_cut() == EDITOR_OK, "cut");
    expect(text_same(editor->clipboard(), "abc") == 1, "cut text");
    expect(text_same(
                editor->active()->buffer()->text(),
                "defabc") == 1,
            "after cut");
    editor->active()->buffer()->set_text("line");
    editor->active()->buffer()->select_all();
    editor->run("indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "    line") == 1,
            "indent");
    editor->active()->buffer()->select_all();
    editor->run("unindent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "line") == 1,
            "unindent");
    expect(editor->save_active() == EDITOR_OK, "save edits");
    editor->set_index(0);
    editor->active()->buffer()->insert_text("Z");
    expect(editor->close_active() == EDITOR_NEEDS_CHOICE,
            "dirty close");
    expect(editor->pending() == PEND_CLOSE, "close pending");
    expect(editor->answer(EDITOR_CANCEL) == EDITOR_CANCELLED,
            "cancel close");
    expect(editor->pending() == PEND_NONE, "close cleared");
    expect(editor->count() == 3, "cancel kept documents");
    expect(editor->active()->buffer()->dirty() == true,
            "still dirty");
    expect(editor->close_active() == EDITOR_NEEDS_CHOICE,
            "close again");
    expect(editor->answer(EDITOR_DISCARD) == EDITOR_OK,
            "discard");
    expect(editor->count() == 2, "discard dropped one");
    editor->set_index(0);
    editor->active()->buffer()->insert_text("Q");
    expect(editor->quit() == EDITOR_NEEDS_CHOICE, "dirty quit");
    expect(editor->quit_ready() == 0, "quit waits");
    expect(editor->answer(EDITOR_CANCEL) == EDITOR_CANCELLED,
            "cancel quit");
    expect(editor->quit_ready() == 0, "quit cancelled");
    expect(editor->quit() == EDITOR_NEEDS_CHOICE, "quit again");
    expect(editor->answer(EDITOR_DISCARD) == EDITOR_OK,
            "discard quit");
    expect(editor->quit_ready() == 1, "quit ready");
    {
        Editor *many;
        char *body;
        long bytes;
        const char *err;

        many = new Editor();
        expect(many->open_file(pathA) == EDITOR_OK,
                "list open a");
        expect(many->open_file(pathB) == EDITOR_OK,
                "list open b");
        many->set_index(0);
        many->active()->buffer()->set_text("alpha\n");
        many->active()->buffer()->mark_dirty();
        many->set_index(1);
        many->active()->buffer()->set_text("beta\n");
        many->active()->buffer()->mark_dirty();
        expect(many->close_all() == EDITOR_NEEDS_CHOICE,
                "list choice");
        expect(many->save_at(0) == EDITOR_NEEDS_CHOICE,
                "one remains");
        expect(many->at(0)->buffer()->dirty() == false,
                "first saved");
        expect(many->discard_at(1) == EDITOR_OK,
                "discard rest");
        expect(many->pending() == PEND_NONE,
                "close all done");
        expect(many->count() == 1, "close all left one");
        err = "";
        bytes = 0;
        body = read_file(pathA, &bytes, &err);
        expect(body != nullptr
                && text_same(body, "alpha\n") == 1,
                "saved alpha");
        many = new Editor();
        many->new_file();
        many->active()->buffer()->insert_text("U");
        expect(many->quit() == EDITOR_NEEDS_CHOICE,
                "untitled choice");
        expect(many->save_at(0) == EDITOR_NEEDS_PATH,
                "untitled asks");
        expect(many->discard_at(0) == EDITOR_OK,
                "discard untitled");
        expect(many->quit_ready() == 1,
                "quit after discard");
    }
    editor->use_brackets(0);
    editor->new_file();
    editor->active()->buffer()->insert_text("(");
    expect(text_same(
                editor->active()->buffer()->text(),
                "(") == 1,
            "brackets setting");
    editor->use_brackets(1);
    editor->active()->buffer()->set_text("");
    editor->active()->buffer()->insert_text("(");
    expect(text_same(
                editor->active()->buffer()->text(),
                "()") == 1,
            "brackets restored");
    editor->set_bracket_pairs("<>");
    editor->active()->buffer()->set_text("");
    editor->active()->buffer()->insert_text("<");
    expect(text_same(
                editor->active()->buffer()->text(),
                "<>") == 1,
            "custom pairs");
    editor->active()->buffer()->set_text("");
    editor->active()->buffer()->insert_text("(");
    expect(text_same(
                editor->active()->buffer()->text(),
                "(") == 1,
            "pairs omit parens");
    editor->set_bracket_pairs(bracket_list());
    expect(editor->tab_width() == 4, "tab default");
    editor->set_tab_width(2);
    expect(editor->tab_width() == 2, "tab width");
    editor->active()->buffer()->set_text("");
    expect(editor->run("indent") == EDITOR_OK, "indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "  ") == 1,
            "two spaces");
    editor->set_tab_width(0);
    expect(editor->tab_width() == 1, "tab clamps");
    expect(editor->uses_spaces() == 1, "spaces default");
    editor->set_tab_width(4);
    editor->use_spaces(0);
    editor->active()->buffer()->set_text("line");
    editor->active()->buffer()->select_all();
    expect(editor->run("indent") == EDITOR_OK, "tab indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "\tline") == 1,
            "indent inserts a tab");
    editor->active()->buffer()->select_all();
    expect(editor->run("unindent") == EDITOR_OK, "tab unindent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "line") == 1,
            "unindent removes a tab");
    editor->use_spaces(1);
    editor->set_indent_style(2);
    expect(editor->indent_style() == 2, "both indent");
    expect(editor->uses_spaces() == 0, "both is not spaces");
    editor->active()->buffer()->set_text("");
    expect(editor->run("indent") == EDITOR_OK, "both indent");
    expect(text_same(
                editor->active()->buffer()->text(),
                "\t") == 1,
            "both inserts a tab");
    editor->active()->buffer()->set_text("  x");
    editor->active()->buffer()->select_all();
    expect(editor->run("indent") == EDITOR_OK,
            "both widens");
    expect(text_same(
                editor->active()->buffer()->text(),
                "\t  x") == 1,
            "both uses a tab and spaces");
    editor->set_indent_style(1);
    expect(editor->trims() == 0, "trim default");
    editor->set_trim(1);
    editor->active()->buffer()->set_text("keep  \n");
    path_join(pathC, EDITOR_PATH, dir, "trim.scpp");
    expect(editor->save_as(pathC) == EDITOR_OK, "trim save");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "keep\n") == 1,
            "trimmed spaces");
    editor->set_trim(0);
    editor->active()->buffer()->set_text("keep  \n");
    expect(editor->save_active() == EDITOR_OK,
            "plain save");
    raw = read_file(pathC, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "keep  \n") == 1,
            "kept spaces");
    {
        char folder[EDITOR_PATH];

        expect(dialog_folder(
                    folder,
                    EDITOR_PATH,
                    "/tmp/kept") == 1,
                "remembered folder");
        expect(text_same(folder, "/tmp/kept") == 1,
                "folder text");
        expect(dialog_folder(nullptr, 8, "/tmp") == 0,
                "folder needs a buffer");
        expect(chdir(dir) == 0, "folder cwd");
        expect(dialog_folder(folder, EDITOR_PATH, "") == 1,
                "empty remember");
        expect(text_same(folder, dir) == 1,
                "folder is cwd");
        expect(dialog_folder(
                    folder,
                    EDITOR_PATH,
                    nullptr) == 1,
                "missing remember");
        expect(text_same(folder, dir) == 1,
                "missing is cwd");
        expect(chdir(was) == 0, "leave folder cwd");
    }
    expect(setenv("HOME", dir, 1) == 0, "config home");
    {
        EditorConfig item;
        EditorConfig back;
        char path[EDITOR_PATH];
        int which;

        config_defaults(&item);
        which = key_index("key-search=");
        expect(which >= 0, "search key");
        expect(text_same(
                    item.accel[which],
                    "<Control>f") == 1,
                "default search key");
        expect(item.searchWrap == 1, "default wrap");
        expect(item.showSpace == 0, "default whitespace");
        expect(item.recentCount == 10, "default recent");
        expect(item.rememberFiles == 0, "default remember");
        expect(item.saveOnTab == 0, "default save tab");
        expect(item.saveOnWindow == 0, "default save window");
        expect(item.trimTrailing == 0, "default trim");
        expect(item.recoveryOn == 0, "default recovery");
        expect(item.recoveryMinutes == 5, "default minutes");
        expect(text_same(
                    item.bracketPairs,
                    "()[]{}\"\"''") == 1,
                "default pairs");
        expect(text_same(
                    theme_color(&item, "c", "keyword"),
                    "#2040c0") == 1,
                "default keyword");
        expect(text_same(
                    theme_color(&item, "python", "keyword"),
                    "#2040c0") == 1,
                "python uses default");
        expect(text_same(
                    theme_color(&item, "scpp", "preprocessor"),
                    "#a04020") == 1,
                "default preprocessor");
        expect(text_same(
                    theme_color(&item, "c", "string"),
                    "#208020") == 1,
                "default string");
        expect(text_same(
                    theme_color(&item, "c", "operator"),
                    "#404040") == 1,
                "default operator");
        expect(text_same(
                    theme_color(&item, "c", "brackets"),
                    "#1a1a1a") == 1,
                "default brackets");
        expect(text_same(
                    theme_color(&item, "c", "brackets-back"),
                    "#ffd56a") == 1,
                "default bracket back");
        expect(text_same(
                    theme_color(
                            &item,
                            "c",
                            "brackets-unmatched"),
                    "#ffffff") == 1,
                "default unmatched");
        expect(text_same(
                    theme_color(
                            &item,
                            "c",
                            "brackets-unmatched-back"),
                    "#c03030") == 1,
                "default unmatched back");
        expect(text_same(
                    theme_color(&item, "c", "background"),
                    "#ffffff") == 1,
                "default background");
        expect(theme_bold(&item, "c", "keyword") == 0,
                "default bold off");
        expect(theme_bold(
                    &item,
                    "c",
                    "brackets-unmatched") == 0,
                "default unmatched plain");
        expect(theme_set(
                    &item,
                    "python",
                    "keyword",
                    "#010203") == 1,
                "set python keyword");
        expect(text_same(
                    theme_color(&item, "python", "keyword"),
                    "#010203") == 1,
                "python keyword color");
        expect(text_same(
                    theme_color(&item, "c", "keyword"),
                    "#2040c0") == 1,
                "c keyword stays");
        expect(text_same(
                    theme_color(&item, "python", "string"),
                    "#208020") == 1,
                "python string falls back");
        expect(theme_set(
                    &item,
                    "python",
                    "keyword",
                    "red!") == 0,
                "reject bad color");
        expect(item.windowWidth == 0, "default width");
        item.searchWrap = 0;
        item.showSpace = 1;
        item.showEnds = 1;
        item.showStops = 1;
        text_copy(item.accel[which], 64, "<Control>g");
        item.brackets = 0;
        text_copy(item.bracketPairs, 64, "<>");
        item.spaces = 2;
        item.trimTrailing = 1;
        item.recoveryOn = 1;
        item.recoveryMinutes = 12;
        item.tabWidth = 2;
        item.showMargin = 1;
        item.marginCols = 90;
        text_copy(item.lineColor, 32, "#aabbcc");
        text_copy(item.marginColor, 32, "#112233");
        text_copy(item.font, 128, "Monospace 12");
        item.recentCount = 4;
        item.rememberFiles = 1;
        item.saveOnTab = 1;
        item.saveOnWindow = 1;
        item.windowWidth = 700;
        item.windowHeight = 500;
        item.recentUsed = 1;
        text_copy(
                item.recentPath[0],
                EDITOR_PATH,
                "/tmp/a.scpp");
        item.openCount = 1;
        text_copy(
                item.openPath[0],
                EDITOR_PATH,
                "/tmp/a.scpp");
        text_copy(
                item.activePath,
                EDITOR_PATH,
                "/tmp/a.scpp");
        expect(theme_set(
                    &item,
                    "",
                    "background",
                    "#f8f8f8") == 1,
                "set background");
        expect(theme_set(
                    &item,
                    "python",
                    "keyword-bold",
                    "1") == 1,
                "set python bold");
        expect(theme_set(
                    &item,
                    "python",
                    "background",
                    "#101010") == 1,
                "set python background");
        expect(config_path(path, EDITOR_PATH) == 1,
                "config path");
        expect(config_write(path, &item) == 1,
                "config write");
        config_defaults(&back);
        expect(config_read(path, &back) == 1,
                "config read");
        expect(back.brackets == 0, "saved brackets");
        expect(text_same(back.bracketPairs, "<>") == 1,
                "saved pairs");
        expect(back.spaces == 2, "saved both");
        expect(back.trimTrailing == 1, "saved trim");
        expect(back.recoveryOn == 1, "saved recovery");
        expect(back.recoveryMinutes == 12, "saved minutes");
        expect(back.tabWidth == 2, "saved tab");
        expect(back.showMargin == 1, "saved margin");
        expect(back.marginCols == 90, "saved columns");
        expect(text_same(back.lineColor, "#aabbcc") == 1,
                "saved line color");
        expect(text_same(
                    theme_color(&back, "python", "keyword"),
                    "#010203") == 1,
                "saved python keyword");
        expect(text_same(
                    theme_color(&back, "c", "background"),
                    "#f8f8f8") == 1,
                "saved background");
        expect(text_same(
                    theme_color(
                            &back,
                            "python",
                            "background"),
                    "#101010") == 1,
                "saved python background");
        expect(theme_bold(&back, "python", "keyword") == 1,
                "saved python bold");
        expect(theme_bold(&back, "c", "keyword") == 0,
                "saved c stays plain");
        expect(text_same(
                    theme_color(&back, "c", "keyword"),
                    "#2040c0") == 1,
                "saved default keyword");
        expect(text_same(
                    theme_color(&back, "python", "comment"),
                    "#808080") == 1,
                "saved missing tag");
        expect(theme_set(
                    &item,
                    "c",
                    "operator",
                    "#112233") == 1,
                "set c operator");
        expect(config_write(path, &item) == 1,
                "config write operator");
        config_defaults(&back);
        expect(config_read(path, &back) == 1,
                "config read operator");
        expect(text_same(
                    theme_color(&back, "c", "operator"),
                    "#112233") == 1,
                "saved c operator");
        expect(text_same(
                    theme_color(&back, "python", "operator"),
                    "#404040") == 1,
                "python operator default");
        expect(theme_set(
                    &item,
                    "python",
                    "brackets-back",
                    "#112244") == 1,
                "set python bracket back");
        expect(theme_set(
                    &item,
                    "c",
                    "brackets-unmatched",
                    "#010101") == 1,
                "set c unmatched");
        expect(config_write(path, &item) == 1,
                "config write brackets");
        config_defaults(&back);
        expect(config_read(path, &back) == 1,
                "config read brackets");
        expect(text_same(
                    theme_color(
                            &back,
                            "python",
                            "brackets-back"),
                    "#112244") == 1,
                "saved bracket back");
        expect(text_same(
                    theme_color(&back, "c", "brackets-back"),
                    "#ffd56a") == 1,
                "c bracket back stays");
        expect(text_same(
                    theme_color(
                            &back,
                            "c",
                            "brackets-unmatched"),
                    "#010101") == 1,
                "saved unmatched");
        expect(text_same(
                    theme_color(
                            &back,
                            "python",
                            "brackets-unmatched"),
                    "#ffffff") == 1,
                "python unmatched default");
        expect(text_same(
                    back.marginColor,
                    "#112233") == 1,
                "saved margin color");
        expect(text_same(back.font, "Monospace 12") == 1,
                "saved font");
        expect(text_same(
                    back.accel[which],
                    "<Control>g") == 1,
                "saved search key");
        expect(back.searchWrap == 0, "saved wrap");
        expect(back.showSpace == 1, "saved whitespace");
        expect(back.showEnds == 1, "saved line ends");
        expect(back.showStops == 1, "saved indent stops");
        expect(back.recentCount == 4, "saved recent count");
        expect(back.rememberFiles == 1, "saved remember");
        expect(back.saveOnTab == 1, "saved save tab");
        expect(back.saveOnWindow == 1, "saved save window");
        expect(back.windowWidth == 700, "saved width");
        expect(back.windowHeight == 500, "saved height");
        expect(back.recentUsed == 1, "saved recent");
        expect(text_same(
                    back.recentPath[0],
                    "/tmp/a.scpp") == 1,
                "saved recent path");
        expect(back.openCount == 1, "saved open");
        expect(text_same(
                    back.activePath,
                    "/tmp/a.scpp") == 1,
                "saved active");
        unlink(path);
    }
    unlink(pathA);
    unlink(pathB);
    unlink(pathC);
    rmdir(dir);
    if (failures == 0) {
        print("test-editor ok\n");
        return 0;
    }
    print("test-editor failed {}\n", failures);
    return 1;
}
