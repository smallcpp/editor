#include "../src/document.shpp"

static int failures;

void expect(int cond, const char *msg) {
    if (cond == 0) {
        print("fail {:s}\n", msg);
        failures = failures + 1;
    }
}

int main(void) {
    char pattern[64];
    char path[EDITOR_PATH];
    char *dir;
    Document *doc;
    const char *io;

    failures = 0;
    text_copy(pattern, 64, "/tmp/editor-doc-XXXXXX");
    dir = mkdtemp(pattern);
    expect(dir != nullptr, "temp");
    if (dir == nullptr)
        return 1;
    path_join(path, EDITOR_PATH, dir, "note.scpp");
    io = "";
    expect(write_file(path, "int main\n", &io) == 1, "seed");
    doc = new Document();
    expect(doc->untitled() == 1, "starts untitled");
    expect(doc->load_path(path) == 1, "load");
    expect(text_same(doc->title(), "note.scpp") == 1, "title");
    expect(text_same(doc->language(), "scpp") == 1, "language");
    expect(doc->buffer()->dirty() == false, "clean");
    doc->buffer()->insert_text("X");
    expect(doc->buffer()->dirty() == true, "edited");
    expect(doc->save_file(false) == 1, "save");
    expect(doc->buffer()->dirty() == false, "saved");
    expect(doc->disk_differs() == 0, "matches disk");
    expect(write_file(path, "other\n", &io) == 1, "outside write");
    expect(doc->disk_differs() == 1, "disk changed");
    expect(doc->reload_file() == 1, "reload");
    expect(text_same(doc->buffer()->text(), "other\n") == 1,
            "reloaded");
    path_join(path, EDITOR_PATH, dir, "bin.dat");
    {
        char bytes[4];
        int fd;

        bytes[0] = 'a';
        bytes[1] = 0;
        bytes[2] = 'b';
        bytes[3] = 0;
        fd = open(path, O_CREAT | O_TRUNC | O_WRONLY, 384);
        expect(fd >= 0, "binary fd");
        if (fd >= 0) {
            expect(write(fd, (void *)bytes, 3) == 3, "binary write");
            close(fd);
        }
    }
    expect(doc->load_path(path) == 0, "reject nul");
    expect(text_same(doc->error(), "not a text file") == 1,
            "nul message");
    expect(text_same(doc->buffer()->text(), "other\n") == 1,
            "buffer kept");
    path_join(path, EDITOR_PATH, dir, "bad.txt");
    {
        char bytes[2];
        int fd;

        bytes[0] = (char)255;
        bytes[1] = 0;
        fd = open(path, O_CREAT | O_TRUNC | O_WRONLY, 384);
        if (fd >= 0) {
            write(fd, (void *)bytes, 1);
            close(fd);
        }
    }
    expect(doc->load_path(path) == 0, "reject utf8");
    path_join(path, EDITOR_PATH, dir, "next.py");
    doc = new Document();
    doc->buffer()->set_text("print\n");
    doc->buffer()->insert_text(" ");
    expect(doc->save_as(path, true) == 1, "save as");
    expect(text_same(doc->language(), "python") == 1, "language follows");
    expect(doc->save_as("http://example/a", false) == 0, "reject uri");
    expect(text_same(doc->path(), path) == 1, "uri keeps path");
    expect(doc->save_as(dir, false) == 0, "reject directory");
    expect(text_same(doc->path(), path) == 1, "dir keeps path");
    expect(text_same(doc->title(), "next.py") == 1, "dir keeps title");
    unlink(path);
    path_join(path, EDITOR_PATH, dir, "widget.shpp");
    expect(write_file(path, "class A;\n", &io) == 1, "shpp seed");
    doc = new Document();
    expect(doc->load_path(path) == 1, "load shpp");
    expect(text_same(doc->language(), "scpp") == 1, "shpp language");
    unlink(path);
    path_join(path, EDITOR_PATH, dir, "watch.scpp");
    expect(write_file(path, "keep\n", &io) == 1, "watch seed");
    doc = new Document();
    expect(doc->disk_status() == 0, "untitled disk");
    expect(doc->write_recovery(dir) == 0, "untitled recovery");
    expect(doc->load_path(path) == 1, "watch load");
    expect(doc->disk_status() == 0, "disk same");
    expect(write_file(path, "other\n", &io) == 1, "watch change");
    expect(doc->disk_status() == 1, "disk status changed");
    doc->ignore_disk();
    expect(doc->disk_status() == 0, "disk ignored");
    expect(write_file(path, "third\n", &io) == 1, "watch again");
    expect(doc->disk_status() == 1, "disk status again");
    unlink(path);
    expect(doc->disk_status() == 2, "disk missing");
    doc->mark_missing();
    expect(doc->disk_status() == 0, "missing noted");
    expect(write_file(path, "keep\n", &io) == 1, "watch back");
    expect(doc->disk_status() == 0, "disk returned");
    doc->buffer()->set_text("saved work\n");
    expect(doc->write_recovery(dir) == 1, "recovery write");
    {
        char leaf[128];
        char rec[EDITOR_PATH];
        char *raw;
        long n;

        n = 0;
        expect(doc->recovery_leaf(leaf, 128) == 1, "leaf");
        path_join(rec, EDITOR_PATH, dir, leaf);
        raw = read_file(rec, &n, &io);
        expect(raw != nullptr, "recovery file");
        if (raw != nullptr)
            expect(text_same(raw, "saved work\n") == 1,
                    "recovery text");
        unlink(rec);
    }
    unlink(path);
    path_join(path, EDITOR_PATH, dir, "note.scpp");
    unlink(path);
    rmdir(dir);
    if (failures == 0) {
        print("test-document ok\n");
        return 0;
    }
    print("test-document failed {}\n", failures);
    return 1;
}
