#include "../src/ui.shpp"

static int failures;

extern void gtk_text_buffer_begin_user_action(void *buffer);
extern void gtk_text_buffer_end_user_action(void *buffer);
extern void gtk_text_buffer_insert_at_cursor(
        void *buffer,
        const char *text,
        int length);
extern void *gtk_window_get_toplevels(void);
extern unsigned int g_list_model_get_n_items(void *list);
extern void *g_list_model_get_item(
        void *list,
        unsigned int position);
extern const char *gtk_window_get_title(void *window);
extern int gtk_widget_get_mapped(void *widget);
extern void g_object_unref(void *object);
extern int system(const char *command);
extern int chdir(const char *path);

int tab_mark(const char *text) {
    if (text == nullptr)
        return 0;
    if (byte_at(text, 0) == 226
            && byte_at(text, 1) == 128
            && byte_at(text, 2) == 162)
        return 1;
    return 0;
}

int mapped_save_dialog(void) {
    void *list;
    unsigned int n;
    unsigned int i;

    list = gtk_window_get_toplevels();
    if (list == nullptr)
        return 0;
    n = g_list_model_get_n_items(list);
    i = 0;
    while (i < n) {
        void *window;
        const char *title;

        window = g_list_model_get_item(list, i);
        title = nullptr;
        if (window != nullptr
                && gtk_widget_get_mapped(window) != 0)
            title = gtk_window_get_title(window);
        if (title != nullptr
                && text_same(title, "Save") == 1) {
            g_object_unref(window);
            return 1;
        }
        if (window != nullptr)
            g_object_unref(window);
        i = i + 1;
    }
    return 0;
}

void type_text(TextBuffer *view, const char *text) {
    gtk_text_buffer_begin_user_action(view->native);
    gtk_text_buffer_insert_at_cursor(
            view->native,
            text,
            -1);
    gtk_text_buffer_end_user_action(view->native);
}

void expect(int cond, const char *msg) {
    if (cond == 0) {
        print("fail {:s}\n", msg);
        failures = failures + 1;
    }
}

static Ui *open_ui(Editor *editor) {
    Ui *ui;

    ui = new Ui(editor);
    ui->prepare();
    return ui;
}

static void burn_stack(long depth) {
    char pad[2048];
    long i;
    char *block;

    pad[0] = 1;
    pad[2047] = 2;
    if (depth > 0) {
        burn_stack(depth - 1);
        return;
    }
    i = 0;
    while (i < 200) {
        block = new char[512];
        block[0] = pad[0];
        i = i + 1;
    }
}

static int x_error(void *display, void *event) {
    (void)display;
    (void)event;
    return 0;
}

extern int setenv(
        const char *name,
        const char *value,
        int overwrite);
extern void *XOpenDisplay(const char *name);
extern int XCloseDisplay(void *display);
extern int XSetErrorHandler(void *handler);
extern int XQueryTree(
        void *display,
        unsigned long window,
        unsigned long *root,
        unsigned long *parent,
        unsigned long **children,
        unsigned int *count);
extern int XFree(void *data);
extern int XGetWindowAttributes(
        void *display,
        unsigned long window,
        void *attributes);
extern int XFetchName(
        void *display,
        unsigned long window,
        char **name);
extern int XSetInputFocus(
        void *display,
        unsigned long window,
        int revert,
        unsigned long time);
extern int XRaiseWindow(
        void *display,
        unsigned long window);
extern int XFlush(void *display);
extern unsigned int XKeysymToKeycode(
        void *display,
        unsigned long keysym);
extern int XTestFakeKeyEvent(
        void *display,
        unsigned int keycode,
        int is_press,
        unsigned long delay);
extern int XTestFakeButtonEvent(
        void *display,
        unsigned int button,
        int is_press,
        unsigned long delay);
extern int XTestFakeMotionEvent(
        void *display,
        int screen,
        int x,
        int y,
        unsigned long delay);
extern unsigned long XDefaultRootWindow(void *display);
extern int usleep(unsigned int usec);
extern int g_main_context_iteration(
        void *context,
        int block);

static void pump(int count) {
    int i;

    i = 0;
    while (i < count) {
        g_main_context_iteration(nullptr, 0);
        i = i + 1;
    }
}

static int send_chord(unsigned long keysym, int ctrl) {
    void *display;
    unsigned long root;
    unsigned long parent;
    unsigned long *kids;
    unsigned int count;
    unsigned long win;
    unsigned int i;
    unsigned int mod;
    unsigned int key;
    int clickX;
    int clickY;

    display = XOpenDisplay(nullptr);
    if (display == nullptr)
        return 0;
    XSetErrorHandler((void *)x_error);
    root = XDefaultRootWindow(display);
    kids = nullptr;
    count = 0;
    parent = 0;
    XQueryTree(
            display,
            root,
            &root,
            &parent,
            &kids,
            &count);
    win = 0;
    clickX = 200;
    clickY = 200;
    i = 0;
    while (i < count) {
        char *name;
        char attr[160];
        int *fields;

        name = nullptr;
        fields = (int *)attr;
        fields[2] = 0;
        XGetWindowAttributes(
                display,
                kids[i],
                (void *)attr);
        if (XFetchName(display, kids[i], &name) != 0
                && name != nullptr
                && text_same(name, "editor") == 1
                && fields[2] > 100) {
            win = kids[i];
            clickX = fields[0] + fields[2] / 2;
            clickY = fields[1] + fields[3] / 2;
        }
        if (name != nullptr)
            XFree((void *)name);
        i = i + 1;
    }
    if (kids != nullptr)
        XFree((void *)kids);
    if (win == 0) {
        XCloseDisplay(display);
        return 0;
    }
    XSetInputFocus(display, win, 2, 0);
    XRaiseWindow(display, win);
    XFlush(display);
    usleep(100000);
    XTestFakeMotionEvent(display, -1, clickX, clickY, 0);
    XFlush(display);
    usleep(20000);
    XTestFakeButtonEvent(display, 1, 1, 0);
    XFlush(display);
    usleep(20000);
    XTestFakeButtonEvent(display, 1, 0, 0);
    XFlush(display);
    usleep(80000);
    key = XKeysymToKeycode(display, keysym);
    mod = 0;
    if (ctrl != 0) {
        mod = XKeysymToKeycode(display, 0xffe3);
        XTestFakeKeyEvent(display, mod, 1, 0);
        XFlush(display);
        usleep(20000);
    }
    XTestFakeKeyEvent(display, key, 1, 0);
    XFlush(display);
    usleep(40000);
    XTestFakeKeyEvent(display, key, 0, 0);
    if (mod != 0)
        XTestFakeKeyEvent(display, mod, 0, 0);
    XFlush(display);
    XCloseDisplay(display);
    return 1;
}

static int send_ctrl_s(void) {
    return send_chord(0x73, 1);
}

void check_project_list(
        Ui *ui,
        Editor *editor,
        const char *pathA) {
    char folder[EDITOR_PATH];
    char nest[EDITOR_PATH];
    char child[EDITOR_PATH];
    const char *io;
    int i;
    int saw;
    int dirRow;
    int childRow;

    path_dir(folder, EDITOR_PATH, pathA);
    path_join(nest, EDITOR_PATH, folder, "nest");
    expect(mkdir(nest, 448) == 0, "nest folder");
    path_join(child, EDITOR_PATH, nest, "c.scpp");
    io = "";
    expect(write_file(child, "int c;\n", &io) == 1,
            "nest file");
    expect(ui->make_project(
                "demo",
                "directory",
                folder) == 1,
            "named project");
    expect(editor->count() == 1, "create closes buffers");
    expect(editor->active()->untitled() == 1,
            "previous file is gone");
    expect(ui->panel_page() == 1, "create shows the project");
    saw = -1;
    dirRow = -1;
    childRow = -1;
    i = 0;
    while (i < ui->panel_project_files()) {
        expect(text_has(
                    ui->shown_project_file(i),
                    "/") == 0,
                "tree hides the path");
        if (text_same(
                    ui->panel_project_file(i),
                    "a.scpp") == 1)
            saw = i;
        if (text_same(
                    ui->panel_project_file(i),
                    "nest") == 1
                && ui->project_row_dir(i) == 1)
            dirRow = i;
        if (text_same(
                    ui->panel_project_file(i),
                    "c.scpp") == 1)
            childRow = i;
        i = i + 1;
    }
    expect(saw >= 0, "project lists a");
    expect(text_same(
                ui->shown_project_file(saw),
                "a.scpp") == 1,
            "project row");
    expect(ui->project_clicks() == 1, "project single click");
    expect(dirRow >= 0, "project lists nest");
    expect(childRow < 0, "nest starts closed");
    ui->open_project_file(dirRow);
    childRow = -1;
    i = 0;
    while (i < ui->panel_project_files()) {
        expect(text_has(
                    ui->shown_project_file(i),
                    "/") == 0,
                "open tree hides the path");
        if (text_same(
                    ui->panel_project_file(i),
                    "c.scpp") == 1)
            childRow = i;
        i = i + 1;
    }
    expect(childRow >= 0, "nest opens");
    ui->open_project_file(saw);
    expect(text_same(
                editor->active()->path(),
                pathA) == 1,
            "project click opens");
}

void check_cmake_project(
        Ui *ui,
        const char *dir,
        const char *io) {
    char lists[EDITOR_PATH];
    int i;
    int saw;

    path_join(lists, EDITOR_PATH, dir, "CMakeLists.txt");
    expect(write_file(
                lists,
                "add_executable(demo a.scpp)\n",
                &io) == 1,
            "cmake lists");
    expect(ui->make_project("built", "cmake", dir) == 1,
            "cmake project");
    saw = -1;
    i = 0;
    while (i < ui->panel_project_files()) {
        expect(text_has(
                    ui->shown_project_file(i),
                    "/") == 0,
                "cmake tree name");
        if (text_same(
                    ui->panel_project_file(i),
                    "a.scpp") == 1)
            saw = i;
        i = i + 1;
    }
    expect(saw >= 0, "cmake lists a");
    unlink(lists);
}

void check_panel_layout(Ui *ui) {
    expect(ui->panel_scrolls() == 1, "panel scroll buttons");
    expect(text_same(ui->panel_scroll_mark(0), "<") == 1,
            "scroll left");
    expect(text_same(ui->panel_scroll_mark(1), ">") == 1,
            "scroll right");
    ui->scroll_panel_tabs(1);
    ui->scroll_panel_tabs(-1);
    expect(ui->panel_edge() >= 0, "panel on the left edge");
    ui->align_file_names();
    expect(ui->files_left() == 1, "files align left");
    ui->show_panel_page(1);
    pump(20);
    ui->align_file_names();
    expect(ui->project_files_left() == 1,
            "project files align left");
    ui->show_panel_page(0);
    ui->set_panel_width(280);
    usleep(100000);
    pump(20);
    expect(ui->panel_width() > 240, "panel grows");
    ui->set_panel_width(110);
    usleep(100000);
    pump(20);
    expect(ui->panel_width() < 160, "panel shrinks");
    expect(ui->panel_edge() >= 0, "panel stays on the edge");
}

void check_map_controls(Ui *ui) {
    long wide;
    long spun;
    long dragged;

    wide = ui->map_width();
    ui->show_settings();
    pump(10);
    spun = wide + 36;
    if (spun > 220)
        spun = 120;
    ui->set_map_spin(spun);
    usleep(100000);
    pump(20);
    expect(ui->map_width() > spun - 8, "spin widens the map");
    expect(ui->map_width() < spun + 8, "spin sets the map width");
    dragged = ui->map_width();
    if (dragged > 160)
        dragged = dragged - 40;
    else
        dragged = dragged + 40;
    ui->move_map_bar(dragged);
    usleep(100000);
    pump(20);
    expect(ui->map_width() > dragged - 8, "drag sets the map width");
    expect(ui->map_width() < dragged + 8, "drag keeps the map width");
    expect(ui->map_spin() > dragged - 8, "drag updates the spin");
    expect(ui->map_spin() < dragged + 8, "spin matches the drag");
    wide = ui->map_width();
    usleep(100000);
    pump(20);
    expect(ui->map_width() > wide - 3, "chosen width holds");
    expect(ui->map_width() < wide + 3, "map does not resize itself");
}

void check_map_click(Ui *ui, Editor *editor) {
    TextBuffer *view;
    TextIter *at;
    long before;
    long after;
    long y;
    long n;
    long height;

    view = ui->view_buffer();
    at = new TextIter(0, 0);
    view->place_cursor(at);
    height = ui->map_height();
    if (height < 4)
        height = 4;
    ui->drag_map_mark(height / 3);
    usleep(80000);
    pump(20);
    before = ui->map_mark();
    ui->drag_map_mark(0);
    n = 0;
    y = -1;
    while (n < 20) {
        usleep(50000);
        pump(10);
        y = ui->gutter_line_y(0);
        if (y >= 0)
            break;
        n = n + 1;
    }
    expect(before >= 0, "click starts with a mark");
    expect(y >= 0, "click starts at the top");
    at = new TextIter(12, 0);
    view->place_cursor(at);
    usleep(80000);
    pump(20);
    after = ui->map_mark();
    expect(editor->active()->buffer()->cursor_line() == 13,
            "click moves the caret");
    expect(ui->gutter_line_y(0) >= 0, "click does not scroll");
    expect(after > before, "click marks the caret line");
}

void check_map_mark(Ui *ui, Editor *editor) {
    long caret;
    long wide;
    long y;
    long height;
    long top;
    long page;
    long moved;

    ui->set_map_font("Monospace 4");
    expect(text_same(ui->map_font(), "Monospace 4") == 1,
            "map font");
    editor->active()->buffer()->move_to(1, 1);
    ui->scroll_view(0);
    pump(30);
    expect(ui->map_mark() >= 0, "map marks the line");
    expect(ui->map_mark() < ui->map_height(),
            "mark is on the map");
    caret = editor->active()->buffer()->cursor_line();
    height = ui->map_height();
    top = ui->map_top();
    ui->drag_map_mark(height - 1);
    usleep(80000);
    pump(20);
    expect(editor->active()->buffer()->cursor_line()
                    == caret,
            "drag leaves the caret");
    y = ui->gutter_line_y(0);
    expect(y < 0, "drag scrolls the buffer");
    expect(ui->map_top() > top, "viewport follows the drag");
    ui->drag_map_mark(0);
    usleep(80000);
    pump(20);
    top = ui->map_top();
    expect(ui->gutter_line_y(0) >= 0, "drag can return to the top");
    page = editor->index();
    ui->map_button(page, top + 2, 1);
    moved = top + 2 + height / 3;
    ui->map_drag(page, moved);
    usleep(80000);
    pump(20);
    expect(editor->active()->buffer()->cursor_line()
                    == caret,
            "gesture leaves the caret");
    expect(ui->map_top() > top, "gesture scrolls the buffer");
    ui->map_button(page, moved, 0);
    wide = ui->map_width();
    ui->set_map_width(wide + 40);
    usleep(100000);
    pump(20);
    expect(ui->map_width() > wide + 15, "map grows");
    wide = ui->map_width();
    usleep(100000);
    pump(20);
    expect(ui->map_width() > wide - 3, "map keeps its width");
    expect(ui->map_width() < wide + 3, "map width stays");
    check_map_controls(ui);
    check_map_click(ui, editor);
}

void check_panels(Ui *ui) {
    expect(ui->shows_left() == 1, "left starts shown");
    expect(ui->left_checked() == 1, "left starts checked");
    expect(ui->shows_map() == 1, "map starts shown");
    expect(ui->map_checked() == 1, "map starts checked");
    ui->set_option("Left panel", 0);
    expect(ui->shows_left() == 0, "left hides");
    expect(ui->left_checked() == 0, "left unchecked");
    ui->on_menu("Left panel");
    expect(ui->shows_left() == 0, "left stays hidden");
    ui->set_option("Left panel", 1);
    expect(ui->shows_left() == 1, "left shows");
    expect(ui->left_checked() == 1, "left checked");
    ui->set_option("Right panel", 0);
    expect(ui->shows_map() == 0, "map hides");
    expect(ui->map_checked() == 0, "map unchecked");
    ui->on_menu("Right panel");
    expect(ui->shows_map() == 0, "map stays hidden");
    ui->set_option("Right panel", 1);
    expect(ui->shows_map() == 1, "map shows");
    expect(ui->map_checked() == 1, "map checked");
}

void seed_ctrl_a(void) {
    char path[EDITOR_PATH];
    const char *io;

    expect(config_path(path, EDITOR_PATH) == 1, "config path");
    io = "";
    expect(write_file(
                path,
                "key-copy=<Control>a\n",
                &io) == 1,
            "seed copy key");
}

void check_select_all(Ui *ui, Editor *editor) {
    TextBuffer *view;
    TextIter *start;
    TextIter *end;
    EditBuffer *buffer;
    int shown;
    int copy;
    int select;

    view = ui->view_buffer();
    expect(view != nullptr, "select view");
    if (view == nullptr)
        return;
    buffer = editor->active()->buffer();
    expect(buffer != nullptr, "select buffer");
    if (buffer == nullptr)
        return;
    expect(text_same(buffer->text(), "two\n") == 1,
            "selects the open file");
    start = new TextIter(0, 1);
    view->place_cursor(start);
    buffer->set_cursor_offset(1);
    ui->on_menu("Select All");
    pump(4);
    expect(buffer->sel_lo() == 0, "select starts");
    expect(buffer->sel_hi() == 4, "select ends");
    expect(text_same(buffer->selected()->c_str(), "two\n") == 1,
            "selects the file");
    expect(buffer->dirty() == false, "select stays clean");
    start = new TextIter(0, 0);
    end = new TextIter(0, 0);
    shown = 0;
    if (view->selection_bounds(start, end) == true)
        shown = 1;
    expect(shown == 1, "view shows the selection");
    expect(start->line() == 0 && start->offset() == 0,
            "view starts at the top");
    expect(end->line() == 1 && end->offset() == 0,
            "view ends at the bottom");
    copy = key_index("key-copy=");
    select = key_index("key-select-all=");
    expect(text_same(ui->key_text(copy), "") == 1,
            "copy lost ctrl a");
    expect(text_same(ui->key_text(select), "<Control>a") == 1,
            "select keeps ctrl a");
    start = new TextIter(0, 0);
    view->place_cursor(start);
    buffer->set_cursor_offset(0);
}

void check_new_directory(Ui *ui, const char *dir);

void check_template_open(
        Ui *ui,
        const char *dir,
        const char *io) {
    char src[EDITOR_PATH];
    char dest[EDITOR_PATH];
    char file[EDITOR_PATH];
    char archive[EDITOR_PATH];
    char config[EDITOR_PATH];
    char small[EDITOR_PATH];
    String *cmd;
    int i;
    int saw;

    path_join(src, EDITOR_PATH, dir, "packsrc");
    expect(mkdir(src, 448) == 0, "template source");
    path_join(file, EDITOR_PATH, src, "hello.txt");
    expect(write_file(file, "hello\n", &io) == 1,
            "template hello");
    path_join(config, EDITOR_PATH, dir, ".config");
    if (file_is_dir(config) == 0)
        expect(mkdir(config, 448) == 0, "config dir");
    path_join(small, EDITOR_PATH, config, "smallcpp");
    if (file_is_dir(small) == 0)
        expect(mkdir(small, 448) == 0, "smallcpp dir");
    expect(template_archive(archive, EDITOR_PATH) == 1,
            "template path");
    cmd = new String();
    cmd->append("tar -C '");
    cmd->append(src);
    cmd->append("' -czf '");
    cmd->append(archive);
    cmd->append("' .");
    expect(system(cmd->c_str()) == 0, "pack template");
    path_join(dest, EDITOR_PATH, dir, "fresh");
    expect(ui->create_from_template(dest) == 1,
            "create new");
    expect(text_same(ui->project_name(), "fresh") == 1,
            "named from the directory");
    saw = 0;
    i = 0;
    while (i < ui->panel_project_files()) {
        if (text_same(
                    ui->panel_project_file(i),
                    "hello.txt") == 1)
            saw = 1;
        expect(text_has(
                    ui->shown_project_file(i),
                    "/") == 0,
                "template tree name");
        i = i + 1;
    }
    expect(saw == 1, "template lists hello");
    check_new_directory(ui, dir);
}

void check_new_directory(Ui *ui, const char *dir) {
    char file[EDITOR_PATH];
    char missing[EDITOR_PATH];
    char got[EDITOR_PATH];
    char kept[EDITOR_PATH];

    ui->show_template_project();
    path_join(file, EDITOR_PATH, dir, "a.scpp");
    ui->use_template_dir(file);
    expect(text_same(ui->template_directory(), dir) == 1,
            "file still names its directory");
    ui->use_template_dir(dir);
    expect(text_same(ui->template_directory(), dir) == 1,
            "existing directory stays");
    path_join(missing, EDITOR_PATH, dir, "brand-new");
    expect(file_is_dir(missing) == 0,
            "name is not a directory");
    ui->use_template_dir(missing);
    expect(text_same(
                ui->template_directory(),
                missing) == 1,
            "new name is kept");
    text_copy(kept, EDITOR_PATH, ui->template_directory());
    ui->use_template_dir(nullptr);
    expect(text_same(ui->template_directory(), kept) == 1,
            "cancel keeps the name");
    expect(ui->create_from_template(kept) == 1,
            "create the new directory");
    expect(file_is_dir(missing) == 1,
            "directory was created");
    path_join(got, EDITOR_PATH, missing, "hello.txt");
    expect(file_exists(got) == 1,
            "template unpacked into it");
    expect(text_same(ui->project_name(), "brand-new") == 1,
            "project uses the new name");
    ui->hide_template_project();
}

void check_template_browse(Ui *ui, const char *away) {
    char began[EDITOR_PATH];
    char back[EDITOR_PATH];
    char sample[EDITOR_PATH];

    text_copy(began, EDITOR_PATH, ui->template_browse_at());
    expect(began[0] == '/', "browse directory is absolute");
    expect(text_same(began, away) == 0,
            "start directory is not the later one");
    path_join(sample, EDITOR_PATH, away, "a.scpp");
    ui->open_path(sample);
    expect(current_directory(back, EDITOR_PATH) == 1,
            "remember directory");
    expect(chdir(away) == 0, "start in another directory");
    expect(ui->template_browse_aimed() == 1,
            "browse stays on the start directory");
    expect(text_same(ui->template_browse_at(), began) == 1,
            "browse directory did not move");
    expect(ui->template_browse_named() == 1,
            "browse accepts a typed name");
    expect(chdir(back) == 0, "return to the start directory");
}

void check_projects(
        Ui *ui,
        Editor *editor,
        const char *dir,
        const char *io) {
    char job[EDITOR_PATH];
    char other[EDITOR_PATH];
    char note[EDITOR_PATH];
    char side[EDITOR_PATH];
    char store[EDITOR_PATH];
    char copy[EDITOR_PATH];
    char *body;
    long n;
    int i;
    int sawJob;
    int sawAlso;
    int sawNote;
    int sawSide;
    int sawStray;
    char stray[EDITOR_PATH];

    i = 0;
    while (i < editor->count()) {
        Document *doc;

        doc = editor->at(i);
        if (doc != nullptr && doc->buffer() != nullptr)
            doc->buffer()->mark_clean();
        i = i + 1;
    }
    path_join(job, EDITOR_PATH, dir, "job");
    path_join(other, EDITOR_PATH, dir, "other");
    expect(mkdir(job, 448) == 0, "job folder");
    expect(mkdir(other, 448) == 0, "other folder");
    path_join(note, EDITOR_PATH, job, "note.scpp");
    path_join(side, EDITOR_PATH, job, "side.scpp");
    expect(write_file(note, "a\nb\nc\nd\n", &io) == 1,
            "job note");
    expect(write_file(side, "side\n", &io) == 1,
            "job side");
    expect(ui->make_project("job", "directory", job) == 1,
            "make job");
    expect(ui->make_project("also", "directory", job) == 1,
            "second project");
    expect(ui->make_project("other", "directory", other) == 1,
            "make other");
    sawJob = 0;
    sawAlso = 0;
    n = ui->known_projects();
    i = 0;
    while (i < (int)n) {
        if (text_same(ui->known_project(i), "job") == 1)
            sawJob = 1;
        if (text_same(ui->known_project(i), "also") == 1)
            sawAlso = 1;
        i = i + 1;
    }
    expect(sawJob == 1, "lists job");
    expect(sawAlso == 1, "lists also");
    expect(ui->open_named_project("job") == 1, "open job");
    expect(text_same(ui->project_name(), "job") == 1,
            "name is job");
    text_copy(store, EDITOR_PATH, ui->project_path());
    expect(file_exists(store) == 1, "project file");
    expect(text_has(
                store,
                "/.config/smallcpp/projects/") == 1,
            "project directory");
    expect(text_has(store, "job.project") == 1,
            "project file name");
    n = 0;
    body = read_file(store, &n, &io);
    expect(body != nullptr, "project text");
    if (body != nullptr) {
        expect(text_has(body, "name=job") == 1,
                "stored name");
        expect(text_has(body, "kind=directory") == 1,
                "stored kind");
        free((void *)body);
    }
    ui->open_path(side);
    ui->open_path(note);
    editor->active()->buffer()->move_to(3, 1);
    editor->active()->buffer()->mark_clean();
    ui->on_project_menu("Save");
    ui->on_project_menu("Close");
    expect(text_same(ui->project_name(), "") == 1,
            "project closed");
    editor->active()->buffer()->mark_clean();
    ui->on_menu("Close");
    editor->active()->buffer()->mark_clean();
    ui->on_menu("Close");
    path_join(stray, EDITOR_PATH, dir, "stray.scpp");
    expect(write_file(stray, "stray\n", &io) == 1,
            "stray file");
    ui->open_path(stray);
    ui->show_panel_page(0);
    expect(ui->panel_page() == 0, "files page");
    expect(ui->open_named_project("job") == 1, "reopen job");
    sawStray = 0;
    i = 0;
    while (i < editor->count()) {
        Document *doc;

        doc = editor->at(i);
        if (doc != nullptr
                && text_same(doc->path(), stray) == 1)
            sawStray = 1;
        i = i + 1;
    }
    expect(sawStray == 0, "open closes the previous buffer");
    expect(ui->panel_page() == 1, "open shows the project");
    expect(text_same(ui->project_name(), "job") == 1,
            "job stays open");
    ui->on_project_menu("New");
    expect(text_same(ui->project_name(), "job") == 1,
            "new does not replace the project");
    expect(text_same(editor->active()->path(), note) == 1,
            "restored file");
    expect(editor->active()->buffer()->cursor_line() == 3,
            "restored line");
    sawNote = 0;
    sawSide = 0;
    i = 0;
    while (i < editor->count()) {
        Document *doc;

        doc = editor->at(i);
        if (doc != nullptr
                && text_same(doc->path(), note) == 1)
            sawNote = 1;
        if (doc != nullptr
                && text_same(doc->path(), side) == 1)
            sawSide = 1;
        i = i + 1;
    }
    expect(sawNote == 1, "restored note");
    expect(sawSide == 1, "restored side");
    expect(ui->open_named_project("also") == 1, "open also");
    text_copy(copy, EDITOR_PATH, ui->project_path());
    ui->on_project_menu("Delete");
    expect(file_exists(copy) == 0, "delete removes the file");
    expect(file_exists(store) == 1, "other project remains");
    expect(text_same(ui->project_name(), "") == 1,
            "deleted project closed");
    ui->open_path(stray);
    editor->active()->buffer()->set_text("changed\n");
    editor->active()->buffer()->mark_dirty();
    expect(ui->make_project("later", "directory", job) == 0,
            "dirty create waits");
    expect(text_same(ui->project_name(), "") == 1,
            "create waits for the buffer");
    expect(ui->listed_count() == 1, "lists the dirty buffer");
    ui->discard_listed(ui->listed_at(0));
    expect(text_same(ui->project_name(), "later") == 1,
            "create finishes");
    expect(ui->panel_page() == 1, "create shows the project");
    sawStray = 0;
    i = 0;
    while (i < editor->count()) {
        Document *doc;

        doc = editor->at(i);
        if (doc != nullptr
                && text_same(doc->path(), stray) == 1)
            sawStray = 1;
        i = i + 1;
    }
    expect(sawStray == 0, "create closes the previous buffer");
    check_template_open(ui, dir, io);
    i = 0;
    while (i < editor->count()) {
        Document *doc;

        doc = editor->at(i);
        if (doc != nullptr && doc->buffer() != nullptr)
            doc->buffer()->mark_clean();
        i = i + 1;
    }
}

int main(void) {
    char pattern[64];
    char pathA[EDITOR_PATH];
    char pathB[EDITOR_PATH];
    char pathC[EDITOR_PATH];
    char *dir;
    Editor *editor;
    Ui *ui;
    TextBuffer *view;
    TextIter *start;
    TextIter *end;
    const char *io;

    failures = 0;
    try {
        text_copy(pattern, 64, "/tmp/editor-win-XXXXXX");
        dir = mkdtemp(pattern);
        expect(dir != nullptr, "temp");
        if (dir == nullptr)
            return 1;
        path_join(pathA, EDITOR_PATH, dir, "a.scpp");
        path_join(pathB, EDITOR_PATH, dir, "b.scpp");
        io = "";
        expect(write_file(pathA, "one\n", &io) == 1, "seed a");
        expect(write_file(pathB, "two\n", &io) == 1, "seed b");
        editor = new Editor();
        expect(editor->open_file(pathA) == EDITOR_OK, "open a");
        expect(editor->open_file(pathB) == EDITOR_OK, "open b");
        expect(setenv("HOME", dir, 1) == 0, "home");
        seed_ctrl_a();
        ui = open_ui(editor);
        burn_stack(8);
        expect(text_same(ui->page_text(0), "one\n") == 1,
                "page a");
        check_panels(ui);
        expect(text_same(ui->page_text(1), "two\n") == 1,
                "page b");
        check_select_all(ui, editor);
        path_join(pathC, EDITOR_PATH, dir, "how_dy.scpp");
        expect(write_file(pathC, "howdy\n", &io) == 1,
                "seed howdy");
        ui->open_path(pathC);
        expect(text_same(ui->recent_at(0), pathC) == 1,
                "recent first");
        expect(ui->recent_count() == 10, "recent count");
        expect(editor->index() == 2, "open activates the tab");
        expect(text_has(
                    ui->tab_text(editor->index()),
                    "how_dy.scpp") == 1,
                "underscore in the name");
        {
            int i;
            int saw;

            saw = 0;
            i = 0;
            while (i < ui->panel_documents()) {
                if (text_same(
                            ui->shown_document(i),
                            "how_dy.scpp") == 1)
                    saw = 1;
                i = i + 1;
            }
            expect(saw == 1, "documents keeps the underscore");
        }
        expect(text_same(
                    ui->page_text(editor->index()),
                    "howdy\n") == 1,
                "opened howdy");
        ui->on_menu("Comment");
        expect(text_same(
                    ui->page_text(editor->index()),
                    "// howdy\n") == 1,
                "menu comment");
        ui->on_menu("Comment");
        expect(text_same(
                    ui->page_text(editor->index()),
                    "howdy\n") == 1,
                "menu uncomment");
        editor->active()->buffer()->mark_clean();
        ui->on_menu("Close");
        expect(editor->count() == 2, "closed howdy");
        unlink(pathC);
        ui->open_recent(pathC);
        expect(ui->missing_prompt() == 1,
                "recent says missing");
        expect(text_same(
                    ui->missing_text(),
                    "File \"how_dy.scpp\" not found.") == 1,
                "missing text");
        expect(editor->count() == 2,
                "missing file stays closed");
        expect(text_same(ui->page_text(0), "one\n") == 1,
                "missing leaves the buffer");
        ui->answer_missing(1);
        expect(ui->missing_prompt() == 0,
                "missing notice closed");
        expect(write_file(pathC, "howdy\n", &io) == 1,
                "recent restored");
        ui->open_recent(pathC);
        expect(ui->missing_prompt() == 0,
                "present file opens");
        expect(editor->count() == 3, "recent opened");
        expect(text_same(
                    ui->page_text(editor->index()),
                    "howdy\n") == 1,
                "recent text");
        ui->on_menu("Close");
        expect(editor->count() == 2, "closed recent again");
        {
            char sym[EDITOR_PATH];
            String *json;
            int i;
            int saw;

            expect(ui->show_folder(dir) == 1,
                    "panel folder");
            check_project_list(ui, editor, pathA);
            saw = 0;
            i = 0;
            while (i < ui->panel_files()) {
                if (text_same(
                            ui->panel_file(i),
                            "a.scpp") == 1) {
                    saw = 1;
                    expect(text_same(
                                ui->shown_file(i),
                                "a.scpp") == 1,
                            "file row");
                }
                i = i + 1;
            }
            expect(saw == 1, "panel lists a");
            check_cmake_project(ui, dir, io);
            ui->open_path(pathA);
            ui->open_path(pathB);
            path_join(sym, EDITOR_PATH, dir, "sym.scpp");
            json = new String();
            json->append("class Box {\n};\n\n");
            json->append("int work(void) {\n");
            json->append("    return 1;\n}\n");
            expect(write_file(
                        sym,
                        json->c_str(),
                        &io) == 1,
                    "symbol file");
            expect(ui->show_folder(dir) == 1,
                    "see symbol file");
            saw = -1;
            i = 0;
            while (i < ui->panel_files()) {
                if (text_same(
                            ui->panel_file(i),
                            "sym.scpp") == 1)
                    saw = i;
                i = i + 1;
            }
            expect(saw >= 0, "lists sym");
            ui->open_panel_file(saw);
            expect(text_has(
                        ui->page_text(editor->index()),
                        "work") == 1,
                    "panel opened");
            saw = -1;
            i = 0;
            while (i < ui->panel_symbols()) {
                if (text_same(
                            ui->panel_symbol(i),
                            "work") == 1)
                    saw = i;
                i = i + 1;
            }
            expect(saw >= 0, "symbol work");
            expect(ui->panel_symbol_line(saw) == 4,
                    "work line");
            ui->open_panel_symbol(saw);
            expect(
                    editor->active()->buffer()
                    ->cursor_line() == 4,
                    "symbol moves");
            editor->active()->buffer()->mark_clean();
            ui->on_menu("Close");
            expect(editor->count() == 2,
                    "closed symbol");
            unlink(sym);
        }
        {
            char pathR[EDITOR_PATH];
            long count;

            path_join(pathR, EDITOR_PATH, dir, "kept.scpp");
            expect(write_file(pathR, "draft\n", &io) == 1,
                    "recover seed");
            ui->open_path(pathR);
            editor->active()->buffer()->set_text(
                    "draft plus\n");
            editor->active()->buffer()->mark_dirty();
            expect(editor->save_active() == EDITOR_OK,
                    "recover save");
            expect(ui->write_recovery_files() >= 1,
                    "recover copy");
            ui->on_menu("Close");
            count = editor->count();
            unlink(pathR);
            ui->set_option("Write recovery files", 1);
            ui->offer_recovery();
            expect(ui->recovery_prompt() == 1,
                    "recover prompt");
            expect(text_same(
                        ui->recovery_text(),
                        "File \"kept.scpp\" is gone.") == 1,
                    "recover text");
            ui->answer_recovery(2);
            expect(ui->recovery_prompt() == 0,
                    "recover ignored");
            expect(editor->count() == count,
                    "ignore stays closed");
            {
                char recDir[EDITOR_PATH];
                char leaf[128];
                char recPath[EDITOR_PATH];

                expect(recovery_dir(
                            recDir,
                            EDITOR_PATH) == 1,
                        "recover dir");
                expect(recovery_leaf_for(
                            pathR, leaf, 128) == 1,
                        "recover leaf");
                path_join(
                        recPath,
                        EDITOR_PATH,
                        recDir,
                        leaf);
                expect(file_exists(recPath) == 0,
                        "ignore removes the copy");
            }
            ui->offer_recovery();
            expect(ui->recovery_prompt() == 0,
                    "ignore does not ask again");
            expect(write_file(pathR, "draft\n", &io) == 1,
                    "recover seed again");
            ui->open_path(pathR);
            editor->active()->buffer()->set_text(
                    "draft plus\n");
            editor->active()->buffer()->mark_dirty();
            expect(editor->save_active() == EDITOR_OK,
                    "recover save again");
            expect(ui->write_recovery_files() >= 1,
                    "recover copy again");
            ui->on_menu("Close");
            unlink(pathR);
            ui->offer_recovery();
            expect(ui->recovery_prompt() == 1,
                    "recover asks to open");
            ui->answer_recovery(1);
            expect(text_same(
                        ui->page_text(editor->index()),
                        "draft plus\n") == 1,
                    "opened recovery");
            expect(text_same(
                        ui->restored_text(),
                        "File \"kept.scpp\" was restored.")
                    == 1,
                    "says restored");
            ui->answer_restored(1);
            expect(ui->restored_prompt() == 0,
                    "restored closed");
            editor->active()->buffer()->mark_clean();
            ui->on_menu("Close");
            expect(editor->count() == count,
                    "closed recovery");
            ui->set_option("Write recovery files", 0);
            unlink(pathR);
        }
        ui->switched(0);
        expect(editor->index() == 0, "switch");
        view = ui->view_buffer();
        expect(view != nullptr, "view");
        expect(text_has(ui->line_number_text(), "1") == 1,
                "line numbers");
        expect(text_has(ui->line_number_text(), "2") == 1,
                "blank line number");
        view->set_text("");
        type_text(view, "(");
        expect(text_same(ui->page_text(0), "()") == 1,
                "type open paren");
        expect(editor->active()->buffer()->cursor_offset()
                        == 1,
                "caret between parens");
        type_text(view, ")");
        expect(text_same(ui->page_text(0), "()") == 1,
                "type close paren");
        expect(editor->active()->buffer()->cursor_offset()
                        == 2,
                "caret after pair");
        view->set_text("");
        type_text(view, "{");
        expect(text_same(ui->page_text(0), "{}") == 1,
                "type brace");
        ui->on_menu("Settings");
        editor->use_brackets(0);
        view->set_text("");
        type_text(view, "(");
        expect(text_same(ui->page_text(0), "(") == 1,
                "brackets off");
        editor->use_brackets(1);
        view->set_text("int value;\n");
        start = new TextIter(0, 0);
        end = new TextIter(0, 3);
        view->select_range(start, end);
        ui->on_menu("Copy");
        expect(text_same(editor->clipboard(), "int") == 1,
                "view copy");
        editor->active()->buffer()->set_cursor_offset(
                editor->active()->buffer()->size());
        ui->on_menu("Paste");
        expect(text_same(
                    editor->active()->buffer()->text(),
                    "int value;\nint") == 1,
                "view paste");
        expect(text_same(ui->page_text(0), "int value;\nint") == 1,
                "view shows paste");
        ui->on_menu("Undo");
        expect(text_same(
                    ui->page_text(0),
                    "int value;\n") == 1,
                "view undo");
        ui->on_menu("Redo");
        expect(text_same(
                    ui->page_text(0),
                    "int value;\nint") == 1,
                "view redo");
        view = ui->view_buffer();
        view->set_text("line\n");
        start = new TextIter(0, 0);
        end = new TextIter(0, 4);
        view->select_range(start, end);
        ui->on_menu("Indent");
        expect(text_same(ui->page_text(0), "    line\n") == 1,
                "view indent");
        ui->on_menu("Unindent");
        expect(text_same(ui->page_text(0), "line\n") == 1,
                "view unindent");
        view->set_text("hi");
        ui->on_menu("Record");
        ui->record_key("<Shift>q");
        ui->record_key("<Control>slash");
        ui->on_menu("Stop");
        expect(ui->recorded_keys() == 2, "two keys recorded");
        view->set_text("hi");
        start = new TextIter(0, 0);
        view->place_cursor(start);
        ui->on_menu("Play");
        expect(text_same(ui->page_text(0), "// Qhi") == 1,
                "played the macro");
        view->set_text("one\ntwo\n");
        pump(4);
        start = new TextIter(0, 0);
        view->place_cursor(start);
        ui->add_caret(1, 0);
        expect(ui->caret_count() == 2, "two carets");
        type_text(view, "X");
        type_text(view, "Y");
        pump(4);
        expect(text_same(ui->page_text(0), "XYone\nXYtwo\n") == 1,
                "typed at both carets");
        ui->on_menu("Comment");
        expect(text_same(
                    ui->page_text(0),
                    "// XYone\n// XYtwo\n") == 1,
                "comment at both carets");
        ui->on_menu("Undo");
        expect(text_same(ui->page_text(0), "XYone\nXYtwo\n") == 1,
                "undo caret comment");
        ui->clear_carets();
        view = ui->view_buffer();
        view->set_text("ab\ncd\n");
        pump(4);
        start = new TextIter(0, 2);
        view->place_cursor(start);
        ui->add_caret(1, 2);
        start = new TextIter(0, 1);
        end = new TextIter(0, 2);
        view->delete_range(start, end);
        pump(4);
        expect(text_same(ui->page_text(0), "a\nc\n") == 1,
                "delete at both carets");
        ui->clear_carets();
        expect(ui->caret_count() == 1, "carets cleared");
        view->set_text("line\n");
        expect(editor->active()->buffer()->dirty() == true,
                "edited");
        expect(tab_mark(ui->tab_text(0)) == 1, "dirty dot");
        ui->on_menu("Close");
        expect(editor->count() == 2, "dirty close waits");
        expect(editor->pending() == PEND_CLOSE, "close pending");
        ui->choice(EDITOR_CANCEL);
        expect(editor->pending() == PEND_NONE, "cancel close");
        expect(editor->count() == 2, "cancel kept both");
        ui->on_menu("Save");
        expect(editor->active()->buffer()->dirty() == false,
                "menu save");
        expect(tab_mark(ui->tab_text(0)) == 0, "clean dot");
        ui->set_option(
                "Save when a tab loses focus",
                1);
        view->set_text("blur\n");
        ui->switched(1);
        {
            char *blurred;
            long blurN;
            const char *blurErr;

            blurErr = "";
            blurN = 0;
            blurred = read_file(pathA, &blurN, &blurErr);
            expect(blurred != nullptr
                    && text_same(blurred, "blur\n") == 1,
                    "tab blur saved");
        }
        ui->set_option(
                "Save when a tab loses focus",
                0);
        ui->switched(0);
        expect(mapped_save_dialog() == 0, "named save has no dialog");
        view->set_text("saved\n");
        expect(editor->active()->buffer()->dirty() == true,
                "ctrl save dirty");
        ui->show_main();
        pump(40);
        check_panel_layout(ui);
        expect(send_ctrl_s() == 1, "ctrl s sent");
        pump(40);
        {
            char *raw;
            long n;
            const char *io2;
            long y;
            long yLine;
            long i;
            char many[256];

            io2 = "";
            n = 0;
            raw = read_file(pathA, &n, &io2);
            expect(raw != nullptr
                    && text_same(raw, "saved\n") == 1,
                    "ctrl s wrote the file");
            expect(mapped_save_dialog() == 0,
                    "ctrl s has no dialog");
            y = ui->gutter_line_y(0);
            expect(y >= 0 && y < 40,
                    "line 1 sits on the first text line");
            view->set_text("");
            ui->on_menu("Record");
            expect(send_chord(0x71, 0) == 1, "letter sent");
            pump(20);
            ui->on_menu("Stop");
            expect(ui->recorded_keys() >= 1, "heard the letter");
            expect(text_has(ui->page_text(0), "q") == 1,
                    "letter reached the buffer");
            view->set_text("");
            ui->on_menu("Play");
            expect(text_same(ui->page_text(0), "q") == 1,
                    "played the letter");
            i = 0;
            while (i + 2 < 256) {
                many[i] = 'x';
                many[i + 1] = '\n';
                i = i + 2;
            }
            many[i] = 0;
            view->set_text(many);
            pump(20);
            i = 0;
            y = 0;
            yLine = -1;
            while (i < 40) {
                ui->scroll_view(100);
                usleep(50000);
                pump(10);
                y = ui->gutter_line_y(0);
                yLine = ui->gutter_line_y(100);
                if (y < 0 && yLine >= 0 && yLine < 700)
                    break;
                i = i + 1;
            }
            expect(y < 0, "scrolled line 1 leaves the gutter");
            expect(yLine >= 0 && yLine < 700,
                    "scrolled line stays with its text");
            pump(20);
            {
                const char *gutter;

                gutter = ui->line_number_text();
                expect(gutter[0] != '1'
                        || gutter[1] != '\n',
                        "gutter names the buffer line");
            }
            {
                String *shape;
                long top;
                long band;
                long height;
                long y;
                int n;

                shape = new String();
                shape->append("short\n");
                shape->append("\n");
                n = 0;
                while (n < 40) {
                    shape->append("x");
                    n = n + 1;
                }
                shape->append("\n");
                n = 0;
                while (n < 80) {
                    shape->append(".\n");
                    n = n + 1;
                }
                view->set_text(shape->c_str());
                ui->scroll_view(0);
                n = 0;
                y = -1;
                while (n < 40) {
                    usleep(50000);
                    pump(10);
                    y = ui->gutter_line_y(0);
                    if (y >= 0 && y < 40)
                        break;
                    n = n + 1;
                }
                expect(y >= 0 && y < 40,
                        "map test starts at the top");
                expect(ui->map_ink(0) == 5,
                        "map short line");
                expect(ui->map_ink(1) == 0,
                        "map blank line");
                expect(ui->map_ink(2) == 40,
                        "map long line");
                height = ui->map_height();
                expect(height > 40, "map has a height");
                top = ui->map_top();
                band = ui->map_band();
                expect(band > 0, "viewport band");
                expect(band < height,
                        "viewport is part of the file");
                ui->map_click(height - 1);
                n = 0;
                y = 0;
                while (n < 40) {
                    usleep(50000);
                    pump(10);
                    y = ui->gutter_line_y(0);
                    if (y < 0)
                        break;
                    n = n + 1;
                }
                expect(y < 0, "map click leaves the top");
                expect(ui->map_top() > top,
                        "viewport moved down");
                check_map_mark(ui, editor);
            }
            editor->active()->buffer()->mark_clean();
        }
        ui->on_menu("Close");
        expect(editor->count() == 1, "clean close");
        ui->switched(0);
        expect(text_same(ui->page_text(0), "two\n") == 1,
                "other file remains");
        expect(text_has(ui->tab_text(0), "b.scpp") == 1,
                "named tab");
        expect(text_same(ui->tab_text(0), "b.scpp") == 1,
                "tab is the file name");
        expect(ui->path_depth() == 0, "depth starts at zero");
        ui->set_option("Show path in file tab", 1);
        ui->set_path_depth(0);
        expect(text_same(ui->tab_text(0), "b.scpp") == 1,
                "depth zero stays the name");
        ui->set_path_depth(2);
        {
            char tail[EDITOR_PATH];

            path_tail(tail, EDITOR_PATH, pathB, 2);
            expect(text_same(ui->tab_text(0), tail) == 1,
                    "tab shows two directories");
        }
        ui->set_option("Show path in file tab", 0);
        expect(text_same(ui->tab_text(0), "b.scpp") == 1,
                "path off is the name");
        expect(ui->tab_marks() == 1, "close marks");
        expect(ui->shows_line() == 1, "current line");
        expect(ui->shows_margin() == 0, "margin off");
        expect(ui->margin_columns() == 80, "margin columns");
        expect(editor->tab_width() == 4, "tab default");
        editor->set_tab_width(7);
        ui->set_option("Remember files", 1);
        ui->set_option(
                "Save when a tab loses focus",
                1);
        ui->set_option(
                "Save when the window loses focus",
                1);
        ui->set_option(
                "Trim trailing spaces on save",
                1);
        ui->set_option(
                "Ensure newline at end of file",
                1);
        ui->set_option("Show path in file tab", 1);
        ui->set_path_depth(2);
        expect(editor->ensures_newline() == 1,
                "newline on");
        expect(ui->path_depth() == 2, "depth two");
        expect(ui->recovery_on() == 0, "recovery off");
        expect(ui->recovery_minutes() == 5, "five minutes");
        ui->set_option("Write recovery files", 1);
        ui->set_recovery_minutes(9);
        ui->set_recovery_keep(8);
        expect(ui->recovery_on() == 1, "recovery on");
        expect(ui->recovery_minutes() == 9, "nine minutes");
        editor->set_indent_style(2);
        ui->on_menu("Settings");
        expect(text_has(
                    ui->key_help(),
                    "Escape cancels") == 1,
                "key help");
        expect(ui->assign_key(0, "<Control>o") == 0,
                "duplicate key");
        expect(text_has(ui->key_warning(), "Open") == 1,
                "names the command");
        expect(text_same(
                    ui->key_text(0),
                    "<Control>n") == 1,
                "keeps New");
        ui->apply_settings();
        {
            char path[EDITOR_PATH];
            char *raw;
            long n;
            const char *err;

            err = "";
            n = 0;
            expect(config_path(path, EDITOR_PATH) == 1,
                    "settings path");
            raw = read_file(path, &n, &err);
            expect(raw != nullptr, "settings file");
            if (raw != nullptr) {
                expect(text_has(raw, "tab-width=7") == 1,
                        "saved tab width");
                expect(text_has(raw, "search-wrap=1") == 1,
                        "saved wrap");
                expect(text_has(
                            raw,
                            "show-whitespace=0") == 1,
                        "saved whitespace");
                expect(text_has(raw, "left-panel=1") == 1,
                        "saved left panel");
                expect(text_has(raw, "right-panel=1") == 1,
                        "saved right panel");
                expect(text_has(raw, "recovery=1") == 1,
                        "saved recovery");
                expect(text_has(
                            raw,
                            "recovery-minutes=9") == 1,
                        "saved minutes");
                expect(text_has(
                            raw,
                            "recovery-keep=8") == 1,
                        "saved keep");
                expect(text_has(
                            raw,
                            "key-new=<Control>n") == 1,
                        "saved new key");
                expect(text_has(
                            raw,
                            "recent-count=10") == 1,
                        "saved recent count");
                expect(text_has(
                            raw,
                            "remember-files=1") == 1,
                        "saved remember");
                expect(text_has(raw, "save-on-tab=1") == 1,
                        "saved save tab");
                expect(text_has(
                            raw,
                            "save-on-window=1") == 1,
                        "saved save window");
                expect(text_has(
                            raw,
                            "trim-trailing=1") == 1,
                        "saved trim");
                expect(text_has(
                            raw,
                            "ensure-newline=1") == 1,
                        "saved newline");
                expect(text_has(raw, "show-path=1") == 1,
                        "saved path");
                expect(text_has(raw, "path-depth=2") == 1,
                        "saved depth");
                expect(text_has(
                            raw,
                            "indent-with=both") == 1,
                        "saved both");
                expect(text_has(raw, pathA) == 1,
                        "saved open path");
            }
            unlink(path);
        }
        editor->set_indent_style(1);
        ui->set_option(
                "Trim trailing spaces on save",
                0);
        ui->set_option(
                "Ensure newline at end of file",
                0);
        ui->set_option("Show path in file tab", 0);
        ui->set_path_depth(0);
        ui->on_menu("Close");
        expect(text_has(ui->tab_text(0), "untitled") == 1,
                "fresh tab");
        expect(text_has(ui->line_number_text(), "1") == 1,
                "empty gutter");
        expect(text_has(ui->line_number_text(), "2") == 0,
                "one gutter line");
        ui->open_path(pathB);
        expect(text_has(ui->tab_text(0), "b.scpp") == 1,
                "open retitles");
        ui->on_menu("New");
        ui->show_panel_page(3);
        pump(20);
        ui->align_file_names();
        expect(ui->panel_page() == 3, "documents page");
        expect(ui->document_clicks() == 1,
                "documents single click");
        expect(ui->documents_left() == 1,
                "documents align left");
        {
            int i;
            int sawB;
            int sawNew;

            sawB = -1;
            sawNew = -1;
            i = 0;
            while (i < ui->panel_documents()) {
                if (text_same(
                            ui->shown_document(i),
                            "b.scpp") == 1)
                    sawB = i;
                if (text_has(
                            ui->shown_document(i),
                            "untitled") == 1)
                    sawNew = i;
                i = i + 1;
            }
            expect(sawB >= 0, "documents lists b");
            expect(sawNew >= 0, "documents lists untitled");
            ui->open_document(sawB);
            expect(text_same(
                        ui->page_text(editor->index()),
                        "two\n") == 1,
                    "documents tab");
            ui->open_document(sawNew);
        }
        expect(editor->run("save") == EDITOR_NEEDS_PATH,
                "untitled save");
        expect(mapped_save_dialog() == 0,
                "untitled save has no dialog");
        ui->find_query("untitled");
        ui->on_menu("Search");
        ui->on_menu("Replace");
        ui->on_menu("Match case");
        ui->on_menu("Wrap");
        ui->set_option("Whitespace", 1);
        expect(ui->shows_space() == 1, "whitespace on");
        ui->set_option("Line ends", 1);
        ui->set_option("Indent stops", 1);
        expect(ui->shows_ends() == 1, "line ends on");
        expect(ui->shows_stops() == 1, "indent stops on");
        ui->set_option("Wrap", 0);
        expect(ui->search_wrap() == 0, "wrap off");
        ui->on_menu("Close All");
        expect(editor->count() == 1, "close all");
        expect(text_has(ui->tab_text(0), "untitled") == 1,
                "close all leaves one");
        editor->open_file(pathA);
        editor->open_file(pathB);
        editor->set_index(editor->count() - 2);
        editor->active()->buffer()->set_text("alpha\n");
        editor->active()->buffer()->mark_dirty();
        editor->set_index(editor->count() - 1);
        editor->active()->buffer()->set_text("beta\n");
        editor->active()->buffer()->mark_dirty();
        ui->on_menu("Close All");
        expect(ui->listed_count() == 2, "lists both files");
        ui->save_listed(ui->listed_at(0));
        expect(ui->listed_count() == 1, "one file remains");
        ui->discard_listed(ui->listed_at(0));
        expect(editor->pending() == PEND_NONE,
                "listed close finished");
        expect(editor->count() == 1, "listed close left one");
        {
            char pathD[EDITOR_PATH];
            char leaf[128];
            char mid[EDITOR_PATH];
            char rec[EDITOR_PATH];
            char *raw;
            long n;
            const char *err;

            path_join(pathD, EDITOR_PATH, dir, "watch.scpp");
            err = "";
            expect(write_file(pathD, "keep\n", &err) == 1,
                    "watch seed");
            ui->open_path(pathD);
            expect(text_same(
                        ui->page_text(editor->index()),
                        "keep\n") == 1,
                    "watch open");
            expect(write_file(pathD, "other\n", &err) == 1,
                    "watch other");
            ui->check_files();
            expect(ui->disk_prompt() == 1, "prompts changed");
            ui->answer_disk(3);
            expect(ui->disk_prompt() == 0, "ignore closed");
            ui->check_files();
            expect(ui->disk_prompt() == 0, "ignore holds");
            expect(write_file(pathD, "third\n", &err) == 1,
                    "watch third");
            ui->check_files();
            expect(ui->disk_prompt() == 1, "prompts again");
            ui->answer_disk(1);
            expect(ui->disk_prompt() == 0, "reload closed");
            expect(text_same(
                        ui->page_text(editor->index()),
                        "third\n") == 1,
                    "reloaded view");
            unlink(pathD);
            ui->check_files();
            expect(ui->disk_prompt() == 2, "prompts missing");
            ui->answer_disk(1);
            expect(ui->disk_prompt() == 0, "missing closed");
            ui->check_files();
            expect(ui->disk_prompt() == 0, "missing stays quiet");
            expect(ui->write_recovery_files() == 1,
                    "wrote recovery");
            expect(editor->active()->recovery_leaf(
                        leaf,
                        128) == 1,
                    "recovery name");
            expect(recovery_dir(mid, EDITOR_PATH) == 1,
                    "watch recovery dir");
            path_join(rec, EDITOR_PATH, mid, leaf);
            n = 0;
            raw = read_file(rec, &n, &err);
            expect(raw != nullptr, "recovery file");
            if (raw != nullptr)
                expect(text_same(raw, "third\n") == 1,
                        "recovery bytes");
        }
        {
            int i;

            i = 0;
            while (i < 16) {
                editor->new_file();
                i = i + 1;
            }
            ui->refresh();
            pump(30);
            expect(ui->window_width() > 200,
                    "window has a width");
            expect(ui->window_width() < 1100,
                    "tabs do not widen the window");
        }
        ui->show_settings();
        expect(text_same(ui->theme_choice(), "default") == 1,
                "theme starts default");
        expect(ui->theme_store("night") == 1,
                "store theme");
        expect(text_same(ui->theme_choice(), "night") == 1,
                "theme is night");
        ui->apply_settings();
        {
            char path[EDITOR_PATH];
            char *raw;
            long n;
            const char *err;

            err = "";
            n = 0;
            expect(config_path(path, EDITOR_PATH) == 1,
                    "theme ini path");
            raw = read_file(path, &n, &err);
            expect(raw != nullptr, "theme ini");
            if (raw != nullptr)
                expect(text_has(raw, "theme=night") == 1,
                        "saved theme name");
        }
        expect(ui->theme_pick("default") == 1,
                "pick default");
        expect(text_same(ui->theme_choice(), "default") == 1,
                "back to default");
        expect(ui->language_total() == 8,
                "language count");
        expect(text_same(
                    ui->language_choice(),
                    "scpp") == 1,
                "language list");
        expect(ui->language_define(
                    "demo",
                    ".demo",
                    "",
                    "",
                    "#",
                    "",
                    "alpha") == 1,
                "define language");
        expect(text_same(
                    language_of("z.demo"),
                    "demo") == 1,
                "window suffix");
        expect(ui->language_drop("demo") == 1,
                "drop language");
        expect(text_same(
                    language_of("z.demo"),
                    "plain") == 1,
                "dropped suffix");
        expect(ui->language_define(
                    "scpp",
                    ".scpp",
                    "",
                    "",
                    "#",
                    "",
                    "int") == 1,
                "change built-in");
        expect(ui->language_builtin_reset("scpp") == 1,
                "reset built-in");
        expect(text_same(
                    comment_leader("scpp"),
                    "//") == 1,
                "reset line comment");
        check_projects(ui, editor, dir, io);
        check_template_browse(ui, dir);
        ui->on_menu("Quit");
        expect(ui->is_leaving() == 1, "quit left");
        unlink(pathA);
        unlink(pathB);
        unlink(pathC);
        rmdir(dir);
    } catch (Exception error) {
        print("fail exception\n");
        if (error.message != nullptr)
            print("fail {:s}\n", error.message);
        failures = failures + 1;
    }
    if (failures == 0) {
        print("test-window ok\n");
        return 0;
    }
    print("test-window failed {}\n", failures);
    return 1;
}
