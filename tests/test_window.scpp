                "reset built-in");
        expect(text_same(
                    comment_leader("scpp"),
                    "//") == 1,
                "reset line comment");
        check_context_menus(ui, editor, dir, io);
        check_sessions(ui, editor, dir, io);
        ui->on_menu("Quit");
        expect(ui->is_leaving() == 1, "quit left");
        unlink(pathA);
        unlink(pathB);
        unlink(pathC);
        rmdir(dir);
    } catch (Exception error) {
        print("fail exception\n");
        if (error.message != nullptr)
            print("fail {:s}\n", error.message);
        failures = failures + 1;
    }
    if (failures == 0) {
        print("test-window ok\n");
        return 0;
    }
    print("test-window failed {}\n", failures);
    return 1;
}
