static void pump(int count) {
    int i;

    i = 0;
    while (i < count) {
        g_main_context_iteration(nullptr, 0);
        i = i + 1;
    }
}

static int send_chord(unsigned long keysym, int ctrl) {
    void *display;
    unsigned long root;
    unsigned long parent;
    unsigned long *kids;
    unsigned int count;
    unsigned long win;
    unsigned int i;
    unsigned int mod;
    unsigned int key;
    int clickX;
    int clickY;

    display = XOpenDisplay(nullptr);
    if (display == nullptr)
        return 0;
    XSetErrorHandler((void *)x_error);
    root = XDefaultRootWindow(display);
    kids = nullptr;
    count = 0;
    parent = 0;
    XQueryTree(
            display,
            root,
            &root,
            &parent,
            &kids,
            &count);
    win = 0;
    clickX = 200;
    clickY = 200;
    i = 0;
    while (i < count) {
        char *name;
        char attr[160];
        int *fields;

        name = nullptr;
        fields = (int *)attr;
        fields[2] = 0;
        XGetWindowAttributes(
                display,
                kids[i],
                (void *)attr);
        if (XFetchName(display, kids[i], &name) != 0
                && name != nullptr
                && text_same(name, "<No Session>") == 1
                && fields[2] > 100) {
            win = kids[i];
            clickX = fields[0] + fields[2] / 2;
            clickY = fields[1] + fields[3] / 2;
        }
        if (name != nullptr)
            XFree((void *)name);
        i = i + 1;
    }
    if (kids != nullptr)
        XFree((void *)kids);
    if (win == 0) {
        XCloseDisplay(display);
        return 0;
    }
    XSetInputFocus(display, win, 2, 0);
    XRaiseWindow(display, win);
    XFlush(display);
    usleep(100000);
    XTestFakeMotionEvent(display, -1, clickX, clickY, 0);
    XFlush(display);
    usleep(20000);
    XTestFakeButtonEvent(display, 1, 1, 0);
    XFlush(display);
    usleep(20000);
    XTestFakeButtonEvent(display, 1, 0, 0);
    XFlush(display);
    usleep(80000);
    key = XKeysymToKeycode(display, keysym);
    mod = 0;
    if (ctrl != 0) {
        mod = XKeysymToKeycode(display, 0xffe3);
        XTestFakeKeyEvent(display, mod, 1, 0);
        XFlush(display);
        usleep(20000);
    }
    XTestFakeKeyEvent(display, key, 1, 0);
    XFlush(display);
    usleep(40000);
    XTestFakeKeyEvent(display, key, 0, 0);
    if (mod != 0)
        XTestFakeKeyEvent(display, mod, 0, 0);
    XFlush(display);
    XCloseDisplay(display);
    return 1;
}

static int send_key(const char *title, unsigned long keysym) {
    void *display;
    unsigned long root;
    unsigned long parent;
    unsigned long *kids;
    unsigned int count;
    unsigned long win;
    unsigned int i;
    unsigned int key;

    if (title == nullptr)
        return 0;
    display = XOpenDisplay(nullptr);
    if (display == nullptr)
        return 0;
    XSetErrorHandler((void *)x_error);
    root = XDefaultRootWindow(display);
    kids = nullptr;
    count = 0;
    parent = 0;
    XQueryTree(
            display,
            root,
            &root,
            &parent,
            &kids,
            &count);
    win = 0;
    i = 0;
    while (i < count) {
        char *name;

        name = nullptr;
        if (XFetchName(display, kids[i], &name) != 0
                && name != nullptr
                && text_same(name, title) == 1)
            win = kids[i];
        if (name != nullptr)
            XFree((void *)name);
        i = i + 1;
    }
    if (kids != nullptr)
        XFree((void *)kids);
    if (win == 0) {
        XCloseDisplay(display);
        return 0;
    }
    XSetInputFocus(display, win, 2, 0);
    XRaiseWindow(display, win);
    XFlush(display);
    usleep(80000);
    key = XKeysymToKeycode(display, keysym);
    XTestFakeKeyEvent(display, key, 1, 0);
    XFlush(display);
    usleep(40000);
    XTestFakeKeyEvent(display, key, 0, 0);
    XFlush(display);
    XCloseDisplay(display);
    return 1;
}

static int send_ctrl_s(void) {
    return send_chord(0x73, 1);
}

static int send_wheel(unsigned int button, int ctrl) {
    void *display;
    unsigned long root;
    unsigned long parent;
    unsigned long *kids;
    unsigned int count;
    unsigned long win;
    unsigned int i;
    unsigned int mod;
    int clickX;
    int clickY;

    display = XOpenDisplay(nullptr);
    if (display == nullptr)
        return 0;
    XSetErrorHandler((void *)x_error);
    root = XDefaultRootWindow(display);
    kids = nullptr;
    count = 0;
    parent = 0;
    XQueryTree(
            display,
            root,
            &root,
            &parent,
            &kids,
            &count);
    win = 0;
    clickX = 200;
    clickY = 200;
    i = 0;
    while (i < count) {
        char *name;
        char attr[160];
        int *fields;

        name = nullptr;
        fields = (int *)attr;
        fields[2] = 0;
        XGetWindowAttributes(
                display,
                kids[i],
                (void *)attr);
        if (XFetchName(display, kids[i], &name) != 0
                && name != nullptr
                && text_same(name, "<No Session>") == 1
                && fields[2] > 100) {
            win = kids[i];
            clickX = fields[0] + fields[2] / 2;
            clickY = fields[1] + fields[3] / 2;
        }
        if (name != nullptr)
            XFree((void *)name);
        i = i + 1;
    }
    if (kids != nullptr)
        XFree((void *)kids);
    if (win == 0) {
        XCloseDisplay(display);
        return 0;
    }
    XSetInputFocus(display, win, 2, 0);
    XRaiseWindow(display, win);
    XFlush(display);
    usleep(80000);
    XTestFakeMotionEvent(display, -1, clickX, clickY, 0);
    XFlush(display);
    usleep(20000);
    mod = 0;
    if (ctrl != 0) {
        mod = XKeysymToKeycode(display, 0xffe3);
        XTestFakeKeyEvent(display, mod, 1, 0);
        XFlush(display);
        usleep(20000);
    }
    XTestFakeButtonEvent(display, button, 1, 0);
    XFlush(display);
    usleep(20000);
    XTestFakeButtonEvent(display, button, 0, 0);
    if (mod != 0)
        XTestFakeKeyEvent(display, mod, 0, 0);
    XFlush(display);
    XCloseDisplay(display);
    return 1;
}

static unsigned long titled_window(
        void *display,
        const char *title) {
    unsigned long root;
    unsigned long parent;
    unsigned long *kids;
    unsigned int count;
    unsigned long win;
    unsigned int i;

    root = XDefaultRootWindow(display);
    kids = nullptr;
    count = 0;
    parent = 0;
    XQueryTree(
            display,
            root,
            &root,
            &parent,
            &kids,
            &count);
    win = 0;
    i = 0;
    while (i < count) {
        char *name;
        char attr[160];
        int *fields;

        name = nullptr;
        fields = (int *)attr;
        fields[2] = 0;
        XGetWindowAttributes(
                display,
                kids[i],
                (void *)attr);
        if (XFetchName(display, kids[i], &name) != 0
                && name != nullptr
                && text_same(name, title) == 1
                && fields[2] > 100)
            win = kids[i];
        if (name != nullptr)
            XFree((void *)name);
        i = i + 1;
    }
    if (kids != nullptr)
        XFree((void *)kids);
    return win;
}

static int send_named(
        const char *title,
        unsigned long keysym,
        int ctrl) {
    void *display;
    unsigned long win;
    unsigned int key;
    unsigned int mod;

    display = XOpenDisplay(nullptr);
    if (display == nullptr)
        return 0;
    XSetErrorHandler((void *)x_error);
    win = titled_window(display, title);
    if (win == 0) {
        XCloseDisplay(display);
        return 0;
    }
    XSetInputFocus(display, win, 2, 0);
    XRaiseWindow(display, win);
    XFlush(display);
    usleep(80000);
    key = XKeysymToKeycode(display, keysym);
    mod = 0;
    if (ctrl != 0) {
        mod = XKeysymToKeycode(display, 0xffe3);
        XTestFakeKeyEvent(display, mod, 1, 0);
        XFlush(display);
        usleep(20000);
    }
    XTestFakeKeyEvent(display, key, 1, 0);
    XFlush(display);
    usleep(40000);
    XTestFakeKeyEvent(display, key, 0, 0);
    if (mod != 0)
        XTestFakeKeyEvent(display, mod, 0, 0);
    XFlush(display);
    XCloseDisplay(display);
    return 1;
}

static int resize_named(
        const char *title,
        unsigned int width,
        unsigned int height) {
    void *display;
    unsigned long win;

    display = XOpenDisplay(nullptr);
    if (display == nullptr)
        return 0;
    XSetErrorHandler((void *)x_error);
    win = titled_window(display, title);
    if (win == 0) {
        XCloseDisplay(display);
        return 0;
    }
    XResizeWindow(display, win, width, height);
    XFlush(display);
    XCloseDisplay(display);
    return 1;
}

static long count_newlines(const char *text) {
    long n;
    long i;

    n = 0;
    if (text == nullptr)
        return (long)0;
    i = 0;
    while (text[i] != 0) {
        if (text[i] == '\n')
            n = n + 1;
        i = i + 1;
    }
    return n;
}

void check_keys_gutter_map(Ui *ui, Editor *editor) {
    TextBuffer *view;
    String *shape;
    const char *title;
    long line;
    long column;
    long height;
    long mark;
    long n;
    long index;

    title = "sedit-nav-b510";
    ui->name_window(title);
    pump(20);
    view = ui->view_buffer();
    shape = new String();
    n = 0;
    while (n < 40) {
        shape->append("abcd efgh\n");
        n = n + 1;
    }
    view->set_text(shape->c_str());
    ui->scroll_view(0);
    pump(20);
    ui->place_at(8, 4);
    ui->focus_view();
    pump(20);
    index = editor->index();
    line = editor->active()->buffer()->cursor_line();
    expect(send_named(title, 0xff54, 0) == 1,
            "down reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_line()
                    == line + 1,
            "down moves the caret");
    line = editor->active()->buffer()->cursor_line();
    expect(send_named(title, 0xff52, 0) == 1,
            "up reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_line()
                    == line - 1,
            "up moves the caret");
    column = editor->active()->buffer()->cursor_column();
    expect(send_named(title, 0xff51, 0) == 1,
            "left reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_column()
                    == column - 1,
            "left moves the caret");
    column = editor->active()->buffer()->cursor_column();
    expect(send_named(title, 0xff53, 0) == 1,
            "right reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_column()
                    == column + 1,
            "right moves the caret");
    expect(send_named(title, 0xff50, 0) == 1,
            "home reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_column() == 1,
            "home moves to the line start");
    expect(send_named(title, 0xff57, 0) == 1,
            "end reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_column() > 1,
            "end moves to the line end");
    line = editor->active()->buffer()->cursor_line();
    expect(send_named(title, 0xff56, 0) == 1,
            "page down reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_line()
                    > line + 1,
            "page down moves the caret");
    line = editor->active()->buffer()->cursor_line();
    expect(send_named(title, 0xff55, 0) == 1,
            "page up reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_line()
                    < line,
            "page up moves the caret");
    expect(send_named(title, 0xff57, 1) == 1,
            "ctrl end reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_line() > 30,
            "ctrl end moves to the buffer end");
    expect(send_named(title, 0xff50, 1) == 1,
            "ctrl home reaches the editor");
    pump(30);
    expect(editor->active()->buffer()->cursor_line() == 1,
            "ctrl home moves to the buffer start");
    line = editor->active()->buffer()->cursor_line();
    ui->wheel_lines(index, 4);
    expect(editor->active()->buffer()->cursor_line()
                    == line + 4,
            "wheel still moves the caret");
    line = editor->active()->buffer()->cursor_line();
    ui->show_first(1);
    ui->wheel_view(index, 2);
    expect(editor->active()->buffer()->cursor_line()
                    == line,
            "ctrl wheel still leaves the caret");
    view->set_text("one\ntwo\nthree\nfour\n");
    ui->place_at(2, 1);
    ui->scroll_view(0);
    pump(20);
    n = 0;
    height = 0;
    while (n < 30) {
        usleep(40000);
        pump(10);
        height = ui->map_height();
        if (height > 40)
            break;
        n = n + 1;
    }
    expect(ui->map_top() == 0, "short map is packed");
    mark = ui->map_mark();
    expect(mark >= 0 && mark < 48,
            "short mark stays near the top");
    expect(resize_named(title, 900, 420) == 1,
            "window can shrink");
    n = 0;
    while (n < 40) {
        usleep(40000);
        pump(10);
        if (ui->map_height() > 20
                && ui->map_height() != height)
            break;
        n = n + 1;
    }
    expect(ui->map_height() != height,
            "shrinking changes the map");
    expect(ui->map_height() > 20, "shrunk map has a height");
    expect(ui->map_top() == 0,
            "short map stays packed after resize");
    mark = ui->map_mark();
    expect(mark >= 0 && mark < ui->map_height(),
            "short mark stays inside the map");
    expect(mark < 48, "short mark stays at the top");
    ui->set_panel_width(260);
    usleep(80000);
    pump(20);
    expect(ui->map_top() == 0,
            "panel resize keeps a short map packed");
    expect(ui->map_mark() >= 0
                    && ui->map_mark() < 48,
            "panel resize keeps the short mark");
    shape = new String();
    n = 0;
    while (n < 180) {
        shape->append("line\n");
        n = n + 1;
    }
    view->set_text(shape->c_str());
    ui->place_at(180, 1);
    ui->scroll_view(150);
    pump(30);
    height = ui->map_height();
    mark = ui->map_mark();
    expect(mark >= 0 && mark < height,
            "long mark starts inside the map");
    expect(resize_named(title, 900, 280) == 1,
            "window can shrink again");
    n = 0;
    while (n < 40) {
        usleep(40000);
        pump(10);
        if (ui->map_height() > 20
                && ui->map_height() != height)
            break;
        n = n + 1;
    }
    expect(ui->map_height() != height,
            "second shrink changes the map");
    expect(ui->map_mark() >= 0
                    && ui->map_mark() < ui->map_height(),
            "long mark stays inside after resize");
    expect(ui->map_mark() > ui->map_height() / 2,
            "long mark stays near the current line");
    ui->finish_font("Monospace 2");
    expect(resize_named(title, 900, 1100) == 1,
            "window can grow for the gutter");
    shape = new String();
    n = 0;
    while (n < 130) {
        shape->append("n\n");
        n = n + 1;
    }
    view->set_text(shape->c_str());
    ui->scroll_view(0);
    ui->place_at(1, 1);
    n = 0;
    while (n < 40) {
        usleep(50000);
        pump(10);
        if (count_newlines(ui->line_number_text()) > 80)
            break;
        n = n + 1;
    }
    expect(count_newlines(ui->line_number_text()) > 80,
            "gutter numbers more than 80 lines");
    expect(text_has(ui->line_number_text(), "\n81\n") == 1,
            "gutter shows line 81");
    ui->scroll_view(130);
    n = 0;
    while (n < 40) {
        usleep(50000);
        pump(10);
        if (text_has(ui->line_number_text(), "\n131\n")
                == 1)
            break;
        n = n + 1;
    }
    expect(text_has(ui->line_number_text(), "\n131\n") == 1,
            "gutter numbers the empty last line");
    ui->finish_font("Monospace 10");
    resize_named(title, 880, 640);
    pump(20);
    ui->show_session_title();
}

void check_panel_layout(Ui *ui) {
    expect(ui->panel_scrolls() == 1, "panel scroll buttons");
    expect(text_same(ui->panel_scroll_mark(0), "<") == 1,
            "scroll left");
    expect(text_same(ui->panel_scroll_mark(1), ">") == 1,
            "scroll right");
    ui->scroll_panel_tabs(1);
    ui->scroll_panel_tabs(-1);
    expect(ui->panel_edge() >= 0, "panel on the left edge");
    ui->align_file_names();
    expect(ui->files_left() == 1, "files align left");
    ui->show_panel_page(2);
    pump(20);
    ui->align_file_names();
    expect(ui->documents_left() == 1,
            "documents align left");
    ui->show_panel_page(0);
    ui->set_panel_width(280);
    usleep(100000);
    pump(20);
    expect(ui->panel_width() > 240, "panel grows");
    ui->set_panel_width(110);
    usleep(100000);
    pump(20);
    expect(ui->panel_width() < 160, "panel shrinks");
    expect(ui->panel_edge() >= 0, "panel stays on the edge");
}

void check_map_controls(Ui *ui) {
    long wide;
    long spun;
    long dragged;

    wide = ui->map_width();
    ui->show_settings();
    pump(10);
    spun = wide + 36;
    if (spun > 220)
        spun = 120;
    ui->set_map_spin(spun);
    usleep(100000);
    pump(20);
    expect(ui->map_width() > spun - 8, "spin widens the map");
    expect(ui->map_width() < spun + 8, "spin sets the map width");
    dragged = ui->map_width();
    if (dragged > 160)
        dragged = dragged - 40;
    else
        dragged = dragged + 40;
    ui->move_map_bar(dragged);
    usleep(100000);
    pump(20);
    expect(ui->map_width() > dragged - 8, "drag sets the map width");
    expect(ui->map_width() < dragged + 8, "drag keeps the map width");
    expect(ui->map_spin() > dragged - 8, "drag updates the spin");
    expect(ui->map_spin() < dragged + 8, "spin matches the drag");
    wide = ui->map_width();
    usleep(100000);
    pump(20);
    expect(ui->map_width() > wide - 3, "chosen width holds");
    expect(ui->map_width() < wide + 3, "map does not resize itself");
    wide = ui->map_width();
    ui->set_map_width(500);
    pump(10);
    expect(ui->map_spin() == 500, "spin accepts 500");
    expect(ui->map_width() >= 24, "map stays at least 24 wide");
    expect(ui->map_width() <= 500, "map stays within 500");
    ui->set_map_width(640);
    pump(10);
    expect(ui->map_spin() == 500, "spin stops at 500");
    ui->set_map_width(24);
    expect(ui->map_spin() == 24, "spin minimum stays 24");
    ui->set_map_width(8);
    expect(ui->map_spin() == 24, "spin stays at least 24");
    pump(20);
    expect(ui->map_spin() == 24, "map width stays put");
    ui->set_map_width(wide);
}

void check_map_click(Ui *ui, Editor *editor) {
    TextBuffer *view;
    TextIter *at;
    long before;
    long after;
    long y;
    long n;
    long height;

    view = ui->view_buffer();
    at = new TextIter(0, 0);
    view->place_cursor(at);
    height = ui->map_height();
    if (height < 4)
        height = 4;
    ui->drag_map_mark(height / 3);
    usleep(80000);
    pump(20);
    before = ui->map_mark();
    ui->drag_map_mark(0);
    n = 0;
    y = -1;
    while (n < 20) {
        usleep(50000);
        pump(10);
        y = ui->gutter_line_y(0);
        if (y >= 0)
            break;
        n = n + 1;
    }
    expect(before >= 0, "click starts with a mark");
    expect(y >= 0, "click starts at the top");
    at = new TextIter(12, 0);
    view->place_cursor(at);
    usleep(80000);
    pump(20);
    after = ui->map_mark();
    expect(editor->active()->buffer()->cursor_line() == 13,
            "click moves the caret");
    expect(ui->gutter_line_y(0) >= 0, "click does not scroll");
    expect(after > before, "click marks the caret line");
}

void check_map_font_dialog(Ui *ui) {
    char path[EDITOR_PATH];
    char *raw;
    long n;
    long wide;
    const char *err;

    ui->set_map_font("Monospace 4");
    wide = ui->map_spin();
    ui->show_map_font_dialog();
    expect(ui->map_font_size() == 4, "dialog shows the size");
    expect(text_same(ui->map_font(), "Monospace 4") == 1,
            "opening leaves the font");
    ui->stage_map_font("Sans 9");
    expect(ui->map_font_size() == 9, "chooser sets the size");
    expect(text_same(ui->map_font(), "Monospace 4") == 1,
            "chooser waits for save");
    ui->answer_map_font(0);
    expect(text_same(ui->map_font(), "Monospace 4") == 1,
            "cancel leaves the font");
    ui->show_map_font_dialog();
    ui->stage_map_font("Sans 9");
    ui->answer_map_font(1);
    expect(text_same(ui->map_font(), "Sans 9") == 1,
            "save updates the map font");
    ui->show_map_font_dialog();
    ui->set_map_font_size(6);
    expect(text_same(ui->map_font(), "Sans 9") == 1,
            "size waits for save");
    ui->answer_map_font(1);
    expect(text_same(ui->map_font(), "Sans 6") == 1,
            "save stores the size");
    err = "";
    n = 0;
    expect(config_path(path, EDITOR_PATH) == 1,
            "map font ini");
    raw = read_file(path, &n, &err);
    expect(raw != nullptr, "map font ini text");
    if (raw != nullptr)
        expect(text_has(raw, "map-font=Sans 6") == 1,
                "saved map font");
    expect(ui->map_spin() == wide, "map width stays");
    ui->scroll_map_wheel(0, 1);
    expect(text_same(ui->map_font(), "Sans 6") == 1,
            "wheel leaves the font");
    ui->set_map_font("Monospace 4");
}

void check_map_mark(Ui *ui, Editor *editor) {
    long caret;
    long wide;
    long y;
    long height;
    long top;
    long page;
    long moved;

    ui->set_map_font("Monospace 4");
    expect(text_same(ui->map_font(), "Monospace 4") == 1,
            "map font");
    editor->active()->buffer()->move_to(1, 1);
    ui->scroll_view(0);
    pump(30);
    expect(ui->map_mark() >= 0, "map marks the line");
    expect(ui->map_mark() < ui->map_height(),
            "mark is on the map");
    caret = editor->active()->buffer()->cursor_line();
    height = ui->map_height();
    top = ui->map_top();
    ui->drag_map_mark(height - 1);
    usleep(80000);
    pump(20);
    expect(editor->active()->buffer()->cursor_line()
                    == caret,
            "drag leaves the caret");
    y = ui->gutter_line_y(0);
    expect(y < 0, "drag scrolls the buffer");
    expect(ui->map_top() > top, "viewport follows the drag");
    ui->drag_map_mark(0);
    usleep(80000);
    pump(20);
    top = ui->map_top();
    expect(ui->gutter_line_y(0) >= 0, "drag can return to the top");
    page = editor->index();
    ui->map_button(page, top + 2, 1);
    moved = top + 2 + height / 3;
    ui->map_drag(page, moved);
    usleep(80000);
    pump(20);
    expect(editor->active()->buffer()->cursor_line()
                    == caret,
            "gesture leaves the caret");
    expect(ui->map_top() > top, "gesture scrolls the buffer");
    ui->map_button(page, moved, 0);
    wide = ui->map_width();
    ui->set_map_width(wide + 40);
    usleep(100000);
    pump(20);
    expect(ui->map_width() > wide + 15, "map grows");
    wide = ui->map_width();
    usleep(100000);
    pump(20);
    expect(ui->map_width() > wide - 3, "map keeps its width");
    expect(ui->map_width() < wide + 3, "map width stays");
    check_map_controls(ui);
    check_map_click(ui, editor);
}

void check_panels(Ui *ui) {
    expect(ui->shows_left() == 1, "left starts shown");
    expect(ui->left_checked() == 1, "left starts checked");
    expect(ui->shows_map() == 1, "map starts shown");
    expect(ui->map_checked() == 1, "map starts checked");
    ui->set_option("Left panel", 0);
    expect(ui->shows_left() == 0, "left hides");
    expect(ui->left_checked() == 0, "left unchecked");
    ui->on_menu("Left panel");
    expect(ui->shows_left() == 0, "left stays hidden");
    ui->set_option("Left panel", 1);
    expect(ui->shows_left() == 1, "left shows");
    expect(ui->left_checked() == 1, "left checked");
    ui->set_option("Right panel", 0);
    expect(ui->shows_map() == 0, "map hides");
    expect(ui->map_checked() == 0, "map unchecked");
    ui->on_menu("Right panel");
    expect(ui->shows_map() == 0, "map stays hidden");
    ui->set_option("Right panel", 1);
    expect(ui->shows_map() == 1, "map shows");
    expect(ui->map_checked() == 1, "map checked");
}

void seed_ctrl_a(void) {
    char path[EDITOR_PATH];
    const char *io;

    expect(config_path(path, EDITOR_PATH) == 1, "config path");
    io = "";
    expect(write_file(
                path,
                "key-copy=<Control>a\n",
                &io) == 1,
            "seed copy key");
}

void check_select_all(Ui *ui, Editor *editor) {
    TextBuffer *view;
    TextIter *start;
    TextIter *end;
    EditBuffer *buffer;
    int shown;
    int copy;
    int select;

    view = ui->view_buffer();
    expect(view != nullptr, "select view");
    if (view == nullptr)
        return;
    buffer = editor->active()->buffer();
    expect(buffer != nullptr, "select buffer");
    if (buffer == nullptr)
        return;
    expect(text_same(buffer->text(), "two\n") == 1,
            "selects the open file");
    start = new TextIter(0, 1);
    view->place_cursor(start);
    buffer->set_cursor_offset(1);
    ui->on_menu("Select All");
    pump(4);
    expect(buffer->sel_lo() == 0, "select starts");
    expect(buffer->sel_hi() == 4, "select ends");
    expect(text_same(buffer->selected()->c_str(), "two\n") == 1,
            "selects the file");
    expect(buffer->dirty() == false, "select stays clean");
    start = new TextIter(0, 0);
    end = new TextIter(0, 0);
    shown = 0;
    if (view->selection_bounds(start, end) == true)
        shown = 1;
    expect(shown == 1, "view shows the selection");
    expect(start->line() == 0 && start->offset() == 0,
            "view starts at the top");
    expect(end->line() == 1 && end->offset() == 0,
            "view ends at the bottom");
    copy = key_index("key-copy=");
    select = key_index("key-select-all=");
    expect(text_same(ui->key_text(copy), "") == 1,
            "copy lost ctrl a");
    expect(text_same(ui->key_text(select), "<Control>a") == 1,
            "select keeps ctrl a");
    start = new TextIter(0, 0);
    view->place_cursor(start);
    buffer->set_cursor_offset(0);
}

static int date_text(const char *text) {
    int i;

    if (text == nullptr)
        return 0;
    i = 0;
    while (i < 10) {
        if (text[i] == 0)
            return 0;
        if (i == 4 || i == 7) {
            if (text[i] != '-')
                return 0;
        } else if (text[i] < '0' || text[i] > '9')
            return 0;
        i = i + 1;
    }
    return 1;
}

static int named_file(Ui *ui, const char *name) {
    int i;

    i = 0;
    while (i < ui->panel_files()) {
        if (text_same(ui->panel_file(i), name) == 1)
            return i;
        i = i + 1;
    }
    return -1;
}

static int named_doc(Ui *ui, const char *name) {
    int i;

    i = 0;
    while (i < ui->panel_documents()) {
        if (text_same(ui->shown_document(i), name) == 1)
            return i;
        i = i + 1;
    }
    return -1;
}

static void mark_clean_all(Editor *editor) {
    int i;

    i = 0;
    while (i < editor->count()) {
        Document *doc;

        doc = editor->at(i);
        if (doc != nullptr && doc->buffer() != nullptr)
            doc->buffer()->mark_clean();
        i = i + 1;
    }
}

static void check_gray(Ui *ui, int page, int row) {
    ui->arm_panel(page, row);
    expect(ui->panel_item_on("New") == 1, "new stays on");
    expect(ui->panel_item_on("Open") == 0, "open gray");
    expect(ui->panel_item_on("Close") == 0, "close gray");
    expect(ui->panel_item_on("Save") == 0, "save gray");
    expect(ui->panel_item_on("Remove") == 0, "remove gray");
}

static void check_context_menus(
        Ui *ui,
        Editor *editor,
        const char *dir,
        const char *io) {
    char folder[EDITOR_PATH];
    char keep[EDITOR_PATH];
    char drop[EDITOR_PATH];
    char hide[EDITOR_PATH];
    char disk[EDITOR_PATH];
    char nest[EDITOR_PATH];
    char *raw;
    long n;
    int row;
    int sub;
    long before;

    ui->on_menu("New");
    expect(ui->text_hides_emoji() == 1, "emoji item hidden");
    expect(text_same(
                ui->text_extra_label(0),
                "Insert date") == 1,
            "insert date item");
    expect(text_same(
                ui->text_extra_label(1),
                "Insert color") == 1,
            "insert color item");
    expect(text_same(ui->text_extra_label(2), "") == 1,
            "no extra emoji item");
    ui->insert_date();
    expect(date_text(ui->page_text(editor->index())) == 1,
            "date at the caret");
    ui->insert_color_text("#2040c0");
    expect(text_has(
                ui->page_text(editor->index()),
                "#2040c0") == 1,
            "color text");
    editor->active()->buffer()->mark_clean();
    ui->on_menu("Close");
    path_join(folder, EDITOR_PATH, dir, "pdir");
    path_join(keep, EDITOR_PATH, folder, "stay.scpp");
    path_join(drop, EDITOR_PATH, folder, "gone.scpp");
    path_join(hide, EDITOR_PATH, folder, "hide.scpp");
    path_join(disk, EDITOR_PATH, folder, "disk.scpp");
    path_join(nest, EDITOR_PATH, folder, "sub");
    expect(mkdir(folder, 448) == 0, "menu folder");
    expect(mkdir(nest, 448) == 0, "menu sub");
    expect(write_file(keep, "stay\n", &io) == 1, "stay file");
    expect(write_file(drop, "gone\n", &io) == 1, "gone file");
    expect(write_file(hide, "hide\n", &io) == 1, "hide file");
    expect(write_file(disk, "disk\n", &io) == 1, "disk file");
    expect(ui->show_folder(folder) == 1, "menu files");
    ui->show_panel_page(0);
    expect(ui->panel_item_count() == 5, "panel menu count");
    expect(text_same(ui->panel_item_label(0), "New") == 1,
            "panel new");
    expect(text_same(ui->panel_item_label(1), "Open") == 1,
            "panel open");
    expect(text_same(ui->panel_item_label(2), "Close") == 1,
            "panel close");
    expect(text_same(ui->panel_item_label(3), "Save") == 1,
            "panel save");
    expect(text_same(ui->panel_item_label(4), "Remove") == 1,
            "panel remove");
    check_gray(ui, 0, -1);
    ui->run_panel_item("Remove");
    expect(ui->remove_waiting() == 0, "gray remove waits");
    sub = -1;
    row = 0;
    while (row < ui->panel_files()) {
        if (ui->panel_file_dir(row) == 1
                && text_same(ui->panel_file(row), "sub") == 1)
            sub = row;
        row = row + 1;
    }
    expect(sub >= 0, "folder row");
    check_gray(ui, 0, sub);
    row = named_file(ui, "stay.scpp");
    expect(row >= 0, "stay row");
    ui->arm_panel(0, row);
    expect(ui->panel_item_on("Open") == 1, "file open on");
    expect(ui->panel_item_on("Close") == 1, "file close on");
    expect(ui->panel_item_on("Save") == 1, "file save on");
    expect(ui->panel_item_on("Remove") == 1,
            "file remove on");
    before = editor->count();
    ui->arm_panel(0, -1);
    ui->run_panel_item("New");
    expect(editor->count() == before + 1, "panel new file");
    editor->active()->buffer()->mark_clean();
    ui->on_menu("Close");
    ui->arm_panel(0, named_file(ui, "stay.scpp"));
    ui->run_panel_item("Open");
    expect(text_same(editor->active()->path(), keep) == 1,
            "panel opened the file");
    editor->active()->buffer()->set_text("saved\n");
    editor->active()->buffer()->mark_dirty();
    ui->arm_panel(0, named_file(ui, "stay.scpp"));
    ui->run_panel_item("Save");
    n = 0;
    raw = read_file(keep, &n, &io);
    expect(raw != nullptr
            && text_same(raw, "saved\n") == 1,
            "panel saved the file");
    ui->arm_panel(0, named_file(ui, "stay.scpp"));
    ui->run_panel_item("Close");
    expect(text_same(editor->active()->path(), keep) == 0,
            "panel closed the file");
    expect(file_exists(keep) == 1, "close keeps the file");
    ui->show_panel_page(2);
    ui->open_path(keep);
    row = named_doc(ui, "stay.scpp");
    expect(row >= 0, "document row");
    ui->arm_panel(3, row);
    expect(ui->panel_item_on("Remove") == 1,
            "document remove on");
    ui->run_panel_item("Remove");
    expect(ui->remove_waiting() == 1, "remove asks");
    expect(file_exists(keep) == 1, "ask leaves the file");
    expect(named_doc(ui, "stay.scpp") >= 0,
            "ask leaves the document");
    ui->answer_remove(0);
    expect(ui->remove_waiting() == 0, "cancel done");
    expect(file_exists(keep) == 1, "cancel keeps the file");
    expect(named_doc(ui, "stay.scpp") >= 0,
            "cancel keeps the document");
    ui->arm_panel(3, named_doc(ui, "stay.scpp"));
    ui->run_panel_item("Remove");
    ui->answer_remove(1);
    expect(named_doc(ui, "stay.scpp") < 0,
            "document dropped");
    expect(file_exists(keep) == 1,
            "document drop keeps the file");
    ui->show_panel_page(0);
    ui->arm_panel(0, named_file(ui, "hide.scpp"));
    ui->run_panel_item("Remove");
    ui->answer_remove(1);
    expect(named_file(ui, "hide.scpp") < 0, "files list drop");
    expect(file_exists(hide) == 1, "files drop keeps disk");
    expect(ui->show_folder(folder) == 1, "list the folder");
    expect(named_file(ui, "hide.scpp") < 0,
            "hidden after refresh");
    ui->arm_panel(0, named_file(ui, "disk.scpp"));
    ui->run_panel_item("Remove");
    expect(file_exists(disk) == 1, "disk ask waits");
    ui->answer_remove(2);
    expect(file_exists(disk) == 0, "disk file deleted");
    expect(named_file(ui, "disk.scpp") < 0,
            "deleted file leaves the list");
    mark_clean_all(editor);
    expect(ui->show_folder(dir) == 1, "files restored");
}

static void check_sessions(
        Ui *ui,
        Editor *editor,
        const char *dir,
        const char *io) {
    char one[EDITOR_PATH];
    char two[EDITOR_PATH];
    int i;
    int saw;

    mark_clean_all(editor);
    expect(ui->new_session() == 1, "start from a blank session");
    expect(text_same(ui->window_title(), "<No Session>") == 1,
            "blank session title");
    path_join(one, EDITOR_PATH, dir, "sess-a.txt");
    path_join(two, EDITOR_PATH, dir, "sess-b.txt");
    expect(write_file(
                one,
                "a1\na2\na3\na4\n",
                &io) == 1,
            "session file a");
    expect(write_file(two, "b1\nb2\n", &io) == 1,
            "session file b");
    ui->open_path(one);
    ui->open_path(two);
    editor->active()->buffer()->move_to(2, 1);
    expect(ui->save_session_as("work") == 1,
            "save the session");
    expect(text_same(ui->current_session(), "work") == 1,
            "session name");
    expect(text_same(ui->window_title(), "work") == 1,
            "saved title");
    expect(ui->save_current_session() == 1,
            "save the named session");
    expect(text_same(ui->window_title(), "work") == 1,
            "save keeps the title");
    mark_clean_all(editor);
    expect(ui->new_session() == 1, "new session");
    expect(text_same(ui->current_session(), "") == 1,
            "new session is unnamed");
    expect(text_same(ui->window_title(), "<No Session>") == 1,
            "new session title");
    expect(editor->count() == 1, "new session is empty");
    expect(ui->open_session("work") == 1, "open work");
    expect(text_same(ui->window_title(), "work") == 1,
            "opened title");
    expect(editor->count() == 2, "restored both files");
    expect(text_same(editor->active()->path(), two) == 1,
            "restored the current file");
    expect(editor->active()->buffer()->cursor_line() == 2,
            "restored the caret");
    ui->show_sessions();
    expect(ui->session_dialog_open() == 1, "dialog is open");
    expect(ui->session_name_open() == 0, "no name field");
    expect(ui->session_row_clicks() == 0,
            "a row does not open on click");
    expect(ui->session_button_count() == 6, "six buttons");
    expect(text_same(
                ui->session_button_label(0),
                "Open") == 1,
            "open button");
    expect(text_same(
                ui->session_button_label(1),
                "New Session") == 1,
            "new button");
    expect(text_same(
                ui->session_button_label(2),
                "Delete") == 1,
            "delete button");
    expect(text_same(
                ui->session_button_label(3),
                "Close") == 1,
            "close button");
    expect(text_same(
                ui->session_button_label(4),
                "Rename") == 1,
            "rename button");
    expect(text_same(
                ui->session_button_label(5),
                "Duplicate") == 1,
            "duplicate button");
    expect(ui->session_button_gap(0) == 0,
            "open starts the column");
    expect(ui->session_button_gap(1) == 0,
            "new session follows open");
    expect(ui->session_button_gap(2) == 1,
            "space before delete");
    expect(ui->session_button_gap(3) == 0,
            "close follows delete");
    expect(ui->session_button_gap(4) == 1,
            "space before rename");
    expect(ui->session_button_gap(5) == 0,
            "duplicate follows rename");
    saw = -1;
    i = 0;
    while (i < ui->session_count()) {
        if (text_same(ui->session_name_at(i), "work") == 1)
            saw = i;
        i = i + 1;
    }
    expect(saw >= 0, "dialog lists work");
    expect(ui->session_files_at(saw) == 2, "work has two files");
    expect(text_length(ui->session_opened_at(saw)) == 10,
            "work shows a date");
    ui->pick_session(saw);
    expect(ui->session_dialog_open() == 1,
            "a click only selects");
    ui->answer_session(6);
    expect(ui->session_name_open() == 1,
            "duplicate asks for a name");
    expect(ui->session_dialog_open() == 1,
            "the list stays up");
    ui->set_session_name_text("work-copy");
    ui->accept_session_name();
    expect(ui->session_name_open() == 0,
            "the prompt closes");
    expect(ui->session_dialog_open() == 1,
            "duplicate leaves the dialog");
    pump(20);
    ui->focus_session_list();
    ui->pick_session(0);
    pump(10);
    expect(ui->session_highlight() == 0,
            "first session highlighted");
    expect(ui->picked_session() == 0,
            "highlight is the pick");
    expect(send_key("Sessions", 0xff54) == 1,
            "down reaches the list");
    pump(20);
    expect(ui->session_highlight() == 1,
            "down moves the highlight");
    expect(ui->picked_session() == 1,
            "down selects that session");
    expect(send_key("Sessions", 0xff52) == 1,
            "up reaches the list");
    pump(20);
    expect(ui->session_highlight() == 0,
            "up moves the highlight");
    expect(ui->picked_session() == 0,
            "up selects that session");
    saw = -1;
    i = 0;
    while (i < ui->session_count()) {
        if (text_same(ui->session_name_at(i), "work") == 1)
            saw = i;
        i = i + 1;
    }
    expect(saw >= 0, "work remains after the copy");
    ui->pick_session(saw);
    ui->answer_session(5);
    expect(ui->session_name_open() == 1,
            "rename asks for a name");
    ui->set_session_name_text("work-two");
    ui->accept_session_name();
    expect(ui->session_name_open() == 0,
            "rename prompt closes");
    expect(ui->session_dialog_open() == 1,
            "rename leaves the dialog");
    expect(text_same(ui->window_title(), "work-two") == 1,
            "renamed title");
    saw = -1;
    i = 0;
    while (i < ui->session_count()) {
        if (text_same(
                    ui->session_name_at(i),
                    "work-copy") == 1)
            saw = i;
        i = i + 1;
    }
    expect(saw >= 0, "copy is listed");
    ui->pick_session(saw);
    ui->answer_session(3);
    expect(ui->session_dialog_open() == 1,
            "delete leaves the dialog");
    expect(file_exists(one) == 1, "delete leaves the file");
    expect(file_exists(two) == 1, "delete leaves the other");
    mark_clean_all(editor);
    ui->answer_session(4);
    expect(ui->session_dialog_open() == 0,
            "close leaves the dialog");
    expect(text_same(ui->current_session(), "work-two") == 1,
            "close opens the latest");
    expect(ui->recent_sessions() >= 1, "recent sessions");
    expect(text_same(ui->recent_session(0), "work-two") == 1,
            "recent is the latest");
    mark_clean_all(editor);
    ui->on_session_menu("New Session");
    expect(text_same(ui->current_session(), "") == 1,
            "menu new session");
    expect(text_same(ui->window_title(), "<No Session>") == 1,
            "closed title");
    ui->open_path(one);
    editor->active()->buffer()->move_to(3, 1);
    ui->on_session_menu("Save Session");
    expect(text_same(ui->current_session(), "") == 1,
            "unnamed save asks");
    expect(ui->save_session_as("later") == 1, "save as later");
    expect(text_same(ui->window_title(), "later") == 1,
            "save as title");
    mark_clean_all(editor);
    ui->on_session_menu("New Session");
    ui->open_recent_session("later");
    expect(text_same(ui->current_session(), "later") == 1,
            "recent opens it");
    expect(text_same(ui->window_title(), "later") == 1,
            "recent title");
    expect(text_same(editor->active()->path(), one) == 1,
            "recent restores the file");
    expect(editor->active()->buffer()->cursor_line() == 3,
            "recent restores the line");
    ui->on_session_menu("All Sessions");
    expect(ui->session_dialog_open() == 1, "all sessions");
    mark_clean_all(editor);
    ui->answer_session(2);
    expect(ui->session_dialog_open() == 0, "new session closes it");
    expect(editor->count() == 1, "new session has no files");
    expect(ui->save_session_as("later") == 0,
            "save as refuses an existing name");
    expect(text_same(ui->window_title(), "<No Session>") == 1,
            "refused save leaves the title");
    expect(ui->save_session_as("gone") == 1,
            "name a session to close");
    expect(text_same(ui->window_title(), "gone") == 1,
            "named before close");
    expect(ui->delete_session("gone") == 1,
            "close the current session");
    expect(text_same(ui->current_session(), "") == 1,
            "closed session has no name");
    expect(text_same(ui->window_title(), "<No Session>") == 1,
            "closed session title");
    mark_clean_all(editor);
    ui->show_sessions();
    saw = -1;
    i = 0;
    while (i < ui->session_count()) {
        if (text_same(ui->session_name_at(i), "later") == 1)
            saw = i;
        i = i + 1;
    }
    expect(saw >= 0, "later is listed");
    ui->pick_session(saw);
    expect(ui->session_dialog_open() == 1,
            "selecting a row stays in the dialog");
    ui->answer_session(1);
    expect(ui->session_dialog_open() == 0,
            "open leaves the dialog");
    expect(text_same(ui->current_session(), "later") == 1,
            "open uses the highlight");
}


void check_keys(Ui *ui) {
    int which;
    long wide;

    which = key_index("key-indent=");
    expect(text_same(ui->key_shown(which), "<Control>]") == 1,
            "indent shows ]");
    which = key_index("key-unindent=");
    expect(text_same(ui->key_shown(which), "<Control>[") == 1,
            "unindent shows [");
    which = key_index("key-comment=");
    expect(text_same(ui->key_shown(which), "<Control>/") == 1,
            "comment shows /");
    wide = ui->key_button_width();
    expect(wide >= 160, "shortcut width");
    expect(ui->key_button_grows() == 0, "shortcut stays fixed");
    expect(ui->assign_key(0, "<Control>o") == 0,
            "duplicate asks");
    expect(ui->key_clash() == 1, "clash waits");
    expect(text_has(ui->key_clash_text(), "Open") == 1,
            "names the command");
    expect(text_same(ui->key_text(0), "<Control>n") == 1,
            "keeps New");
    expect(text_same(ui->key_text(1), "<Control>o") == 1,
            "keeps Open");
    ui->answer_key_clash(0);
    expect(ui->key_clash() == 0, "cancel closes");
    expect(text_same(ui->key_text(0), "<Control>n") == 1,
            "cancel keeps New");
    expect(text_same(ui->key_text(1), "<Control>o") == 1,
            "cancel keeps Open");
    expect(ui->assign_key(0, "<Control>o") == 0,
            "asks again");
    ui->answer_key_clash(1);
    expect(text_same(ui->key_text(0), "<Control>o") == 1,
            "New takes the combo");
    expect(text_same(ui->key_text(1), "") == 1,
            "Open is blank");
    ui->reset_key(1);
    expect(ui->key_clash() == 1, "default asks");
    ui->answer_key_clash(0);
    expect(text_same(ui->key_text(1), "") == 1,
            "default cancel stays blank");
    expect(text_same(ui->key_text(0), "<Control>o") == 1,
            "New still has it");
    ui->reset_key(1);
    ui->answer_key_clash(1);
    expect(text_same(ui->key_text(1), "<Control>o") == 1,
            "Open default");
    expect(text_same(ui->key_text(0), "") == 1,
            "New cleared");
    ui->reset_key(0);
    expect(ui->key_clash() == 0, "New default is free");
    expect(text_same(ui->key_text(0), "<Control>n") == 1,
            "New default");
    expect(ui->key_button_width() == wide,
            "width stays after a change");
    ui->apply_settings();
    which = key_index("key-indent=");
    expect(text_same(
                ui->key_text(which),
                "<Control>bracketright") == 1,
            "indent stays stored");
    expect(text_same(ui->key_shown(which), "<Control>]") == 1,
            "indent still shows ]");
}

int main(void) {
    char pattern[64];
    char pathA[EDITOR_PATH];
    char pathB[EDITOR_PATH];
    char pathC[EDITOR_PATH];
    char *dir;
    Editor *editor;
    Ui *ui;
    TextBuffer *view;
    TextIter *start;
    TextIter *end;
    const char *io;

    failures = 0;
    try {
        text_copy(pattern, 64, "/tmp/editor-win-XXXXXX");
        dir = mkdtemp(pattern);
        expect(dir != nullptr, "temp");
        if (dir == nullptr)
            return 1;
        path_join(pathA, EDITOR_PATH, dir, "a.scpp");
        path_join(pathB, EDITOR_PATH, dir, "b.scpp");
        io = "";
        expect(write_file(pathA, "one\n", &io) == 1, "seed a");
        expect(write_file(pathB, "two\n", &io) == 1, "seed b");
        editor = new Editor();
        expect(editor->open_file(pathA) == EDITOR_OK, "open a");
        expect(editor->open_file(pathB) == EDITOR_OK, "open b");
        expect(setenv("HOME", dir, 1) == 0, "home");
        seed_ctrl_a();
        ui = open_ui(editor);
        burn_stack(8);
        expect(text_same(ui->page_text(0), "one\n") == 1,
                "page a");
        check_panels(ui);
        expect(text_same(ui->page_text(1), "two\n") == 1,
                "page b");
        check_select_all(ui, editor);
        path_join(pathC, EDITOR_PATH, dir, "how_dy.scpp");
        expect(write_file(pathC, "howdy\n", &io) == 1,
                "seed howdy");
        ui->open_path(pathC);
        expect(text_same(ui->recent_at(0), pathC) == 1,
                "recent first");
        expect(ui->recent_count() == 10, "recent count");
        expect(editor->index() == 2, "open activates the tab");
        expect(text_has(
                    ui->tab_text(editor->index()),
                    "how_dy.scpp") == 1,
                "underscore in the name");
        {
            int i;
            int saw;

            saw = 0;
            i = 0;
            while (i < ui->panel_documents()) {
                if (text_same(
                            ui->shown_document(i),
                            "how_dy.scpp") == 1)
                    saw = 1;
                i = i + 1;
            }
            expect(saw == 1, "documents keeps the underscore");
        }
        expect(text_same(
                    ui->page_text(editor->index()),
                    "howdy\n") == 1,
                "opened howdy");
        ui->on_menu("Comment");
        expect(text_same(
                    ui->page_text(editor->index()),
                    "// howdy\n") == 1,
                "menu comment");
        ui->on_menu("Comment");
        expect(text_same(
                    ui->page_text(editor->index()),
                    "howdy\n") == 1,
                "menu uncomment");
        editor->active()->buffer()->mark_clean();
        ui->on_menu("Close");
        expect(editor->count() == 2, "closed howdy");
        unlink(pathC);
        ui->open_recent(pathC);
        expect(ui->missing_prompt() == 1,
                "recent says missing");
        expect(text_same(
                    ui->missing_text(),
                    "File \"how_dy.scpp\" not found.") == 1,
                "missing text");
        expect(editor->count() == 2,
                "missing file stays closed");
        expect(text_same(ui->page_text(0), "one\n") == 1,
                "missing leaves the buffer");
        ui->answer_missing(1);
        expect(ui->missing_prompt() == 0,
                "missing notice closed");
        expect(write_file(pathC, "howdy\n", &io) == 1,
                "recent restored");
        ui->open_recent(pathC);
        expect(ui->missing_prompt() == 0,
                "present file opens");
        expect(editor->count() == 3, "recent opened");
        expect(text_same(
                    ui->page_text(editor->index()),
                    "howdy\n") == 1,
                "recent text");
        ui->on_menu("Close");
        expect(editor->count() == 2, "closed recent again");
        {
            char sym[EDITOR_PATH];
            String *json;
            int i;
            int saw;

            expect(ui->show_folder(dir) == 1,
                    "panel folder");
            saw = 0;
            i = 0;
            while (i < ui->panel_files()) {
                if (text_same(
                            ui->panel_file(i),
                            "a.scpp") == 1) {
                    saw = 1;
                    expect(text_same(
                                ui->shown_file(i),
                                "a.scpp") == 1,
                            "file row");
                }
                i = i + 1;
            }
            expect(saw == 1, "panel lists a");
            ui->open_path(pathA);
            ui->open_path(pathB);
            path_join(sym, EDITOR_PATH, dir, "sym.scpp");
            json = new String();
            json->append("class Box {\n};\n\n");
            json->append("int work(void) {\n");
            json->append("    return 1;\n}\n");
            expect(write_file(
                        sym,
                        json->c_str(),
                        &io) == 1,
                    "symbol file");
            expect(ui->show_folder(dir) == 1,
                    "see symbol file");
            saw = -1;
            i = 0;
            while (i < ui->panel_files()) {
                if (text_same(
                            ui->panel_file(i),
                            "sym.scpp") == 1)
                    saw = i;
                i = i + 1;
            }
            expect(saw >= 0, "lists sym");
            ui->open_panel_file(saw);
            expect(text_has(
                        ui->page_text(editor->index()),
                        "work") == 1,
                    "panel opened");
            saw = -1;
            i = 0;
            while (i < ui->panel_symbols()) {
                if (text_same(
                            ui->panel_symbol(i),
                            "work") == 1)
                    saw = i;
                i = i + 1;
            }
            expect(saw >= 0, "symbol work");
            expect(ui->panel_symbol_line(saw) == 4,
                    "work line");
            ui->open_panel_symbol(saw);
            expect(
                    editor->active()->buffer()
                    ->cursor_line() == 4,
                    "symbol moves");
            editor->active()->buffer()->mark_clean();
            ui->on_menu("Close");
            expect(editor->count() == 2,
                    "closed symbol");
            unlink(sym);
        }
        {
            char pathR[EDITOR_PATH];
            long count;

            path_join(pathR, EDITOR_PATH, dir, "kept.scpp");
            expect(write_file(pathR, "draft\n", &io) == 1,
                    "recover seed");
            ui->open_path(pathR);
            editor->active()->buffer()->set_text(
                    "draft plus\n");
            editor->active()->buffer()->mark_dirty();
            expect(editor->save_active() == EDITOR_OK,
                    "recover save");
            expect(ui->write_recovery_files() >= 1,
                    "recover copy");
            ui->on_menu("Close");
            count = editor->count();
            unlink(pathR);
            ui->set_option("Write recovery files", 1);
            ui->offer_recovery();
            expect(ui->recovery_prompt() == 1,
                    "recover prompt");
            expect(text_same(
                        ui->recovery_text(),
                        "File \"kept.scpp\" is gone.") == 1,
                    "recover text");
            ui->answer_recovery(2);
            expect(ui->recovery_prompt() == 0,
                    "recover ignored");
            expect(editor->count() == count,
                    "ignore stays closed");
            {
                char recDir[EDITOR_PATH];
                char leaf[128];
                char recPath[EDITOR_PATH];

                expect(recovery_dir(
                            recDir,
                            EDITOR_PATH) == 1,
                        "recover dir");
                expect(recovery_leaf_for(
                            pathR, leaf, 128) == 1,
                        "recover leaf");
                path_join(
                        recPath,
                        EDITOR_PATH,
                        recDir,
                        leaf);
                expect(file_exists(recPath) == 0,
                        "ignore removes the copy");
            }
            ui->offer_recovery();
            expect(ui->recovery_prompt() == 0,
                    "ignore does not ask again");
            expect(write_file(pathR, "draft\n", &io) == 1,
                    "recover seed again");
            ui->open_path(pathR);
            editor->active()->buffer()->set_text(
                    "draft plus\n");
            editor->active()->buffer()->mark_dirty();
            expect(editor->save_active() == EDITOR_OK,
                    "recover save again");
            expect(ui->write_recovery_files() >= 1,
                    "recover copy again");
            ui->on_menu("Close");
            unlink(pathR);
            ui->offer_recovery();
            expect(ui->recovery_prompt() == 1,
                    "recover asks to open");
            ui->answer_recovery(1);
            expect(text_same(
                        ui->page_text(editor->index()),
                        "draft plus\n") == 1,
                    "opened recovery");
            expect(text_same(
                        ui->restored_text(),
                        "File \"kept.scpp\" was restored.")
                    == 1,
                    "says restored");
            ui->answer_restored(1);
            expect(ui->restored_prompt() == 0,
                    "restored closed");
            editor->active()->buffer()->mark_clean();
            ui->on_menu("Close");
            expect(editor->count() == count,
                    "closed recovery");
            ui->set_option("Write recovery files", 0);
            unlink(pathR);
        }
        ui->switched(0);
        expect(editor->index() == 0, "switch");
        view = ui->view_buffer();
        expect(view != nullptr, "view");
        expect(text_has(ui->line_number_text(), "1") == 1,
                "line numbers");
        expect(text_has(ui->line_number_text(), "2") == 1,
                "blank line number");
        view->set_text("");
        type_text(view, "(");
        expect(text_same(ui->page_text(0), "()") == 1,
                "type open paren");
        expect(editor->active()->buffer()->cursor_offset()
                        == 1,
                "caret between parens");
        type_text(view, ")");
        expect(text_same(ui->page_text(0), "()") == 1,
                "type close paren");
        expect(editor->active()->buffer()->cursor_offset()
                        == 2,
                "caret after pair");
        view->set_text("");
        type_text(view, "{");
        expect(text_same(ui->page_text(0), "{}") == 1,
                "type brace");
        ui->on_menu("Settings");
        editor->use_brackets(0);
        view->set_text("");
        type_text(view, "(");
        expect(text_same(ui->page_text(0), "(") == 1,
                "brackets off");
        editor->use_brackets(1);
        view->set_text("int value;\n");
        start = new TextIter(0, 0);
        end = new TextIter(0, 3);
        view->select_range(start, end);
        ui->on_menu("Copy");
        expect(text_same(editor->clipboard(), "int") == 1,
                "view copy");
        editor->active()->buffer()->set_cursor_offset(
                editor->active()->buffer()->size());
        ui->on_menu("Paste");
        expect(text_same(
                    editor->active()->buffer()->text(),
                    "int value;\nint") == 1,
                "view paste");
        expect(text_same(ui->page_text(0), "int value;\nint") == 1,
                "view shows paste");
        ui->on_menu("Undo");
        expect(text_same(
                    ui->page_text(0),
                    "int value;\n") == 1,
                "view undo");
        ui->on_menu("Redo");
        expect(text_same(
                    ui->page_text(0),
                    "int value;\nint") == 1,
                "view redo");
        view = ui->view_buffer();
        view->set_text("line\n");
        start = new TextIter(0, 0);
        end = new TextIter(0, 4);
        view->select_range(start, end);
        ui->on_menu("Indent");
        expect(text_same(ui->page_text(0), "    line\n") == 1,
                "view indent");
        ui->on_menu("Unindent");
        expect(text_same(ui->page_text(0), "line\n") == 1,
                "view unindent");
        view->set_text("hi");
        ui->on_menu("Record");
        ui->record_key("<Shift>q");
        ui->record_key("<Control>slash");
        ui->on_menu("Stop");
        expect(ui->recorded_keys() == 2, "two keys recorded");
        view->set_text("hi");
        start = new TextIter(0, 0);
        view->place_cursor(start);
        ui->on_menu("Play");
        expect(text_same(ui->page_text(0), "// Qhi") == 1,
                "played the macro");
        view->set_text("one\ntwo\n");
        pump(4);
        start = new TextIter(0, 0);
        view->place_cursor(start);
        ui->add_caret(1, 0);
        expect(ui->caret_count() == 2, "two carets");
        type_text(view, "X");
        type_text(view, "Y");
        pump(4);
        expect(text_same(ui->page_text(0), "XYone\nXYtwo\n") == 1,
                "typed at both carets");
        ui->on_menu("Comment");
        expect(text_same(
                    ui->page_text(0),
                    "// XYone\n// XYtwo\n") == 1,
                "comment at both carets");
        ui->on_menu("Undo");
        expect(text_same(ui->page_text(0), "XYone\nXYtwo\n") == 1,
                "undo caret comment");
        ui->clear_carets();
        view = ui->view_buffer();
        view->set_text("ab\ncd\n");
        pump(4);
        start = new TextIter(0, 2);
        view->place_cursor(start);
        ui->add_caret(1, 2);
        start = new TextIter(0, 1);
        end = new TextIter(0, 2);
        view->delete_range(start, end);
        pump(4);
        expect(text_same(ui->page_text(0), "a\nc\n") == 1,
                "delete at both carets");
        ui->clear_carets();
        expect(ui->caret_count() == 1, "carets cleared");
        view->set_text("line\n");
        expect(editor->active()->buffer()->dirty() == true,
                "edited");
        expect(tab_mark(ui->tab_text(0)) == 1, "dirty dot");
        ui->on_menu("Close");
        expect(editor->count() == 2, "dirty close waits");
        expect(editor->pending() == PEND_CLOSE, "close pending");
        ui->choice(EDITOR_CANCEL);
        expect(editor->pending() == PEND_NONE, "cancel close");
        expect(editor->count() == 2, "cancel kept both");
        ui->on_menu("Save");
        expect(editor->active()->buffer()->dirty() == false,
                "menu save");
        expect(tab_mark(ui->tab_text(0)) == 0, "clean dot");
        ui->set_option(
                "Save when a tab loses focus",
                1);
        view->set_text("blur\n");
        ui->switched(1);
        {
            char *blurred;
            long blurN;
            const char *blurErr;

            blurErr = "";
            blurN = 0;
            blurred = read_file(pathA, &blurN, &blurErr);
            expect(blurred != nullptr
                    && text_same(blurred, "blur\n") == 1,
                    "tab blur saved");
        }
        ui->set_option(
                "Save when a tab loses focus",
                0);
        ui->switched(0);
        expect(mapped_save_dialog() == 0, "named save has no dialog");
        view->set_text("saved\n");
        expect(editor->active()->buffer()->dirty() == true,
                "ctrl save dirty");
        ui->show_main();
        pump(40);
        check_panel_layout(ui);
        expect(send_ctrl_s() == 1, "ctrl s sent");
        pump(40);
        {
            char *raw;
            long n;
            const char *io2;
            long y;
            long yLine;
            long i;
            char many[256];

            io2 = "";
            n = 0;
            raw = read_file(pathA, &n, &io2);
            expect(raw != nullptr
                    && text_same(raw, "saved\n") == 1,
                    "ctrl s wrote the file");
            expect(mapped_save_dialog() == 0,
                    "ctrl s has no dialog");
            y = ui->gutter_line_y(0);
            expect(y >= 0 && y < 40,
                    "line 1 sits on the first text line");
            view->set_text("");
            ui->on_menu("Record");
            expect(send_chord(0x71, 0) == 1, "letter sent");
            pump(20);
            ui->on_menu("Stop");
            expect(ui->recorded_keys() >= 1, "heard the letter");
            expect(text_has(ui->page_text(0), "q") == 1,
                    "letter reached the buffer");
            view->set_text("");
            ui->on_menu("Play");
            expect(text_same(ui->page_text(0), "q") == 1,
                    "played the letter");
            i = 0;
            while (i + 2 < 256) {
                many[i] = 'x';
                many[i + 1] = '\n';
                i = i + 2;
            }
            many[i] = 0;
            view->set_text(many);
            pump(20);
            i = 0;
            y = 0;
            yLine = -1;
            while (i < 40) {
                ui->scroll_view(100);
                usleep(50000);
                pump(10);
                y = ui->gutter_line_y(0);
                yLine = ui->gutter_line_y(100);
                if (y < 0 && yLine >= 0 && yLine < 700)
                    break;
                i = i + 1;
            }
            expect(y < 0, "scrolled line 1 leaves the gutter");
            expect(yLine >= 0 && yLine < 700,
                    "scrolled line stays with its text");
            pump(20);
            {
                const char *gutter;

                gutter = ui->line_number_text();
                expect(gutter[0] != '1'
                        || gutter[1] != '\n',
                        "gutter names the buffer line");
            }
            {
                String *shape;
                long top;
                long band;
                long height;
                long y;
                long caret;
                long wide;
                int n;

                view->set_text("one\ntwo\nthree\n");
                n = 0;
                height = 0;
                while (n < 40) {
                    usleep(50000);
                    pump(10);
                    height = ui->map_height();
                    if (height > 40)
                        break;
                    n = n + 1;
                }
                expect(height > 40, "map has a height");
                expect(ui->map_top() == 0,
                        "short map starts at the top");
                band = ui->map_band();
                expect(band > 0, "short map has a band");
                expect(band < height,
                        "short map stays packed");
                caret = editor->active()->buffer()
                        ->cursor_line();
                wide = ui->map_width();
                ui->scroll_map_wheel(editor->index(), 3);
                pump(20);
                expect(editor->active()->buffer()
                                ->cursor_line() == caret,
                        "wheel leaves a short-file caret");
                expect(ui->map_top() == 0,
                        "wheel keeps a short map at the top");
                band = ui->map_band();
                expect(band > 0 && band < height,
                        "wheel keeps a short map packed");
                expect(ui->map_width() > wide - 3,
                        "wheel keeps a short map width");
                expect(ui->map_width() < wide + 3,
                        "short map width stays");
                shape = new String();
                shape->append("short\n");
                shape->append("\n");
                n = 0;
                while (n < 40) {
                    shape->append("x");
                    n = n + 1;
                }
                shape->append("\n");
                n = 0;
                while (n < 80) {
                    shape->append(".\n");
                    n = n + 1;
                }
                view->set_text(shape->c_str());
                ui->scroll_view(0);
                n = 0;
                y = -1;
                while (n < 40) {
                    usleep(50000);
                    pump(10);
                    y = ui->gutter_line_y(0);
                    if (y >= 0 && y < 40)
                        break;
                    n = n + 1;
                }
                expect(y >= 0 && y < 40,
                        "map test starts at the top");
                {
                    long index;
                    long tall;
                    long half;
                    long last;
                    long spot;

                    index = editor->index();
                    expect(ui->caret_margin() == 10,
                            "caret margin starts at 10");
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    pump(10);
                    expect(ui->shown_first() == 10,
                            "example starts on line 10");
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "example caret starts on 25");
                    expect(25 - ui->shown_first() == 15,
                            "caret starts 15 lines down");
                    ui->wheel_lines(index, -1);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 24,
                            "one notch moves the caret");
                    expect(ui->shown_first() == 10,
                            "a notch inside the margin stays");
                    ui->place_at(25, 1);
                    ui->wheel_lines(index, -6);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 19,
                            "six lines up lands on 19");
                    expect(ui->shown_first() == 9,
                            "the view scrolls up one line");
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line()
                            - ui->shown_first() == 10,
                            "the caret sits 10 lines down");
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    last = ui->shown_first()
                            + ui->shown_count() - 1;
                    spot = last - 15;
                    if (spot > ui->shown_first() + 10) {
                        ui->place_at(spot, 1);
                        ui->wheel_lines(index, 6);
                        expect(editor->active()
                                        ->buffer()
                                        ->cursor_line()
                                == spot + 6,
                                "six lines down moves the caret");
                        expect(ui->shown_first() == 11,
                                "the view scrolls down one line");
                        last = ui->shown_first()
                                + ui->shown_count() - 1;
                        expect(last
                                - editor->active()
                                        ->buffer()
                                        ->cursor_line()
                                == 10,
                                "the caret sits 10 lines up");
                    }
                    ui->show_first(1);
                    ui->place_at(5, 1);
                    ui->wheel_lines(index, -1);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 4,
                            "the caret can pass the margin");
                    expect(ui->shown_first() == 1,
                            "the view stops at the file");
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    tall = ui->text_line_height(index);
                    half = tall / 2;
                    ui->scroll_view_delta(
                            index,
                            4,
                            1,
                            -(double)half);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "half a line waits");
                    ui->scroll_view_delta(
                            index,
                            4,
                            1,
                            -(double)(tall - half));
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 24,
                            "smooth scroll moves one line");
                    expect(ui->shown_first() == 10,
                            "smooth scroll inside the margin stays");
                    ui->set_caret_margin(15);
                    ui->apply_settings();
                    expect(ui->caret_margin() == 15,
                            "setup changes the margin");
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    ui->wheel_lines(index, -6);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 19,
                            "the new margin keeps the caret");
                    expect(ui->shown_first() == 4,
                            "the new margin scrolls the view");
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line()
                            - ui->shown_first() == 15,
                            "the caret sits on the new margin");
                    {
                        char path[EDITOR_PATH];
                        char *raw;
                        long nread;
                        const char *err;

                        err = "";
                        nread = 0;
                        expect(config_path(
                                    path,
                                    EDITOR_PATH) == 1,
                                "margin settings path");
                        raw = read_file(path, &nread, &err);
                        expect(raw != nullptr
                                && text_has(
                                        raw,
                                        "caret-margin=15") == 1,
                                "caret margin is saved");
                    }
                    ui->set_caret_margin(10);
                    ui->apply_settings();
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    expect(send_wheel(4, 0) == 1,
                            "wheel reaches the buffer");
                    pump(20);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 24,
                            "the wheel moves the caret");
                    expect(ui->shown_first() == 10,
                            "the wheel leaves a wide margin");
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    ui->wheel_view(index, 1);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "ctrl wheel leaves the caret");
                    expect(ui->shown_first() == 11,
                            "ctrl wheel scrolls one line");
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    ui->wheel_view(index, 6);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "ctrl wheel keeps the caret");
                    expect(ui->shown_first() == 15,
                            "ctrl wheel stops at the margin");
                    expect(25 - ui->shown_first() == 10,
                            "the caret stays 10 lines down");
                    ui->wheel_view(index, 1);
                    expect(ui->shown_first() == 15,
                            "ctrl wheel stays on the margin");
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "a stopped ctrl wheel leaves the caret");
                    ui->show_first(1);
                    ui->place_at(5, 1);
                    ui->wheel_view(index, 1);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 5,
                            "ctrl wheel near the start keeps the caret");
                    expect(ui->shown_first() == 1,
                            "ctrl wheel stops at the file");
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    ui->scroll_view_held(
                            index,
                            4,
                            1,
                            (double)half);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "a short ctrl scroll waits");
                    expect(ui->shown_first() == 10,
                            "a short ctrl scroll stays put");
                    ui->scroll_view_held(
                            index,
                            4,
                            1,
                            (double)(tall - half));
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "smooth ctrl scroll leaves the caret");
                    expect(ui->shown_first() == 11,
                            "smooth ctrl scroll moves one line");
                    ui->set_caret_margin(15);
                    ui->show_first(1);
                    ui->place_at(25, 1);
                    ui->wheel_view(index, 40);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "the saved margin keeps the caret");
                    expect(ui->shown_first() == 10,
                            "ctrl wheel uses the saved margin");
                    expect(25 - ui->shown_first() == 15,
                            "the caret sits on that margin");
                    ui->set_caret_margin(10);
                    ui->apply_settings();
                    ui->show_first(10);
                    ui->place_at(25, 1);
                    expect(send_wheel(5, 1) == 1,
                            "ctrl wheel reaches the buffer");
                    pump(20);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "ctrl wheel event leaves the caret");
                    expect(ui->shown_first() == 11,
                            "ctrl wheel event scrolls one line");
                    ui->show_first(15);
                    ui->place_at(25, 1);
                    expect(send_wheel(5, 1) == 1,
                            "ctrl wheel at the margin is sent");
                    pump(20);
                    expect(editor->active()
                                    ->buffer()
                                    ->cursor_line() == 25,
                            "ctrl wheel at the margin keeps the caret");
                    expect(ui->shown_first() == 15,
                            "ctrl wheel event stops at the margin");
                    ui->scroll_view(0);
                    n = 0;
                    y = -1;
                    while (n < 40) {
                        usleep(50000);
                        pump(10);
                        y = ui->gutter_line_y(0);
                        if (y >= 0 && y < 40)
                            break;
                        n = n + 1;
                    }
                }
                expect(ui->map_ink(0) == 5,
                        "map short line");
                expect(ui->map_ink(1) == 0,
                        "map blank line");
                expect(ui->map_ink(2) == 40,
                        "map long line");
                height = ui->map_height();
                expect(height > 40, "map has a height");
                top = ui->map_top();
                band = ui->map_band();
                expect(band > 0, "viewport band");
                expect(band < height,
                        "viewport is part of the file");
                caret = editor->active()->buffer()
                        ->cursor_line();
                wide = ui->map_width();
                top = ui->map_top();
                ui->scroll_map_wheel(editor->index(), 4);
                n = 0;
                y = 0;
                while (n < 20) {
                    usleep(50000);
                    pump(10);
                    y = ui->gutter_line_y(0);
                    if (y < 0)
                        break;
                    n = n + 1;
                }
                expect(y < 0, "wheel scrolls the buffer");
                expect(editor->active()->buffer()
                                ->cursor_line() == caret,
                        "wheel leaves the caret");
                expect(ui->map_top() > top,
                        "wheel moves the viewport");
                expect(ui->map_width() > wide - 3,
                        "wheel keeps the map width");
                expect(ui->map_width() < wide + 3,
                        "map width stays through the wheel");
                ui->scroll_view(0);
                pump(20);
                ui->map_click(height - 1);
                n = 0;
                y = 0;
                while (n < 40) {
                    usleep(50000);
                    pump(10);
                    y = ui->gutter_line_y(0);
                    if (y < 0)
                        break;
                    n = n + 1;
                }
                expect(y < 0, "map click leaves the top");
                expect(ui->map_top() > top,
                        "viewport moved down");
                check_map_mark(ui, editor);
                check_map_font_dialog(ui);
                check_keys_gutter_map(ui, editor);
            }
            editor->active()->buffer()->mark_clean();
        }
        ui->on_menu("Close");
        expect(editor->count() == 1, "clean close");
        ui->switched(0);
        expect(text_same(ui->page_text(0), "two\n") == 1,
